# Public domain selected for this deployment; replace the operator email.
HELIX_DOMAIN=cognispect.tech
PUBLIC_URL=https://cognispect.tech
ACME_EMAIL=operator@example.org

HELIX_DATA_PATH=/srv/helix/data
HELIX_BACKUP_PATH=/srv/helix/backups
HELIX_CADDY_DATA_PATH=/srv/helix/caddy/data
HELIX_CADDY_CONFIG_PATH=/srv/helix/caddy/config

# Registration and password reset use this SMTP account.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# starttls (usually 587), ssl (usually 465), or none for a local relay.
SMTP_TLS=starttls

# Request throttling, PDF upload size (MiB), concurrent scientific calculations.
HELIX_RATE_LIMIT=1
HELIX_MAX_UPLOAD_MB=30
HELIX_COMPUTE_CONCURRENCY=2
