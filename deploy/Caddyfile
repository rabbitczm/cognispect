{
	email {$ACME_EMAIL}
}

{$HELIX_DOMAIN} {
	encode zstd gzip

	@versioned {
		path /assets/*
		query v=*
	}
	handle @versioned {
		root * /srv/helix
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}
	handle /assets/* {
		root * /srv/helix
		header Cache-Control "public, max-age=3600, must-revalidate"
		file_server
	}
	handle {
		reverse_proxy app:8000 {
			flush_interval -1
		}
	}
}
