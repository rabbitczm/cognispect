pe": ["doi"]}, "dateOfCompletion": "2020-03-27", "dateOfCreation": "2019-06-22", "dateOfRevision": "2025-05-30", "electronicPublicationDate": "2019-08-07", "firstPublicationDate": "2019-08-07", "firstIndexDate": "2019-06-24", "fullTextReceivedDate": "2025-02-03", "hasEvaluations": "N"}]}}