therlands."}]}}, {"fullName": "Schaefer-Prokop C", "lastName": "Schaefer-Prokop", "firstName": "Cornelia", "initials": "C", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Diagnostic Image Analysis Group, Radboud University Medical Center, Nijmegen, The Netherlands."}]}}, {"fullName": "Wille MMW", "lastName": "Wille", "firstName": "Mathilde M W", "initials": "MMW", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Respiratory Medicine, Gentofte Hospital, Copenhagen, Denmark."}]}}, {"fullName": "Marchianò A", "lastName": "Marchianò", "firstName": "Alfonso", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0003-1379-878X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Fondazione IRCCS Istituto Nazionale dei Tumori, Milano, Italy."}]}}, {"fullName": "Pastorino U", "lastName": "Pastorino", "firstName": "Ugo", "initials": "U", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Fondazione IRCCS Istituto Nazionale dei Tumori, Milano, Italy."}]}}, {"fullName": "Prokop M", "lastName": "Prokop", "firstName": "Mathias", "initials": "M", "authorId": {"type": "ORCID", "value": "0000-0001-8157-8055"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Diagnostic Image Analysis Group, Radboud University Medical Center, Nijmegen, The Netherlands."}]}}, {"fullName": "van Ginneken B", "lastName": "van Ginneken", "firstName": "Bram", "initials": "B", "authorId": {"type": "ORCID", "value": "0000-0003-2028-8972"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Diagnostic Image Analysis Group, Radboud University Medical Center, Nijmegen, The Netherlands."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-8157-8055"}, {"type": "ORCID", "value": "0000-0001-8327-9606"}, {"type": "ORCID", "value": "0000-0003-1180-3805"}, {"type": "ORCID", "value": "0000-0003-1379-878X"}, {"type": "ORCID", "value": "0000-0003-2028-8972"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"volume": "7", "journalIssueId": 2542553, "dateOfPublication": "2017 Apr", "monthOfPublication": 4, "yearOfPublication": 2017, "journal": {"medlineAbbreviation": "Sci Rep", "title": "Scientific reports", "essn": "2045-2322", "issn": "2045-2322", "nlmid": "101563288", "isoabbreviation": "Sci Rep"}, "printPublicationDate": "2017-04-01"}, "pubYear": "2017", "pageInfo": "46479", "abstractText": "The introduction of lung cancer screening programs will produce an unprecedented amount of chest CT scans in the near future, which radiologists will have to read in order to decide on a patient follow-up strategy. According to the current guidelines, the workup of screen-detected nodules strongly relies on nodule size and nodule type. In this paper, we present a deep learning system based on multi-stream multi-scale convolutional networks, which automatically classifies all nodule types relevant for nodule workup. The system processes raw CT data containing a nodule without the need for any additional information such as nodule segmentation or nodule size and learns a representation of 3D data by analyzing an arbitrary number of 2D views of a given nodule. The deep learning system was trained with data from the Italian MILD screening trial and validated on an independent set of data from the Danish DLCST screening trial. We analyze the advantage of processing nodules at multiple scales with a multi-stream convolutional network architecture, and we show that the proposed deep learning system achieves performance at classifying nodule type that surpasses the one of classical machine learning approaches and is within the inter-observer variability among four experienced human observers.", "affiliation": "Diagnostic Image Analysis Group, Radboud University Medical Center, Nijmegen, The Netherlands.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Lung Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Tomography, X-Ray Computed"}, {"majorTopic_YN": "N", "descriptorName": "Solitary Pulmonary Nodule", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}]}}, {"majorTopic_YN": "N", "descriptorName": "Early Detection of Cancer", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Deep Learning"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1038/srep46479"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC5395959"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC5395959?pdf=render"}]}, "commentCorrectionList": {"commentCorrection": [{"source": "MED", "id": "28880026", "reference": "Sci Rep. 2017 Sep 07;7:46878. doi: 10.1038/srep46878", "type": "Erratum in", "orderIn": 1}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 198, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "Y", "hasData": "Y", "license": "cc by", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "Y