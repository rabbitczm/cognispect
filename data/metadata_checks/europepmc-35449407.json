ffiliation": [{"affiliation": "Massachusetts Institute of Technology, Cambridge, MA, USA."}]}}, {"fullName": "Fuster V", "lastName": "Fuster", "firstName": "Valentin", "initials": "V", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Icahn School of Medicine at Mount Sinai, New York, NY, USA."}]}}, {"fullName": "Jang IK", "lastName": "Jang", "firstName": "Ik-Kyung", "initials": "IK", "authorId": {"type": "ORCID", "value": "0000-0002-5796-3006"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Massachusetts General Hospital, Boston, MA, USA. ijang@mgh.harvard.edu."}, {"affiliation": "Kyung Hee University, Seoul, South Korea. ijang@mgh.harvard.edu."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5100-0471"}, {"type": "ORCID", "value": "0000-0001-5577-081X"}, {"type": "ORCID", "value": "0000-0001-9092-4458"}, {"type": "ORCID", "value": "0000-0001-9251-7610"}, {"type": "ORCID", "value": "0000-0002-0542-0448"}, {"type": "ORCID", "value": "0000-0002-1502-502X"}, {"type": "ORCID", "value": "0000-0002-2045-8567"}, {"type": "ORCID", "value": "0000-0002-2090-2031"}, {"type": "ORCID", "value": "0000-0002-2169-3112"}, {"type": "ORCID", "value": "0000-0002-2823-3928"}, {"type": "ORCID", "value": "0000-0002-2971-8310"}, {"type": "ORCID", "value": "0000-0002-3291-2632"}, {"type": "ORCID", "value": "0000-0002-3614-0924"}, {"type": "ORCID", "value": "0000-0002-4461-2055"}, {"type": "ORCID", "value": "0000-0002-4531-2206"}, {"type": "ORCID", "value": "0000-0002-5646-0378"}, {"type": "ORCID", "value": "0000-0002-5796-3006"}, {"type": "ORCID", "value": "0000-0002-5935-3236"}, {"type": "ORCID", "value": "0000-0002-6439-1018"}, {"type": "ORCID", "value": "0000-0002-7267-4376"}, {"type": "ORCID", "value": "0000-0002-7815-9789"}, {"type": "ORCID", "value": "0000-0002-8034-4529"}, {"type": "ORCID", "value": "0000-0002-8099-1224"}, {"type": "ORCID", "value": "0000-0002-8666-3731"}, {"type": "ORCID", "value": "0000-0002-9854-5046"}, {"type": "ORCID", "value": "0000-0003-0571-3918"}, {"type": "ORCID", "value": "0000-0003-0824-3026"}, {"type": "ORCID", "value": "0000-0003-2263-3274"}, {"type": "ORCID", "value": "0000-0003-2447-6815"}, {"type": "ORCID", "value": "0000-0003-2948-7994"}, {"type": "ORCID", "value": "0000-0003-2968-0057"}, {"type": "ORCID", "value": "0000-0003-3354-0698"}, {"type": "ORCID", "value": "0000-0003-3827-945X"}, {"type": "ORCID", "value": "0000-0003-4638-601X"}, {"type": "ORCID", "value": "0000-0003-4669-3562"}, {"type": "ORCID", "value": "0000-0003-4932-0112"}, {"type": "ORCID", "value": "0009-0008-8311-4252"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data", "full_text"]}, "journalInfo": {"issue": "10", "volume": "19", "journalIssueId": 3423878, "dateOfPublication": "2022 Oct", "monthOfPublication": 10, "yearOfPublication": 2022, "journal": {"medlineAbbreviation": "Nat Rev Cardiol", "title": "Nature reviews. Cardiology", "essn": "1759-5010", "issn": "1759-5002", "nlmid": "101500075", "isoabbreviation": "Nat Rev Cardiol"}, "printPublicationDate": "2022-10-01"}, "pubYear": "2022", "pageInfo": "684-703", "abstractText": "Since optical coherence tomography (OCT) was first performed in humans two decades ago, this imaging modality has been widely adopted in research on coronary atherosclerosis and adopted clinically for the optimization of percutaneous coronary intervention. In the past 10 years, substantial advances have been made in the understanding of in vivo vascular biology using OCT. Identification by OCT of culprit plaque pathology could potentially lead to a major shift in the management of patients with acute coronary syndromes. Detection by OCT of healed coronary plaque has been important in our understanding of the mechanisms involved in plaque destabilization and healing with the rapid progression of atherosclerosis. Accurate detection by OCT of sequelae from percutaneous coronary interventions that might be missed by angiography could improve clinical outcomes. In addition, OCT has become an essential diagnostic modality for myocardial infarction with non-obstructive coronary arteries. Insight into neoatherosclerosis from OCT could improve our understanding of the mechanisms of very late stent thrombosis. The appropriate use of OCT depends on accurate interpretation and understanding of the clinical significance of OCT findings. In this Review, we summarize the state of the art in cardiac OCT and facilitate the uniform use of this modality in coronary atherosclerosis. Contributions have been made by clinicians and investigators worldwide with extensive experience in OCT, with the aim that this document will serve as a standard reference for future research and clinical application.", "affiliation": "Massachusetts General Hospital, Boston, MA, USA.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Review", "Journal Article"]}, "grantsList": {"grant": [{"agency": "NIBIB NIH HHS", "acronym": "EB", "grantId": "P41 EB015903", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Coronary Vessels", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}, {"majorTopic_YN": "N", "abbreviation": "PA", "qualifierName": "pathology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "Y", "descriptorName": "Myocardial Infarction", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "CO", "qualifierName": "complications"}]}}, {"majorTopic_YN": "N", "descriptorName": "Coronary Angiography", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Tomography, Optical Coherence", "meshQualifierList": {"meshQualifier": [{"majo