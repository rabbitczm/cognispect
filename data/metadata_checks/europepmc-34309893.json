ilsList": {"authorAffiliation": [{"affiliation": "Department of Nuclear Medicine and Oncological Imaging, University Hospital of Liege, Liege, Belgium."}]}}, {"fullName": "Leijenaar RTH", "lastName": "Leijenaar", "firstName": "Ralph T H", "initials": "RTH", "authorId": {"type": "ORCID", "value": "0000-0001-8642-9657"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Radiomics (Oncoradiomics SA), Liège, Belgium."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-7800-1730"}, {"type": "ORCID", "value": "0000-0001-7961-0191"}, {"type": "ORCID", "value": "0000-0001-8642-9657"}, {"type": "ORCID", "value": "0000-0002-8162-8793"}, {"type": "ORCID", "value": "0000-0003-0785-3412"}, {"type": "ORCID", "value": "0009-0002-0113-6703"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics"]}, "journalInfo": {"issue": "1", "volume": "42", "journalIssueId": 3278707, "dateOfPublication": "2022 Jan", "monthOfPublication": 1, "yearOfPublication": 2022, "journal": {"medlineAbbreviation": "Med Res Rev", "title": "Medicinal research reviews", "essn": "1098-1128", "issn": "0198-6325", "nlmid": "8103150", "isoabbreviation": "Med Res Rev"}, "printPublicationDate": "2022-01-01"}, "pubYear": "2022", "pageInfo": "426-440", "abstractText": "Radiomics is the quantitative analysis of standard-of-care medical imaging; the information obtained can be applied within clinical decision support systems to create diagnostic, prognostic, and/or predictive models. Radiomics analysis can be performed by extracting hand-crafted radiomics features or via deep learning algorithms. Radiomics has evolved tremendously in the last decade, becoming a bridge between imaging and precision medicine. Radiomics exploits sophisticated image analysis tools coupled with statistical elaboration to extract the wealth of information hidden inside medical images, such as computed tomography (CT), magnetic resonance (MR), and/or Positron emission tomography (PET) scans, routinely performed in the everyday clinical practice. Many efforts have been devoted in recent years to the standardization and validation of radiomics approaches, to demonstrate their usefulness and robustness beyond any reasonable doubts. However, the booming of publications and commercial applications of radiomics approaches warrant caution and proper understanding of all the factors involved to avoid \"scientific pollution\" and overly enthusiastic claims by researchers and clinicians alike. For these reasons the present review aims to be a guidebook of sorts, describing the process of radiomics, its pitfalls, challenges, and opportunities, along with its ability to improve clinical decision-making, from oncology and respiratory medicine to pharmacological and genotyping studies.", "affiliation": "Department of Pneumology, University Hospital of Liège, Liège, Belgium.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "Review", "Journal Article"]}, "grantsList": {"grant": [{"agency": "European Research Council", "grantId": "EuCanImage n° 952103", "orderIn": 0}, {"agency": "European Research Council", "grantId": "ImmunoSABR n° 733008", "orderIn": 0}, {"agency": "European Research Council", "grantId": "CHAIMELEON n° 952172", "orderIn": 0}, {"agency": "European Research Council", "grantId": "MSCA‐ITN‐PREDICT n° 766276", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Positron-Emission Tomography"}, {"majorTopic_YN": "N", "descriptorName": "Magnetic Resonance Imaging"}, {"majorTopic_YN": "N", "descriptorName": "Medical Oncology"}, {"majorTopic_YN": "Y", "descriptorName": "Image Processing, Computer-Assisted", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Precision Medicine"}]}, "keywordList": {"keyword": ["Artificial intelligence", "Personalized Medicine", "Machine Learning", "Deep Learning", "Radiomics"]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1002/med.21846"}]}, "isOpenAccess": "N", "inEPMC": "N", "inPMC": "N", "citedByCount": 271, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "N", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "Y", "hasData": "N", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "N", "dateOfCompletion": "2022-04-04", "dateOfCreation": "2021-07-26", "dateOfRevision": "2022-04-05", "electronicPublicationDate": "2021-07-26", "firstPublicationDate": "2021-07-26", "firstIndexDate": "2021-07-27", "hasEvaluations": "N"}]}}