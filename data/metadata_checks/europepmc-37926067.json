nDetailsList": {"authorAffiliation": [{"affiliation": "Lunit Inc., Seoul, Korea."}]}}, {"fullName": "Shin S", "lastName": "Shin", "firstName": "Sangwon", "initials": "S", "authorId": {"type": "ORCID", "value": "0009-0003-2626-3052"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Lunit Inc., Seoul, Korea."}]}}, {"fullName": "Yang SA", "lastName": "Yang", "firstName": "Su-A", "initials": "SA", "authorId": {"type": "ORCID", "value": "0009-0006-5875-4966"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Lunit Inc., Seoul, Korea."}]}}, {"fullName": "Park EK", "lastName": "Park", "firstName": "Eun Kyung", "initials": "EK", "authorId": {"type": "ORCID", "value": "0000-0002-5388-9515"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Lunit Inc., Seoul, Korea."}]}}, {"fullName": "Kim KH", "lastName": "Kim", "firstName": "Ki Hwan", "initials": "KH", "authorId": {"type": "ORCID", "value": "0000-0001-7684-235X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Lunit Inc., Seoul, Korea."}]}}, {"fullName": "Cho SI", "lastName": "Cho", "firstName": "Soo Ick", "initials": "SI", "authorId": {"type": "ORCID", "value": "0000-0003-3414-9869"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Lunit Inc., Seoul, Korea."}]}}, {"fullName": "Ock CY", "lastName": "Ock", "firstName": "Chan-Young", "initials": "CY", "authorId": {"type": "ORCID", "value": "0000-0002-6755-9728"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Lunit Inc., Seoul, Korea."}]}}, {"fullName": "Kim S", "lastName": "Kim", "firstName": "Seokhwi", "initials": "S", "authorId": {"type": "ORCID", "value": "0000-0001-7646-5064"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Pathology, Ajou University School of Medicine, Suwon, Korea."}, {"affiliation": "Department of Biomedical Sciences, Ajou University Graduate School of Medicine, Suwon, Korea. seokhwikim@ajou.ac.kr."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-7646-5064"}, {"type": "ORCID", "value": "0000-0001-7684-235X"}, {"type": "ORCID", "value": "0000-0002-5388-9515"}, {"type": "ORCID", "value": "0000-0002-6755-9728"}, {"type": "ORCID", "value": "0000-0003-1189-5981"}, {"type": "ORCID", "value": "0000-0003-3414-9869"}, {"type": "ORCID", "value": "0009-0003-2626-3052"}, {"type": "ORCID", "value": "0009-0006-5875-4966"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "5", "volume": "26", "journalIssueId": 3659574, "dateOfPublication": "2023 Oct", "monthOfPublication": 10, "yearOfPublication": 2023, "journal": {"medlineAbbreviation": "J Breast Cancer", "title": "Journal of breast cancer", "essn": "2092-9900", "issn": "1738-6756", "nlmid": "101314183", "isoabbreviation": "J Breast Cancer"}, "printPublicationDate": "2023-10-01"}, "pubYear": "2023", "pageInfo": "405-435", "abstractText": "Breast cancer is a significant cause of cancer-related mortality in women worldwide. Early and precise diagnosis is crucial, and clinical outcomes can be markedly enhanced. The rise of artificial intelligence (AI) has ushered in a new era, notably in image analysis, paving the way for major advancements in breast cancer diagnosis and individualized treatment regimens. In the diagnostic workflow for patients with breast cancer, the role of AI encompasses screening, diagnosis, staging, biomarker evaluation, prognostication, and therapeutic response prediction. Although its potential is immense, its complete integration into clinical practice is challenging. Particularly, these challenges include the imperatives for extensive clinical validation, model generalizability, navigating the \"black-box\" conundrum, and pragmatic considerations of embedding AI into everyday clinical environments. In this review, we comprehensively explored the diverse applications of AI in breast cancer care, underlining its transformative promise and existing impediments. In radiology, we specifically address AI in mammography, tomosynthesis, risk prediction models, and supplementary imaging methods, including magnetic resonance imaging and ultrasound. In pathology, our focus is on AI applications for pathologic diagnosis, evaluation of biomarkers, and predictions related to genetic alterations, treatment response, and prognosis in the context of breast cancer diagnosis and treatment. Our discussion underscores the transformative potential of AI in breast cancer management and emphasizes the importance of focused research to realize the full spectrum of benefits of AI in patient care.", "affiliation": "Lunit Inc., Seoul, Korea.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["review-article", "Review", "Journal Article"]}, "keywordList": {"keyword": ["Artificial intelligence", "Pathology", "Breast neoplasms", "Diagnostic Imaging", "Precision Medicine"]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.4048/jbc.2023.26.e45"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC10625863"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC10625863?pdf=render"}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 103, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "Y", "hasData": "Y", "license": "cc by-nc", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["doi"]}, "dateOfCreation": "2023-11-05", "dateOfRevision": "2023-11-10", "firstPublicationDate": "2023-10-01", "firstIndexDate": "2023-11-06", "fullTextReceivedDate": "2023-11-07", "hasEvaluations": "N"}]}}