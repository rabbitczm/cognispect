ffiliation": [{"affiliation": "Smart Bio-Interfaces, Istituto Italiano di Tecnologia, 56025 Pisa, Italy."}]}}, {"fullName": "Martinelli C", "lastName": "Martinelli", "firstName": "Chiara", "initials": "C", "authorId": {"type": "ORCID", "value": "0000-0001-9360-1689"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Smart Bio-Interfaces, Istituto Italiano di Tecnologia, 56025 Pisa, Italy."}]}}, {"fullName": "Ciofani G", "lastName": "Ciofani", "firstName": "Gianni", "initials": "G", "authorId": {"type": "ORCID", "value": "0000-0003-1192-3647"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Smart Bio-Interfaces, Istituto Italiano di Tecnologia, 56025 Pisa, Italy."}, {"affiliation": "Department of Mechanical and Aerospace Engineering, Politecnico di Torino, 10129 Torino, Italy."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-9360-1689"}, {"type": "ORCID", "value": "0000-0002-8976-3711"}, {"type": "ORCID", "value": "0000-0003-1192-3647"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"volume": "13", "journalIssueId": 2785265, "dateOfPublication": "2019 ", "monthOfPublication": 0, "yearOfPublication": 2019, "journal": {"medlineAbbreviation": "Ecancermedicalscience", "title": "Ecancermedicalscience", "essn": "1754-6605", "issn": "1754-6605", "nlmid": "101392236", "isoabbreviation": "Ecancermedicalscience"}, "printPublicationDate": "2019-01-01"}, "pubYear": "2019", "pageInfo": "961", "abstractText": "Every year, cancer is responsible for millions of deaths worldwide and, even though much progress has been achieved in medicine, there are still many issues that must be addressed in order to improve cancer therapy. For this reason, oncological research is putting a lot of effort towards finding new and efficient therapies which can alleviate critical side effects caused by conventional treatments. Different technologies are currently under evaluation in clinical trials or have been already introduced into clinical practice. While nanomedicine is contributing to the development of biocompatible materials both for diagnostic and therapeutic purposes, bioengineering of extracellular vesicles and cells derived from patients has allowed designing <i>ad hoc</i> systems and univocal targeting strategies. In this review, we will provide an in-depth analysis of the most innovative advances in basic and applied cancer research.", "affiliation": "Smart Bio-Interfaces, Istituto Italiano di Tecnologia, 56025 Pisa, Italy.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["review-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "European Research Council", "acronym": "ERC_", "grantId": "709613", "orderIn": 0}]}, "keywordList": {"keyword": ["Gene therapy", "Cancer", "Immunotherapy", "Targeted Therapy", "Nanomedicine", "Thermal Ablation", "Extracellular Vesicles", "Radiomics", "Pathomics"]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Unpaywall", "url": "https://ecancer.org/en/journal/article/961-innovative-approaches-for-cancer-treatment-current-perspectives-and-new-challenges/pdf"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.3332/ecancer.2019.961"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC6753017"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC6753017?pdf=render"}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 431, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "Y", "hasData": "Y", "license": "cc by", "authMan": "Y", "epmcAuthMan": "Y", "nihAuthMan": "N", "manuscriptId": "EMS84369", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["doi"]}, "dateOfCreation": "2019-09-21", "dateOfRevision": "2026-04-29", "firstPublicationDate": "2019-01-01", "firstIndexDate": "2019-09-22", "fullTextReceivedDate": "2025-02-03", "hasEvaluations": "N"}]}}