rAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Metabolic Diseases, Graduate School of Medicine, University of Tokyo, Tokyo, Japan. kadowaki-3im@h.u-tokyo.ac.jp"}]}}, {"fullName": "Yamauchi T", "lastName": "Yamauchi", "firstName": "Toshimasa", "initials": "T"}, {"fullName": "Kubota N", "lastName": "Kubota", "firstName": "Naoto", "initials": "N"}, {"fullName": "Hara K", "lastName": "Hara", "firstName": "Kazuo", "initials": "K"}, {"fullName": "Ueki K", "lastName": "Ueki", "firstName": "Kohjiro", "initials": "K"}, {"fullName": "Tobe K", "lastName": "Tobe", "firstName": "Kazuyuki", "initials": "K"}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-5428-3582"}]}, "dataLinksTagsList": {"dataLinkstag": ["related_data"]}, "journalInfo": {"issue": "7", "volume": "116", "journalIssueId": 1333397, "dateOfPublication": "2006 Jul", "monthOfPublication": 7, "yearOfPublication": 2006, "journal": {"medlineAbbreviation": "J Clin Invest", "title": "The Journal of clinical investigation", "essn": "1558-8238", "issn": "0021-9738", "nlmid": "7802877", "isoabbreviation": "J Clin Invest"}, "printPublicationDate": "2006-07-01"}, "pubYear": "2006", "pageInfo": "1784-1792", "abstractText": "Adiponectin is an adipokine that is specifically and abundantly expressed in adipose tissue and directly sensitizes the body to insulin. Hypoadiponectinemia, caused by interactions of genetic factors such as SNPs in the Adiponectin gene and environmental factors causing obesity, appears to play an important causal role in insulin resistance, type 2 diabetes, and the metabolic syndrome, which are linked to obesity. The adiponectin receptors, AdipoR1 and AdipoR2, which mediate the antidiabetic metabolic actions of adiponectin, have been cloned and are downregulated in obesity-linked insulin resistance. Upregulation of adiponectin is a partial cause of the insulin-sensitizing and antidiabetic actions of thiazolidinediones. Therefore, adiponectin and adiponectin receptors represent potential versatile therapeutic targets to combat obesity-linked diseases characterized by insulin resistance. This Review describes the pathophysiology of adiponectin and adiponectin receptors in insulin resistance, diabetes, and the metabolic syndrome.", "affiliation": "Department of Metabolic Diseases, Graduate School of Medicine, University of Tokyo, Tokyo, Japan. kadowaki-3im@h.u-tokyo.ac.jp", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "review-article", "Review", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Diabetes Mellitus, Type 2", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "ME", "qualifierName": "metabolism"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Insulin Resistance"}, {"majorTopic_YN": "N", "descriptorName": "Receptors, Cell Surface", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "GE", "qualifierName": "genetics"}, {"majorTopic_YN": "Y", "abbreviation": "ME", "qualifierName": "metabolism"}, {"majorTopic_YN": "N", "abbreviation": "CH", "qualifierName": "chemistry"}]}}, {"majorTopic_YN": "N", "descriptorName": "Polymorphism, Single Nucleotide"}, {"majorTopic_YN": "N", "descriptorName": "Adiponectin", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "BL", "qualifierName": "blood"}, {"majorTopic_YN": "N", "abbreviation": "GE", "qualifierName": "genetics"}]}}, {"majorTopic_YN": "N", "descriptorName": "Receptors, Adiponectin"}, {"majorTopic_YN": "N", "descriptorName": "Metabolic Syndrome", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "ME", "qualifierName": "metabolism"}]}}]}, "chemicalList": {"chemical": [{"name": "adiponectin", "registryNumber": "0"}, {"name": "Receptors, Cell Surface", "registryNumber