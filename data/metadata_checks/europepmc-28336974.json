nDetailsList": {"authorAffiliation": [{"affiliation": "Department of Biomedical Sciences, Humanitas University, via Manzoni, 113-20089, Rozzano, (Milan), Italy. martina.sollini@cancercenter.humanitas.it."}]}}, {"fullName": "Cozzi L", "lastName": "Cozzi", "firstName": "L", "initials": "L", "authorId": {"type": "ORCID", "value": "0000-0001-7862-898X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Biomedical Sciences, Humanitas University, via Manzoni, 113-20089, Rozzano, (Milan), Italy."}, {"affiliation": "Radiotherapy and Radiosurgery Unit, Humanitas Clinical and Research Center, via Manzoni, 56-20089, Rozzano, (Milan), Italy."}]}}, {"fullName": "Antunovic L", "lastName": "Antunovic", "firstName": "L", "initials": "L", "authorId": {"type": "ORCID", "value": "0000-0003-1832-1083"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Nuclear Medicine Unit, Humanitas Clinical and Research Center, via Manzoni, 56-20089, Rozzano, (Milan), Italy."}]}}, {"fullName": "Chiti A", "lastName": "Chiti", "firstName": "A", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0002-5806-1856"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Biomedical Sciences, Humanitas University, via Manzoni, 113-20089, Rozzano, (Milan), Italy."}, {"affiliation": "Nuclear Medicine Unit, Humanitas Clinical and Research Center, via Manzoni, 56-20089, Rozzano, (Milan), Italy."}]}}, {"fullName": "Kirienko M", "lastName": "Kirienko", "firstName": "M", "initials": "M", "authorId": {"type": "ORCID", "value": "0000-0002-3923-1151"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Biomedical Sciences, Humanitas University, via Manzoni, 113-20089, Rozzano, (Milan), Italy."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-7862-898X"}, {"type": "ORCID", "value": "0000-0002-3923-1151"}, {"type": "ORCID", "value": "0000-0002-5806-1856"}, {"type": "ORCID", "value": "0000-0003-1832-1083"}, {"type": "ORCID", "value": "0000-0003-2214-6492"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "1", "volume": "7", "journalIssueId": 2536506, "dateOfPublication": "2017 Mar", "monthOfPublication": 3, "yearOfPublication": 2017, "journal": {"medlineAbbreviation": "Sci Rep", "title": "Scientific reports", "essn": "2045-2322", "issn": "2045-2322", "isoabbreviation": "Sci Rep", "nlmid": "101563288"}, "printPublicationDate": "2017-03-01"}, "pubYear": "2017", "pageInfo": "358", "abstractText": "Imaging with positron emission tomography (PET)/computed tomography (CT) is crucial in the management of cancer because of its value in tumor staging, response assessment, restaging, prognosis and treatment responsiveness prediction. In the last years, interest has grown in texture analysis which provides an \"in-vivo\" lesion characterization, and predictive information in several malignances including NSCLC; however several drawbacks and limitations affect these studies, especially because of lack of standardization in features calculation, definitions and methodology reporting. The present paper provides a comprehensive review of literature describing the state-of-the-art of FDG-PET/CT texture analysis in NSCLC, suggesting a proposal for harmonization of methodology.", "affiliation": "Department of Biomedical Sciences, Humanitas University, via Manzoni, 113-20089, Rozzano, (Milan), Italy. martina.sollini@cancercenter.humanitas.it.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["research-article", "Review", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Carcinoma, Non-Small-Cell Lung", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}, {"majorTopic_YN": "N"