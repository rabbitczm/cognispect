 AV", "lastName": "Parwani", "firstName": "Anil V", "initials": "AV", "authorId": {"type": "ORCID", "value": "0009-0007-7224-6682"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "The Ohio State University Medical Center, Columbus, OH, USA."}]}}, {"fullName": "Lillard K", "lastName": "Lillard", "firstName": "Kate", "initials": "K", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Indica Labs, Inc., Corrales, NM, USA."}]}}, {"fullName": "Turner OC", "lastName": "Turner", "firstName": "Oliver C", "initials": "OC", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Novartis, Novartis Institutes for BioMedical Research, Preclinical Safety, East Hannover, NJ, USA."}]}}, {"fullName": "Vemuri VNP", "lastName": "Vemuri", "firstName": "Venkata N P", "initials": "VNP", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "3scan, San Francisco, CA, USA."}]}}, {"fullName": "Yuil-Valdes AG", "lastName": "Yuil-Valdes", "firstName": "Ana G", "initials": "AG", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Pathology and Microbiology, University of Nebraska Medical Center, Omaha, NE, USA."}]}}, {"fullName": "Bowman D", "lastName": "Bowman", "firstName": "Douglas", "initials": "D", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Indica Labs, Inc., Corrales, NM, USA."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-1405-9228"}, {"type": "ORCID", "value": "0000-0002-1722-6773"}, {"type": "ORCID", "value": "0009-0007-7224-6682"}]}, "dataLinksTagsList": {"dataLinkstag": ["wikipedia"]}, "journalInfo": {"volume": "10", "journalIssueId": 2784670, "dateOfPublication": "2019 ", "monthOfPublication": 0, "yearOfPublication": 2019, "journal": {"medlineAbbreviation": "J Pathol Inform", "title": "Journal of pathology informatics", "essn": "2153-3539", "issn": "2229-5089", "isoabbreviation": "J Pathol Inform", "nlmid": "101528849"}, "printPublicationDate": "2019-01-01"}, "pubYear": "2019", "pageInfo": "9", "abstractText": "The advent of whole-slide imaging in digital pathology has brought about the advancement of computer-aided examination of tissue via digital image analysis. Digitized slides can now be easily annotated and analyzed via a variety of algorithms. This study reviews the fundamentals of tissue image analysis and aims to provide pathologists with basic information regarding the features, applications, and general workflow of these new tools. The review gives an overview of the basic categories of software solutions available, potential analysis strategies, technical considerations, and general algorithm readouts. Advantages and limitations of tissue image analysis are discussed, and emerging concepts, such as artificial intelligence and machine learning, are introduced. Finally, examples of how digital image analysis tools are currently being used in diagnostic laboratories, translational research, and drug development are discussed.", "affiliation": "Amgen Inc., Amgen Research, Comparative Biology and Safety Sciences, South San Francisco, CA, USA.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic-eCollection", "pubTypeList": {"pubType": ["review-article", "Review", "Journal Article"]}, "keywordList": {"keyword": ["Artificial intelligence", "Image analysis", "Quantitative image analysis", "Digital Pathology", "Whole-slide Imaging", "Computational Pathology"]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": "OA", "documentStyle": "doi", "site": "Unpaywall", "url": "https://doi.org/10.4103/jpi.jpi_82_18"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.4103/jpi.jpi_82_18"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC6437786"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC6437786?pdf=render"}]}, "commentCorrectionList": {"commentCorrection": [{"source": "MED", "id": "31198617", "reference": "J Pathol Inform. 2019 Apr 24;10:15. doi: 10.4103/2153-3539.259372", "type": "Erratum in", "orderIn": 1}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 256, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "Y", "hasData": "N", "license": "cc by-nc-sa", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "N", "dateOfCreation": "2019-04-16", "dateOfRevision": "2022-07-29", "electronicPublicationDate": "2019-03-08", "firstPublicationDate": "2019-03-08", "firstIndexDate": "2019-04-15", "fullTextReceivedDate": "2025-02-03", "hasEvaluations": "N"}]}}