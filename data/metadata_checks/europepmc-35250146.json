[{"affiliation": "IIIT Allahabad, Prayagraj, 211015 India."}]}}, {"fullName": "Agarwal S", "lastName": "Agarwal", "firstName": "Sonali", "initials": "S", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "IIIT Allahabad, Prayagraj, 211015 India."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0003-1175-1865"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "7", "volume": "55", "journalIssueId": 3415638, "dateOfPublication": "2022 ", "monthOfPublication": 0, "yearOfPublication": 2022, "journal": {"medlineAbbreviation": "Artif Intell Rev", "title": "Artificial intelligence review", "essn": "1573-7462", "issn": "0269-2821", "nlmid": "9883087", "isoabbreviation": "Artif Intell Rev"}, "printPublicationDate": "2022-01-01"}, "pubYear": "2022", "pageInfo": "5845-5889", "abstractText": "With the advent of advancements in deep learning approaches, such as deep convolution neural network, residual neural network, adversarial network; U-Net architectures are most widely utilized in biomedical image segmentation to address the automation in identification and detection of the target regions or sub-regions. In recent studies, U-Net based approaches have illustrated state-of-the-art performance in different applications for the development of computer-aided diagnosis systems for early diagnosis and treatment of diseases such as brain tumor, lung cancer, alzheimer, breast cancer, etc., using various modalities. This article contributes in presenting the success of these approaches by describing the U-Net framework, followed by the comprehensive analysis of the U-Net variants by performing (1) inter-modality, and (2) intra-modality categorization to establish better insights into the associated challenges and solutions. Besides, this article also highlights the contribution of U-Net based frameworks in the ongoing pandemic, severe acute respiratory syndrome coronavirus 2 (SARS-CoV-2) also known as COVID-19. Finally, the strengths and similarities of these U-Net variants are analysed along with the challenges involved in biomedical image segmentation to uncover promising future research directions in this area.", "affiliation": "IIIT Allahabad, Prayagraj, 211015 India.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "keywordList": {"keyword": ["Deep Learning", "U-net", "Biomedical Image Segmentation"]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Free", "availabilityCode": "F", "documentStyle": "pdf", "site": "Unpaywall", "url": "https://link.springer.com/content/pdf/10.1007/s10462-022-10152-1.pdf"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1007/s10462-022-10152-1"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC8886195"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC8886195?pdf=render"}]}, "commentCorrectionList": {"commentCorrection": [{"source": "PPR", "id": "PPR454559", "type": "Preprint in", "note": "Link created based on a title-first author match", "orderIn": 10002}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 70, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "Y", "hasData": "Y", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["doi"]}, "dateOfCreation": "2022-03-07", "dateOfRevision": "2024-09-03", "electronicPublicationDate": "2022-03-01", "firstPublicationDate": "2022-03-01", "firstIndexDate": "2022-03-07", "fullTextReceivedDate": "2025-02-04