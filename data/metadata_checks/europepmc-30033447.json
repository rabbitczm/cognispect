: "0000-0002-7650-1720"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Duke University School of Medicine, Durham, NC, 22705, USA. ashirbani.saha@duke.edu."}]}}, {"fullName": "Harowicz MR", "lastName": "Harowicz", "firstName": "Michael R", "initials": "MR", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Duke University School of Medicine, Durham, NC, 22705, USA."}]}}, {"fullName": "Grimm LJ", "lastName": "Grimm", "firstName": "Lars J", "initials": "LJ", "authorId": {"type": "ORCID", "value": "0000-0002-3865-3352"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Duke University School of Medicine, Durham, NC, 22705, USA."}]}}, {"fullName": "Kim CE", "lastName": "Kim", "firstName": "Connie E", "initials": "CE", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Duke University School of Medicine, Durham, NC, 22705, USA."}]}}, {"fullName": "Ghate SV", "lastName": "Ghate", "firstName": "Sujata V", "initials": "SV", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Duke University School of Medicine, Durham, NC, 22705, USA."}]}}, {"fullName": "Walsh R", "lastName": "Walsh", "firstName": "Ruth", "initials": "R", "authorId": {"type": "ORCID", "value": "0000-0002-2164-2761"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Duke University School of Medicine, Durham, NC, 22705, USA."}]}}, {"fullName": "Mazurowski MA", "lastName": "Mazurowski", "firstName": "Maciej A", "initials": "MA", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Duke University School of Medicine, Durham, NC, 22705, USA."}, {"affiliation": "Department of Electrical and Computer Engineering, Duke University, Durham, NC, 22705, USA."}, {"affiliation": "Duke University Medical Physics Program, Durham, NC, 22705, USA."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-2164-2761"}, {"type": "ORCID", "value": "0000-0002-3865-3352"}, {"type": "ORCID", "value": "0000-0002-7650-1720"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "4", "volume": "119", "journalIssueId": 2720956, "dateOfPublication": "2018 Aug", "monthOfPublication": 8, "yearOfPublication": 2018, "journal": {"medlineAbbreviation": "Br J Cancer", "title": "British journal of cancer", "essn": "1532-1827", "issn": "0007-0920", "nlmid": "0370635", "isoabbreviation": "Br J Cancer"}, "printPublicationDate": "2018-08-01"}, "pubYear": "2018", "pageInfo": "508-516", "abstractText": "<h4>Background</h4>Recent studies showed preliminary data on associations of MRI-based imaging phenotypes of breast tumours with breast cancer molecular, genomic, and related characteristics. In this study, we present a comprehensive analysis of this relationship.<h4>Methods</h4>We analysed a set of 922 patients with invasive breast cancer and pre-operative MRI. The MRIs were analysed by a computer algorithm to extract 529 features of the tumour and the surrounding tissue. Machine-learning-based models based on the imaging features were trained using a portion of the data (461 patients) to predict the following molecular, genomic, and proliferation characteristics: tumour surrogate molecular subtype, oestrogen receptor, progesterone receptor and human epidermal growth factor status, as well as a tumour proliferation marker (Ki-67). Trained models were evaluated on the set of the remaining 461 patients.<h4>Results</h4>Multivariate models were predictive of Luminal A subtype with AUC = 0.697 (95% CI: 0.647-0.746, p < .0001), triple negative breast cancer with AUC = 0.654 (95% CI: 0.589-0.727, p < .0001), ER status with AUC = 0.649 (95% CI: 0.591-0.705, p < .001), and PR status with AUC = 0.622 (95% CI: 0.569-0.674, p < .0001). Associations between individual features and subtypes we also found.<h4>Conclusions</h4>There is a moderate association between tumour molecular biomarkers and algorithmically assessed imaging features.", "affiliation": "Department of Radiology, Duke University School of Medicine, Durham, NC, 22705, USA. ashirbani.saha@duke.edu.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NIBIB NIH HHS", "acronym": "EB", "grantId": "R01 EB021360", "orderIn": 0}, {"agency": "U.S. Department of Health &amp; Human Services | National Institutes of Health", "grantId": "1R01EB021360", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Breast Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}, {"majorTopic_YN": "N", "abbreviation": "GE", "qualifierName": "genetics"}, {"majorTopic_YN": "N", "abbreviation": "ME", "qualifierName": "metabolism"}, {"majorTopic_YN": "Y", "abbreviation": "PA", "qualifierName": "pathology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Receptors, Estrogen", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "ME", "qualifierName": "metabolism"}]}}, {"majorTopic_YN": "N", "descriptorName": "Receptors, Progesterone", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "ME", "qualifierName": "metabolism"}]}}, {"majorTopic_YN": "N", "descriptorName": "Magnetic Resonance Imaging", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Area Under Curve"}, {"majorTopic_YN": "N", "descriptorName": "Genomics", "meshQu