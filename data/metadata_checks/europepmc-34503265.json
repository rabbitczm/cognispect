ion": [{"affiliation": "Discipline of Surgery, The Lambe Institute for Translational Research, National University of Ireland, H91 YR71 Galway, Ireland."}, {"affiliation": "Department of Surgery, Galway University Hospitals, H91 YR71 Galway, Ireland."}]}}, {"fullName": "Hynes SO", "lastName": "Hynes", "firstName": "Sean O", "initials": "SO", "authorId": {"type": "ORCID", "value": "0000-0002-3092-7945"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Histopathology, National University of Ireland, H91 YR71 Galway, Ireland."}]}}, {"fullName": "Kerin MJ", "lastName": "Kerin", "firstName": "Michael J", "initials": "MJ", "authorId": {"type": "ORCID", "value": "0000-0003-4164-5561"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Discipline of Surgery, The Lambe Institute for Translational Research, National University of Ireland, H91 YR71 Galway, Ireland."}]}}, {"fullName": "Miller N", "lastName": "Miller", "firstName": "Nicola", "initials": "N", "authorId": {"type": "ORCID", "value": "0000-0002-5416-7047"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Discipline of Surgery, The Lambe Institute for Translational Research, National University of Ireland, H91 YR71 Galway, Ireland."}]}}, {"fullName": "Lowery AJ", "lastName": "Lowery", "firstName": "Aoife J", "initials": "AJ", "authorId": {"type": "ORCID", "value": "0000-0002-8062-6235"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Discipline of Surgery, The Lambe Institute for Translational Research, National University of Ireland, H91 YR71 Galway, Ireland."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-3092-7945"}, {"type": "ORCID", "value": "0000-0002-5416-7047"}, {"type": "ORCID", "value": "0000-0002-8062-6235"}, {"type": "ORCID", "value": "0000-0002-9892-9920"}, {"type": "ORCID", "value": "0000-0003-4164-5561"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "17", "volume": "13", "journalIssueId": 3231264, "dateOfPublication": "2021 Sep", "monthOfPublication": 9, "yearOfPublication": 2021, "journal": {"medlineAbbreviation": "Cancers (Basel)", "title": "Cancers", "essn": "2072-6694", "issn": "2072-6694", "nlmid": "101526829", "isoabbreviation": "Cancers (Basel)"}, "printPublicationDate": "2021-09-01"}, "pubYear": "2021", "pageInfo": "4455", "abstractText": "The advent of molecular medicine has transformed breast cancer management. Breast cancer is now recognised as a heterogenous disease with varied morphology, molecular features, tumour behaviour, and response to therapeutic strategies. These parameters are underpinned by a combination of genomic and immunohistochemical tumour factors, with estrogen receptor (ER) status, progesterone receptor (PgR) status, human epidermal growth factor receptor-2 (HER2) status, Ki-67 proliferation indices, and multigene panels all playing a contributive role in the substratification, prognostication and personalization of treatment modalities for each case. The expression of Ki-67 is strongly linked to tumour cell proliferation and growth and is routinely evaluated as a proliferation marker. This review will discuss the clinical utility, current pitfalls, and promising strategies to augment Ki-67 proliferation indices in future breast oncology.", "affiliation": "Discipline of Surgery, The Lambe Institute for Translational Research, National University of Ireland, H91 YR71 Galway, Ireland.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["review-article", "Review", "Journal Article"]}, "grantsList": {"grant": [{"agency": "National Breast Cancer Research Institute, Ireland", "grantId": "2021", "orderIn": 0}]}, "keywordList": {"keyword": ["Breast cancer", "Biomarker", "Ki-67", "Mib-1", "Personalised Medicine"]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "avai