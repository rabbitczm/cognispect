ls": "IF", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Princess Margaret Cancer Centre and University of Toronto, Toronto, Ontario, Canada."}]}}, {"fullName": "Tomar V", "lastName": "Tomar", "firstName": "Vivek", "initials": "V", "authorId": {"type": "ORCID", "value": "0000-0003-4341-4839"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Rise To Survive Cancer, New Delhi, India."}]}}, {"fullName": "Vanderpuye V", "lastName": "Vanderpuye", "firstName": "Verna", "initials": "V", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "National Center for Radiotherapy Oncology and Nuclear Medicine and Korle Bu Teaching Hospital, Accra, Ghana."}]}}, {"fullName": "Varghese C", "lastName": "Varghese", "firstName": "Cherian", "initials": "C", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "World Health Organization, Geneva, Switzerland."}]}}, {"fullName": "Weiderpass E", "lastName": "Weiderpass", "firstName": "Elisabete", "initials": "E", "authorId": {"type": "ORCID", "value": "0000-0003-2237-0128"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "International Association for Research on Cancer, Lyon, France."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-0809-5812"}, {"type": "ORCID", "value": "0000-0002-3635-0083"}, {"type": "ORCID", "value": "0000-0002-4043-559X"}, {"type": "ORCID", "value": "0000-0002-4751-6595"}, {"type": "ORCID", "value": "0000-0002-6435-1825"}, {"type": "ORCID", "value": "0000-0003-2237-0128"}, {"type": "ORCID", "value": "0000-0003-4341-4839"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "4", "volume": "28", "journalIssueId": 3345568, "dateOfPublication": "2022 Apr", "monthOfPublication": 4, "yearOfPublication": 2022, "journal": {"medlineAbbreviation": "Nat Med", "title": "Nature medicine", "essn": "1546-170X", "issn": "1078-8956", "nlmid": "9502015", "isoabbreviation": "Nat Med"}, "printPublicationDate": "2022-04-01"}, "pubYear": "2022", "pageInfo": "649-657", "abstractText": "Cancer research currently is heavily skewed toward high-income countries (HICs), with little research conducted in, and relevant to, the problems of low- and middle-income countries (LMICs). This regional discordance in cancer knowledge generation and application needs to be rebalanced. Several gaps in the research enterprise of LMICs need to be addressed to promote regionally relevant research, and radical rethinking is needed to address the burning issues in cancer care in these regions. We identified five top priorities in cancer research in LMICs based on current and projected needs: reducing the burden of patients with advanced disease; improving access and affordability, and outcomes of cancer treatment; value-based care and health economics; quality improvement and implementation research; and leveraging technology to improve cancer control. LMICs have an excellent opportunity to address important questions in cancer research that could impact cancer control globally. Success will require collaboration and commitment from governments, policy makers, funding agencies, health care organizations and leaders, researchers and the public.", "affiliation": "Tata Memorial Centre, Homi Bhabha National Institute, Mumbai, India. prameshcs@tmc.gov.in.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["research-article", "Review", "Journal Article"]}, "grantsList": {"grant": [{"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "P30 CA008748", "orderIn": 0}, {"agency": "Cancer Research UK", "acronym": "CRUK_", "grantId": "29186", "orderIn": 0}, {"agency": "World Health Organization", "acronym": "WHO_", "grantId": "001", "orderIn": 0}, {"agency": "Medical Research Council", "acronym": "MRC_", "grantId": "MR/W023903/1", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTo