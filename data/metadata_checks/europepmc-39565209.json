horAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Pharmacological Sciences, Mount Sinai Center for Bioinformatics, Icahn School of Medicine at Mount Sinai, One Gustave L. Levy Place, Box 1603 New York, NY, USA."}]}}, {"fullName": "Clarke DJB", "lastName": "Clarke", "firstName": "Daniel J B", "initials": "DJB", "authorId": {"type": "ORCID", "value": "0000-0003-3471-7416"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Pharmacological Sciences, Mount Sinai Center for Bioinformatics, Icahn School of Medicine at Mount Sinai, One Gustave L. Levy Place, Box 1603 New York, NY, USA."}]}}, {"fullName": "Evangelista JE", "lastName": "Evangelista", "firstName": "John Erol", "initials": "JE", "authorId": {"type": "ORCID", "value": "0000-0003-4836-0518"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Pharmacological Sciences, Mount Sinai Center for Bioinformatics, Icahn School of Medicine at Mount Sinai, One Gustave L. Levy Place, Box 1603 New York, NY, USA."}]}}, {"fullName": "Lingam N", "lastName": "Lingam", "firstName": "Nathania", "initials": "N", "authorId": {"type": "ORCID", "value": "0009-0006-9938-4527"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Pharmacological Sciences, Mount Sinai Center for Bioinformatics, Icahn School of Medicine at Mount Sinai, One Gustave L. Levy Place, Box 1603 New York, NY, USA."}]}}, {"fullName": "Ma'ayan A", "lastName": "Ma'ayan", "firstName": "Avi", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0002-6904-1017"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Pharmacological Sciences, Mount Sinai Center for Bioinformatics, Icahn School of Medicine at Mount Sinai, One Gustave L. Levy Place, Box 1603 New York, NY, USA."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-6904-1017"}, {"type": "ORCID", "value": "0000-0003-3471-7416"}, {"type": "ORCID", "value": "0000-0003-4836-0518"}, {"type": "ORCID", "value": "0009-0004-7253-2556"}, {"type": "ORCID", "value": "0009-0006-9938-4527"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics"]}, "journalInfo": {"issue": "D1", "volume": "53", "journalIssueId": 3884742, "dateOfPublication": "2025 Jan", "monthOfPublication": 1, "yearOfPublication": 2025, "journal": {"medlineAbbreviation": "Nucleic Acids Res", "title": "Nucleic acids research", "essn": "1362-4962", "issn": "0305-1048", "isoabbreviation": "Nucleic Acids Res", "nlmid": "0411011"}, "printPublicationDate": "2025-01-01"}, "pubYear": "2025", "pageInfo": "D1016-D1028", "abstractText": "By processing and abstracting diverse omics datasets into associations between genes and their attributes, the Harmonizome database enables researchers to explore and integrate knowledge about human genes from many central omics resources. Here, we introduce Harmonizome 3.0, a significant upgrade to the original Harmonizome database. The upgrade adds 26 datasets that contribute nearly 12 million associations between genes and various attribute types such as cells and tissues, diseases, and pathways. The upgrade has a dataset crossing feature to identify gene modules that are shared across datasets. To further explain significantly high gene set overlap between dataset pairs, a large language model (LLM) composes a paragraph that speculates about the reasons behind the high overlap. The upgrade also adds more data formats and visualization options. Datasets are downloadable as knowledge graph (KG) assertions and visualized with Uniform Manifold Approximation and Projection (UMAP) plots. The KG assertions can be explored via a user interface that visualizes gene-attribute associations as ball-and-stick diagrams. Overall, Harmonizome 3.0 is a rich resource of processed omics datasets that are provided in several AI-ready formats. Harmonizome 3.0 is available at https://maayanlab.cloud/Harmonizome/.