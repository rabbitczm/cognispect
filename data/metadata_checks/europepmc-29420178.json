uthorAffiliation": [{"affiliation": "Evidence-Based Practice Center, Mayo Clinic, Rochester, Minnesota, USA."}]}}, {"fullName": "Sultan S", "lastName": "Sultan", "firstName": "Shahnaz", "initials": "S", "authorId": {"type": "ORCID", "value": "0000-0002-5867-8741"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Division of Gastroenterology, Hepatology, and Nutrition, University of Minnesota, Center for Chronic Diseases Outcomes Research, Minneapolis Veterans Affairs Healthcare System, Minneapolis, Minnesota, USA."}]}}, {"fullName": "Haffar S", "lastName": "Haffar", "firstName": "Samir", "initials": "S", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Digestive Center for Diagnosis and Treatment, Damascus, Syrian Arab Republic."}]}}, {"fullName": "Bazerbachi F", "lastName": "Bazerbachi", "firstName": "Fateh", "initials": "F", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Gastroenterology and Hepatology, Mayo Clinic, Rochester, Minnesota, USA."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5502-5975"}, {"type": "ORCID", "value": "0000-0002-5867-8741"}]}, "journalInfo": {"issue": "2", "volume": "23", "journalIssueId": 2665695, "dateOfPublication": "2018 Apr", "monthOfPublication": 4, "yearOfPublication": 2018, "journal": {"medlineAbbreviation": "BMJ Evid Based Med", "title": "BMJ evidence-based medicine", "essn": "2515-4478", "issn": "2515-446X", "isoabbreviation": "BMJ Evid Based Med", "nlmid": "101719009"}, "printPublicationDate": "2018-04-01"}, "pubYear": "2018", "pageInfo": "60-63", "abstractText": "Case reports and case series are uncontrolled study designs known for increased risk of bias but have profoundly influenced the medical literature and continue to advance our knowledge. In this guide, we present a framework for appraisal, synthesis and application of evidence derived from case reports and case series. We propose a tool to evaluate the methodological quality of case reports and case series based on the domains of selection, ascertainment, causality and reporting and provide signalling questions to aid evidence-based practitioners and systematic reviewers in their assessment. We suggest using evidence derived from case reports and case series to inform decision-making when no other higher level of evidence is available.", "affiliation": "Evidence-Based Practice Center, Mayo Clinic, Rochester, Minnesota, USA.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "keywordList": {"keyword": ["epidemiology"]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Unpaywall", "url": "https://ebm.bmj.com/content/ebmed/23/2/60.full.pdf"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1136/bmjebm-2017-110853"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC6234235"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC6234235?pdf=render"}]}, "commentCorrectionList": {"commentCorrection": [{"source": "MED", "id": "29848544", "reference": "BMJ Evid Based Med. 2018 Oct;23(5):200. doi: 10.1136/bmjebm-2018-110969", "type": "Comment in", "orderIn": 1}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 1754, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "N", "hasData": "N", "license": "cc by-nc", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "N", "dateOfCreation": "2018-02-09", "dateOfRevision": "2022-04-09", "electronicPub