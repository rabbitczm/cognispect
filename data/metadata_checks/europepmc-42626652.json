G", "initials": "HG", "authorId": {"type": "ORCID", "value": "0000-0001-8698-8432"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "School of Family Life, Brigham Young University."}]}}, {"fullName": "Porter CL", "lastName": "Porter", "firstName": "Chris L", "initials": "CL", "authorId": {"type": "ORCID", "value": "0000-0002-6359-6951"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "School of Family Life, Brigham Young University."}]}}, {"fullName": "Fraser A", "lastName": "Fraser", "firstName": "Ashley", "initials": "A", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "School of Family Life, Brigham Young University."}]}}, {"fullName": "Reschke PJ", "lastName": "Reschke", "firstName": "Peter J", "initials": "PJ", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "School of Family Life, Brigham Young University."}]}}, {"fullName": "Booth MA", "lastName": "Booth", "firstName": "McCall A", "initials": "MA", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Psychology, Georgetown University."}]}}, {"fullName": "Swit C", "lastName": "Swit", "firstName": "Cara", "initials": "C", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Faculty of Health, University of Canterbury, Christchurch, New Zealand."}]}}, {"fullName": "Kerr ML", "lastName": "Kerr", "firstName": "Margaret L", "initials": "ML", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Human Development and Family Studies, University of Wisconsin-Madison."}]}}, {"fullName": "Barr R", "lastName": "Barr", "firstName": "Rachel", "initials": "R", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Psychology, Georgetown University."}]}}, {"fullName": "Kirkorian H", "lastName": "Kirkorian", "firstName": "Heather", "initials": "H", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Human Development and Family Studies, University of Wisconsin-Madison."}]}}, {"fullName": "Radesky J", "lastName": "Radesky", "firstName": "Jenny", "initials": "J", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "University of Michigan Medical School."}]}}, {"fullName": "Densley RL", "lastName": "Densley", "firstName": "Rebecca L", "initials": "RL", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "School of Family Life, Brigham Young University."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-6939-6697"}, {"type": "ORCID", "value": "0000-0001-8698-8432"}, {"type": "ORCID", "value": "0000-0002-6359-6951"}, {"type": "ORCID", "value": "0009-0007-8291-3143"}, {"type": "ORCID", "value": "0009-0008-6605-3814"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"volume": "186", "journalIssueId": 4246479, "dateOfPublication": "2027 Jan", "monthOfPublication": 1, "yearOfPublication": 2027, "journal": {"medlineAbbreviation": "Comput Human Behav", "title": "Computers in human behavior", "issn": "0747-5632", "nlmid": "8510313", "isoabbreviation": "Comput Human Behav"}, "printPublicationDate": "2027-01-01"}, "pubYear": "2027", "pageInfo": "109138", "abstractText": "Parents today face increasing challenges in managing children's media use, which are often accompanied by intense feelings of guilt. This study examines the prevalence and predictors of mother's parental media guilt surrounding their own and their child's media use. Using structural equation modeling, we analyzed data from 474 U.S. mothers (65% White, <i>M</i> child age = 7.48 yrs). Approximately half of mothers endorsed moderate or higher levels of guilt on several media guilt related items. Maternal guilt about their child's media use was significantly associated with higher maternal depression, lower media efficacy, and greater child problematic media use (PMU). In contrast, mothers' guilt over their own media use was associated with maternal depression and child PMU. Media content and screen time did not predict guilt levels. Younger maternal age predicted both types of guilt. Findings suggest that maternal media guilt is both common and complex and may be more closely tied to perceived parenting ideals and emotional well-being than to actual media behaviors.", "affiliation": "School of Family Life, Brigham Young University.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "NICHD NIH HHS", "acronym": "HD", "grantId": "P01 HD109907", "orderIn": 0}, {"agency": "NICHD NIH HHS", "acronym": "HD", "grantId": "R15 HD101969", "orderIn": 0}]}, "keywordList": {"keyword": ["Maternal Depression", "Maternal Guilt", "Problematic Media Use", "Media Efficacy", "Parental Media Guilt"]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1016/j.chb.2026.109138"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC13492524"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC13492524?pdf=render"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1016/j.chb.2026.109138"}]}, "isOpenAccess": "N", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 0, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "N", "hasData": "Y", "authMan": "Y", "epmcAuthMan": "N", "nihAuthMan": "Y", "manuscriptId": "NIHMS2204301", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["doi"]}, "dateOfCompletion": "