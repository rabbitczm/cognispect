liationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology (J.S., B.C., S.N., R. Gillies, R. Gatenby), Moffitt Cancer Research Center, Tampa, Florida Olivier.gevaert@stanford.edu Robert.gatenby@moffitt.org."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5072-5630"}, {"type": "ORCID", "value": "0000-0001-5461-863X"}, {"type": "ORCID", "value": "0000-0001-6794-7213"}, {"type": "ORCID", "value": "0000-0001-8906-9618"}, {"type": "ORCID", "value": "0000-0001-9860-3368"}, {"type": "ORCID", "value": "0000-0002-1621-1510"}, {"type": "ORCID", "value": "0000-0002-6876-5507"}, {"type": "ORCID", "value": "0000-0002-7726-6208"}, {"type": "ORCID", "value": "0000-0002-7898-8456"}, {"type": "ORCID", "value": "0000-0002-8888-7747"}, {"type": "ORCID", "value": "0000-0002-9965-5466"}, {"type": "ORCID", "value": "0000-0003-2902-9897"}, {"type": "ORCID", "value": "0000-0003-2971-7673"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics"]}, "journalInfo": {"issue": "2", "volume": "39", "journalIssueId": 2651790, "dateOfPublication": "2018 Feb", "monthOfPublication": 2, "yearOfPublication": 2018, "journal": {"medlineAbbreviation": "AJNR Am J Neuroradiol", "title": "AJNR. American journal of neuroradiology", "essn": "1936-959X", "issn": "0195-6108", "nlmid": "8003708", "isoabbreviation": "AJNR Am J Neuroradiol"}, "printPublicationDate": "2018-02-01"}, "pubYear": "2018", "pageInfo": "208-216", "abstractText": "Radiomics describes a broad set of computational methods that extract quantitative features from radiographic images. The resulting features can be used to inform imaging diagnosis, prognosis, and therapy response in oncology. However, major challenges remain for methodologic developments to optimize feature extraction and provide rapid information flow in clinical settings. Equally important, to be clinically useful, predictive radiomic properties must be clearly linked to meaningful biologic characteristics and qualitative imaging properties familiar to radiologists. Here we use a cross-disciplinary approach to highlight studies in radiomics. We review brain tumor radiologic studies (eg, imaging interpretation) through computational models (eg, computer vision and machine learning) that provide novel clinical insights. We outline current quantitative image feature extraction and prediction strategies with different levels of available clinical classes for supporting clinical decision-making. We further discuss machine-learning challenges and data opportunities to advance radiomic studies.", "affiliation": "From the Stanford Center for Biomedical Informatic Research (M.Z., O.G.).", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["review-article", "Review", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U01 CA187947", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U01 CA190214", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U24 CA180927", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U24 CA180918", "orderIn": 0}, {"agency": "NIBIB NIH HHS", "acronym": "EB", "grantId": "R01 EB020527", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U01 CA154601", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Brain Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}]}}, {"majorTopic_YN": "N", "descriptorName": "Image Interpretation, Computer-Assisted", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Neuroimaging", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN":