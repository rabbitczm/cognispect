etailsList": {"authorAffiliation": [{"affiliation": "Radiology Informatics Lab, Mayo Clinic, 200 First Street SW, Rochester, MN, 55905, USA."}]}}, {"fullName": "Galimzianova A", "lastName": "Galimzianova", "firstName": "Alfiia", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0002-2901-6423"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Stanford University School of Medicine, Stanford, CA, USA."}]}}, {"fullName": "Hoogi A", "lastName": "Hoogi", "firstName": "Assaf", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0002-4542-6254"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Stanford University School of Medicine, Stanford, CA, USA."}]}}, {"fullName": "Rubin DL", "lastName": "Rubin", "firstName": "Daniel L", "initials": "DL", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Stanford University School of Medicine, Stanford, CA, USA."}]}}, {"fullName": "Erickson BJ", "lastName": "Erickson", "firstName": "Bradley J", "initials": "BJ", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Radiology Informatics Lab, Mayo Clinic, 200 First Street SW, Rochester, MN, 55905, USA. bje@mayo.edu."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-2901-6423"}, {"type": "ORCID", "value": "0000-0002-4542-6254"}, {"type": "ORCID", "value": "0000-0003-3920-1515"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics"]}, "journalInfo": {"issue": "4", "volume": "30", "journalIssueId": 2581553, "dateOfPublication": "2017 Aug", "monthOfPublication": 8, "yearOfPublication": 2017, "journal": {"medlineAbbreviation": "J Digit Imaging", "title": "Journal of digital imaging", "essn": "1618-727X", "issn": "0897-1889", "nlmid": "9100529", "isoabbreviation": "J Digit Imaging"}, "printPublicationDate": "2017-08-01"}, "pubYear": "2017", "pageInfo": "449-459", "abstractText": "Quantitative analysis of brain MRI is routine for many neurological diseases and conditions and relies on accurate segmentation of structures of interest. Deep learning-based segmentation approaches for brain MRI are gaining interest due to their self-learning and generalization ability over large amounts of data. As the deep learning architectures are becoming more mature, they gradually outperform previous state-of-the-art classical machine learning algorithms. This review aims to provide an overview of current deep learning-based segmentation approaches for quantitative brain MRI. First we review the current deep learning architectures used for segmentation of anatomical brain structures and brain lesions. Next, the performance, speed, and properties of deep learning approaches are summarized and discussed. Finally, we provide a critical assessment of the current state and identify likely future developments and trends.", "affiliation": "Radiology Informatics Lab, Mayo Clinic, 200 First Street SW, Rochester, MN, 55905, USA.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["review-article", "Review", "Journal Article"]}, "grantsList": {"grant": [{"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U01 CA142555", "orderIn": 0}, {"agency": "National Cancer Institute", "grantId": "U01CA160045", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U01 CA187947", "orderIn": 0}, {"agency": "National Cancer Institute", "grantId": "U01CA142555", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U01 CA160045", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U01 CA190214", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Brain", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}, {"majorTopic_YN": "N", "abbreviation": "AH", "qualifierName": "anatomy & histology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Magnetic Resonance Imaging", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Algorithms"}, {"majorTopic_YN": "N", "descriptorName": "Forecasting"}, {"majorTopic_YN": "Y", "descriptorName": "Machine Learning", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "TD", "qualifierName": "trends"}]}}]}, "keywordList": {"keyword": ["Convolutional Neural Network", "Deep Learning", "Brain Lesion Segmentation", "Quantitative Brain Mri"]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1007/s10278-017-9983-4"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC5537095"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC5537095?pdf=render"}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 466, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "Y", "hasData": "N", "license": "cc by", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "N", "dateOfCompletion": "2018-04-04", "dateOfCreation": "2017-06-04", "dateOfRevision": "2026-11-09", "firstPublicationDate": "2017-08-01", "firstIndexDate": "2017-06-03", "fullTextReceivedDate": "2025-02-05", "hasEvaluations": "N"}]}}