firstName": "Yarin", "initials": "Y", "authorId": {"type": "ORCID", "value": "0000-0002-2733-2078"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "OATML Group, Department of Computer Science, University of Oxford, Oxford, UK."}]}}, {"fullName": "Marks DS", "lastName": "Marks", "firstName": "Debora S", "initials": "DS", "authorId": {"type": "ORCID", "value": "0000-0001-9388-2281"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Marks Group, Department of Systems Biology, Harvard Medical School, Boston, MA, USA. debbie@hms.harvard.edu."}, {"affiliation": "Broad Institute of Harvard and MIT, Cambridge, MA, USA. debbie@hms.harvard.edu."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5931-6622"}, {"type": "ORCID", "value": "0000-0001-9388-2281"}, {"type": "ORCID", "value": "0000-0002-2733-2078"}, {"type": "ORCID", "value": "0009-0009-3266-9917"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "7984", "volume": "622", "journalIssueId": 3652004, "dateOfPublication": "2023 Oct", "monthOfPublication": 10, "yearOfPublication": 2023, "journal": {"medlineAbbreviation": "Nature", "title": "Nature", "essn": "1476-4687", "issn": "0028-0836", "nlmid": "0410462", "isoabbreviation": "Nature"}, "printPublicationDate": "2023-10-01"}, "pubYear": "2023", "pageInfo": "818-825", "abstractText": "Effective pandemic preparedness relies on anticipating viral mutations that are able to evade host immune responses to facilitate vaccine and therapeutic design. However, current strategies for viral evolution prediction are not available early in a pandemic-experimental approaches require host polyclonal antibodies to test against<sup>1-16</sup>, and existing computational methods draw heavily from current strain prevalence to make reliable predictions of variants of concern<sup>17-19</sup>. To address this, we developed EVEscape, a generalizable modular framework that combines fitness predictions from a deep learning model of historical sequences with biophysical and structural information. EVEscape quantifies the viral escape potential of mutations at scale and has the advantage of being applicable before surveillance sequencing, experimental scans or three-dimensional structures of antibody complexes are available. We demonstrate that EVEscape, trained on sequences available before 2020, is as accurate as high-throughput experimental scans at anticipating pandemic variation for SARS-CoV-2 and is generalizable to other viruses including influenza, HIV and understudied viruses with pandemic potential such as Lassa and Nipah. We provide continually revised escape scores for all current strains of SARS-CoV-2 and predict probable further mutations to forecast emerging strains as a tool for continuing vaccine development ( evescape.org ).", "affiliation": "Marks Group, Department of Systems Biology, Harvard Medical School, Boston, MA, USA.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01 CA260415", "orderIn": 0}, {"agency": "NIGMS NIH HHS", "acronym": "GM", "grantId": "F32 GM141007", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "Y", "descriptorName": "Viruses", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "GE", "qualifierName": "genetics"}, {"majorTopic_YN": "N", "abbreviation": "IM", "qualifierName": "immunology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Lassa virus"}, {"majorTopic_YN": "N", "descriptorName": "Nipah Virus"}, {"majorTopic_YN": "N", "descriptorName": "HIV Infections"}, {"majorTopic_YN": "N", "descriptorName": "Viral Vaccines", "meshQualifi