sList": {"authorAffiliation": [{"affiliation": "Institute of Biomedical Engineering, Dept. Engineering Science, University of Oxford, Oxford, UK. jenny.yang@eng.ox.ac.uk."}]}}, {"fullName": "Soltan AAS", "lastName": "Soltan", "firstName": "Andrew A S", "initials": "AAS", "authorId": {"type": "ORCID", "value": "0000-0003-2391-5361"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "John Radcliffe Hospital, Oxford University Hospitals NHS Foundation Trust, Oxford, UK."}, {"affiliation": "RDM Division of Cardiovascular Medicine, University of Oxford, Oxford, UK."}]}}, {"fullName": "Clifton DA", "lastName": "Clifton", "firstName": "David A", "initials": "DA", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Biomedical Engineering, Dept. Engineering Science, University of Oxford, Oxford, UK."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0003-0352-8452"}, {"type": "ORCID", "value": "0000-0003-2391-5361"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "1", "volume": "5", "journalIssueId": 3368448, "dateOfPublication": "2022 Jun", "monthOfPublication": 6, "yearOfPublication": 2022, "journal": {"medlineAbbreviation": "NPJ Digit Med", "title": "NPJ digital medicine", "essn": "2398-6352", "issn": "2398-6352", "nlmid": "101731738", "isoabbreviation": "NPJ Digit Med"}, "printPublicationDate": "2022-06-01"}, "pubYear": "2022", "pageInfo": "69", "abstractText": "As patient health information is highly regulated due to privacy concerns, most machine learning (ML)-based healthcare studies are unable to test on external patient cohorts, resulting in a gap between locally reported model performance and cross-site generalizability. Different approaches have been introduced for developing models across multiple clinical sites, however less attention has been given to adopting ready-made models in new settings. We introduce three methods to do this-(1) applying a ready-made model \"as-is\" (2); readjusting the decision threshold on the model's output using site-specific data and (3); finetuning the model using site-specific data via transfer learning. Using a case study of COVID-19 diagnosis across four NHS Hospital Trusts, we show that all methods achieve clinically-effective performances (NPV > 0.959), with transfer learning achieving the best results (mean AUROCs between 0.870 and 0.925). Our models demonstrate that site-specific customization improves predictive performance when compared to other ready-made approaches.", "affiliation": "Institute of Biomedical Engineering, Dept. Engineering Science, University of Oxford, Oxford, UK. jenny.yang@eng.ox.ac.uk.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "National Institute for Health Research (NIHR)", "grantId": "ACF-2020-13-015", "orderIn": 0}, {"agency": "Wellcome Trust", "acronym": "WT_", "orderIn": 0}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Unpaywall", "url": "https://www.nature.com/articles/s41746-022-00614-9.pdf"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1038/s41746-022-00614-9"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC9174159"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC9174159?pdf=render"}]}, "commentCorrectionList": {"commentCorrection": [{"source": "PPR", "id": "PPR452760", "type": "Preprint in", "note": "CrossRef Pre-print loader", "orderIn": 10002}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 111, "h