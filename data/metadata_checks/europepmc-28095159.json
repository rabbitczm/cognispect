orAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "All authors: University Medical Center Groningen, University of Groningen, Groningen, the Netherlands."}]}}, {"fullName": "van Dijk-Peters FB", "lastName": "van Dijk-Peters", "firstName": "Femke B J", "initials": "FB", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "All authors: University Medical Center Groningen, University of Groningen, Groningen, the Netherlands."}]}}, {"fullName": "Marteijn LA", "lastName": "Marteijn", "firstName": "Laurens A W", "initials": "LA", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "All authors: University Medical Center Groningen, University of Groningen, Groningen, the Netherlands."}]}}, {"fullName": "de Bock GH", "lastName": "de Bock", "firstName": "Gertruida H", "initials": "GH", "authorId": {"type": "ORCID", "value": "0000-0003-3104-4471"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "All authors: University Medical Center Groningen, University of Groningen, Groningen, the Netherlands."}]}}, {"fullName": "Burgerhof JG", "lastName": "Burgerhof", "firstName": "Johannes G M", "initials": "JG", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "All authors: University Medical Center Groningen, University of Groningen, Groningen, the Netherlands."}]}}, {"fullName": "Gietema JA", "lastName": "Gietema", "firstName": "Jourik A", "initials": "JA", "authorId": {"type": "ORCID", "value": "0000-0003-0629-7354"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "All authors: University Medical Center Groningen, University of Groningen, Groningen, the Netherlands."}]}}, {"fullName": "Langendijk JA", "lastName": "Langendijk", "firstName": "Johannes A", "initials": "JA", "authorId": {"type": "ORCID", "value": "0000-0003-1083-372X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "All authors: University Medical Center Groningen, University of Groningen, Groningen, the Netherlands."}]}}, {"fullName": "Maduro JH", "lastName": "Maduro", "firstName": "John H", "initials": "JH", "authorId": {"type": "ORCID", "value": "0000-0003-2458-8702"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "All authors: University Medical Center Groningen, University of Groningen, Groningen, the Netherlands."}]}}, {"fullName": "Crijns AP", "lastName": "Crijns", "firstName": "Anne P G", "initials": "AP", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "All authors: University Medical Center Groningen, University of Groningen, Groningen, the Netherlands."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-9515-5616"}, {"type": "ORCID", "value": "0000-0003-0629-7354"}, {"type": "ORCID", "value": "0000-0003-1083-372X"}, {"type": "ORCID", "value": "0000-0003-2458-8702"}, {"type": "ORCID", "value": "0000-0003-3104-4471"}, {"type": "ORCID", "value": "0000-0003-4067-7975"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "11", "volume": "35", "journalIssueId": 2544580, "dateOfPublication": "2017 Apr", "monthOfPublication": 4, "yearOfPublication": 2017, "journal": {"medlineAbbreviation": "J Clin Oncol", "title": "Journal of clinical oncology : official journal of the American Society of Clinical Oncology", "essn": "1527-7755", "issn": "0732-183X", "isoabbreviation": "J Clin Oncol", "nlmid": "8309333"}, "printPublicationDate": "2017-04-01"}, "pubYear": "2017", "pageInfo": "1171-1178", "abstractText": "Purpose A relationship between mean heart dose (MHD) and acute coronary event (ACE) rate was reported in a study of patients with breast cancer (BC). The main objective of our cohort study was to validate this relationship and investigate if other dose-distribution parameters are better predictors for ACEs than MHD. Patients and Methods The cohort consisted of 910 consecutive female patients with BC treated with radiotherapy (RT) after breast-conserving surgery. The primary end point was cumulative incidence of ACEs within 9 years of follow-up. Both MHD and various dose-distribution parameters of the cardiac substructures were collected from three-dimensional computed tomography planning data. Results The median MHD was 2.37 Gy (range, 0.51 to 15.25 Gy). The median follow-up time was 7.6 years (range, 0.1 to 10.1 years), during which 30 patients experienced an ACE. The cumulative incidence of ACE increased by 16.5% per Gy (95% CI, 0.6 to 35.0; P = .042). Analysis showed that the volume of the left ventricle receiving 5 Gy (LV-V5) was the most important prognostic dose-volume parameter. The most optimal multivariable normal tissue complication probability model for ACEs consisted of LV-V5, age, and weighted ACE risk score per patient (c-statistic, 0.83; 95% CI, 0.75 to 0.91). Conclusion A significant dose-effect relationship was found for ACEs within 9 years after RT. Using MHD, the relative increase per Gy was similar to that reported in the previous study. In addition, LV-V5 seemed to be a better predictor for ACEs than MHD. This study confirms the importance of reducing exposure of the heart to radiation to avoid excess risk of ACEs after radiotherapy for BC.", "affiliation": "All authors: University Medical Center Groningen, University of Groningen, Groningen, the Netherlands.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["research-article", "Validation Study", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Heart", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "RE", "qualifierName": "radiation effects"}]}}, {"majorTopic_YN": "N", "descriptorName": "Heart Ventricles", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "RE", "qualifierName": "radiation effects"}]}}, {"majorTopic_YN": "N", "descrip