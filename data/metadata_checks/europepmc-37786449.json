e": "S Kevin", "initials": "SK", "authorId": {"type": "ORCID", "value": "0000-0002-6881-4444"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "School of Biomedical Engineering, University of Science and Technology of China and Institute of Computing Technology, Chinese Academy of Sciences."}]}}, {"fullName": "Greenspan H", "lastName": "Greenspan", "firstName": "Hayit", "initials": "H", "authorId": {"type": "ORCID", "value": "0000-0001-6908-7552"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Biomedical Engineering Department, Tel-Aviv University, Israel."}]}}, {"fullName": "Davatzikos C", "lastName": "Davatzikos", "firstName": "Christos", "initials": "C", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Radiology Department and Electrical and Systems Engineering Department, University of Pennsylvania, USA."}]}}, {"fullName": "Duncan JS", "lastName": "Duncan", "firstName": "James S", "initials": "JS", "authorId": {"type": "ORCID", "value": "0000-0002-5167-9856"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Departments of Biomedical Engineering and Radiology & Biomedical Imaging, Yale University."}]}}, {"fullName": "van Ginneken B", "lastName": "van Ginneken", "firstName": "Bram", "initials": "B", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Radboud University Medical Center, the Netherlands."}]}}, {"fullName": "Madabhushi A", "lastName": "Madabhushi", "firstName": "Anant", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0002-5741-0399"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Biomedical Engineering, Case Western Reserve University and Louis Stokes Cleveland Veterans Administration Medical Center, USA."}]}}, {"fullName": "Prince JL", "lastName": "Prince", "firstName": "Jerry L", "initials": "JL", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Electrical and Computer Engineering Department, Johns Hopkins University, USA."}]}}, {"fullName": "Rueckert D", "lastName": "Rueckert", "firstName": "Daniel", "initials": "D", "authorId": {"type": "ORCID", "value": "0000-0002-5683-5889"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Klinikum rechts der Isar, TU Munich, Germany and Department of Computing, Imperial College, UK."}]}}, {"fullName": "Summers RM", "lastName": "Summers", "firstName": "Ronald M", "initials": "RM", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "National Institute of Health Clinical Center, USA."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-6908-7552"}, {"type": "ORCID", "value": "0000-0002-5167-9856"}, {"type": "ORCID", "value": "0000-0002-5683-5889"}, {"type": "ORCID", "value": "0000-0002-5741-0399"}, {"type": "ORCID", "value": "0000-0002-6881-4444"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics"]}, "journalInfo": {"issue": "5", "volume": "109", "journalIssueId": 3642181, "dateOfPublication": "2021 May", "monthOfPublication": 5, "yearOfPublication": 2021, "journal": {"medlineAbbreviation": "Proc IEEE Inst Electr Electron Eng", "title": "Proceedings of the IEEE. Institute of Electrical and Electronics Engineers", "essn": "1558-2256", "issn": "0018-9219", "nlmid": "9879073", "isoabbreviation": "Proc IEEE Inst Electr Electron Eng"}, "printPublicationDate": "2021-05-01"}, "pubYear": "2021", "pageInfo": "820-838", "abstractText": "Since its renaissance, deep learning has been widely used in various medical imaging tasks and has achieved remarkable success in many medical imaging applications, thereby propelling us into the so-called artificial intelligence (AI) era. It is known that the success of AI is mostly attributed to the availability of big data with annotations for a single task and the advances in high performance computing. However, medical imaging presents unique challenges that confront deep learning approaches. In this survey paper, we first present traits of medical imaging, highlight both clinical needs and technical challenges in medical imaging, and describe how emerging trends in deep learning are addressing these issues. We cover the topics of network architecture, sparse and noisy labels, federating learning, interpretability, uncertainty quantification, etc. Then, we present several case studies that are commonly found in clinical practice, including digital pathology and chest, brain, cardiovascular, and abdominal imaging. Rather than presenting an exhaustive literature survey, we instead describe some prominent research highlights related to these case study applications. We conclude with a discussion and presentation of promising future directions.", "affiliation": "School of Biomedical Engineering, University of Science and Technology of China and Institute of Computing Technology, Chinese Academy of Sciences.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01 CA208236", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01 CA249992", "orderIn": 0}, {"agency": "National Institutes of Health", "grantId": "R01CA220581-01A1", "orderIn": 0}, {"agency": "NIBIB NIH HHS", "acronym": "EB", "grantId": "R43 EB028736", "orderIn": 0}, {"agency": "National Institutes of Health Clinical Center", "orderIn": 0}, {"agency": "NHLBI NIH HHS", "acronym": "HL", "grantId": "R01 HL158071", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U01 CA248226", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01 CA202752", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01 CA216579", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01 CA268207", "orderIn": 0}, {"agency": "Israeli Science Foundati