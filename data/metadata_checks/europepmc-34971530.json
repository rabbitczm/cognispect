me": "Turkbey B", "lastName": "Turkbey", "firstName": "Baris", "initials": "B"}, {"fullName": "Xu S", "lastName": "Xu", "firstName": "Sheng", "initials": "S"}, {"fullName": "Wood BJ", "lastName": "Wood", "firstName": "Bradford J", "initials": "BJ", "authorId": {"type": "ORCID", "value": "0000-0002-4297-0051"}}, {"fullName": "Yan P", "lastName": "Yan", "firstName": "Pingkun", "initials": "P", "authorId": {"type": "ORCID", "value": "0000-0002-9779-2141"}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-4297-0051"}, {"type": "ORCID", "value": "0000-0002-6045-8457"}, {"type": "ORCID", "value": "0000-0002-9779-2141"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "6", "volume": "41", "journalIssueId": 3367776, "dateOfPublication": "2022 Jun", "monthOfPublication": 6, "yearOfPublication": 2022, "journal": {"medlineAbbreviation": "IEEE Trans Med Imaging", "title": "IEEE transactions on medical imaging", "essn": "1558-254X", "issn": "0278-0062", "isoabbreviation": "IEEE Trans Med Imaging", "nlmid": "8310780"}, "printPublicationDate": "2022-06-01"}, "pubYear": "2022", "pageInfo": "1331-1345", "abstractText": "Prostate segmentation in transrectal ultrasound (TRUS) image is an essential prerequisite for many prostate-related clinical procedures, which, however, is also a long-standing problem due to the challenges caused by the low image quality and shadow artifacts. In this paper, we propose a Shadow-consistent Semi-supervised Learning (SCO-SSL) method with two novel mechanisms, namely shadow augmentation (Shadow-AUG) and shadow dropout (Shadow-DROP), to tackle this challenging problem. Specifically, Shadow-AUG enriches training samples by adding simulated shadow artifacts to the images to make the network robust to the shadow patterns. Shadow-DROP enforces the segmentation network to infer the prostate boundary using the neighboring shadow-free pixels. Extensive experiments are conducted on two large clinical datasets (a public dataset containing 1,761 TRUS volumes and an in-house dataset containing 662 TRUS volumes). In the fully-supervised setting, a vanilla U-Net equipped with our Shadow-AUG&Shadow-DROP outperforms the state-of-the-arts with statistical significance. In the semi-supervised setting, even with only 20% labeled training data, our SCO-SSL method still achieves highly competitive performance, suggesting great clinical value in relieving the labor of data annotation. Source code is released at https://github.com/DIAL-RPI/SCO-SSL.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "National Institute of Biomedical Imaging and Bioengineering (NIBIB) of the National Institutes of Health", "grantId": "R21EB028001", "orderIn": 0}, {"agency": "NIBIB NIH HHS", "acronym": "EB", "grantId": "R01 EB027898", "orderIn": 0}, {"agency": "National Institute of Biomedical Imaging and Bioengineering (NIBIB) of the National Institutes of Health", "grantId": "R01EB027898", "orderIn": 0}, {"agency": "NIBIB NIH HHS", "acronym": "EB", "grantId": "R21 EB028001", "orderIn": 0}, {"agency": "NIH Bench-to-Bedside Award by the National Cancer Institute", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Pelvis"}, {"majorTopic_YN": "Y", "descriptorName": "Prostate", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}]}}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Ultrasonography"}, {"majorTopic_YN": "N", "descriptorName": "Artifacts"}, {"majorTopic_YN": "N", "descriptorName": "Image Processing, Computer-Assisted", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Male"}, {"majorTopic_YN": "Y", "descriptorName": "Supervised Machine Learning"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Free", "availabilityCode": "F", "documentStyle": "html", "site": "Unpaywall", "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC9709821"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1109/TMI.2021.3139999"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC9709821"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC9709821?pdf=render"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1109/tmi.2021.3139999"}]}, "isOpenAccess": "N", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 34, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "Y", "hasData": "Y", "authMan": "Y", "epmcAuthMan": "N", "nihAuthMan": "Y", "manuscriptId": "NIHMS1850153", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["doi"]}, "dateOfCompletion": "2022-06-03", "dateOfCreation": "2021-12-31", "dateOfRevision": "2023-06-02", "electronicPublicationDate": "2022-06-01", "firstPublicationDate": "2022-06-01", "firstIndexDate": "2022-01-01", "fullTextReceivedDate": "2025-02-02", "embargoDate": "2023-06-01", "hasEvaluations": "N"}]}}