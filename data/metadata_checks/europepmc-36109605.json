on": "Stanford University Department of Computer Science, Stanford, CA, USA."}, {"affiliation": "Department of Biomedical Informatics, Harvard University, Boston, MA, USA."}]}}, {"fullName": "Talius E", "lastName": "Talius", "firstName": "Ellie", "initials": "E", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Stanford University Department of Computer Science, Stanford, CA, USA."}, {"affiliation": "Department of Biomedical Informatics, Harvard University, Boston, MA, USA."}]}}, {"fullName": "Patel P", "lastName": "Patel", "firstName": "Pujan", "initials": "P", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Stanford University Department of Computer Science, Stanford, CA, USA."}, {"affiliation": "Department of Biomedical Informatics, Harvard University, Boston, MA, USA."}]}}, {"fullName": "Langlotz CP", "lastName": "Langlotz", "firstName": "Curtis P", "initials": "CP", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "AIMI Center, Stanford University, Palo Alto, CA, USA."}]}}, {"fullName": "Ng AY", "lastName": "Ng", "firstName": "Andrew Y", "initials": "AY", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Stanford University Department of Computer Science, Stanford, CA, USA."}]}}, {"fullName": "Rajpurkar P", "lastName": "Rajpurkar", "firstName": "Pranav", "initials": "P", "authorId": {"type": "ORCID", "value": "0000-0002-8030-3727"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Biomedical Informatics, Harvard University, Boston, MA, USA. pranav_rajpurkar@hms.harvard.edu."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-8030-3727"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "12", "volume": "6", "journalIssueId": 3479318, "dateOfPublication": "2022 Dec", "monthOfPublication": 12, "yearOfPublication": 2022, "journal": {"medlineAbbreviation": "Nat Biomed Eng", "title": "Nature biomedical engineering", "essn": "2157-846X", "issn": "2157-846X", "nlmid": "101696896", "isoabbreviation": "Nat Biomed Eng"}, "printPublicationDate": "2022-12-01"}, "pubYear": "2022", "pageInfo": "1399-1406", "abstractText": "In tasks involving the interpretation of medical images, suitably trained machine-learning models often exceed the performance of medical experts. Yet such a high-level of performance typically requires that the models be trained with relevant datasets that have been painstakingly annotated by experts. Here we show that a self-supervised model trained on chest X-ray images that lack explicit annotations performs pathology-classification tasks with accuracies comparable to those of radiologists. On an external validation dataset of chest X-rays, the self-supervised model outperformed a fully supervised model in the detection of three pathologies (out of eight), and the performance generalized to pathologies that were not explicitly annotated for model training, to multiple image-interpretation tasks and to datasets from multiple institutions.", "affiliation": "Stanford University Department of Computer Science, Stanford, CA, USA.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "X-Rays"}, {"majorTopic_YN": "Y", "descriptorName": "Machine Learning"}, {"majorTopic_YN": "Y", "descriptorName": "Supervised Machine Learning"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1038/s41551-022-00936-9"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC9792370"}, {"availability"