authorId": {"type": "ORCID", "value": "0000-0001-7569-173X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Basque Center on Cognition, Brain and Language (BCBL), Spain. Electronic address: e.iglesias@bcbl.eu."}]}}, {"fullName": "Van Leemput K", "lastName": "Van Leemput", "firstName": "Koen", "initials": "K", "authorId": {"type": "ORCID", "value": "0000-0001-6466-5309"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Martinos Center for Biomedical Imaging, Massachusetts General Hospital and Harvard Medical School, Boston, MA, USA; Department of Applied Mathematics and Computer Science, Technical University of Denmark (DTU), Denmark; Departments of Information and Computer Science and of Biomedical Engineering and Computational Science, Aalto University, Finland."}]}}, {"fullName": "Bhatt P", "lastName": "Bhatt", "firstName": "Priyanka", "initials": "P", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Memory and Aging Center, University of California, San Francisco, CA, USA."}]}}, {"fullName": "Casillas C", "lastName": "Casillas", "firstName": "Christen", "initials": "C", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Memory and Aging Center, University of California, San Francisco, CA, USA."}]}}, {"fullName": "Dutt S", "lastName": "Dutt", "firstName": "Shubir", "initials": "S", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Memory and Aging Center, University of California, San Francisco, CA, USA."}]}}, {"fullName": "Schuff N", "lastName": "Schuff", "firstName": "Norbert", "initials": "N", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Center for Imaging of Neurodegenerative Dieases (CIND), Department of Radiology, University of California, San Francisco, CA, USA."}]}}, {"fullName": "Truran-Sacrey D", "lastName": "Truran-Sacrey", "firstName": "Diana", "initials": "D", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Center for Imaging of Neurodegenerative Dieases (CIND), Department of Radiology, University of California, San Francisco, CA, USA."}]}}, {"fullName": "Boxer A", "lastName": "Boxer", "firstName": "Adam", "initials": "A", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Memory and Aging Center, University of California, San Francisco, CA, USA."}]}}, {"fullName": "Fischl B", "lastName": "Fischl", "firstName": "Bruce", "initials": "B", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Martinos Center for Biomedical Imaging, Massachusetts General Hospital and Harvard Medical School, Boston, MA, USA; Computer Science and Artificial Intelligence Laboratory (CSAIL), Massachusetts Institute of Technology (MIT), Cambridge, MA, USA."}]}}, {"collectiveName": "Alzheimer's Disease Neuroimaging Initiative"}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-6466-5309"}, {"type": "ORCID", "value": "0000-0001-7569-173X"}, {"type": "ORCID", "value": "0000-0002-8345-6892"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"volume": "113", "journalIssueId": 2285329, "dateOfPublication": "2015 Jun", "monthOfPublication": 6, "yearOfPublication": 2015, "journal": {"medlineAbbreviation": "Neuroimage", "title": "NeuroImage", "essn": "1095-9572", "issn": "1053-8119", "nlmid": "9215515", "isoabbreviation": "Neuroimage"}, "printPublicationDate": "2015-06-01"}, "pubYear": "2015", "pageInfo": "184-195", "abstractText": "In this paper we present a method to segment four brainstem structures (midbrain, pons, medulla oblongata and superior cerebellar peduncle) from 3D brain MRI scans. The segmentation method relies on a probabilistic atlas of the brainstem and its neighboring brain structures. To build the atlas, we combined a dataset of 39 scans with already existing manual delineations of the whole brainstem and a dataset of 10 scans in which the brainstem structures were manually labeled with a protocol that was specifically designed for this study. The resulting atlas can be used in a Bayesian framework to segment the brainstem structures in novel scans. Thanks to the generative nature of the scheme, the segmentation method is robust to changes in MRI contrast or acquisition hardware. Using cross validation, we show that the algorithm can segment the structures in previously unseen T1 and FLAIR scans with great accuracy (mean error under 1mm) and robustness (no failures in 383 scans including 168 AD cases). We also indirectly evaluate the algorithm with a experiment in which we study the atrophy of the brainstem in aging. The results show that, when used simultaneously, the volumes of the midbrain, pons and medulla are significantly more predictive of age than the volume of the entire brainstem, estimated as their sum. The results also demonstrate that the method can detect atrophy patterns in the brainstem structures that have been previously described in the literature. Finally, we demonstrate that the proposed algorithm is able to detect differential effects of AD on the brainstem structures. The method will be implemented as part of the popular neuroimaging package FreeSurfer.", "affiliation": "Basque Center on Cognition, Brain and Language (BCBL), Spain. Electronic address: e.iglesias@bcbl.eu.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Research Support, U.S. Gov't, Non-P.H.S.", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NINDS NIH HHS", "acronym": "NS", "grantId": "1R21 NS 072652-01", "orderIn": 0}, {"agency": "National Institute on Aging", "grantId": "5R01 AG008122-22", "orderIn": 0}, {"agency": "NIH Blueprint for Neuroscience Research", "grantId": "5U01 MH093765", "orderIn": 0}, {"agency": "NIA NIH HHS", "acronym": "AG", "grantId": "R01 AG0164