gel", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0003-3389-8913"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Universidad Nacional de Colombia, Bogota, Colombia."}, {"affiliation": "Universidad de los Llanos, Villavicencio, Colombia."}]}}, {"fullName": "Gilmore H", "lastName": "Gilmore", "firstName": "Hannah", "initials": "H", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "University Hospitals Case Medical Center, Cleveland, OH, USA."}]}}, {"fullName": "Basavanhally A", "lastName": "Basavanhally", "firstName": "Ajay", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0002-4713-815X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Inspirata Inc., Tampa, FL, USA."}]}}, {"fullName": "Feldman M", "lastName": "Feldman", "firstName": "Michael", "initials": "M", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Hospital of the University of Pennsylvania, Philadelphia, PA, USA."}]}}, {"fullName": "Ganesan S", "lastName": "Ganesan", "firstName": "Shridar", "initials": "S", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Cancer Institute of New Jersey, New Brunswick, NJ, USA."}]}}, {"fullName": "Shih NNC", "lastName": "Shih", "firstName": "Natalie N C", "initials": "NNC", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Hospital of the University of Pennsylvania, Philadelphia, PA, USA."}]}}, {"fullName": "Tomaszewski J", "lastName": "Tomaszewski", "firstName": "John", "initials": "J", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "University at Buffalo, The State University of New York, Buffalo, NY USA."}]}}, {"fullName": "González FA", "lastName": "González", "firstName": "Fabio A", "initials": "FA", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Universidad Nacional de Colombia, Bogota, Colombia."}]}}, {"fullName": "Madabhushi A", "lastName": "Madabhushi", "firstName": "Anant", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0002-5741-0399"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Case Western Reserve University, Cleveland, OH, USA."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-4713-815X"}, {"type": "ORCID", "value": "0000-0002-5741-0399"}, {"type": "ORCID", "value": "0000-0003-3389-8913"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics"]}, "journalInfo": {"volume": "7", "journalIssueId": 2542553, "dateOfPublication": "2017 Apr", "monthOfPublication": 4, "yearOfPublication": 2017, "journal": {"medlineAbbreviation": "Sci Rep", "title": "Scientific reports", "essn": "2045-2322", "issn": "2045-2322", "nlmid": "101563288", "isoabbreviation": "Sci Rep"}, "printPublicationDate": "2017-04-01"}, "pubYear": "2017", "pageInfo": "46450", "abstractText": "With the increasing ability to routinely and rapidly digitize whole slide images with slide scanners, there has been interest in developing computerized image analysis algorithms for automated detection of disease extent from digital pathology images. The manual identification of presence and extent of breast cancer by a pathologist is critical for patient management for tumor staging and assessing treatment response. However, this process is tedious and subject to inter- and intra-reader variability. For computerized methods to be useful as decision support tools, they need to be resilient to data acquired from different sources, different staining and cutting protocols and different scanners. The objective of this study was to evaluate the accuracy and robustness of a deep learning-based method to automatically identify the extent of invasive tumor on digitized images. Here, we present a new method that employs a convolutional neural network for detecting presence of invasive tumor on whole slide images. Our approach involves training the classifier on nearly 400 exemplars from multiple different sites, and scanners, and then independently validating on almost 200 cases from The Cancer Genome Atlas. Our approach yielded a Dice coefficient of 75.86%, a positive predictive value of 71.62% and a negative predictive value of 96.77% in terms of pixel-by-pixel evaluation compared to manually annotated regions of invasive ductal carcinoma.", "affiliation": "Universidad Nacional de Colombia, Bogota, Colombia.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Research Support, U.S. Gov't, Non-P.H.S.", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01 CA202752", "orderIn": 0}, {"agency": "NIBIB NIH HHS", "acronym": "EB", "grantId": "R43 EB015199", "orderIn": 0}, {"agency": "NCRR NIH HHS", "acronym": "RR", "grantId": "C06 RR012463", "orderIn": 0}, {"agency": "NIDDK NIH HHS", "acronym": "DK", "grantId": "R01 DK098503", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01 CA208236", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U24 CA199374", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R21 CA179327", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R21 CA167811", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R21 CA195152", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Carcinoma, Ductal, Breast", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}, {"majorTopic_YN": "Y", "abbreviation": "PA", "qualifierName": "pathology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Breast Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DG", "q