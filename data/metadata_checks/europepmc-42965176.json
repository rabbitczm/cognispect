ssn": "2352-1872", "issn": "2352-1872", "nlmid": "101646176", "isoabbreviation": "Bone Rep"}, "printPublicationDate": "2026-12-01"}, "pubYear": "2026", "pageInfo": "101963", "abstractText": "Conventional imaging poorly captures bone disorganization, a pathological feature of hypophosphatasia (HPP). This single-patient case report applied ALIGNOGRAM to previously published open-access distal radius radiographs from a 16-year-old with severe HPP before and after six months of asfotase alfa. It detected overt, subtle, and covert lesions and quantified reduced lesion burden post-treatment. Residual disorganization persisted. These findings support preliminary technical feasibility, with independent validation in larger prospective cohorts required to establish diagnostic and treatment-response validity.", "affiliation": "Monash University School of Clinical Sciences at Monash Health, Clayton, Victoria, Australia.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic-eCollection", "pubTypeList": {"pubType": ["Journal Article", "Case Reports", "case-report"]}, "grantsList": {"grant": [{"agency": "Alexion Pharmaceuticals Inc", "orderIn": 0}]}, "keywordList": {"keyword": ["Hypophosphatasia", "Imaging Biomarker", "Asfotase Alfa", "Bone Disorganization", "Alignogram"]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1016/j.bonr.2026.101963"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC13722107"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC13722107?pdf=render"}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 0, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook