l University of Ireland Galway, Galway, Ireland School of Natural Sciences, National University of Ireland Galway, Galway, Ireland."}]}}, {"fullName": "Koryga I", "lastName": "Koryga", "firstName": "Izabela", "initials": "I", "authorId": {"type": "ORCID", "value": "0000-0001-8151-1926"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Apoptosis Research Centre, National University of Ireland Galway, Galway, Ireland School of Natural Sciences, National University of Ireland Galway, Galway, Ireland."}]}}, {"fullName": "Mnich K", "lastName": "Mnich", "firstName": "Katarzyna", "initials": "K", "authorId": {"type": "ORCID", "value": "0000-0003-2137-9163"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Apoptosis Research Centre, National University of Ireland Galway, Galway, Ireland School of Natural Sciences, National University of Ireland Galway, Galway, Ireland."}]}}, {"fullName": "Ljujic M", "lastName": "Ljujic", "firstName": "Mila", "initials": "M", "authorId": {"type": "ORCID", "value": "0000-0003-4428-2938"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Apoptosis Research Centre, National University of Ireland Galway, Galway, Ireland School of Natural Sciences, National University of Ireland Galway, Galway, Ireland."}]}}, {"fullName": "Samali A", "lastName": "Samali", "firstName": "Afshin", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0002-8610-8375"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Apoptosis Research Centre, National University of Ireland Galway, Galway, Ireland School of Natural Sciences, National University of Ireland Galway, Galway, Ireland."}]}}, {"fullName": "Gorman AM", "lastName": "Gorman", "firstName": "Adrienne M", "initials": "AM", "authorId": {"type": "ORCID", "value": "0000-0002-6068-0058"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Apoptosis Research Centre, National University of Ireland Galway, Galway, Ireland School of Natural Sciences, National University of Ireland Galway, Galway, Ireland adrienne.gorman@nuigalway.ie."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-8151-1926"}, {"type": "ORCID", "value": "0000-0002-6068-0058"}, {"type": "ORCID", "value": "0000-0002-8610-8375"}, {"type": "ORCID", "value": "0000-0003-2137-9163"}, {"type": "ORCID", "value": "0000-0003-4428-2938"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "related_data", "wikipedia", "supporting_data"]}, "journalInfo": {"issue": "10", "volume": "17", "journalIssueId": 2458332, "dateOfPublication": "2016 Oct", "monthOfPublication": 10, "yearOfPublication": 2016, "journal": {"medlineAbbreviation": "EMBO Rep", "title": "EMBO reports", "essn": "1469-3178", "issn": "1469-221X", "isoabbreviation": "EMBO Rep", "nlmid": "100963049"}, "printPublicationDate": "2016-10-01"}, "pubYear": "2016", "pageInfo": "1374-1395", "abstractText": "In response to diverse stress stimuli, eukaryotic cells activate a common adaptive pathway, termed the integrated stress response (ISR), to restore cellular homeostasis. The core event in this pathway is the phosphorylation of eukaryotic translation initiation factor 2 alpha (eIF2α) by one of four members of the eIF2α kinase family, which leads to a decrease in global protein synthesis and the induction of selected genes, including the transcription factor ATF4, that together promote cellular recovery. The gene expression program activated by the ISR optimizes the cellular response to stress and is dependent on the cellular context, as well as on the nature and intensity of the stress stimuli. Although the ISR is primarily a pro-survival, homeostatic program, exposure to severe stress can drive signaling toward cell death. Here, we review current understanding of the ISR signaling and how it regulates cell fate under diverse types of stress.", "affiliation": "Apoptosis Research Centre, National University of Ireland Galwa