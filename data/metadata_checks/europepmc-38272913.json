uimin", "initials": "H", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Jiangmen Central Hospital, Jiangmen, China."}]}}, {"fullName": "Chen X", "lastName": "Chen", "firstName": "Xiangguang", "initials": "X", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Meizhou People's Hospital, Meizhou, China."}]}}, {"fullName": "Wan C", "lastName": "Wan", "firstName": "Cuixia", "initials": "C", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Meizhou People's Hospital, Meizhou, China."}]}}, {"fullName": "Hu Q", "lastName": "Hu", "firstName": "Qinghui", "initials": "Q", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Laboratory of Intelligent Detection and Information Processing, Guilin University of Aerospace Technology, Guilin, China."}]}}, {"fullName": "Cui E", "lastName": "Cui", "firstName": "Enming", "initials": "E", "authorId": {"type": "ORCID", "value": "0000-0003-0634-822X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Jiangmen Central Hospital, Jiangmen, China."}]}}, {"fullName": "Chen Y", "lastName": "Chen", "firstName": "Yehang", "initials": "Y", "authorId": {"type": "ORCID", "value": "0009-0002-3724-3957"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Laboratory of Intelligent Detection and Information Processing, Guilin University of Aerospace Technology, Guilin, China. cyh93yl@163.com."}]}}, {"fullName": "Long W", "lastName": "Long", "firstName": "Wansheng", "initials": "W", "authorId": {"type": "ORCID", "value": "0000-0002-1331-1858"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Jiangmen Central Hospital, Jiangmen, China. jmlws2@163.com."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-1331-1858"}, {"type": "ORCID", "value": "0000-0003-0634-822X"}, {"type": "ORCID", "value": "0009-0002-3724-3957"}, {"type": "ORCID", "value": "0009-0009-3543-2798"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "1", "volume": "15", "journalIssueId": 3689398, "dateOfPublication": "2024 Jan", "monthOfPublication": 1, "yearOfPublication": 2024, "journal": {"medlineAbbreviation": "Nat Commun", "title": "Nature communications", "essn": "2041-1723", "issn": "2041-1723", "nlmid": "101528555", "isoabbreviation": "Nat Commun"}, "printPublicationDate": "2024-01-01"}, "pubYear": "2024", "pageInfo": "742", "abstractText": "The prediction of patient disease risk via computed tomography (CT) images and artificial intelligence techniques shows great potential. However, training a robust artificial intelligence model typically requires large-scale data support. In practice, the collection of medical data faces obstacles related to privacy protection. Therefore, the present study aims to establish a robust federated learning model to overcome the data island problem and identify high-risk patients with postoperative gastric cancer recurrence in a multicentre, cross-institution setting, thereby enabling robust treatment with significant value. In the present study, we collect data from four independent medical institutions for experimentation. The robust federated learning model algorithm yields area under the receiver operating characteristic curve (AUC) values of 0.710, 0.798, 0.809, and 0.869 across four data centres. Additionally, the effectiveness of the algorithm is evaluated, and both adaptive and common features are identified through analysis.", "affiliation": "Department of Radiology, Jiangmen Central Hospital, Jiangmen, China.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "de