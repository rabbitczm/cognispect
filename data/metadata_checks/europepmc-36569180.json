lue": "0000-0001-5738-1631"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Computer Science and Engineering, American International University Bangladesh, Dhaka 1229, Bangladesh."}]}}, {"fullName": "Prodeep AR", "lastName": "Prodeep", "firstName": "Akibur Rahman", "initials": "AR", "authorId": {"type": "ORCID", "value": "0000-0002-0198-7586"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Computer Science and Engineering, Bangladesh University of Business and Technology, Dhaka 1216, Bangladesh."}]}}, {"fullName": "Hoque ASMM", "lastName": "Hoque", "firstName": "A S M Morshedul", "initials": "ASMM", "authorId": {"type": "ORCID", "value": "0000-0002-5017-1508"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Computer Science and Engineering, Bangladesh University of Business and Technology, Dhaka 1216, Bangladesh."}]}}, {"fullName": "Islam MR", "lastName": "Islam", "firstName": "Md Rashedul", "initials": "MR", "authorId": {"type": "ORCID", "value": "0000-0001-8676-6338"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Computer Science and Engineering, University of Asia Pacific, Dhaka 1216, Bangladesh."}]}}, {"fullName": "Lima AA", "lastName": "Lima", "firstName": "Aklima Akter", "initials": "AA", "authorId": {"type": "ORCID", "value": "0000-0002-0807-523X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Computer Science and Engineering, Bangladesh University of Business and Technology, Dhaka 1216, Bangladesh."}]}}, {"fullName": "Kabir MM", "lastName": "Kabir", "firstName": "Muhammad Mohsin", "initials": "MM", "authorId": {"type": "ORCID", "value": "0000-0001-9624-5499"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Computer Science and Engineering, Bangladesh University of Business and Technology, Dhaka 1216, Bangladesh."}]}}, {"fullName": "Hamid MA", "lastName": "Hamid", "firstName": "Md Abdul", "initials": "MA", "authorId": {"type": "ORCID", "value": "0000-0001-9698-4726"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Information Technology, King Abdulaziz University, Jeddah 21589, Saudi Arabia."}]}}, {"fullName": "Watanobe Y", "lastName": "Watanobe", "firstName": "Yutaka", "initials": "Y", "authorId": {"type": "ORCID", "value": "0000-0002-0030-3859"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Computer Science and Engineering, University of Aizu, Aizuwakamatsu 965-8580, Japan."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5738-1631"}, {"type": "ORCID", "value": "0000-0001-8676-6338"}, {"type": "ORCID", "value": "0000-0001-9624-5499"}, {"type": "ORCID", "value": "0000-0001-9698-4726"}, {"type": "ORCID", "value": "0000-0002-0030-3859"}, {"type": "ORCID", "value": "0000-0002-0198-7586"}, {"type": "ORCID", "value": "0000-0002-0807-523X"}, {"type": "ORCID", "value": "0000-0002-5017-1508"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"volume": "2022", "journalIssueId": 3292158, "dateOfPublication": "2022 ", "monthOfPublication": 0, "yearOfPublication": 2022, "journal": {"medlineAbbreviation": "J Healthc Eng", "title": "Journal of healthcare engineering", "essn": "2040-2309", "issn": "2040-2295", "nlmid": "101528166", "isoabbreviation": "J Healthc Eng"}, "printPublicationDate": "2022-01-01"}, "pubYear": "2022", "pageInfo": "5905230", "abstractText": "Lung cancer is the primary reason of cancer deaths worldwide, and the percentage of death rate is increasing step by step. There are chances of recovering from lung cancer by detecting it early. In any case, because the number of radiologists is limited and they have been working overtime, the increase in image data makes it hard for them to evaluate the images accurately. As a result, many researchers have come up with automated ways to predict the growth of cancer cells using medical imaging methods in a quick and accurate way. Previously, a lot of work was done on computer-aided detection (CADe) and computer-aided diagnosis (CADx) in computed tomography (CT) scan, magnetic resonance imaging (MRI), and X-ray with the goal of effective detection and segmentation of pulmonary nodule, as well as classifying nodules as malignant or benign. But still, no complete comprehensive review that includes all aspects of lung cancer has been done. In this paper, every aspect of lung cancer is discussed in detail, including datasets, image preprocessing, segmentation methods, optimal feature extraction and selection methods, evaluation measurement matrices, and classifiers. Finally, the study looks into several lung cancer-related issues with possible solutions.", "affiliation": "Department of Computer Science and Engineering, American International University Bangladesh, Dhaka 1229, Bangladesh.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic-eCollection", "pubTypeList": {"pubType": ["research-article", "Review", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Thorax"}, {"majorTopic_YN": "N", "descriptorName": "Lung", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "PA", "qualifierName": "pathology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "Y", "descriptorName": "Lung Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}]}}, {"majorTopic_YN": "N", "descriptorName": "Diagnosis, Computer-Assisted", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Radiographic Image Interpretation, Computer-Assisted", "meshQualifierList": {"meshQualifier": [{"majorTo