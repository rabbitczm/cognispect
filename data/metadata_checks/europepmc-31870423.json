n": "New York Genome Center, 101 6th Ave, New York, 10013, NY, USA. christoph.hafemeister@nyu.edu."}]}}, {"fullName": "Satija R", "lastName": "Satija", "firstName": "Rahul", "initials": "R", "authorId": {"type": "ORCID", "value": "0000-0001-9448-8833"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "New York Genome Center, 101 6th Ave, New York, 10013, NY, USA. rsatija@nygenome.org."}, {"affiliation": "Center for Genomics and Systems Biology, New York University, 12 Waverly Pl, New York, 10003, NY, USA. rsatija@nygenome.org."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-9448-8833"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "1", "volume": "20", "journalIssueId": 2887411, "dateOfPublication": "2019 Dec", "monthOfPublication": 12, "yearOfPublication": 2019, "journal": {"medlineAbbreviation": "Genome Biol", "title": "Genome biology", "essn": "1474-760X", "issn": "1474-7596", "nlmid": "100960660", "isoabbreviation": "Genome Biol"}, "printPublicationDate": "2019-12-01"}, "pubYear": "2019", "pageInfo": "296", "abstractText": "Single-cell RNA-seq (scRNA-seq) data exhibits significant cell-to-cell variation due to technical factors, including the number of molecules detected in each cell, which can confound biological heterogeneity with technical effects. To address this, we present a modeling framework for the normalization and variance stabilization of molecular count data from scRNA-seq experiments. We propose that the Pearson residuals from \"regularized negative binomial regression,\" where cellular sequencing depth is utilized as a covariate in a generalized linear model, successfully remove the influence of technical characteristics from downstream analyses while preserving biological heterogeneity. Importantly, we show that an unconstrained negative binomial model may overfit scRNA-seq data, and overcome this by pooling information across genes with similar abundances to obtain stable parameter estimates. Our procedure omits the need for heuristic steps including pseudocount addition or log-transformation and improves common downstream analytical tasks such as variable gene selection, dimensional reduction, and differential expression. Our approach can be applied to any UMI-based scRNA-seq dataset and is freely available as part of the R package sctransform, with a direct interface to our single-cell toolkit Seurat.", "affiliation": "New York Genome Center, 101 6th Ave, New York, 10013, NY, USA. christoph.hafemeister@nyu.edu.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Evaluation Study", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NICHD NIH HHS", "acronym": "HD", "grantId": "R01 HD096770", "orderIn": 0}, {"agency": "NIH HHS", "acronym": "OD", "grantId": "OT2 OD026673", "orderIn": 0}, {"agency": "NIMH NIH HHS", "acronym": "MH", "grantId": "R01 MH071679", "orderIn": 0}, {"agency": "NINDS NIH HHS", "acronym": "NS", "grantId": "R35 NS097404", "orderIn": 0}, {"agency": "NHGRI NIH HHS", "acronym": "HG", "grantId": "DP2 HG009623", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Regression Analysis"}, {"majorTopic_YN": "Y", "descriptorName": "Sequence Analysis, RNA"}, {"majorTopic_YN": "Y", "descriptorName": "Software"}, {"majorTopic_YN": "Y", "descriptorName": "Single-Cell Analysis"}]}, "keywordList": {"keyword": ["Normalization", "Single-cell Rna-seq"]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Unpaywall", "url": "https://genomebiology.biomedcentral.com/track/pdf/10.1186/s13059-019-1874-1"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1186/s13059-019-1874-1"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC6927181"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC6927181?pdf=render"}]}, "commentCorrectionList": {"commentCorrection": [{"source": "PPR", "id": "PPR73120", "type": "Preprint in", "note": "CrossRef Pre-print loader", "orderIn": 10002}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 4336, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "Y", "hasLabsLinks": "Y", "hasData": "Y", "license": "cc by", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["doi"]}, "dateOfCompletion": "2020-03-20", "dateOfCreation": "2019-12-25", "dateOfRevision": "2023-10-27", "electronicPublicationDate": "2019-12-23", "firstPublicationDate": "2019-12-23", "firstIndexDate": "2019-12-30", "fullTextReceivedDate": "2025-02-03", "hasEvaluations": "N"}]}}