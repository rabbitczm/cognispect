st": {"authorAffiliation": [{"affiliation": "Academic Unit of Oral & Maxillofacial Surgery, School of Clinical Dentistry, University of Sheffield, Sheffield, UK. h.mahmood@sheffield.ac.uk."}]}}, {"fullName": "Shaban M", "lastName": "Shaban", "firstName": "Muhammad", "initials": "M", "authorId": {"type": "ORCID", "value": "0000-0001-6115-1505"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Computer Science, University of Warwick, Coventry, UK."}]}}, {"fullName": "Rajpoot N", "lastName": "Rajpoot", "firstName": "Nasir", "initials": "N", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Computer Science, University of Warwick, Coventry, UK."}]}}, {"fullName": "Khurram SA", "lastName": "Khurram", "firstName": "Syed A", "initials": "SA", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Unit of Oral & Maxillofacial Pathology, School of Clinical Dentistry, University of Sheffield, Sheffield, UK."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-6115-1505"}, {"type": "ORCID", "value": "0000-0001-7159-0368"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "12", "volume": "124", "journalIssueId": 3183909, "dateOfPublication": "2021 Jun", "monthOfPublication": 6, "yearOfPublication": 2021, "journal": {"medlineAbbreviation": "Br J Cancer", "title": "British journal of cancer", "essn": "1532-1827", "issn": "0007-0920", "nlmid": "0370635", "isoabbreviation": "Br J Cancer"}, "printPublicationDate": "2021-06-01"}, "pubYear": "2021", "pageInfo": "1934-1940", "abstractText": "<h4>Background</h4>This paper reviews recent literature employing Artificial Intelligence/Machine Learning (AI/ML) methods for diagnostic evaluation of head and neck cancers (HNC) using automated image analysis.<h4>Methods</h4>Electronic database searches using MEDLINE via OVID, EMBASE and Google Scholar were conducted to retrieve articles using AI/ML for diagnostic evaluation of HNC (2009-2020). No restrictions were placed on the AI/ML method or imaging modality used.<h4>Results</h4>In total, 32 articles were identified. HNC sites included oral cavity (n = 16), nasopharynx (n = 3), oropharynx (n = 3), larynx (n = 2), salivary glands (n = 2), sinonasal (n = 1) and in five studies multiple sites were studied. Imaging modalities included histological (n = 9), radiological (n = 8), hyperspectral (n = 6), endoscopic/clinical (n = 5), infrared thermal (n = 1) and optical (n = 1). Clinicopathologic/genomic data were used in two studies. Traditional ML methods were employed in 22 studies (69%), deep learning (DL) in eight studies (25%) and a combination of these methods in two studies (6%).<h4>Conclusions</h4>There is an increasing volume of studies exploring the role of AI/ML to aid HNC detection using a range of imaging modalities. These methods can achieve high degrees of accuracy that can exceed the abilities of human judgement in making data predictions. Large-scale multi-centric prospective studies are required to aid deployment into clinical practice.", "affiliation": "Academic Unit of Oral & Maxillofacial Surgery, School of Clinical Dentistry, University of Sheffield, Sheffield, UK. h.mahmood@sheffield.ac.uk.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Review", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Medical Research Council", "acronym": "MRC_", "grantId": "MR/P015476/1", "orderIn": 0}, {"agency": "Cancer Research UK", "acronym": "CRUK_", "grantId": "29674", "orderIn": 0}, {"agency": "National Institute for Health Research (NIHR)", "grantId": "ACF-2017-04-012", "orderIn": 0}, {"agency": "National Institute for Health Research (NIHR)", "grantId": "NIHR300904", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Head and Neck Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "DI", "qualifierName": "diagnosis"}, {"majorTopic_YN": "N", "abbreviation": "PA", "qualifierName": "pathology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Medical Oncology", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "MT", "qualifierName": "methods"}, {"majorTopic_YN": "N", "abbreviation": "TD", "qualifierName": "trends"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Artificial Intelligence"}, {"majorTopic_YN": "N", "descriptorName": "Image Processing, Computer-Assisted", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Pattern Recognition, Automated"}, {"majorTopic_YN": "N", "descriptorName": "Machine Learning"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1038/s41416-021-01386-x"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC8184820"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC8184820?pdf=render"}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 106, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "Y", "hasLabsLinks": "Y", "hasData": "Y", "license": "cc by", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "N", "dateOfCompletion": "2021-12-10", "dateOfCreation": "2021-04-20", "dateOfRevision": "2025-05-30", "electronicPublicationDate": "2021-04-19", "firstPublic