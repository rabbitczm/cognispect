, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Anesthesia and Critical Care, Istituto Nazionale Tumori - IRCCS, Fondazione Pascale, Via Mariano Semmola, 53, 80131, Naples, Italy."}]}}, {"fullName": "Montomoli J", "lastName": "Montomoli", "firstName": "Jonathan", "initials": "J", "authorId": {"type": "ORCID", "value": "0000-0002-4028-9588"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Anesthesia and Intensive Care, Infermi Hospital, AUSL Romagna, Viale Settembrini 2, 47923, Rimini, Italy."}]}}, {"fullName": "Bellini V", "lastName": "Bellini", "firstName": "Valentina", "initials": "V", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Anesthesiology, Critical Care and Pain Medicine Division, Department of Medicine and Surgery, University of Parma, Viale Gramsci 14, 43126, Parma, Italy."}]}}, {"fullName": "Bignami E", "lastName": "Bignami", "firstName": "Elena", "initials": "E", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Anesthesiology, Critical Care and Pain Medicine Division, Department of Medicine and Surgery, University of Parma, Viale Gramsci 14, 43126, Parma, Italy. elenagiovanna.bignami@unipr.it."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-4028-9588"}, {"type": "ORCID", "value": "0000-0002-5236-3132"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "1", "volume": "47", "journalIssueId": 3515094, "dateOfPublication": "2023 Mar", "monthOfPublication": 3, "yearOfPublication": 2023, "journal": {"medlineAbbreviation": "J Med Syst", "title": "Journal of medical systems", "essn": "1573-689X", "issn": "0148-5598", "nlmid": "7806056", "isoabbreviation": "J Med Syst"}, "printPublicationDate": "2023-03-01"}, "pubYear": "2023", "pageInfo": "33", "abstractText": "This paper aims to highlight the potential applications and limits of a large language model (LLM) in healthcare. ChatGPT is a recently developed LLM that was trained on a massive dataset of text for dialogue with users. Although AI-based language models like ChatGPT have demonstrated impressive capabilities, it is uncertain how well they will perform in real-world scenarios, particularly in fields such as medicine where high-level and complex thinking is necessary. Furthermore, while the use of ChatGPT in writing scientific articles and other scientific outputs may have potential benefits, important ethical concerns must also be addressed. Consequently, we investigated the feasibility of ChatGPT in clinical and research scenarios: (1) support of the clinical practice, (2) scientific production, (3) misuse in medicine and research, and (4) reasoning about public health topics. Results indicated that it is important to recognize and promote education on the appropriate use and potential pitfalls of AI-based LLMs in medicine.", "affiliation": "Department of Anesthesia and Critical Care, Istituto Nazionale Tumori - IRCCS, Fondazione Pascale, Via Mariano Semmola, 53, 80131, Naples, Italy.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Università degli Studi di Parma", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Feasibility Studies"}, {"majorTopic_YN": "Y", "descriptorName": "Language"}, {"majorTopic_YN": "N", "descriptorName": "Educational Status"}, {"majorTopic_YN": "N", "descriptorName": "Delivery of Health Care"}]}, "keywordList": {"keyword": ["Artificial intelligence", "Medicine", "Chatgpt", "Clinical Resaerch"]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "u