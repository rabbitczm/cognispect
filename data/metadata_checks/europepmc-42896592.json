ese Medicine, Hefei, China."}]}}, {"fullName": "Fang X", "lastName": "Fang", "firstName": "Xiangming", "initials": "X", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Anhui University of Chinese Medicine, Hefei, China."}, {"affiliation": "School of Traditional Chinese Medicine, Anhui University of Chinese Medicine, Hefei, China."}, {"affiliation": "Key Laboratory of Xin'an Medicine, Ministry of Education, Anhui University of Chinese Medicine, Hefei, China."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-7787-2638"}, {"type": "ORCID", "value": "0009-0003-8019-2419"}, {"type": "ORCID", "value": "0009-0007-8241-7019"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "12", "volume": "40", "journalIssueId": 4294959, "dateOfPublication": "2026 Dec", "monthOfPublication": 12, "yearOfPublication": 2026, "journal": {"medlineAbbreviation": "Biomed Chromatogr", "title": "Biomedical chromatography : BMC", "essn": "1099-0801", "issn": "0269-3879", "nlmid": "8610241", "isoabbreviation": "Biomed Chromatogr"}, "printPublicationDate": "2026-12-01"}, "pubYear": "2026", "pageInfo": "e70607", "abstractText": "An ultrahigh-performance liquid chromatography coupled with quadrupole-Orbitrap high-resolution mass spectrometry (UHPLC-Q-Orbitrap HRMS) method was applied to characterize Pingchuanning (PCN) decoction and its absorbed serum constituents in asthmatic rats. A total of 107 compounds were identified in PCN, of which 36 prototypes were detected in rat serum. Network pharmacology and molecular docking of these absorbed compounds predicted ADORA2A as the core therapeutic target, with 5-O-methylvisammioside, nobiletin, sec-O-glucosylhamaudol, and 9-oxo-ODE showing binding affinity. In an ovalbumin-induced asthmatic rat model, PCN alleviated airway hyperresponsiveness and lung inflammation. Mechanistically, PCN upregulated ADORA2A, elevated cAMP and PKA phosphorylation, and suppressed NLRP3 expression. This UHPLC-Q-Orbitrap HRMS-based serum pharmacochemistry method effectively identified the bioactive components of PCN, and the integrated strategy demonstrates that PCN exerts anti-asthmatic effects through the ADORA2A/cAMP/PKA/NLRP3 axis.", "affiliation": "Anhui University of Chinese Medicine, Hefei, China.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Postdoctoral Research Project of the Department of Human Resources and Social Security of Anhui Province", "orderIn": 0}, {"agency": "Anhui University of Chinese Medicine", "grantId": "Wan Ren She Mi [2024] No. 231", "orderIn": 0}, {"agency": "Anhui University of Chinese Medicine", "grantId": "82575020", "orderIn": 0}, {"agency": "National Natural Science Foundation of China", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Animals"}, {"majorTopic_YN": "N", "descriptorName": "Rats"}, {"majorTopic_YN": "N", "descriptorName": "Rats, Sprague-Dawley"}, {"majorTopic_YN": "Y", "descriptorName": "Asthma", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DT", "qualifierName": "drug therapy"}, {"majorTopic_YN": "N", "abbreviation": "ME", "qualifierName": "metabolism"}]}}, {"majorTopic_YN": "N", "descriptorName": "Receptor, Adenosine A2A", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "ME", "qualifierName": "metabolism"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Drugs, Chinese Herbal", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "AN", "qualifierName": "analysis"}, {"majorTopic_YN": "N", "abbreviation": "PK", "qualifierName": "pharmacokinetics"}, {"majorTopic_YN": "N", "abbreviation": "PD", "qualifierName": "pharmacology"}, {"majorTopic_YN": "N", "abbreviation": "CH", "qualifierName": "chemistry"}]}}, {"majorTopic_YN": "Y", "descriptorName":