00-9080"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Critical Care, King's College London, Guy's & St Thomas' Hospital, London, SE1 9RT, UK."}]}}, {"fullName": "Prowle JR", "lastName": "Prowle", "firstName": "John R", "initials": "JR", "authorId": {"type": "ORCID", "value": "0000-0002-5002-2721"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Adult Critical Care Unit, Department of Renal Medicine and Transplantation, The Royal London Hospital, Barts Health NHS Trust, London, UK."}, {"affiliation": "William Harvey Research Institute, Queen Mary University of London, London, UK."}]}}, {"fullName": "Schneider A", "lastName": "Schneider", "firstName": "Antoine", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0003-0576-7094"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Adult Intensive Care Unit, Centre Hospitalier Universitaire Vaudois (CHUV), Lausanne, Switzerland."}]}}, {"fullName": "Schetz M", "lastName": "Schetz", "firstName": "Miet", "initials": "M", "authorId": {"type": "ORCID", "value": "0000-0001-5776-4827"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Clinical Department and Laboratory of Intensive Care Medicine, Division of Cellular and Molecular Medicine, KU Leuven University, Herestraat 49, B3000, Leuven, Belgium. marie.schetz@uzleuven.be."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5776-4827"}, {"type": "ORCID", "value": "0000-0001-9301-8055"}, {"type": "ORCID", "value": "0000-0001-9500-9080"}, {"type": "ORCID", "value": "0000-0001-9788-5316"}, {"type": "ORCID", "value": "0000-0002-1104-4303"}, {"type": "ORCID", "value": "0000-0002-5002-2721"}, {"type": "ORCID", "value": "0000-0003-0576-7094"}, {"type": "ORCID", "value": "0000-0003-4198-8038"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "8", "volume": "47", "journalIssueId": 3207758, "dateOfPublication": "2021 Aug", "monthOfPublication": 8, "yearOfPublication": 2021, "journal": {"medlineAbbreviation": "Intensive Care Med", "title": "Intensive care medicine", "essn": "1432-1238", "issn": "0342-4642", "nlmid": "7704851", "isoabbreviation": "Intensive Care Med"}, "printPublicationDate": "2021-08-01"}, "pubYear": "2021", "pageInfo": "835-850", "abstractText": "Acute kidney injury (AKI) is now recognized as a heterogeneous syndrome that not only affects acute morbidity and mortality, but also a patient's long-term prognosis. In this narrative review, an update on various aspects of AKI in critically ill patients will be provided. Focus will be on prediction and early detection of AKI (e.g., the role of biomarkers to identify high-risk patients and the use of machine learning to predict AKI), aspects of pathophysiology and progress in the recognition of different phenotypes of AKI, as well as an update on nephrotoxicity and organ cross-talk. In addition, prevention of AKI (focusing on fluid management, kidney perfusion pressure, and the choice of vasopressor) and supportive treatment of AKI is discussed. Finally, post-AKI risk of long-term sequelae including incident or progression of chronic kidney disease, cardiovascular events and mortality, will be addressed.", "affiliation": "Department of Intensive Care, Radboud University Medical Centre, PO Box 9101, NL 6500 HB, Nijmegen, The Netherlands.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["review-article", "Review", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Kidney"}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "Y", "descriptorName": "Critical Illness"}, {"majorTopic_YN": "N", "descriptorName": "Prognosis"}, {"majorTopic_YN": "Y", "descriptorName": "Acute Kidney Injury", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DI", "qualifierName": "diagnosis"}, {"majorTopic_YN": "N", "abbreviation": "ET", "qualifierName": "etiology"}, {"majorTopic_YN": "N", "abbreviation": "TH", "qualifierName": "therapy"}]}}, {"majorTopic_YN": "N", "descriptorName": "Biomarkers"}]}, "keywordList": {"keyword": ["Heterogeneity", "Diagnosis", "Nephrotoxicity", "Phenotypes", "Biomarkers", "Pathophysiology", "Acute Kidney Injury", "Machine Learning", "Fluid Therapy", "Blood Pressure Management", "Vasopressor", "Long-term Consequences", "Organ Cross-talk"]}, "chemicalList": {"chemical": [{"name": "Biomarkers", "registryNumber": "0"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Unpaywall", "url": "https://escholarship.org/uc/item/6q2320x5"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1007/s00134-021-06454-7"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC8249842"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC8249842?pdf=render"}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 421, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "Y", "hasLabsLinks": "Y", "hasData": "Y", "license": "cc by-nc", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["nct"]}, "dateOfCompletion": "2021-08-09", "dateOfCreation": "2021-07-02", "dateOfRevision": "2021-08-09", "electronicPublicationDate": "2021-07-02", "firstPublicationDate": "2021-07-02", "firstIndexDate": "2021-07-03", "fullTextReceivedDate": "2025-02-04", "hasEval