: "0000-0002-1790-2719"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "1 Julius Center for Health Sciences and Primary Care, University Medical Center Utrecht, Utrecht, The Netherlands."}, {"affiliation": "2 Cochrane Netherlands, University Medical Center Utrecht, Utrecht, The Netherlands."}]}}, {"fullName": "Damen JA", "lastName": "Damen", "firstName": "Johanna Aag", "initials": "JA", "authorId": {"type": "ORCID", "value": "0000-0001-7401-4593"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "1 Julius Center for Health Sciences and Primary Care, University Medical Center Utrecht, Utrecht, The Netherlands."}, {"affiliation": "2 Cochrane Netherlands, University Medical Center Utrecht, Utrecht, The Netherlands."}]}}, {"fullName": "Riley RD", "lastName": "Riley", "firstName": "Richard D", "initials": "RD", "authorId": {"type": "ORCID", "value": "0000-0001-8699-0735"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "3 Research Institute for Primary Care and Health Sciences, Keele University, Staffordshire, UK."}]}}, {"fullName": "Snell K", "lastName": "Snell", "firstName": "Kym", "initials": "K", "authorId": {"type": "ORCID", "value": "0000-0001-9373-6591"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "3 Research Institute for Primary Care and Health Sciences, Keele University, Staffordshire, UK."}]}}, {"fullName": "Reitsma JB", "lastName": "Reitsma", "firstName": "Johannes B", "initials": "JB", "authorId": {"type": "ORCID", "value": "0000-0003-4026-4345"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "1 Julius Center for Health Sciences and Primary Care, University Medical Center Utrecht, Utrecht, The Netherlands."}, {"affiliation": "2 Cochrane Netherlands, University Medical Center Utrecht, Utrecht, The Netherlands."}]}}, {"fullName": "Hooft L", "lastName": "Hooft", "firstName": "Lotty", "initials": "L", "authorId": {"type": "ORCID", "value": "0000-0002-7950-2980"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "1 Julius Center for Health Sciences and Primary Care, University Medical Center Utrecht, Utrecht, The Netherlands."}, {"affiliation": "2 Cochrane Netherlands, University Medical Center Utrecht, Utrecht, The Netherlands."}]}}, {"fullName": "Collins GS", "lastName": "Collins", "firstName": "Gary S", "initials": "GS", "authorId": {"type": "ORCID", "value": "0000-0002-2772-2316"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "4 Centre for Statistics in Medicine, University of Oxford, Oxford, UK."}]}}, {"fullName": "Moons KG", "lastName": "Moons", "firstName": "Karel Gm", "initials": "KG", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "1 Julius Center for Health Sciences and Primary Care, University Medical Center Utrecht, Utrecht, The Netherlands."}, {"affiliation": "2 Cochrane Netherlands, University Medical Center Utrecht, Utrecht, The Netherlands."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-7401-4593"}, {"type": "ORCID", "value": "0000-0001-8699-0735"}, {"type": "ORCID", "value": "0000-0001-9373-6591"}, {"type": "ORCID", "value": "0000-0002-1790-2719"}, {"type": "ORCID", "value": "0000-0002-2772-2316"}, {"type": "ORCID", "value": "0000-0002-7950-2980"}, {"type": "ORCID", "value": "0000-0003-4026-4345"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "9", "volume": "28", "journalIssueId": 2854680, "dateOfPublication": "2019 Sep", "monthOfPublication": 9, "yearOfPublication": 2019, "journal": {"medlineAbbreviation": "Stat Methods Med Res", "title": "Statistical methods in medical research", "essn": "1477-0334", "issn": "0962-2802", "nlmid": "9212457", "isoabbreviation": "Stat Methods Med Res"}, "printPublicationDate": "2019-09-01"}, "pubYear": "2019", "pageInfo": "2768-2786", "abstractText": "It is widely recommended that any developed-diagnostic or prognostic-prediction model is externally validated in terms of its predictive performance measured by calibration and discrimination. When multiple validations have been performed, a systematic review followed by a formal meta-analysis helps to summarize overall performance across multiple settings, and reveals under which circumstances the model performs suboptimal (alternative poorer) and may need adjustment. We discuss how to undertake meta-analysis of the performance of prediction models with either a binary or a time-to-event outcome. We address how to deal with incomplete availability of study-specific results (performance estimates and their precision), and how to produce summary estimates of the <i>c</i>-statistic, the observed:expected ratio and the calibration slope. Furthermore, we discuss the implementation of frequentist and Bayesian meta-analysis methods, and propose novel empirically-based prior distributions to improve estimation of between-study heterogeneity in small samples. Finally, we illustrate all methods using two examples: meta-analysis of the predictive performance of EuroSCORE II and of the Framingham Risk Score. All examples and meta-analysis models have been implemented in our newly developed R package \"metamisc\".", "affiliation": "1 Julius Center for Health Sciences and Primary Care, University Medical Center Utrecht, Utrecht, The Netherlands.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Cochrane Methods Innovation Funds Round 2", "grantId": "MTH001F", "orderIn": 0}, {"agency": "Cancer Research UK", "acronym": "CRUK_", "grantId": "16895", "orderIn": 0}, {"agency": "Cancer Research UK", "acronym": "CRUK_", "grantId": "27294", "orderIn": 0}, {"agency": "Dutch Research Council (NWO)", "grantId": "91617050", "orderIn": 0}]}, "meshHeadingList": {"