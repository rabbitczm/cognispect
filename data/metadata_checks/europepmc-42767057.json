"authorAffiliation": [{"affiliation": "Purdue University, West Lafayette, IN, USA. Electronic address: zhan5041@purdue.edu."}]}}, {"fullName": "Yuile AR", "lastName": "Yuile", "firstName": "Amanda Rose", "initials": "AR", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "MGH Institute of Health Professions, Boston, MA, USA."}]}}, {"fullName": "Deevy P", "lastName": "Deevy", "firstName": "Patricia", "initials": "P", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Purdue University, West Lafayette, IN, USA."}]}}, {"fullName": "Leonard LB", "lastName": "Leonard", "firstName": "Laurence B", "initials": "LB", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Purdue University, West Lafayette, IN, USA."}]}}, {"fullName": "Borovsky A", "lastName": "Borovsky", "firstName": "Arielle", "initials": "A", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Purdue University, West Lafayette, IN, USA. Electronic address: borovsky@purdue.edu."}]}}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"volume": "274", "journalIssueId": 4286148, "dateOfPublication": "2027 Feb", "monthOfPublication": 2, "yearOfPublication": 2027, "journal": {"medlineAbbreviation": "J Exp Child Psychol", "title": "Journal of experimental child psychology", "essn": "1096-0457", "issn": "0022-0965", "nlmid": "2985128R", "isoabbreviation": "J Exp Child Psychol"}, "printPublicationDate": "2027-02-01"}, "pubYear": "2027", "pageInfo": "106669", "abstractText": "Prediction is an important component of language comprehension, and language users may pre-activate multiple possible lexical continuations to different degrees. However, it remains unclear whether children with developmental language disorder (DLD) generate graded predictions and recover from prediction violations in the same way as their typically developing (TD) peers. The present study investigated graded lexical activation during real-time comprehension of sentences with unexpected endings in preschool-aged children with developmental language disorder (N = 34) and age-matched typically developing (TD) children (N = 41) using a visual-world eye-tracking paradigm. Children listened to transitive sentences in which the verb supported a locally coherent but globally unpredictable continuation (e.g., \"The pirate chases the CAT\"; action-related condition) or an unrelated continuation (e.g., \"The pirate chases the BONES\"; unrelated condition), while viewing corresponding images. Both children with TD and DLD generated graded predictions with anticipatory fixations to action-related referents prior to theme onset. In contrast, the TD group showed more sustained benefits from the action-related condition than the DLD group following the theme onset. These findings suggest that early differences in DLD may arise not from impaired prediction generation, but from reduced ability to maintain and use updated semantic representations over time.", "affiliation": "Purdue University, West Lafayette, IN, USA. Electronic address: zhan5041@purdue.edu.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "NIDCD NIH HHS", "acronym": "DC", "grantId": "R01 DC014708", "orderIn": 0}, {"agency": "NIDCD NIH HHS", "acronym": "DC", "grantId": "R01 DC018593", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "Y", "descriptorName": "Language Development Disorders", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "PP", "qualifierName": "physiopathology"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Comprehension", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "PH", "qualifierName": "physiology"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Speech Perception", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "PH", "qualifierName": "physiology"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Semantics"}, {"majorTopic_YN": "N", "descriptorName": "Child, Preschool"}, {"majorTopic_YN": "N", "descriptorName": "Female"}, {"majorTopic_YN": "N", "descriptorName": "Male"}, {"majorTopic_YN": "Y", "descriptorName": "Anticipation, Psychological", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "PH", "qualifierName": "physiology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Eye-Tracking Technology"}]}, "keywordList": {"keyword": ["Prediction", "Eye Tracking", "Sentence Processing", "Dld", "Semantic Violation"]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1016/j.jecp.2026.106669"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC13685431"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC13685431?pdf=render"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1016/j.jecp.2026.106669"}]}, "isOpenAccess": "N", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 0, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "Y", "hasLabsLinks": "N", "hasData": "Y", "authMan": "Y", "epmcAuthMan": "N", "nihAuthMan": "Y", "manuscriptId": "NIHMS2212493", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["doi"]}, "dateOfCompletion": "2026-10-07", "dateOfCreation": "2026-09-21", "dateOfRevision": "2026-10-22", "electronicPublicationDate": "2026-09-21", "firstPublication