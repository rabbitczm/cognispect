ials": "S", "authorId": {"type": "ORCID", "value": "0000-0002-0861-9743"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "AI Center for Precision Health, Weill Cornell Medicine-Qatar, Doha, Qatar."}]}}, {"fullName": "Damseh R", "lastName": "Damseh", "firstName": "Rafat", "initials": "R", "authorId": {"type": "ORCID", "value": "0000-0001-6797-0448"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Computer Science and Software Engineering, United Arab Emirates University, Abu Dhabi, United Arab Emirates."}]}}, {"fullName": "Alabed Alrazak S", "lastName": "Alabed Alrazak", "firstName": "Sadam", "initials": "S", "authorId": {"type": "ORCID", "value": "0000-0002-8586-7564"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Mechanical & Industrial Engineering, Faculty of Applied Science and Engineering, University of Toronto, Toronto, ON, Canada."}]}}, {"fullName": "Sheikh J", "lastName": "Sheikh", "firstName": "Javaid", "initials": "J", "authorId": {"type": "ORCID", "value": "0000-0002-5762-4186"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "AI Center for Precision Health, Weill Cornell Medicine-Qatar, Doha, Qatar."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5038-3044"}, {"type": "ORCID", "value": "0000-0001-6797-0448"}, {"type": "ORCID", "value": "0000-0001-7695-4626"}, {"type": "ORCID", "value": "0000-0002-0861-9743"}, {"type": "ORCID", "value": "0000-0002-3235-0860"}, {"type": "ORCID", "value": "0000-0002-4025-5767"}, {"type": "ORCID", "value": "0000-0002-5762-4186"}, {"type": "ORCID", "value": "0000-0002-5804-0342"}, {"type": "ORCID", "value": "0000-0002-8586-7564"}, {"type": "ORCID", "value": "0000-0003-0505-609X"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"volume": "9", "journalIssueId": 3579593, "dateOfPublication": "2023 Jun", "monthOfPublication": 6, "yearOfPublication": 2023, "journal": {"medlineAbbreviation": "JMIR Med Educ", "title": "JMIR medical education", "essn": "2369-3762", "issn": "2369-3762", "nlmid": "101684518", "isoabbreviation": "JMIR Med Educ"}, "printPublicationDate": "2023-06-01"}, "pubYear": "2023", "pageInfo": "e48291", "abstractText": "The integration of large language models (LLMs), such as those in the Generative Pre-trained Transformers (GPT) series, into medical education has the potential to transform learning experiences for students and elevate their knowledge, skills, and competence. Drawing on a wealth of professional and academic experience, we propose that LLMs hold promise for revolutionizing medical curriculum development, teaching methodologies, personalized study plans and learning materials, student assessments, and more. However, we also critically examine the challenges that such integration might pose by addressing issues of algorithmic bias, overreliance, plagiarism, misinformation, inequity, privacy, and copyright concerns in medical education. As we navigate the shift from an information-driven educational paradigm to an artificial intelligence (AI)-driven educational paradigm, we argue that it is paramount to understand both the potential and the pitfalls of LLMs in medical education. This paper thus offers our perspective on the opportunities and challenges of using LLMs in this context. We believe that the insights gleaned from this analysis will serve as a foundation for future recommendations and best practices in the field, fostering the responsible and effective use of AI technologies in medical education.", "affiliation": "AI Center for Precision Health, Weill Cornell Medicine-Qatar, Doha, Qatar.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "keywordList": {"keyword": ["Artificial intelligence", "Students", "Medical education", "Educators", "Generative Ai", "Large Language Models", "Chatgpt", "Gpt-4"]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Unpaywall", "url": "https://mededu.jmir.org/2023/1/e48291/PDF"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.2196/48291"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC10273039"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC10273039?pdf=render"}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 305, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "Y", "hasLabsLinks": "Y", "hasData": "Y", "license": "cc by", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["doi"]}, "dateOfCreation": "2023-06-01", "dateOfRevision": "2023-06-19", "electronicPublicationDate": "2023-06-01", "firstPublicationDate": "2023-06-01", "firstIndexDate": "2023-06-03", "fullTextReceivedDate": "2025-02-04", "hasEvaluations": "N"}]}}