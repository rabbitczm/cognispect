nDetailsList": {"authorAffiliation": [{"affiliation": "European Molecular Biology Laboratory, European Bioinformatics Institute (EMBL-EBI), Cambridge, UK.", "affiliationOrgId": "ror.org/02catss52"}, {"affiliation": "Institute of Computational Biology, Helmholtz Zentrum München, Munich, Germany."}]}}, {"fullName": "Lun ATL", "lastName": "Lun", "firstName": "Aaron T L", "initials": "ATL", "authorId": {"type": "ORCID", "value": "0000-0002-3564-4813"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Cancer Research UK Cambridge Institute, University of Cambridge, Cambridge, UK."}]}}, {"fullName": "Morgan MD", "lastName": "Morgan", "firstName": "Michael D", "initials": "MD", "authorId": {"type": "ORCID", "value": "0000-0003-0757-0711"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Wellcome Trust Sanger Institute, Cambridge, UK."}]}}, {"fullName": "Marioni JC", "lastName": "Marioni", "firstName": "John C", "initials": "JC", "authorId": {"type": "ORCID", "value": "0000-0001-9092-0852"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "European Molecular Biology Laboratory, European Bioinformatics Institute (EMBL-EBI), Cambridge, UK.", "affiliationOrgId": "ror.org/02catss52"}, {"affiliation": "Cancer Research UK Cambridge Institute, University of Cambridge, Cambridge, UK."}, {"affiliation": "Wellcome Trust Sanger Institute, Cambridge, UK."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-9092-0852"}, {"type": "ORCID", "value": "0000-0001-9280-9170"}, {"type": "ORCID", "value": "0000-0002-3564-4813"}, {"type": "ORCID", "value": "0000-0003-0757-0711"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data", "wikipedia"]}, "journalInfo": {"issue": "5", "volume": "36", "journalIssueId": 2681639, "dateOfPublication": "2018 Jun", "monthOfPublication": 6, "yearOfPublication": 2018, "journal": {"medlineAbbreviation": "Nat Biotechnol", "title": "Nature biotechnology", "essn": "1546-1696", "issn": "1087-0156", "isoabbreviation": "Nat Biotechnol", "nlmid": "9604648"}, "printPublicationDate": "2018-06-01"}, "pubYear": "2018", "pageInfo": "421-427", "abstractText": "Large-scale single-cell RNA sequencing (scRNA-seq) data sets that are produced in different laboratories and at different times contain batch effects that may compromise the integration and interpretation of the data. Existing scRNA-seq analysis methods incorrectly assume that the composition of cell populations is either known or identical across batches. We present a strategy for batch correction based on the detection of mutual nearest neighbors (MNNs) in the high-dimensional expression space. Our approach does not rely on predefined or equal population compositions across batches; instead, it requires only that a subset of the population be shared between batches. We demonstrate the superiority of our approach compared with existing methods by using both simulated and real scRNA-seq data sets. Using multiple droplet-based scRNA-seq data sets, we demonstrate that our MNN batch-effect-correction method can be scaled to large numbers of cells.", "affiliation": "European Molecular Biology Laboratory, European Bioinformatics Institute (EMBL-EBI), Cambridge, UK.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Wellcome Trust", "acronym": "WT_", "orderIn": 0}, {"agency": "Wellcome Trust", "grantId": "105045/Z/14/Z", "orderIn": 0}, {"agency": "Cancer Research UK", "acronym": "CRUK_", "grantId": "22231", "orderIn": 0}, {"agency": "Wellcome Trust", "grantId": "108437", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Cluster Analysis"}, {"majorTopic_YN": "N", "descriptorName": "Sequence Analysis, RNA", "meshQualifierList": {"meshQualifier": [{"majorTopic_