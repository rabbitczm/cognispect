ame": "Qiu W", "lastName": "Qiu", "firstName": "Wu", "initials": "W", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Robarts Research Institute, Canada."}]}}, {"fullName": "Gao Q", "lastName": "Gao", "firstName": "Qinquan", "initials": "Q", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Imperial College London, England, United Kingdom."}]}}, {"fullName": "Edwards PE", "lastName": "Edwards", "firstName": "Philip Eddie", "initials": "PE", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Imperial College London, England, United Kingdom."}]}}, {"fullName": "Maan B", "lastName": "Maan", "firstName": "Bianca", "initials": "B", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "University of Twente, The Netherlands."}]}}, {"fullName": "van der Heijden F", "lastName": "van der Heijden", "firstName": "Ferdinand", "initials": "F", "authorId": {"type": "ORCID", "value": "0000-0001-8065-8053"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "University of Twente, The Netherlands."}]}}, {"fullName": "Ghose S", "lastName": "Ghose", "firstName": "Soumya", "initials": "S", "authorId": {"type": "ORCID", "value": "0000-0002-2730-1482"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Commonwealth Scientific and Industrial Research Organisation, Australia; Université de Bourgogne, France; Universitat de Girona, Spain."}]}}, {"fullName": "Mitra J", "lastName": "Mitra", "firstName": "Jhimli", "initials": "J", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Commonwealth Scientific and Industrial Research Organisation, Australia; Université de Bourgogne, France; Universitat de Girona, Spain."}]}}, {"fullName": "Dowling J", "lastName": "Dowling", "firstName": "Jason", "initials": "J", "authorId": {"type": "ORCID", "value": "0000-0001-9349-2275"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Commonwealth Scientific and Industrial Research Organisation, Australia."}]}}, {"fullName": "Barratt D", "lastName": "Barratt", "firstName": "Dean", "initials": "D", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "University College London, England, United Kingdom."}]}}, {"fullName": "Huisman H", "lastName": "Huisman", "firstName": "Henkjan", "initials": "H", "authorId": {"type": "ORCID", "value": "0000-0001-6753-3221"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Radboud University Nijmegen Medical Centre, The Netherlands."}]}}, {"fullName": "Madabhushi A", "lastName": "Madabhushi", "firstName": "Anant", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0002-5741-0399"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Case Western Reserve University, USA."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-6753-3221"}, {"type": "ORCID", "value": "0000-0001-7764-1787"}, {"type": "ORCID", "value": "0000-0001-8065-8053"}, {"type": "ORCID", "value": "0000-0001-9349-2275"}, {"type": "ORCID", "value": "0000-0002-1025-8561"}, {"type": "ORCID", "value": "0000-0002-2730-1482"}, {"type": "ORCID", "value": "0000-0002-5741-0399"}, {"type": "ORCID", "value": "0000-0002-7726-6208"}, {"type": "ORCID", "value": "0000-0003-1174-9829"}, {"type": "ORCID", "value": "0000-0003-1554-1291"}, {"type": "ORCID", "value": "0000-0003-2028-8972"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics"]}, "journalInfo": {"issue": "2", "volume": "18", "journalIssueId": 2125937, "dateOfPublication": "2014 Feb", "monthOfPublication": 2, "yearOfPublication": 2014, "journal": {"medlineAbbreviation": "Med Image Anal", "title": "Medical image analysis", "essn": "1361-8423", "issn": "1361-8415", "nlmid": "9713490", "isoabbreviation": "Med Image Anal"}, "printPublicationDate": "2014-02-01"}, "pubYear": "2014", "pageInfo": "359-373", "abstractText": "Prostate MRI image segmentation has been an area of intense research due to the increased use of MRI as a modality for the clinical workup of prostate cancer. Segmentation is useful for various tasks, e.g. to accurately localize prostate boundaries for radiotherapy or to initialize multi-modal registration algorithms. In the past, it has been difficult for research groups to evaluate prostate segmentation algorithms on multi-center, multi-vendor and multi-protocol data. Especially because we are dealing with MR images, image appearance, resolution and the presence of artifacts are affected by differences in scanners and/or protocols, which in turn can have a large influence on algorithm accuracy. The Prostate MR Image Segmentation (PROMISE12) challenge was setup to allow a fair and meaningful comparison of segmentation methods on the basis of performance and robustness. In this work we will discuss the initial results of the online PROMISE12 challenge, and the results obtained in the live challenge workshop hosted by the MICCAI2012 conference. In the challenge, 100 prostate MR cases from 4 different centers were included, with differences in scanner manufacturer, field strength and protocol. A total of 11 teams from academic research groups and industry participated. Algorithms showed a wide variety in methods and implementation, including active appearance models, atlas registration and level sets. Evaluation was performed using boundary and volume based metrics which were combined into a single score relating the metrics to human expert performance. The winners of the challenge where the algorithms by teams Imorphics and ScrAutoProstate, with scores of 85.72 and 84.29 overall. Both algorithms where significantly better than all other algorithms in the challenge (p<0.05) and had an efficient implementation with a run time of 8min and 3s per case respectively. Overall, active appearance model based approaches seemed to outperform other approaches like multi-atlas registration, both on accuracy and computation time. Although average algorithm performance was good to excellent and the Imorphics algorithm outperformed the second observer on average, we showed that algorithm combination might lead to further improvement, indicating that optimal performance for prostate segmentation is not yet obtained. All results are available online at http://promise12.grand-challenge.org/.", "affiliation": "Radboud University Nijmegen Medical Centre, The Netherlands. Electronic address: g.litjens@rad.umcn.nl.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Multicenter Study", "Evaluation Study", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NIBIB NIH HHS", "acronym": "EB", "grantId": "R43EB015199-01", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01 CA140772", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01 CA136535", "orderIn": 0}, {"agency": "NIBIB NIH HHS", "acronym": "EB", "grantId": "R43 EB015199", "orderIn": 0}, {"agency": "National Science Foundation", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01CA140772-01", "orderIn": 0}, {"agency": "National Cancer Institute of the National Institutes of Health", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R21 CA167811", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R21 CA179327", "orderIn": 0}, {"agency": "National Institute of Biomedical Imaging and Bioengineering of the National Institutes of Health", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01CA136535-01", "orderIn": 0}, {"agency": "Dutch Cancer Society", "grantId": "KUN2007-3971", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R21CA167811-01", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {