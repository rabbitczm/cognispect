002-5210-0770"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Clinical Medical College, Southwest Medical University, Luzhou, China."}]}}, {"fullName": "Xie X", "lastName": "Xie", "firstName": "Xixi", "initials": "X", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "School of Stomatology, Southwest Medical University, Luzhou, China."}]}}, {"fullName": "Yan Y", "lastName": "Yan", "firstName": "Yingjie", "initials": "Y", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Plastic and Reconstructive Surgery, Shanghai Ninth People's Hospital Affiliated to Shanghai Jiaotong University School of Medicine, Shanghai, China."}]}}, {"fullName": "Peng G", "lastName": "Peng", "firstName": "Gaoge", "initials": "G", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Clinical Medical College, Southwest Medical University, Luzhou, China."}]}}, {"fullName": "Strohmer DF", "lastName": "Strohmer", "firstName": "Dorothee Franziska", "initials": "DF", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of General, Visceral, and Transplant Surgery, Ludwig-Maximilians-University Munich, Munich, Germany."}]}}, {"fullName": "Lai G", "lastName": "Lai", "firstName": "Guichuan", "initials": "G", "authorId": {"type": "ORCID", "value": "0000-0003-2857-7867"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Epidemiology and Health Statistics, School of Public Health, Chongqing Medical University, Chongqing, China."}]}}, {"fullName": "Zhao S", "lastName": "Zhao", "firstName": "Songyun", "initials": "S", "authorId": {"type": "ORCID", "value": "0000-0003-0542-1085"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Neurosurgery, Wuxi People's Hospital Affiliated to Nanjing Medical University, Wuxi, China."}]}}, {"fullName": "Xia Z", "lastName": "Xia", "firstName": "Zhijia", "initials": "Z", "authorId": {"type": "ORCID", "value": "0000-0003-1974-4360"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of General, Visceral, and Transplant Surgery, Ludwig-Maximilians-University Munich, Munich, Germany."}]}}, {"fullName": "Tian G", "lastName": "Tian", "firstName": "Gang", "initials": "G", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Laboratory Medicine, The Affiliated Hospital of Southwest Medical University, Luzhou, China."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-5210-0770"}, {"type": "ORCID", "value": "0000-0003-0542-1085"}, {"type": "ORCID", "value": "0000-0003-1974-4360"}, {"type": "ORCID", "value": "0000-0003-2857-7867"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"volume": "13", "journalIssueId": 3304879, "dateOfPublication": "2022 ", "monthOfPublication": 0, "yearOfPublication": 2022, "journal": {"medlineAbbreviation": "Front Immunol", "title": "Frontiers in immunology", "essn": "1664-3224", "issn": "1664-3224", "nlmid": "101560960", "isoabbreviation": "Front Immunol"}, "printPublicationDate": "2022-01-01"}, "pubYear": "2022", "pageInfo": "1018685", "abstractText": "<h4>Background</h4>Head and neck squamous cell carcinoma (HNSCC), the most common head and neck cancer, is highly aggressive and heterogeneous, resulting in variable prognoses and immunotherapeutic outcomes. Natural killer (NK) cells play essential roles in malignancies' development, diagnosis, and prognosis. The purpose of this study was to establish a reliable signature based on genes related to NK cells (NRGs), thus providing a new perspective for assessing immunotherapy response and prognosis of HNSCC patients.<h4>Methods</h4>In this study, NRGs were used to classify HNSCC from the TCGA-HNSCC and GEO cohorts. The genes were evaluated using univariate cox regression analysis based on the differential analysis of normal and tumor samples in TCGA-HNSCC conducted using the \"limma\" R package. Thereafter, we built prognostic gene signatures using LASSO-COX analysis. External validation was carried out in the GSE41613 cohort. Immunity analysis based on NRGs was performed <i>via</i> several methods, such as CIBERSORT, and immunotherapy response was evaluated by TIP portal website.<h4>Results</h4>With the TCGA-HNSCC data, we established a nomogram based on the 17-NRGs signature and a variety of clinicopathological characteristics. The low-risk group exhibited a better effect when it came to immunotherapy.<h4>Conclusions</h4>17-NRGs signature and nomograms demonstrate excellent predictive performance and offer new perspectives for assessing pre-immune efficacy, which will facilitate future precision immuno-oncology research.", "affiliation": "Clinical Medical College, Southwest Medical University, Luzhou, China.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic-eCollection", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Southwest Medical University", "grantId": "No.2020XSJG-C01-21", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Killer Cells, Natural"}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "Y", "descriptorName": "Head and Neck Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DI", "qualifierName": "diagnosis"}, {"majorTopic_YN": "N", "abbreviation": "GE", "qualifierName": "genetics"}, {"majorTopic_YN": "N", "abbreviation": "TH", "qualifierName": "therapy"}]}}, {"majorTopic_YN": "N", "descriptorName": "Prognosis"}, {"majorTopic_YN": "N", "descriptorName": "Nomograms"}, {"majorTopic_YN": "N", "descriptorName": "Squamous Cell Carcinoma of Head and Neck", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "GE", "qualifierName": "genetics"}, {"majorTopic_YN": "N", "abbreviation": "TH", "qualifierName": "therapy"}]}}]}, "keywordList": {"keyword": ["Immunotherapy", "Natural killer cell", "Tumor Microenvironment", "Hnscc", "Prognostic Signature"]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Unpaywall", "url": "https://www.frontiersin.org/articles/10.3389/fimmu.2022.1018685/pdf"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.3389/fimmu.2022.1018685"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC9575041"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC9575041?pdf=render"}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 123, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "Y", "hasLabsLinks": "Y", "hasData": "Y", "license": "cc by", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["geo", "doi"]}, "dateOfCompletion": "2022-10-21", "dateOfCreation": "2022-10-20", "dateOfRevision": "2022-10-24", "electronicPublicationDate": "2022-10-03", "firstPublicationDate": "2022-10-03", "firstIndexDate": "2022-10-20", "fullTextReceivedDate": "2022-10-20", "hasEvaluations": "N"}]}}