ion": "Department of Radiation Oncology, Dana-Farber Cancer Institute, Harvard Medical School, Boston, MA, USA."}]}}, {"fullName": "Parmar C", "lastName": "Parmar", "firstName": "Chintan", "initials": "C", "authorId": {"type": "ORCID", "value": "0000-0002-2140-814X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiation Oncology, Dana-Farber Cancer Institute, Harvard Medical School, Boston, MA, USA."}]}}, {"fullName": "Quackenbush J", "lastName": "Quackenbush", "firstName": "John", "initials": "J", "authorId": {"type": "ORCID", "value": "0000-0002-2702-5879"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Biostatistics & Computational Biology, Dana-Farber Cancer Institute, Boston, MA, USA."}, {"affiliation": "Department of Cancer Biology, Dana-Farber Cancer Institute, Boston, MA, USA."}]}}, {"fullName": "Schwartz LH", "lastName": "Schwartz", "firstName": "Lawrence H", "initials": "LH", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Columbia University College of Physicians and Surgeons, New York, NY, USA."}, {"affiliation": "Department of Radiology, New York Presbyterian Hospital, New York, NY, USA."}]}}, {"fullName": "Aerts HJWL", "lastName": "Aerts", "firstName": "Hugo J W L", "initials": "HJWL", "authorId": {"type": "ORCID", "value": "0000-0002-2122-2003"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiation Oncology, Dana-Farber Cancer Institute, Harvard Medical School, Boston, MA, USA. Hugo_Aerts@dfci.harvard.edu."}, {"affiliation": "Department of Radiology, Dana-Farber Cancer Institute, Brigham and Women's Hospital, Harvard Medical School, Boston, MA, USA. Hugo_Aerts@dfci.harvard.edu."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-1844-481X"}, {"type": "ORCID", "value": "0000-0002-2122-2003"}, {"type": "ORCID", "value": "0000-0002-2140-814X"}, {"type": "ORCID", "value": "0000-0002-2702-5879"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "8", "volume": "18", "journalIssueId": 2709723, "dateOfPublication": "2018 Aug", "monthOfPublication": 8, "yearOfPublication": 2018, "journal": {"medlineAbbreviation": "Nat Rev Cancer", "title": "Nature reviews. Cancer", "essn": "1474-1768", "issn": "1474-175X", "isoabbreviation": "Nat Rev Cancer", "nlmid": "101124168"}, "printPublicationDate": "2018-08-01"}, "pubYear": "2018", "pageInfo": "500-510", "abstractText": "Artificial intelligence (AI) algorithms, particularly deep learning, have demonstrated remarkable progress in image-recognition tasks. Methods ranging from convolutional neural networks to variational autoencoders have found myriad applications in the medical image analysis field, propelling it forward at a rapid pace. Historically, in radiology practice, trained physicians visually assessed medical images for the detection, characterization and monitoring of diseases. AI methods excel at automatically recognizing complex patterns in imaging data and providing quantitative, rather than qualitative, assessments of radiographic characteristics. In this Opinion article, we establish a general understanding of AI methods, particularly those pertaining to image-based tasks. We explore how these methods could impact multiple facets of radiology, with a general focus on applications in oncology, and demonstrate ways in which these methods are advancing the field. Finally, we discuss the challenges facing clinical implementation and provide our perspective on how the domain could be advanced.", "affiliation": "Department of Radiation Oncology, Dana-Farber Cancer Institute, Harvard Medical School, Boston, MA, USA.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["research-article", "Review", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant"