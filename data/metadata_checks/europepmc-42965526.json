orId": {"type": "ORCID", "value": "0000-0001-7715-1825"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiation Oncology, Ziv Medical Center, Safed, Israel."}, {"affiliation": "Faculty of Health Sciences, Ben-Gurion University of the Negev, Be'er Sheva, Israel."}]}}, {"fullName": "Hijab A", "lastName": "Hijab", "firstName": "Adham", "initials": "A", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiation Oncology, Ziv Medical Center, Safed, Israel."}]}}, {"fullName": "Zabit R", "lastName": "Zabit", "firstName": "Reem", "initials": "R", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Pediatrics, Ziv Medical Center, Safed, Israel."}]}}, {"fullName": "Zidan J", "lastName": "Zidan", "firstName": "Jamal", "initials": "J", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Oncology, Ziv Medical Center, Safed, Israel."}]}}, {"fullName": "Wiesel O", "lastName": "Wiesel", "firstName": "Ory", "initials": "O", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Baruch Padeh-Tzafon Medical Center, Poriya, Israel."}]}}, {"fullName": "Peled N", "lastName": "Peled", "firstName": "Nir", "initials": "N", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Helmsley Cancer Center, Shaare Zedek Medical Center, Jerusalem, Israel."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-7715-1825"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "1", "volume": "15", "journalIssueId": 4079941, "dateOfPublication": "2026 Dec", "monthOfPublication": 12, "yearOfPublication": 2026, "journal": {"medlineAbbreviation": "Oncoimmunology", "title": "Oncoimmunology", "essn": "2162-402X", "issn": "2162-4011", "nlmid": "101570526", "isoabbreviation": "Oncoimmunology"}, "printPublicationDate": "2026-12-01"}, "pubYear": "2026", "pageInfo": "2756061", "abstractText": "Some patients with metastatic non-small-cell lung cancer (NSCLC) receiving anti-PD-1 or anti-PD-L1 immune checkpoint inhibitors (ICIs) progress at a few sites while disease elsewhere stays controlled, a pattern consistent with focal, oligo-acquired immune escape rather than systemic treatment failure. Ablating the escaping focus may eliminate the resistant clone and preserve an otherwise effective immunotherapy line. We performed a PRISMA 2020-compliant, PROSPERO-registered systematic review and meta-analysis of local ablative treatment (LAT) for oligoprogressive or oligo-resistant metastatic NSCLC during active ICI therapy, with continuation of the same immunotherapy line after LAT. MEDLINE, PubMed, Web of Science, Scopus, and the Cochrane Library were searched from inception to March 8, 2026. From 1270 records, 22 studies were included in the qualitative synthesis. Four studies, one randomized subgroup, and three retrospective cohorts contributed to each primary analysis. LAT-oriented management was associated with improved progression-free survival (PFS; pooled hazard ratio [HR] 0.45, 95% CI 0.33-0.62; 95% prediction interval [PI] 0.28-0.74; I<sup>2</sup> = 0%) and overall survival (OS; pooled HR 0.41, 95% CI 0.27-0.63; 95% PI 0.24-0.69; I<sup>2</sup> = 0%). PFS and OS estimates were consistent across sensitivity analyses, including the exclusion of the one PFS estimate measured to a second progression. The evidence is predominantly observational and of low certainty, reflecting the current absence of NSCLC-specific randomized trials. On this evidence, LAT, delivered predominantly as stereotactic body radiotherapy, may be considered a continuation-enabling option for carefully selected patients with focal progression on otherwise effective immunotherapy, pending ongoing randomized trials.", "affiliation": "Department of Radiation Oncology, Ziv Medical Center, Safed, Israel.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Meta-Analysis", "Systematic Review", "review-article", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "Y", "descriptorName": "Carcinoma, Non-Small-Cell Lung", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "IM", "qualifierName": "immunology"}, {"majorTopic_YN": "N", "abbreviation": "MO", "qualifierName": "mortality"}, {"majorTopic_YN": "N", "abbreviation": "PA", "qualifierName": "pathology"}, {"majorTopic_YN": "N", "abbreviation": "TH", "qualifierName": "therapy"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Lung Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "IM", "qualifierName": "immunology"}, {"majorTopic_YN": "N", "abbreviation": "MO", "qualifierName": "mortality"}, {"majorTopic_YN": "N", "abbreviation": "PA", "qualifierName": "pathology"}, {"majorTopic_YN": "N", "abbreviation": "TH", "qualifierName": "therapy"}]}}, {"majorTopic_YN": "N", "descriptorName": "Neoplasm Metastasis"}, {"majorTopic_YN": "N", "descriptorName": "Disease Progression"}, {"majorTopic_YN": "Y", "descriptorName": "Immunotherapy", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Immune Checkpoint Inhibitors", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "TU", "qualifierName": "therapeutic use"}]}}]}, "keywordList": {"keyword": ["Meta-analysis", "non-small-cell lung cancer", "Stereotactic Body Radiotherapy", "Immune Checkpoint Inhibitor", "Oligoprogression", "Local Ablative Treatment", "Oligo-acquired Resistance"]}, "chemicalList": {"chemical": [{"name": "Immune Checkpoint Inhibitors", "registryNumber": "0"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "av