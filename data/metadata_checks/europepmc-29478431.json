, "lastName": "Watson", "firstName": "Stuart", "initials": "S", "authorId": {"type": "ORCID", "value": "0000-0002-2558-3367"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Newcastle University,Newcastle Upon Tyne,UK."}]}}, {"fullName": "Friston KJ", "lastName": "Friston", "firstName": "Karl J", "initials": "KJ", "authorId": {"type": "ORCID", "value": "0000-0001-7984-8909"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "University College London,London,UK."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-7984-8909"}, {"type": "ORCID", "value": "0000-0002-2558-3367"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics"]}, "journalInfo": {"issue": "14", "volume": "48", "journalIssueId": 2724470, "dateOfPublication": "2018 Oct", "monthOfPublication": 10, "yearOfPublication": 2018, "journal": {"medlineAbbreviation": "Psychol Med", "title": "Psychological medicine", "essn": "1469-8978", "issn": "0033-2917", "isoabbreviation": "Psychol Med", "nlmid": "1254142"}, "printPublicationDate": "2018-10-01"}, "pubYear": "2018", "pageInfo": "2277-2284", "abstractText": "The neurobiological understanding of mood, and by extension mood disorders, remains elusive despite decades of research implicating several neuromodulator systems. This review considers a new approach based on existing theories of functional brain organisation. The free energy principle (a.k.a. active inference), and its instantiation in the Bayesian brain, offers a complete and simple formulation of mood. It has been proposed that emotions reflect the precision of - or certainty about - the predicted sensorimotor/interoceptive consequences of action. By extending this reasoning, in a hierarchical setting, we suggest mood states act as (hyper) priors over uncertainty (i.e. emotions). Here, we consider the same computational pathology in the proprioceptive and interoceptive (behavioural and autonomic) domain in order to furnish an explanation for mood disorders. This formulation reconciles several strands of research at multiple levels of enquiry.", "affiliation": "Newcastle University,Newcastle Upon Tyne,UK.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "review-article", "Review", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Wellcome Trust", "orderIn": 0}, {"agency": "Wellcome Trust", "grantId": "088130/Z/09/Z", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Brain", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "PH", "qualifierName": "physiology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Affect", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "PH", "qualifierName": "physiology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Mood Disorders", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "PP", "qualifierName": "physiopathology"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Models, Theoretical"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1017/S0033291718000430"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC6340107"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC6340107?pdf=render"}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 134, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks"