iliation": [{"affiliation": "Cooperative Medianet Innovation Center, Shanghai Jiao Tong University, 200240, Shanghai, China."}, {"affiliation": "Shanghai Artificial Intelligence Laboratory, 200232, Shanghai, China."}]}}, {"fullName": "Wu C", "lastName": "Wu", "firstName": "Chaoyi", "initials": "C", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Cooperative Medianet Innovation Center, Shanghai Jiao Tong University, 200240, Shanghai, China."}, {"affiliation": "Shanghai Artificial Intelligence Laboratory, 200232, Shanghai, China."}]}}, {"fullName": "Zhang Y", "lastName": "Zhang", "firstName": "Ya", "initials": "Y", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Cooperative Medianet Innovation Center, Shanghai Jiao Tong University, 200240, Shanghai, China."}, {"affiliation": "Shanghai Artificial Intelligence Laboratory, 200232, Shanghai, China."}]}}, {"fullName": "Xie W", "lastName": "Xie", "firstName": "Weidi", "initials": "W", "authorId": {"type": "ORCID", "value": "0009-0002-8609-6826"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Cooperative Medianet Innovation Center, Shanghai Jiao Tong University, 200240, Shanghai, China. weidi@sjtu.edu.cn."}, {"affiliation": "Shanghai Artificial Intelligence Laboratory, 200232, Shanghai, China. weidi@sjtu.edu.cn."}]}}, {"fullName": "Wang Y", "lastName": "Wang", "firstName": "Yanfeng", "initials": "Y", "authorId": {"type": "ORCID", "value": "0000-0002-3196-2347"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Cooperative Medianet Innovation Center, Shanghai Jiao Tong University, 200240, Shanghai, China. wangyanfeng@sjtu.edu.cn."}, {"affiliation": "Shanghai Artificial Intelligence Laboratory, 200232, Shanghai, China. wangyanfeng@sjtu.edu.cn."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-3196-2347"}, {"type": "ORCID", "value": "0000-0002-5390-9053"}, {"type": "ORCID", "value": "0000-0002-7696-9366"}, {"type": "ORCID", "value": "0009-0002-8609-6826"}]}, "journalInfo": {"issue": "1", "volume": "14", "journalIssueId": 3596496, "dateOfPublication": "2023 Jul", "monthOfPublication": 7, "yearOfPublication": 2023, "journal": {"medlineAbbreviation": "Nat Commun", "title": "Nature communications", "essn": "2041-1723", "issn": "2041-1723", "nlmid": "101528555", "isoabbreviation": "Nat Commun"}, "printPublicationDate": "2023-07-01"}, "pubYear": "2023", "pageInfo": "4542", "abstractText": "While multi-modal foundation models pre-trained on large-scale data have been successful in natural language understanding and vision recognition, their use in medical domains is still limited due to the fine-grained nature of medical tasks and the high demand for domain knowledge. To address this challenge, we propose an approach called Knowledge-enhanced Auto Diagnosis (KAD) which leverages existing medical domain knowledge to guide vision-language pre-training using paired chest X-rays and radiology reports. We evaluate KAD on four external X-ray datasets and demonstrate that its zero-shot performance is not only comparable to that of fully supervised models but also superior to the average of three expert radiologists for three (out of five) pathologies with statistical significance. Moreover, when few-shot annotation is available, KAD outperforms all existing approaches in fine-tuning settings, demonstrating its potential for application in different clinical scenarios.", "affiliation": "Cooperative Medianet Innovation Center, Shanghai Jiao Tong University, 200240, Shanghai, China.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Radiography"}, {"majorTopic_YN": "N", "descriptorName": "Language"}, {"majorTopic_YN": "Y", "descriptorName": "Radiology"}, {"majorTopic_YN": "Y", "descriptorName": "Knowledge"}, {"majorTopic_YN": "N", "descriptorName": "Radiologists"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Unpaywall", "url": "https://www.nature.com/articles/s41467-023-40260-7.pdf"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1038/s41467-023-40260-7"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC10382552"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC10382552?pdf=render"}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 82, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "Y", "hasLabsLinks": "N", "hasData": "Y", "license": "cc by", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "N", "dateOfCompletion": "2023-07-31", "dateOfCreation": "2023-07-28", "dateOfRevision": "2023-08-01", "electronicPublicationDate": "2023-07-28", "firstPublicationDate": "2023-07-28", "firstIndexDate": "2023-07-30", "fullTextReceivedDate": "2023-08-20", "hasEvaluations": "N"}]}}