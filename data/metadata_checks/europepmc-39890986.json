0-0002-4884-2544"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Medical Oncology, St Luke's Clinic, Panorama, Thessaloniki, Greece."}]}}, {"fullName": "Pearce T", "lastName": "Pearce", "firstName": "Tillman", "initials": "T", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "TCellCo, 415 De Haro Street, San Francisco, CA, USA."}]}}, {"fullName": "Baysal MA", "lastName": "Baysal", "firstName": "Mehmet A", "initials": "MA", "authorId": {"type": "ORCID", "value": "0000-0002-8446-6531"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Investigational Cancer Therapeutics, The University of Texas MD Anderson Cancer Center, 1515 Holcombe Blvd., Houston, TX, USA."}]}}, {"fullName": "Chakraborty A", "lastName": "Chakraborty", "firstName": "Abhijit", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0002-3822-5657"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Investigational Cancer Therapeutics, The University of Texas MD Anderson Cancer Center, 1515 Holcombe Blvd., Houston, TX, USA."}]}}, {"fullName": "Tsimberidou AM", "lastName": "Tsimberidou", "firstName": "Apostolia M", "initials": "AM", "authorId": {"type": "ORCID", "value": "0000-0003-2713-233X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Investigational Cancer Therapeutics, The University of Texas MD Anderson Cancer Center, 1515 Holcombe Blvd., Houston, TX, USA. atsimber@mdanderson.org."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-3822-5657"}, {"type": "ORCID", "value": "0000-0002-4884-2544"}, {"type": "ORCID", "value": "0000-0002-8446-6531"}, {"type": "ORCID", "value": "0000-0003-2713-233X"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "1", "volume": "8", "journalIssueId": 3878803, "dateOfPublication": "2025 Jan", "monthOfPublication": 1, "yearOfPublication": 2025, "journal": {"medlineAbbreviation": "NPJ Digit Med", "title": "NPJ digital medicine", "essn": "2398-6352", "issn": "2398-6352", "isoabbreviation": "NPJ Digit Med", "nlmid": "101731738"}, "printPublicationDate": "2025-01-01"}, "pubYear": "2025", "pageInfo": "75", "abstractText": "The confluence of new technologies with artificial intelligence (AI) and machine learning (ML) analytical techniques is rapidly advancing the field of precision oncology, promising to improve diagnostic approaches and therapeutic strategies for patients with cancer. By analyzing multi-dimensional, multiomic, spatial pathology, and radiomic data, these technologies enable a deeper understanding of the intricate molecular pathways, aiding in the identification of critical nodes within the tumor's biology to optimize treatment selection. The applications of AI/ML in precision oncology are extensive and include the generation of synthetic data, e.g., digital twins, in order to provide the necessary information to design or expedite the conduct of clinical trials. Currently, many operational and technical challenges exist related to data technology, engineering, and storage; algorithm development and structures; quality and quantity of the data and the analytical pipeline; data sharing and generalizability; and the incorporation of these technologies into the current clinical workflow and reimbursement models.", "affiliation": "Department of Medical Oncology, St Luke's Clinic, Panorama, Thessaloniki, Greece.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "P30 CA016672", "orderIn": 0}, {"agency": "U.S. Department of Health &amp; Human Services | NIH | NIH Clinical Center", "grantId": "P30 CA016672", "orderIn": 0}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": 