DetailsList": {"authorAffiliation": [{"affiliation": "Translational Sciences, Research & Development, Biogen, Cambridge, MA, USA. christopherdwhelan@outlook.com."}, {"affiliation": "Neuroscience Data Science, Janssen Research & Development, Cambridge, MA, USA. christopherdwhelan@outlook.com."}]}}]}, "investigatorList": {"investigator": [{"fullName": "Kang HM", "lastName": "Kang", "firstName": "Hyun Ming", "initials": "HM"}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5098-6902"}, {"type": "ORCID", "value": "0000-0001-5413-204X"}, {"type": "ORCID", "value": "0000-0001-5585-3420"}, {"type": "ORCID", "value": "0000-0001-6347-2281"}, {"type": "ORCID", "value": "0000-0001-7591-3902"}, {"type": "ORCID", "value": "0000-0001-7618-0050"}, {"type": "ORCID", "value": "0000-0001-7900-3973"}, {"type": "ORCID", "value": "0000-0001-9638-3912"}, {"type": "ORCID", "value": "0000-0002-1527-961X"}, {"type": "ORCID", "value": "0000-0002-2730-4472"}, {"type": "ORCID", "value": "0000-0002-3388-5760"}, {"type": "ORCID", "value": "0000-0002-4618-0647"}, {"type": "ORCID", "value": "0000-0002-4666-0923"}, {"type": "ORCID", "value": "0000-0002-5943-6189"}, {"type": "ORCID", "value": "0000-0002-7400-5643"}, {"type": "ORCID", "value": "0000-0002-8017-809X"}, {"type": "ORCID", "value": "0000-0002-8437-7387"}, {"type": "ORCID", "value": "0000-0002-8906-9762"}, {"type": "ORCID", "value": "0000-0002-9226-1317"}, {"type": "ORCID", "value": "0000-0002-9326-7227"}, {"type": "ORCID", "value": "0000-0002-9739-0249"}, {"type": "ORCID", "value": "0000-0003-0308-5583"}, {"type": "ORCID", "value": "0000-0003-0365-3077"}, {"type": "ORCID", "value": "0000-0003-3295-3116"}, {"type": "ORCID", "value": "0000-0003-3466-1846"}, {"type": "ORCID", "value": "0000-0003-3634-3016"}, {"type": "ORCID", "value": "0000-0003-3745-1940"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "7982", "volume": "622", "journalIssueId": 3647508, "dateOfPublication": "2023 Oct", "monthOfPublication": 10, "yearOfPublication": 2023, "journal": {"medlineAbbreviation": "Nature", "title": "Nature", "essn": "1476-4687", "issn": "0028-0836", "nlmid": "0410462", "isoabbreviation": "Nature"}, "printPublicationDate": "2023-10-01"}, "pubYear": "2023", "pageInfo": "329-338", "abstractText": "The Pharma Proteomics Project is a precompetitive biopharmaceutical consortium characterizing the plasma proteomic profiles of 54,219 UK Biobank participants. Here we provide a detailed summary of this initiative, including technical and biological validations, insights into proteomic disease signatures, and prediction modelling for various demographic and health indicators. We present comprehensive protein quantitative trait locus (pQTL) mapping of 2,923 proteins that identifies 14,287 primary genetic associations, of which 81% are previously undescribed, alongside ancestry-specific pQTL mapping in non-European individuals. The study provides an updated characterization of the genetic architecture of the plasma proteome, contextualized with projected pQTL discovery rates as sample sizes and proteomic assay coverages increase over time. We offer extensive insights into trans pQTLs across multiple biological domains, highlight genetic influences on ligand-receptor interactions and pathway perturbations across a diverse collection of cytokines and complement networks, and illustrate long-range epistatic effects of ABO blood group and FUT2 secretor status on proteins with gastrointestinal tissue-enriched expression. We demonstrate the utility of these data for drug discovery by extending the genetic proxied effects of protein targets, such as PCSK9, on additional endpoints, and disentangle specific genes and proteins perturbed at loci associated with COVID-19 susceptibility. This public-private partnership provides the scientific community with an open-access proteomics resource of considerable breadth and depth to help to elucidate the biological mechanisms underlying proteo-genomic discoveries and accelerate the development of biomarkers, predictive models and therapeutics<sup>1</sup>.", "affiliation": "Translational Sciences, Research & Development, Biogen, Cambridge, MA, USA. bbsun92@outlook.com.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Plasma", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "CH", "qualifierName": "chemistry"}]}}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Genetic Predisposition to Disease"}, {"majorTopic_YN": "N", "descriptorName": "Fucosyltransferases", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "ME", "qualifierName": "metabolism"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Blood Proteins", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "AN", "qualifierName": "analysis"}, {"majorTopic_YN": "N", "abbreviation": "GE", "qualifierName": "genetics"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Proteome", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "AN", "qualifierName": "analysis"}, {"majorTopic_YN": "N", "abbreviation": "GE", "qualifierName": "genetics"}]}}, {"majorTopic_YN": "N", "descriptorName": "ABO Blood-Group System", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "GE", "qualifierName": "genetics"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Proteomics"}, {"majorTopic_YN": "Y", "descriptorName": "Genomics"}, {"majorTopic_YN": "N", "descriptorName": "Epistasis, Genetic"}, {"majorTopic_YN": "N", "descriptorName": "Quantitative Trait Loci"}, {"majorTopic_YN": "Y", "descriptorName": "Databases, Factual"}, {"majorTopic_YN": "Y", "descriptorNam