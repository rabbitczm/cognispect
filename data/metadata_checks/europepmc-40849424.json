ao Tong University, Shanghai, China."}, {"affiliation": "Shanghai Artificial Intelligence Laboratory, Shanghai, China."}]}}, {"fullName": "Zhang X", "lastName": "Zhang", "firstName": "Xiaoman", "initials": "X", "authorId": {"type": "ORCID", "value": "0000-0002-7696-9366"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Shanghai Jiao Tong University, Shanghai, China."}, {"affiliation": "Shanghai Artificial Intelligence Laboratory, Shanghai, China."}]}}, {"fullName": "Zhang Y", "lastName": "Zhang", "firstName": "Ya", "initials": "Y", "authorId": {"type": "ORCID", "value": "0000-0002-5390-9053"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Shanghai Jiao Tong University, Shanghai, China."}, {"affiliation": "Shanghai Artificial Intelligence Laboratory, Shanghai, China."}]}}, {"fullName": "Hui H", "lastName": "Hui", "firstName": "Hui", "initials": "H", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Shanghai Jiao Tong University, Shanghai, China."}]}}, {"fullName": "Wang Y", "lastName": "Wang", "firstName": "Yanfeng", "initials": "Y", "authorId": {"type": "ORCID", "value": "0000-0002-3196-2347"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Shanghai Jiao Tong University, Shanghai, China. wangyanfeng622@sjtu.edu.cn."}, {"affiliation": "Shanghai Artificial Intelligence Laboratory, Shanghai, China. wangyanfeng622@sjtu.edu.cn."}]}}, {"fullName": "Xie W", "lastName": "Xie", "firstName": "Weidi", "initials": "W", "authorId": {"type": "ORCID", "value": "0009-0002-8609-6826"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Shanghai Jiao Tong University, Shanghai, China. weidi@sjtu.edu.cn."}, {"affiliation": "Shanghai Artificial Intelligence Laboratory, Shanghai, China. weidi@sjtu.edu.cn."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-3196-2347"}, {"type": "ORCID", "value": "0000-0002-5390-9053"}, {"type": "ORCID", "value": "0000-0002-7696-9366"}, {"type": "ORCID", "value": "0009-0002-8609-6826"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "1", "volume": "16", "journalIssueId": 3985749, "dateOfPublication": "2025 Aug", "monthOfPublication": 8, "yearOfPublication": 2025, "journal": {"medlineAbbreviation": "Nat Commun", "title": "Nature communications", "essn": "2041-1723", "issn": "2041-1723", "nlmid": "101528555", "isoabbreviation": "Nat Commun"}, "printPublicationDate": "2025-08-01"}, "pubYear": "2025", "pageInfo": "7866", "abstractText": "In this study, as a proof-of-concept, we aim to initiate the development of Radiology Foundation Model, termed as RadFM. We consider three perspectives: dataset construction, model design, and thorough evaluation, concluded as follows: (i), we contribute 4 multimodal datasets with 13M 2D images and 615K 3D scans. When combined with a vast collection of existing datasets, this forms our training dataset, termed as Medical Multi-modal Dataset, MedMD. (ii), we propose an architecture that enables to integrate text input with 2D or 3D medical scans, and generates responses for diverse radiologic tasks, including diagnosis, visual question answering, report generation, and rationale diagnosis; (iii), beyond evaluation on 9 existing datasets, we propose a new benchmark, RadBench, comprising three tasks aiming to assess foundation models comprehensively. We conduct both automatic and human evaluations on RadBench. RadFM outperforms former accessible multi-modal foundation models, including GPT-4V. Additionally, we adapt RadFM for diverse public benchmarks, surpassing various existing SOTAs.", "affiliation": "Shanghai Jiao Tong University, Shanghai, China.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic