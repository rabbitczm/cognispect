]}}]}, "journalInfo": {"issue": "3", "volume": "7", "journalIssueId": 1031973, "dateOfPublication": "2000 May-Jun", "monthOfPublication": 0, "yearOfPublication": 2000, "journal": {"medlineAbbreviation": "J Am Med Inform Assoc", "title": "Journal of the American Medical Informatics Association : JAMIA", "essn": "1527-974X", "issn": "1067-5027", "nlmid": "9430800", "isoabbreviation": "J Am Med Inform Assoc"}, "printPublicationDate": "2000-05-01"}, "pubYear": "2000", "pageInfo": "298-303", "abstractText": "The evolution of health terminology has undergone glacial transition over time, although this pace has quickened recently. After a long history of near neglect, unimaginative structure, and factitious development, health terminologies are in an era of unprecedented importance, sophistication, and collaboration. The major highlights of this history are reviewed, together with important intellectual advances in health terminology development. The inescapable conclusion is that we are amidst a major revolution in the role and capabilities of health terminologies, entering an age of large-scale systems for health concept representation with international implications.", "affiliation": "Mayo Foundation, Rochester, Minnesota 55905, USA. chute@mayo.edu", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["Historical Article", "research-article", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Disease", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "CL", "qualifierName": "classification"}]}}, {"majorTopic_YN": "N", "descriptorName": "History, 16th Century"}, {"majorTopic_YN": "N", "descriptorName": "History, 17th Century"}, {"majorTopic_YN": "N", "descriptorName": "History, 20th Century"}, {"majorTopic_YN": "Y", "descriptorName": "Classification"}, {"majorTopic_YN": "N", "descriptorName": "Vo