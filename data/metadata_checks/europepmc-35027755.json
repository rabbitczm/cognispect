tName": "Tukiainen", "firstName": "Mikko", "initials": "M"}, {"fullName": "Karlsson A", "lastName": "Karlsson", "firstName": "Antti", "initials": "A"}, {"fullName": "Guo R", "lastName": "Guo", "firstName": "Rui", "initials": "R"}, {"fullName": "Hsieh CL", "lastName": "Hsieh", "firstName": "Chia-Lun", "initials": "CL"}, {"fullName": "Zubarev I", "lastName": "Zubarev", "firstName": "Igor", "initials": "I"}, {"fullName": "Bukhar HST", "lastName": "Bukhar", "firstName": "Habib S T", "initials": "HST"}, {"fullName": "Li W", "lastName": "Li", "firstName": "Wenyuan", "initials": "W"}, {"fullName": "Li J", "lastName": "Li", "firstName": "Jiayun", "initials": "J"}, {"fullName": "Speier W", "lastName": "Speier", "firstName": "William", "initials": "W", "authorId": {"type": "ORCID", "value": "0000-0002-0890-8684"}}, {"fullName": "Arnold C", "lastName": "Arnold", "firstName": "Corey", "initials": "C"}, {"fullName": "Kim K", "lastName": "Kim", "firstName": "Kyungdoc", "initials": "K"}, {"fullName": "Bae B", "lastName": "Bae", "firstName": "Byeonguk", "initials": "B"}, {"fullName": "Kim YW", "lastName": "Kim", "firstName": "Yeong Won", "initials": "YW"}, {"fullName": "Lee HS", "lastName": "Lee", "firstName": "Hong-Seok", "initials": "HS"}, {"fullName": "Park J", "lastName": "Park", "firstName": "Jeonghyuk", "initials": "J"}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5032-5266"}, {"type": "ORCID", "value": "0000-0001-5297-3822"}, {"type": "ORCID", "value": "0000-0001-5640-2250"}, {"type": "ORCID", "value": "0000-0001-5943-3634"}, {"type": "ORCID", "value": "0000-0001-7982-0754"}, {"type": "ORCID", "value": "0000-0001-8531-222X"}, {"type": "ORCID", "value": "0000-0001-8640-5786"}, {"type": "ORCID", "value": "0000-0001-8702-4643"}, {"type": "ORCID", "value": "0000-0001-9086-9591"}, {"type": "ORCID", "value": "0000-0002-0083-4991"}, {"type": "ORCID", "value": "0000-0002-0816-3395"}, {"type": "ORCID", "value": "0000-0002-0890-8684"}, {"type": "ORCID", "value": "0000-0002-1073-2753"}, {"type": "ORCID", "value": "0000-0002-4855-4366"}, {"type": "ORCID", "value": "0000-0002-6129-5039"}, {"type": "ORCID", "value": "0000-0002-8154-5875"}, {"type": "ORCID", "value": "0000-0002-9470-4783"}, {"type": "ORCID", "value": "0000-0003-0128-6947"}, {"type": "ORCID", "value": "0000-0003-1010-536X"}, {"type": "ORCID", "value": "0000-0003-1174-9829"}, {"type": "ORCID", "value": "0000-0003-1297-0023"}, {"type": "ORCID", "value": "0000-0003-1465-6580"}, {"type": "ORCID", "value": "0000-0003-1554-1291"}, {"type": "ORCID", "value": "0009-0006-4635-0438"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data", "full_text"]}, "journalInfo": {"issue": "1", "volume": "28", "journalIssueId": 3300287, "dateOfPublication": "2022 Jan", "monthOfPublication": 1, "yearOfPublication": 2022, "journal": {"medlineAbbreviation": "Nat Med", "title": "Nature medicine", "essn": "1546-170X", "issn": "1078-8956", "isoabbreviation": "Nat Med", "nlmid": "9502015"}, "printPublicationDate": "2022-01-01"}, "pubYear": "2022", "pageInfo": "154-163", "abstractText": "Artificial intelligence (AI) has shown promise for diagnosing prostate cancer in biopsies. However, results have been limited to individual studies, lacking validation in multinational settings. Competitions have been shown to be accelerators for medical imaging innovations, but their impact is hindered by lack of reproducibility and independent validation. With this in mind, we organized the PANDA challenge-the largest histopathology competition to date, joined by 1,290 developers-to catalyze development of reproducible AI algorithms for Gleason grading using 10,616 digitized prostate biopsies. We validated that a diverse set of submitted algorithms reached pathologist-level performance on independent cross-continental cohorts, fully blinded to the algorithm developers. On United States and European external validation sets, the algorithms achieved agreements of 0.862 (quadratically weighted κ, 95% confidence interval (CI), 0.840-0.884) and 0.868 (95% CI, 0.835-0.900) with expert uropathologists. Successful generalization across different patient populations, laboratories and reference standards, achieved by a variety of algorithmic approaches, warrants evaluating AI-based Gleason grading in prospective clinical trials.", "affiliation": "Department of Pathology, Radboud Institute for Health Sciences, Radboud University Medical Center, Nijmegen, The Netherlands. wouter@wouterbulten.com.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Dutch Research Council (NWO)", "grantId": "016.186.152", "orderIn": 0}, {"agency": "EIT Health, Prostatacancerförbundet", "orderIn": 0}, {"agency": "Google LLC, Verily Life Sciences", "orderIn": 0}, {"agency": "Syöpäsäätiö", "orderIn": 0}, {"agency": "Academy of Finland", "orderIn": 0}, {"agency": "ERAPermed", "orderIn": 0}, {"agency": "Åke Wiberg Stiftelse", "orderIn": 0}, {"agency": "Cancer Foundation Finland sr", "grantId": "200120", "orderIn": 0}, {"agency": "Cancerfonden", "orderIn": 0}, {"agency": "KWF Kankerbestrijding", "grantId": "KUN 2015-7970", "orderIn": 0}, {"agency": "Cancer Foundation Finland sr", "grantId": "210069", "orderIn": 0}, {"agency": "Vetenskapsrådet", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Prostatic Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DI", "qualifierName": "diagnosis"}, {"majorTopic_YN": "Y", "abbreviation": "PA", "qualifierName": "pathology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Biopsy"}, {"majorTopic_YN": "N", "descriptorName": "Cohort Studies"}, {"majorTopic_YN": "N", "descriptorName": "Reproducibility of Results"}, {"majorTopic_YN": "N", "descriptorName": "Algorithms"}, {"majorTopic_YN": "N", "descriptorName": "Male"}, {"majorTopic_YN": "Y", "descriptorName": "Neoplasm Grading"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Unpaywall", "url": "https://escholarship.org/uc/item/8px8m0dt"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1038/s41591-021-01620-2"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC8799467"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC8799467?pdf=render"}]}, "commentCorrectionList": {"commentCorrection": [{"source": "MED", "id": "35277666", "reference": "Nat Rev Urol. 2022 May;19(5):261-262. doi: 10.1038/s41585-022-00583-4", "type": "Comment in", "orderIn": 1}, {"source": "MED", "id": "35593717", "reference": "Radiol Imaging Cancer. 2022 May;4(3):e229010. doi: 10.1148/rycan.229010", "type": "Comment in", "orderIn": 2}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 365, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "Y", "hasLabsLinks": "Y", "hasData": "Y", "license": "cc by", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["doi"]}, "dateOfCompletion": "2022-02-21", "dateOfCreation": "2022-01-14", "dateOfRevision": "2024-04-05", "electronicPublicationDate": "2022-01-13", "firstPublicationDate": "2022-01-13", "firstIndexDate": "2022-01-15", "fullTextReceivedDate": "2025-02-04", "hasEvaluations": "N"}]}}