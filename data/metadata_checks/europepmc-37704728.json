"ORCID", "value": "0000-0003-4676-1158"}}, {"fullName": "Zheng Y", "lastName": "Zheng", "firstName": "Yalin", "initials": "Y"}, {"fullName": "Luben R", "lastName": "Luben", "firstName": "Robert", "initials": "R", "authorId": {"type": "ORCID", "value": "0000-0002-5088-6343"}}, {"fullName": "Luthert P", "lastName": "Luthert", "firstName": "Phil", "initials": "P"}, {"fullName": "Sun Z", "lastName": "Sun", "firstName": "Zihan", "initials": "Z", "authorId": {"type": "ORCID", "value": "0000-0002-5001-7113"}}, {"fullName": "McKibbin M", "lastName": "McKibbin", "firstName": "Martin", "initials": "M"}, {"fullName": "O'Sullivan E", "lastName": "O'Sullivan", "firstName": "Eoin", "initials": "E"}, {"fullName": "Oram R", "lastName": "Oram", "firstName": "Richard", "initials": "R", "authorId": {"type": "ORCID", "value": "0000-0003-3581-8980"}}, {"fullName": "Weedon M", "lastName": "Weedon", "firstName": "Mike", "initials": "M"}, {"fullName": "Owen CG", "lastName": "Owen", "firstName": "Chris G", "initials": "CG", "authorId": {"type": "ORCID", "value": "0000-0003-1135-5977"}}, {"fullName": "Rudnicka AR", "lastName": "Rudnicka", "firstName": "Alicja R", "initials": "AR"}, {"fullName": "Sattar N", "lastName": "Sattar", "firstName": "Naveed", "initials": "N"}, {"fullName": "Steel D", "lastName": "Steel", "firstName": "David", "initials": "D", "authorId": {"type": "ORCID", "value": "0000-0001-8734-3089"}}, {"fullName": "Stratton I", "lastName": "Stratton", "firstName": "Irene", "initials": "I", "authorId": {"type": "ORCID", "value": "0000-0003-1172-7865"}}, {"fullName": "Tapp R", "lastName": "Tapp", "firstName": "Robyn", "initials": "R", "authorId": {"type": "ORCID", "value": "0000-0002-8553-2684"}}, {"fullName": "Yates MM", "lastName": "Yates", "firstName": "Max M", "initials": "MM", "authorId": {"type": "ORCID", "value": "0000-0003-3977-8920"}}, {"fullName": "Petzold A", "lastName": "Petzold", "firstName": "Axel", "initials": "A"}, {"fullName": "Madhusudhan S", "lastName": "Madhusudhan", "firstName": "Savita", "initials": "S"}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5219-9312"}, {"type": "ORCID", "value": "0000-0001-5541-4305"}, {"type": "ORCID", "value": "0000-0001-5936-1431"}, {"type": "ORCID", "value": "0000-0001-6131-7640"}, {"type": "ORCID", "value": "0000-0001-6265-0381"}, {"type": "ORCID", "value": "0000-0001-7849-0087"}, {"type": "ORCID", "value": "0000-0001-8197-6280"}, {"type": "ORCID", "value": "0000-0001-8734-3089"}, {"type": "ORCID", "value": "0000-0001-8952-0659"}, {"type": "ORCID", "value": "0000-0001-9413-2669"}, {"type": "ORCID", "value": "0000-0002-0742-3159"}, {"type": "ORCID", "value": "0000-0002-0840-6422"}, {"type": "ORCID", "value": "0000-0002-0973-8285"}, {"type": "ORCID", "value": "0000-0002-1030-9963"}, {"type": "ORCID", "value": "0000-0002-1478-4729"}, {"type": "ORCID", "value": "0000-0002-2201-859X"}, {"type": "ORCID", "value": "0000-0002-3025-4066"}, {"type": "ORCID", "value": "0000-0002-3184-2353"}, {"type": "ORCID", "value": "0000-0002-3227-2620"}, {"type": "ORCID", "value": "0000-0002-5001-7113"}, {"type": "ORCID", "value": "0000-0002-5055-0794"}, {"type": "ORCID", "value": "0000-0002-5088-6343"}, {"type": "ORCID", "value": "0000-0002-5691-4659"}, {"type": "ORCID", "value": "0000-0002-6210-5620"}, {"type": "ORCID", "value": "0000-0002-7028-5633"}, {"type": "ORCID", "value": "0000-0002-7452-1648"}, {"type": "ORCID", "value": "0000-0002-7913-1403"}, {"type": "ORCID", "value": "0000-0002-8553-2684"}, {"type": "ORCID", "value": "0000-0002-9239-745X"}, {"type": "ORCID", "value": "0000-0002-9265-2393"}, {"type": "ORCID", "value": "0000-0003-0986-4123"}, {"type": "ORCID", "value": "0000-0003-1135-5977"}, {"type": "ORCID", "value": "0000-0003-1172-7865"}, {"type": "ORCID", "value": "0000-0003-1217-4852"}, {"type": "ORCID", "value": "0000-0003-1686-7189"}, {"type": "ORCID", "value": "0000-0003-2439-350X"}, {"type": "ORCID", "value": "0000-0003-2648-0869"}, {"type": "ORCID", "value": "0000-0003-2834-3040"}, {"type": "ORCID", "value": "0000-0003-3581-8980"}, {"type": "ORCID", "value": "0000-0003-3977-8920"}, {"type": "ORCID", "value": "0000-0003-4676-1158"}, {"type": "ORCID", "value": "0000-0003-4915-4353"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "7981", "volume": "622", "journalIssueId": 3640182, "dateOfPublication": "2023 Oct", "monthOfPublication": 10, "yearOfPublication": 2023, "journal": {"medlineAbbreviation": "Nature", "title": "Nature", "essn": "1476-4687", "issn": "0028-0836", "nlmid": "0410462", "isoabbreviation": "Nature"}, "printPublicationDate": "2023-10-01"}, "pubYear": "2023", "pageInfo": "156-163", "abstractText": "Medical artificial intelligence (AI) offers great potential for recognizing signs of health conditions in retinal images and expediting the diagnosis of eye diseases and systemic disorders<sup>1</sup>. However, the development of AI models requires substantial annotation and models are usually task-specific with limited generalizability to different clinical applications<sup>2</sup>. Here, we present RETFound, a foundation model for retinal images that learns generalizable representations from unlabelled retinal images and provides a basis for label-efficient model adaptation in several applications. Specifically, RETFound is trained on 1.6 million unlabelled retinal images by means of self-supervised learning and then adapted to disease detection tasks with explicit labels. We show that adapted RETFound consistently outperforms several comparison models in the diagnosis and prognosis of sight-threatening eye diseases, as well as incident prediction of complex systemic disorders such as heart failure and myocardial infarction with fewer labelled data. RETFound provides a generalizable solution to improve model performance and alleviate the annotation workload of experts to enable broad clinical AI applications from retinal imaging.", "affiliation": "Centre for Medical Image Computing, University College London, London, UK. yukun.zhou.19@ucl.ac.uk.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Engineering and Physical Sciences Research Council", "grantId": "EP/V034537/1", "orderIn": 0}, {"agency": "Medical Research Council", "acronym": "MRC_", "grantId": "MR/K003364/1", "orderIn": 0}, {"agency": "National Institute for Health Research (NIHR)", "grantId": "NF-SI-0515-10020", "orderIn": 0}, {"agency": "Medical Research Council", "acronym": "MRC_", "grantId": "MC_PC_19005", "orderIn": 0}, {"agency": "National Institute for Health Research (NIHR)", "grantId": "NIHR205103", "orderIn": 0}, {"agency": "Engineering and Physical Sciences Research Council", "grantId": "EP/M020533/1", "orderIn": 0}, {"agency": "Medical Research Council", "acronym": "MRC_", "grantId": "MC_UU_00007/10", "orderIn": 0}, {"agency": "National Institute for Health Research (NIHR)", "grantId": "NIHR205109", "orderIn": 0}, {"agency": "National Institute for Health Research (NIHR)", "grantId": "NIHR205096", "orderIn": 0}, {"agency": "Engineering and Physical Sciences Research Council", "grantId": "EP/R014019/1", "orderIn": 0}, {"agency": "Medical Research Council", "acronym": "MRC_", "grantId": "MR/T019050/1", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "Y", "descriptorName": "Retina", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}]}}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "Y", "descriptorName": "Eye Diseases", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}, {"majorTopic_YN": "N", "abbreviation": "CO", "qualifierName": "complications"}]}}, {"majorTopic_YN": "N", "descriptorName