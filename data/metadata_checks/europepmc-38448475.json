rAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Medical Informatics, University of Münster, Münster, Germany."}]}}, {"fullName": "Riepenhausen S", "lastName": "Riepenhausen", "firstName": "Sarah", "initials": "S", "authorId": {"type": "ORCID", "value": "0000-0002-0623-2625"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Medical Informatics, University of Münster, Münster, Germany."}]}}, {"fullName": "Plagwitz L", "lastName": "Plagwitz", "firstName": "Lucas", "initials": "L", "authorId": {"type": "ORCID", "value": "0000-0001-7626-8853"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Medical Informatics, University of Münster, Münster, Germany."}]}}, {"fullName": "Varghese J", "lastName": "Varghese", "firstName": "Julian", "initials": "J", "authorId": {"type": "ORCID", "value": "0000-0002-7206-3719"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Medical Informatics, University of Münster, Münster, Germany. julian.varghese@uni-muenster.de."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-7626-8853"}, {"type": "ORCID", "value": "0000-0002-0623-2625"}, {"type": "ORCID", "value": "0000-0002-5011-0641"}, {"type": "ORCID", "value": "0000-0002-7206-3719"}, {"type": "ORCID", "value": "0000-0002-7718-7024"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "1", "volume": "15", "journalIssueId": 3732529, "dateOfPublication": "2024 Mar", "monthOfPublication": 3, "yearOfPublication": 2024, "journal": {"medlineAbbreviation": "Nat Commun", "title": "Nature communications", "essn": "2041-1723", "issn": "2041-1723", "nlmid": "101528555", "isoabbreviation": "Nat Commun"}, "printPublicationDate": "2024-03-01"}, "pubYear": "2024", "pageInfo": "2050", "abstractText": "It is likely that individuals are turning to Large Language Models (LLMs) to seek health advice, much like searching for diagnoses on Google. We evaluate clinical accuracy of GPT-3·5 and GPT-4 for suggesting initial diagnosis, examination steps and treatment of 110 medical cases across diverse clinical disciplines. Moreover, two model configurations of the Llama 2 open source LLMs are assessed in a sub-study. For benchmarking the diagnostic task, we conduct a naïve Google search for comparison. Overall, GPT-4 performed best with superior performances over GPT-3·5 considering diagnosis and examination and superior performance over Google for diagnosis. Except for treatment, better performance on frequent vs rare diseases is evident for all three approaches. The sub-study indicates slightly lower performances for Llama models. In conclusion, the commercial LLMs show growing potential for medical question answering in two successive major releases. However, some weaknesses underscore the need for robust and regulated AI models in health care. Open source LLMs can be a viable option to address specific needs regarding data privacy and transparency of training.", "affiliation": "Institute of Medical Informatics, University of Münster, Münster, Germany.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Animals"}, {"majorTopic_YN": "Y", "descriptorName": "Camelids, New World"}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "Y", "descriptorName": "Decision Support Systems, Clinical"}, {"majorTopic_YN": "N", "descriptorName": "Health Facilities"}, {"majorTopic_YN": "N", "descriptorName": "Benchmarking"}, {"majorTopic_YN": "N", "descriptorName": "Search Engine"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "s