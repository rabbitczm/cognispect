: [{"affiliation": "Department of Endocrinology, Beaumont Hospital, Dublin, Ireland."}, {"affiliation": "Royal College of Surgeons in Ireland, Dublin, Ireland."}]}}, {"fullName": "Scarsbrook A", "lastName": "Scarsbrook", "firstName": "Andrew", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0002-4243-032X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Leeds Teaching Hospitals NHS Trust, St James University Hospital, Leeds, UK."}]}}, {"fullName": "Abbas A", "lastName": "Abbas", "firstName": "Afroze", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0003-2497-6887"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Endocrinology, Leeds Teaching Hospitals NHS Trust, St James University Hospital, Leeds, UK."}]}}, {"fullName": "Fraser S", "lastName": "Fraser", "firstName": "Sheila", "initials": "S", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Endocrine Surgery, Leeds Teaching Hospitals NHS Trust, St James University Hospital, Leeds, UK."}]}}, {"fullName": "Limumpornpetch P", "lastName": "Limumpornpetch", "firstName": "Padiporn", "initials": "P", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Faculty of Medicine & Health, University of Leeds, Worsley Building, Clarendon Way, Leeds, UK."}]}}, {"fullName": "Dineen R", "lastName": "Dineen", "firstName": "Rosemary", "initials": "R", "authorId": {"type": "ORCID", "value": "0000-0001-9740-7621"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Endocrinology, Beaumont Hospital, Dublin, Ireland."}, {"affiliation": "Royal College of Surgeons in Ireland, Dublin, Ireland."}]}}, {"fullName": "Stewart PM", "lastName": "Stewart", "firstName": "Paul M", "initials": "PM", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Faculty of Medicine & Health, University of Leeds, Worsley Building, Clarendon Way, Leeds, UK."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-8486-7469"}, {"type": "ORCID", "value": "0000-0001-9740-7621"}, {"type": "ORCID", "value": "0000-0002-4243-032X"}, {"type": "ORCID", "value": "0000-0003-2497-6887"}, {"type": "ORCID", "value": "0000-0003-4078-624X"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "6", "volume": "41", "journalIssueId": 2996983, "dateOfPublication": "2020 Dec", "monthOfPublication": 12, "yearOfPublication": 2020, "journal": {"medlineAbbreviation": "Endocr Rev", "title": "Endocrine reviews", "essn": "1945-7189", "issn": "0163-769X", "nlmid": "8006258", "isoabbreviation": "Endocr Rev"}, "printPublicationDate": "2020-12-01"}, "pubYear": "2020", "pageInfo": "bnaa008", "abstractText": "An adrenal incidentaloma is now established as a common endocrine diagnosis that requires a multidisciplinary approach for effective management. The majority of patients can be reassured and discharged, but a personalized approach based upon image analysis, endocrine workup, and clinical symptoms and signs are required in every case. Adrenocortical carcinoma remains a real concern but is restricted to <2% of all cases. Functional adrenal incidentaloma lesions are commoner (but still probably <10% of total) and the greatest challenge remains the diagnosis and optimum management of autonomous cortisol secretion. Modern-day surgery has improved outcomes and novel radiological and urinary biomarkers will improve early detection and patient stratification in future years to come.", "affiliation": "Department of Endocrinology, Beaumont Hospital, Dublin, Ireland.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "review-article", "Review", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "Y", "descriptorName": "Adrenal Glands", "meshQualifierList": {"meshQua