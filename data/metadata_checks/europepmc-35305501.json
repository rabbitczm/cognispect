"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "The Vehant Technology Pvt. Ltd., Noida, India. Electronic address: priyaaggarwal27@gmail.com."}]}}, {"fullName": "Mishra NK", "lastName": "Mishra", "firstName": "Narendra Kumar", "initials": "NK", "authorId": {"type": "ORCID", "value": "0000-0003-3735-8906"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "The Department of EE, Indian Institute of Technology Delhi, Delhi 110016, India. Electronic address: eez188568@ee.iitd.ac.in."}]}}, {"fullName": "Fatimah B", "lastName": "Fatimah", "firstName": "Binish", "initials": "B", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "The Department of ECE, CMR Institute of Technology, Bengaluru, India. Electronic address: binish.fatimah@gmail.com."}]}}, {"fullName": "Singh P", "lastName": "Singh", "firstName": "Pushpendra", "initials": "P", "authorId": {"type": "ORCID", "value": "0000-0001-5615-519X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "The Department of ECE, National Institute of Technology Hamirpur, HP, India. Electronic address: spushp@nith.ac.in."}]}}, {"fullName": "Gupta A", "lastName": "Gupta", "firstName": "Anubha", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0002-7752-1926"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "The Department of ECE, IIIT-Delhi, Delhi, 110020, India. Electronic address: anubha@iiitd.ac.in."}]}}, {"fullName": "Joshi SD", "lastName": "Joshi", "firstName": "Shiv Dutt", "initials": "SD", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "The Department of EE, Indian Institute of Technology Delhi, Delhi 110016, India. Electronic address: sdjoshi@ee.iitd.ac.in."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5615-519X"}, {"type": "ORCID", "value": "0000-0002-2993-4021"}, {"type": "ORCID", "value": "0000-0002-7752-1926"}, {"type": "ORCID", "value": "0000-0003-3735-8906"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"volume": "144", "journalIssueId": 3339751, "dateOfPublication": "2022 May", "monthOfPublication": 5, "yearOfPublication": 2022, "journal": {"medlineAbbreviation": "Comput Biol Med", "title": "Computers in biology and medicine", "essn": "1879-0534", "issn": "0010-4825", "nlmid": "1250250", "isoabbreviation": "Comput Biol Med"}, "printPublicationDate": "2022-05-01"}, "pubYear": "2022", "pageInfo": "105350", "abstractText": "Corona Virus Disease-2019 (COVID-19), caused by Severe Acute Respiratory Syndrome-Corona Virus-2 (SARS-CoV-2), is a highly contagious disease that has affected the lives of millions around the world. Chest X-Ray (CXR) and Computed Tomography (CT) imaging modalities are widely used to obtain a fast and accurate diagnosis of COVID-19. However, manual identification of the infection through radio images is extremely challenging because it is time-consuming and highly prone to human errors. Artificial Intelligence (AI)-techniques have shown potential and are being exploited further in the development of automated and accurate solutions for COVID-19 detection. Among AI methodologies, Deep Learning (DL) algorithms, particularly Convolutional Neural Networks (CNN), have gained significant popularity for the classification of COVID-19. This paper summarizes and reviews a number of significant research publications on the DL-based classification of COVID-19 through CXR and CT images. We also present an outline of the current state-of-the-art advances and a critical discussion of open challenges. We conclude our study by enumerating some future directions of research in COVID-19 imaging classification.", "affiliation": "The Vehant Technology Pvt. Ltd., Noida, India. Electronic address: priyaaggarwal27@gmail.com.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["review-article", "Revi