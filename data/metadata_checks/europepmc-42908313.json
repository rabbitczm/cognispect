"IS", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "College of Animal Science and Technology, Northwest A&F University, Yangling, China."}]}}, {"fullName": "Song G", "lastName": "Song", "firstName": "Guohua", "initials": "G", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "College of Animal Science and Technology, Northwest A&F University, Yangling, China."}]}}, {"fullName": "Kinkpe L", "lastName": "Kinkpe", "firstName": "Lionel", "initials": "L", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "College of Animal Science and Technology, Northwest A&F University, Yangling, China."}]}}, {"fullName": "Duan Q", "lastName": "Duan", "firstName": "Qianting", "initials": "Q", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "College of Animal Science and Technology, Northwest A&F University, Yangling, China."}]}}, {"fullName": "Goswami N", "lastName": "Goswami", "firstName": "Naqash", "initials": "N", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "College of Animal Science and Technology, Northwest A&F University, Yangling, China."}]}}, {"fullName": "Jin Z", "lastName": "Jin", "firstName": "Zhuoya", "initials": "Z", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "College of Animal Science and Technology, Northwest A&F University, Yangling, China."}]}}, {"fullName": "Wu J", "lastName": "Wu", "firstName": "Jie", "initials": "J", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "College of Animal Science and Technology, Northwest A&F University, Yangling, China."}]}}, {"fullName": "Dong X", "lastName": "Dong", "firstName": "Xianggui", "initials": "X", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "College of Animal Science and Technology, Northwest A&F University, Yangling, China."}]}}, {"fullName": "Ren Z", "lastName": "Ren", "firstName": "Zhanjun", "initials": "Z", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "College of Animal Science and Technology, Northwest A&F University, Yangling, China."}]}}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "1", "volume": "38", "journalIssueId": 4296333, "dateOfPublication": "2027 Dec", "monthOfPublication": 12, "yearOfPublication": 2027, "journal": {"medlineAbbreviation": "Anim Biotechnol", "title": "Animal biotechnology", "essn": "1532-2378", "issn": "1049-5398", "nlmid": "9011409", "isoabbreviation": "Anim Biotechnol"}, "printPublicationDate": "2027-12-01"}, "pubYear": "2027", "pageInfo": "2740386", "abstractText": "Intramuscular fat (IMF) significantly influences meat quality, affecting flavor, tenderness, and juiciness. Despite extensive research on livestock such as cattle and pigs, the regulation of IMF in rabbits remains poorly understood. This study establishes a standardized in vitro method for isolating and characterizing intramuscular preadipocytes from the longissimus dorsi muscle of 3-day-old Hycole rabbits using enzymatic digestion and differential centrifugation. Three-day-old neonates were selected for initial protocol development due to their higher progenitor cell abundance and tissue accessibility, which facilitates method optimization and ensures consistent cell yields. Isolated cells displayed typical preadipocyte morphology and expressed key markers, including PREF-1, PPARγ, and Leptin, confirmed by RT-qPCR and immunofluorescence. Upon adipogenic induction, cells exhibited progressive lipid accumulation, as indicated by Oil Red O staining, and showed upregulated expression of <i>PPARG</i>, <i>C/EBPa</i>, and <i>FABP4</i>, confirming their differentiation potential. This study establishes a comprehensive protocol for isolating rabbit intramuscular preadipocytes, providing a foundational tool for investigating the molecular mechanisms of adipogenesis in lagomorphs. The model supports future studies on genetic and nutritional strategies to enhance rabbit meat quality while preserving its lean characteristics.", "affiliation": "College of Animal Science and Technology, Northwest A&F University, Yangling, China.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Chinese Universities Scientific Fund", "grantId": "2452020187", "orderIn": 0}, {"agency": "Rabbit Industry Technology System of Shaanxi Province", "grantId": "K3320217013", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "Y", "descriptorName": "Muscle, Skeletal", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "CY", "qualifierName": "cytology"}, {"majorTopic_YN": "N", "abbreviation": "ME", "qualifierName": "metabolism"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Adipose Tissue", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "CY", "qualifierName": "cytology"}, {"majorTopic_YN": "N", "abbreviation": "ME", "qualifierName": "metabolism"}]}}, {"majorTopic_YN": "N", "descriptorName": "Cells, Cultured"}, {"majorTopic_YN": "Y", "descriptorName": "Adipocytes", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "CY", "qualifierName": "cytology"}, {"majorTopic_YN": "N", "abbreviation": "ME", "qualifierName": "metabolism"}, {"majorTopic_YN": "N", "abbreviation": "PH", "qualifierName": "physiology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Animals"}, {"majorTopic_YN": "N", "descriptorName": "Rabbits"}, {"majorTopic_YN": "Y", "descriptorName": "Cell Separation", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Cell Differentiation"}, {"majorTopic_YN": "N", "descriptorName": "Meat"}, {"majorTopic_YN": "N", "descriptorName": "Adipogenesis", "meshQualifierList": {"meshQualifier": 