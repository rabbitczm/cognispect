DetailsList": {"authorAffiliation": [{"affiliation": "Scottish Pulmonary Vascular Unit, Regional Lung and Heart Centre, Glasgow, UK."}]}}, {"fullName": "Pepke-Zaba J", "lastName": "Pepke-Zaba", "firstName": "Joanna", "initials": "J", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Pulmonary Hypertension Unit, Papworth Hospital, Cambridge, UK."}]}}, {"fullName": "Provencher S", "lastName": "Provencher", "firstName": "Steeve", "initials": "S", "authorId": {"type": "ORCID", "value": "0000-0001-7535-9972"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institut Universitaire de Cardiologie et de Pneumologie de Québec Research Center, Laval University, Quebec City, QC, Canada."}]}}, {"fullName": "Weissmann N", "lastName": "Weissmann", "firstName": "Norbert", "initials": "N", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "University of Giessen and Marburg Lung Center (UGMLC), Justus-Liebig University Giessen and Member of the German Center for Lung Research (DZL), Giessen, Germany."}]}}, {"fullName": "Seeger W", "lastName": "Seeger", "firstName": "Werner", "initials": "W", "authorId": {"type": "ORCID", "value": "0000-0003-1946-0894"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "University of Giessen and Marburg Lung Center (UGMLC), Justus-Liebig University Giessen and Member of the German Center for Lung Research (DZL), Giessen, Germany."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-7535-9972"}, {"type": "ORCID", "value": "0000-0002-2834-7466"}, {"type": "ORCID", "value": "0000-0003-1946-0894"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics"]}, "journalInfo": {"issue": "1", "volume": "53", "journalIssueId": 2766411, "dateOfPublication": "2019 Jan", "monthOfPublication": 1, "yearOfPublication": 2019, "journal": {"medlineAbbreviation": "Eur Respir J", "title": "The European respiratory journal", "essn": "1399-3003", "issn": "0903-1936", "nlmid": "8803460", "isoabbreviation": "Eur Respir J"}, "printPublicationDate": "2019-01-01"}, "pubYear": "2019", "pageInfo": "1801914", "abstractText": "Pulmonary hypertension (PH) frequently complicates the course of patients with various forms of chronic lung disease (CLD). CLD-associated PH (CLD-PH) is invariably associated with reduced functional ability, impaired quality of life, greater oxygen requirements and an increased risk of mortality. The aetiology of CLD-PH is complex and multifactorial, with differences in the pathogenic sequelae between the diverse forms of CLD. Haemodynamic evaluation of PH severity should be contextualised within the extent of the underlying lung disease, which is best gauged through a combination of physiological and imaging assessment. Who, when, if and how to screen for PH will be addressed in this article, as will the current state of knowledge with regard to the role of treatment with pulmonary vasoactive agents. Although such therapy cannot be endorsed given the current state of findings, future studies in this area are strongly encouraged.", "affiliation": "Inova Fairfax Hospital, Falls Church, VA, USA.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic-Print", "pubTypeList": {"pubType": ["research-article", "Review", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Animals"}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Hypertension, Pulmonary", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DT", "qualifierName": "drug therapy"}, {"majorTopic_YN": "Y", "abbreviation": "EP", "qualifierName": "epidemiology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Lung Diseases, Interstitial", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "CO", "qualifierName": "complications"}, {"majorTopic_YN": "N", "abbreviation": "DT", "qualifierName": "drug 