": {"authorAffiliation": [{"affiliation": "Institute of Computer Science, University of Bern, Neubrückstrasse 10 3012 Bern, Switzerland."}, {"affiliation": "Population Health Sciences, Bristol Medical School, University of Bristol, Bristol BS8 1UD, UK."}]}}, {"fullName": "Hu Q", "lastName": "Hu", "firstName": "Qiyang", "initials": "Q", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Computer Science, University of Bern, Neubrückstrasse 10 3012 Bern, Switzerland."}]}}, {"fullName": "Aellen FM", "lastName": "Aellen", "firstName": "Florence Marcelle", "initials": "FM", "authorId": {"type": "ORCID", "value": "0000-0001-9087-8359"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Computer Science, University of Bern, Neubrückstrasse 10 3012 Bern, Switzerland."}]}}, {"fullName": "Faraci FD", "lastName": "Faraci", "firstName": "Francesca Dalia", "initials": "FD", "authorId": {"type": "ORCID", "value": "0000-0002-8720-1256"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Digital Technologies for Personalized Healthcare (MeDiTech), Department of Innovative Technologies, University of Applied Sciences and Arts of Southern Switzerland, 6962 Lugano, Switzerland."}]}}, {"fullName": "Tzovara A", "lastName": "Tzovara", "firstName": "Athina", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0002-7588-1418"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Computer Science, University of Bern, Neubrückstrasse 10 3012 Bern, Switzerland."}, {"affiliation": "Sleep Wake Epilepsy Center | NeuroTec, Department of Neurology, Inselspital, Bern University Hospital, University of Bern, 3010 Bern, Switzerland."}, {"affiliation": "Helen Wills Neuroscience Institute, University of California Berkeley, Berkeley, CA 94720, USA."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-9087-8359"}, {"type": "ORCID", "value": "0000-0002-6611-118X"}, {"type": "ORCID", "value": "0000-0002-7588-1418"}, {"type": "ORCID", "value": "0000-0002-8720-1256"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "10", "volume": "2", "journalIssueId": 3247395, "dateOfPublication": "2021 Oct", "monthOfPublication": 10, "yearOfPublication": 2021, "journal": {"medlineAbbreviation": "Patterns (N Y)", "title": "Patterns (New York, N.Y.)", "essn": "2666-3899", "issn": "2666-3899", "isoabbreviation": "Patterns (N Y)", "nlmid": "101767765"}, "printPublicationDate": "2021-10-01"}, "pubYear": "2021", "pageInfo": "100347", "abstractText": "Artificial intelligence (AI) has an astonishing potential in assisting clinical decision making and revolutionizing the field of health care. A major open challenge that AI will need to address before its integration in the clinical routine is that of algorithmic bias. Most AI algorithms need big datasets to learn from, but several groups of the human population have a long history of being absent or misrepresented in existing biomedical datasets. If the training data is misrepresentative of the population variability, AI is prone to reinforcing bias, which can lead to fatal outcomes, misdiagnoses, and lack of generalization. Here, we describe the challenges in rendering AI algorithms fairer, and we propose concrete steps for addressing bias using tools from the field of open science.", "affiliation": "Institute of Computer Science, University of Bern, Neubrückstrasse 10 3012 Bern, Switzerland.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic-eCollection", "pubTypeList": {"pubType": ["review-article", "Review", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Swiss National Science Foundation", "grantId": "320030", "orderIn": 0}, {"agency": "Swiss National Science Foundation", "grantId": "188737", "orderIn": 0}, {"agency": "Swiss National Science Foundation", "grantId": "320030_188737"