-2399-8083"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Harvard University."}]}}, {"fullName": "Arganda-Carreras I", "lastName": "Arganda-Carreras", "firstName": "Ignacio", "initials": "I", "authorId": {"type": "ORCID", "value": "0000-0003-0229-5722"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Donostia International Physics Center."}, {"affiliation": "University of the Basque Country."}, {"affiliation": "Ikerbasque, Basque Foundation for Science."}]}}, {"fullName": "Lichtman JW", "lastName": "Lichtman", "firstName": "Jeff W", "initials": "JW", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Harvard University."}]}}, {"fullName": "Pfister H", "lastName": "Pfister", "firstName": "Hanspeter", "initials": "H", "authorId": {"type": "ORCID", "value": "0000-0002-3620-2582"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Harvard University."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-1109-110X"}, {"type": "ORCID", "value": "0000-0002-2399-8083"}, {"type": "ORCID", "value": "0000-0002-3620-2582"}, {"type": "ORCID", "value": "0000-0002-8511-9670"}, {"type": "ORCID", "value": "0000-0003-0229-5722"}, {"type": "ORCID", "value": "0000-0003-4176-8035"}]}, "journalInfo": {"volume": "12265", "journalIssueId": 3063315, "dateOfPublication": "2020 Oct", "monthOfPublication": 10, "yearOfPublication": 2020, "journal": {"medlineAbbreviation": "Med Image Comput Comput Assist Interv", "title": "Medical image computing and computer-assisted intervention : MICCAI ... International Conference on Medical Image Computing and Computer-Assisted Intervention", "isoabbreviation": "Med Image Comput Comput Assist Interv", "nlmid": "101249582"}, "printPublicationDate": "2020-10-01"}, "pubYear": "2020", "pageInfo": "66-76", "abstractText": "Electron microscopy (EM) allows the identification of intracellular organelles such as mitochondria, providing insights for clinical and scientific studies. However, public mitochondria segmentation datasets only contain hundreds of instances with simple shapes. It is unclear if existing methods achieving human-level accuracy on these small datasets are robust in practice. To this end, we introduce the <i>MitoEM</i> dataset, a 3D mitochondria instance segmentation dataset with two (30<i>μ</i>m)<sup>3</sup> volumes from human and rat cortices respectively, 3, 600× larger than previous benchmarks. With around 40K instances, we find a great diversity of mitochondria in terms of shape and density. For evaluation, we tailor the implementation of the average precision (AP) metric for 3D data with a 45× speedup. On MitoEM, we find existing instance segmentation methods often fail to correctly segment mitochondria with complex shapes or close contacts with other instances. Thus, our MitoEM dataset poses new challenges to the field. We release our code and data: https://donglaiw.github.io/page/mitoEM/index.html.", "affiliation": "Harvard University.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U54 CA225088", "orderIn": 0}]}, "keywordList": {"keyword": ["Mitochondria", "3d Instance Segmentation", "Em Dataset"]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Free", "availabilityCode": "F", "documentStyle": "html", "site": "Unpaywall", "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/7713709"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1007/978-3-030-59722-1_7"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC7713709"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC7713709?pdf=render"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1007/978-3-030-59722-1_7"}]}, "isOpenAccess": "N", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 60, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "N", "hasData": "N", "authMan": "Y", "epmcAuthMan": "N", "nihAuthMan": "Y", "manuscriptId": "NIHMS1648694", "hasTMAccessionNumbers": "N", "dateOfCreation": "2020-12-07", "dateOfRevision": "2024-03-30", "electronicPublicationDate": "2020-09-29", "firstPublicationDate": "2020-09-29", "firstIndexDate": "2020-12-09", "fullTextReceivedDate": "2025-02-03", "hasEvaluations": "N"}]}}