: "Visvikis D", "lastName": "Visvikis", "firstName": "D", "initials": "D", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "LaTiM, INSERM, UMR 1101, Univ Brest, Brest, France."}, {"affiliation": "equally contributed."}]}}, {"fullName": "Hatt M", "lastName": "Hatt", "firstName": "M", "initials": "M", "authorId": {"type": "ORCID", "value": "0000-0002-8938-8667"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "LaTiM, INSERM, UMR 1101, Univ Brest, Brest, France."}, {"affiliation": "equally contributed."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-5730-4211"}, {"type": "ORCID", "value": "0000-0002-8938-8667"}, {"type": "ORCID", "value": "0009-0004-4696-2683"}]}, "journalInfo": {"issue": "24", "volume": "65", "journalIssueId": 3076161, "dateOfPublication": "2020 Dec", "monthOfPublication": 12, "yearOfPublication": 2020, "journal": {"medlineAbbreviation": "Phys Med Biol", "title": "Physics in medicine and biology", "essn": "1361-6560", "issn": "0031-9155", "nlmid": "0401220", "isoabbreviation": "Phys Med Biol"}, "printPublicationDate": "2020-12-01"}, "pubYear": "2020", "pageInfo": "24TR02", "abstractText": "Carrying out large multicenter studies is one of the key goals to be achieved towards a faster transfer of the radiomics approach in the clinical setting. This requires large-scale radiomics data analysis, hence the need for integrating radiomic features extracted from images acquired in different centers. This is challenging as radiomic features exhibit variable sensitivity to differences in scanner model, acquisition protocols and reconstruction settings, which is similar to the so-called 'batch-effects' in genomics studies. In this review we discuss existing methods to perform data integration with the aid of reducing the unwanted variation associated with batch effects. We also discuss the future potential role of deep learning methods in providing solutions for addressing radiomic multicentre studies.", "affiliation": "LaTiM, INSERM, UMR 1101, Univ Brest, Brest, France.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["Review", "Journal Article"]}, "grantsList": {"grant": [{"agency": "H2020 Marie Skłodowska-Curie Actions", "grantId": "766276 PREDICT H2020-MSCA-ITN-2017", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Quality Control"}, {"majorTopic_YN": "Y", "descriptorName": "Image Processing, Computer-Assisted", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Multicenter Studies as Topic"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1088/1361-6560/aba798"}]}, "isOpenAccess": "N", "inEPMC": "N", "inPMC": "N", "citedByCount": 125, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "N", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "N", "hasData": "N", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "N", "dateOfCompletion": "2021-04-14", "dateOfCreation": "2020-07-21", "dateOfRevision": "2024-04-01", "electronicPublicationDate": "2020-12-17", "firstPublicationDate": "2020-12-17", "firstIndexDate": "2020-07-21", "hasEvaluations": "N"}]}}