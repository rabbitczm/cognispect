iliation": "Department of Preventive Medicine, Feinberg School of Medicine, Northwestern University, Chicago, IL 60611, USA."}]}}, {"fullName": "Wu X", "lastName": "Wu", "firstName": "Xin", "initials": "X", "authorId": {"type": "ORCID", "value": "0000-0003-2386-6344"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Medicine, University of Illinois at Chicago, Chicago, IL 60612, USA."}]}}, {"fullName": "Yang P", "lastName": "Yang", "firstName": "Ping", "initials": "P", "authorId": {"type": "ORCID", "value": "0000-0002-8588-847X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Quantitative Health Sciences, Mayo Clinic, Rochester, MN 55905 / Scottsdale, AZ 85259, USA."}]}}, {"fullName": "Jiang G", "lastName": "Jiang", "firstName": "Guoqian", "initials": "G", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Artificial Intelligence and Informatics, Mayo Clinic, Rochester, MN 55905, USA."}]}}, {"fullName": "Luo Y", "lastName": "Luo", "firstName": "Yuan", "initials": "Y", "authorId": {"type": "ORCID", "value": "0000-0003-0195-7456"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Preventive Medicine, Feinberg School of Medicine, Northwestern University, Chicago, IL 60611, USA. Electronic address: yuan.luo@northwestern.edu."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-9699-5118"}, {"type": "ORCID", "value": "0000-0002-8588-847X"}, {"type": "ORCID", "value": "0000-0003-0195-7456"}, {"type": "ORCID", "value": "0000-0003-2386-6344"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "5", "volume": "20", "journalIssueId": 3522608, "dateOfPublication": "2022 Oct", "monthOfPublication": 10, "yearOfPublication": 2022, "journal": {"medlineAbbreviation": "Genomics Proteomics Bioinformatics", "title": "Genomics, proteomics & bioinformatics", "essn": "2210-3244", "issn": "1672-0229", "nlmid": "101197608", "isoabbreviation": "Genomics Proteomics Bioinformatics"}, "printPublicationDate": "2022-10-01"}, "pubYear": "2022", "pageInfo": "850-866", "abstractText": "The recent development of imaging and sequencing technologies enables systematic advances in the clinical study of lung cancer. Meanwhile, the human mind is limited in effectively handling and fully utilizing the accumulation of such enormous amounts of data. Machine learning-based approaches play a critical role in integrating and analyzing these large and complex datasets, which have extensively characterized lung cancer through the use of different perspectives from these accrued data. In this review, we provide an overview of machine learning-based approaches that strengthen the varying aspects of lung cancer diagnosis and therapy, including early detection, auxiliary diagnosis, prognosis prediction, and immunotherapy practice. Moreover, we highlight the challenges and opportunities for future applications of machine learning in lung cancer.", "affiliation": "Department of Preventive Medicine, Feinberg School of Medicine, Northwestern University, Chicago, IL 60611, USA.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["review-article", "Review", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NCATS NIH HHS", "acronym": "TR", "grantId": "U01 TR003528", "orderIn": 0}, {"agency": "National Institutes of Health", "grantId": "U01TR003528", "orderIn": 0}, {"agency": "NLM NIH HHS", "acronym": "LM", "grantId": "R01 LM013337", "orderIn": 0}, {"agency": "National Institutes of Health", "grantId": "R01LM013337", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "Y", "descriptorName": "Lung Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DI", "qualifier