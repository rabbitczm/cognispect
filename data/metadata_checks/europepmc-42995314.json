ype": "ORCID", "value": "0000-0002-2059-1317"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Diagnostics and Intervention, Surgery, Umeå University, Umeå, Sweden. josefin.jonsson@umu.se."}]}}, {"fullName": "Ling A", "lastName": "Ling", "firstName": "A", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0002-9503-0784"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Medical Biosciences, Pathology, Umeå University, Umeå, Sweden."}]}}, {"fullName": "Axelsson J", "lastName": "Axelsson", "firstName": "J", "initials": "J", "authorId": {"type": "ORCID", "value": "0000-0002-3731-3612"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Diagnostics and Intervention, Radiation Physics, Umeå University, Umeå, Sweden."}]}}, {"fullName": "Lundin M", "lastName": "Lundin", "firstName": "M", "initials": "M", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Diagnostics and Intervention, Surgery, Umeå University, Umeå, Sweden."}, {"affiliation": "Department of Statistics, Umeå School of Business, Economics and Statistics (USBE), Statistics Umeå University, Umeå, Sweden."}]}}, {"fullName": "Vermeulen P", "lastName": "Vermeulen", "firstName": "P", "initials": "P", "authorId": {"type": "ORCID", "value": "0000-0002-5676-3141"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Translational Cancer Research Unit, Oncology Center Antwerp, Ziekenhuis aan de Stroom, Wilrijk, Antwerp, Belgium."}]}}, {"fullName": "Riklund K", "lastName": "Riklund", "firstName": "K", "initials": "K", "authorId": {"type": "ORCID", "value": "0000-0001-5227-8117"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Diagnostics and Intervention, Diagnostic Radiology, Umeå University, Umeå, Sweden."}]}}, {"fullName": "Nyström H", "lastName": "Nyström", "firstName": "H", "initials": "H", "authorId": {"type": "ORCID", "value": "0000-0003-4595-5399"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Diagnostics and Intervention, Surgery, Umeå University, Umeå, Sweden."}, {"affiliation": "Wallenberg Centre for Molecular Medicine, Umeå University, Umeå, Sweden."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5227-8117"}, {"type": "ORCID", "value": "0000-0002-2059-1317"}, {"type": "ORCID", "value": "0000-0002-3731-3612"}, {"type": "ORCID", "value": "0000-0002-5676-3141"}, {"type": "ORCID", "value": "0000-0002-9503-0784"}, {"type": "ORCID", "value": "0000-0003-4595-5399"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "6", "volume": "43", "journalIssueId": 4306850, "dateOfPublication": "2026 Nov", "monthOfPublication": 11, "yearOfPublication": 2026, "journal": {"medlineAbbreviation": "Clin Exp Metastasis", "title": "Clinical & experimental metastasis", "essn": "1573-7276", "issn": "0262-0898", "nlmid": "8409970", "isoabbreviation": "Clin Exp Metastasis"}, "printPublicationDate": "2026-11-01"}, "pubYear": "2026", "pageInfo": "63", "abstractText": "Colorectal liver metastases (CLM) exhibit distinct histopathological growth patterns (HGPs) at the metastasis-liver interface, clinically relevant for prognosis and potential predictive value. This study investigates the feasibility of using Fluorine-18 Fluorodeoxyglucose Positron Emission Tomography Computed Tomography (<sup>18</sup>F-FDG PET/CT) to preoperatively classify HGPs in CLM and secondly investigate PET parameters as prognostic markers for overall survival (OS). In a prospective study at Umeå University Hospital (June 2013-December 2017), 78 patients with resectable CLM underwent contrast-enhanced liver MRI and <sup>18</sup>F-FDG PET/CT imaging. HGP classification was performed on tissue sections according to 2017 international guidelines. PET features (SUV<sub>mean</sub> [standardised uptake value], SUV<sub>max</sub>, metabolic tumour volume [MTV] and first-order texture metrics) were analysed to distinguish encapsulating (eHGP) from replacement (rHGP) patterns. In pretreated patients, multivariate logistic regression including both metabolic and texture parameters identified significant associations for parameters from the fixed level threshold algorithm (VuePoint Sharp IR) with small odds ratios. Overall, PET parameters showed limited ability to discriminate between eHGP and rHGP. OS was superior with eHGP versus rHGP (log-rank p = 0.045). In chemonaïve patients, SUV-based metrics showed unadjusted exploratory associations with OS after liver surgery, varying by reconstruction/delineation and were not significant after correction for multiple testing. FDG-PET-derived parameters were not reliably associated with HGP and did not support non-invasive HGP prediction in this cohort. eHGP was associated with superior survival, underscoring the value of HGP assessment for prognostication while alternative non-invasive biomarkers remain to be identified.", "affiliation": "Department of Diagnostics and Intervention, Surgery, Umeå University, Umeå, Sweden. josefin.jonsson@umu.se.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "Y", "descriptorName": "Colorectal Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}, {"majorTopic_YN": "N", "abbreviation": "MO", "qualifierName": "mortality"}, {"majorTopic_YN": "N", "abbreviation": "PA", "qualifierName": "pathology"}, {"majorTopic_YN": "N", "abbreviation": "SU", "qualifierName": "surgery"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Liver Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}, {"majorTopic_YN": "N", "abbreviation": "CL", "qualifierName": "classification"}, {"majorTopic_YN": "N", "abbreviation": "MO", "qualifierName": "mortality"}, {"majorTopic_YN": "N", "abbreviation": "PA", "qualifierName": "pathology"}, {"majorTopic_YN": "N", "abbreviation": "SC", "qualifierName": "secondary"}, {"majorTopic_YN": "N", "abbreviation": "SU", "qualifierName": "surgery"}]}}, {"majorTopic_YN": "N", "descriptorName": "Fluorodeoxyglucose F18", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "AD", "qualifierName": "administration & dosage"}]}}, {"majorTopic_YN": "N", "descriptorName": "Radiopharmaceuticals", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "AD", "qualifierName": "administration & dosage"}]}}, {"majorTopic_YN": "N", "descriptorName": "Prognosis"}, {"majorTopic_YN": "N", "descriptorName": "Prospective Studies"}, {"majorTopic_YN": "N", "descriptorName": "Adult"}, {"majorTopic_YN": "N", "descriptorName": "Aged"}, {"majorTopic_YN": "N", "descriptorName": "Middle Aged"}, {"majorTopic_YN": "N", "descriptorName": "Female"}, {"majorTopic_YN": "N", "descriptorName": "Male"}, {"majorTopic_YN": "Y", "descriptorName": "Positron Emission Tomography Computed Tomography", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "MT", "qualifierName": "methods"}]}}]}, "keywordList": {"keyword": ["Texture analysis", "Fdg-pet/ct", "Colorectal Liver Metastases", "Metabolic Tumour Volume", "Histopathological Growth Pattern"]}, "chemicalList": {"chemical": [{"name": "Radiopharmaceuticals", "registryNumber": "0"}, {"name": "Fluorodeoxyglucose F18", "registryNumber": "0Z5B2CJX4D"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1007/s10585-026-10441-x"}, {"availability