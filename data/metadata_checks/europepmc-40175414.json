RCID", "value": "0000-0003-3034-7665"}, {"type": "ORCID", "value": "0000-0003-3457-9359"}, {"type": "ORCID", "value": "0000-0003-3584-4433"}, {"type": "ORCID", "value": "0000-0003-3597-596X"}, {"type": "ORCID", "value": "0000-0003-3942-4284"}, {"type": "ORCID", "value": "0000-0003-4604-217X"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "1", "volume": "16", "journalIssueId": 3920965, "dateOfPublication": "2025 Apr", "monthOfPublication": 4, "yearOfPublication": 2025, "journal": {"medlineAbbreviation": "Nat Commun", "title": "Nature communications", "essn": "2041-1723", "issn": "2041-1723", "isoabbreviation": "Nat Commun", "nlmid": "101528555"}, "printPublicationDate": "2025-04-01"}, "pubYear": "2025", "pageInfo": "3165", "abstractText": "The landscape of diagnostic testing is undergoing a significant transformation, driven by the integration of artificial intelligence (AI) and machine learning (ML) into decentralized, rapid, and accessible sensor platforms for point-of-care testing (POCT). The COVID-19 pandemic has accelerated the shift from centralized laboratory testing but also catalyzed the development of next-generation POCT platforms that leverage ML to enhance the accuracy, sensitivity, and overall efficiency of point-of-care sensors. This Perspective explores how ML is being embedded into various POCT modalities, including lateral flow assays, vertical flow assays, nucleic acid amplification tests, and imaging-based sensors, illustrating their impact through different applications. We also discuss several challenges, such as regulatory hurdles, reliability, and privacy concerns, that must be overcome for the widespread adoption of ML-enhanced POCT in clinical settings and provide a comprehensive overview of the current state of ML-driven POCT technologies, highlighting their potential impact in the future of healthcare.", "affiliation": "Electrical & Computer Engineering Department, University of California, Los Angeles, CA, USA.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["review-article", "Review", "Journal Article"]}, "grantsList": {"grant": [{"agency": "National Science Foundation", "grantId": "1648451", "orderIn": 0}, {"agency": "National Science Foundation (NSF)", "grantId": "1648451", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Reproducibility of Results"}, {"majorTopic_YN": "N", "descriptorName": "Artificial Intelligence"}, {"majorTopic_YN": "N", "descriptorName": "Point-of-Care Systems"}, {"majorTopic_YN": "N", "descriptorName": "Pandemics"}, {"majorTopic_YN": "Y", "descriptorName": "Machine Learning"}, {"majorTopic_YN": "Y", "descriptorName": "Point-of-Care Testing", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "TD", "qualifierName": "trends"}]}}, {"majorTopic_YN": "Y", "descriptorName": "COVID-19", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DI", "qualifierName": "diagnosis"}, {"majorTopic_YN": "N", "abbreviation": "VI", "qualifierName": "virology"}]}}, {"majorTopic_YN": "N", "descriptorName": "SARS-CoV-2", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "IP", "qualifierName": "isolation & purification"}]}}, {"majorTopic_YN": "N", "descriptorName": "COVID-19 Testing", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "MT", "qualifierName": "methods"}]}}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1038/s41467-025-58527-6"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC