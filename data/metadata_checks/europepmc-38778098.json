liation": "Providence Genomics, Portland, OR, USA. carlo.bifulco@providence.org."}, {"affiliation": "Earle A. Chiles Research Institute, Providence Cancer Institute, Portland, OR, USA. carlo.bifulco@providence.org."}]}}, {"fullName": "Wang S", "lastName": "Wang", "firstName": "Sheng", "initials": "S", "authorId": {"type": "ORCID", "value": "0000-0002-0439-5199"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Paul G. Allen School of Computer Science and Engineering, University of Washington, Seattle, WA, USA. swang@cs.washington.edu."}, {"affiliation": "Department of Surgery, University of Washington, Seattle, WA, USA. swang@cs.washington.edu."}]}}, {"fullName": "Poon H", "lastName": "Poon", "firstName": "Hoifung", "initials": "H", "authorId": {"type": "ORCID", "value": "0000-0002-9067-0918"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Microsoft Research, Redmond, WA, USA. hoifung@microsoft.com."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-0439-5199"}, {"type": "ORCID", "value": "0000-0002-1704-1744"}, {"type": "ORCID", "value": "0000-0002-2683-8157"}, {"type": "ORCID", "value": "0000-0002-9067-0918"}, {"type": "ORCID", "value": "0000-0003-0888-929X"}, {"type": "ORCID", "value": "0000-0003-1922-6977"}, {"type": "ORCID", "value": "0000-0003-2150-1747"}, {"type": "ORCID", "value": "0009-0002-0183-5483"}, {"type": "ORCID", "value": "0009-0005-7792-0483"}, {"type": "ORCID", "value": "0009-0005-8469-8892"}, {"type": "ORCID", "value": "0009-0006-7692-6709"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "8015", "volume": "630", "journalIssueId": 3778098, "dateOfPublication": "2024 Jun", "monthOfPublication": 6, "yearOfPublication": 2024, "journal": {"medlineAbbreviation": "Nature", "title": "Nature", "essn": "1476-4687", "issn": "0028-0836", "nlmid": "0410462", "isoabbreviation": "Nature"}, "printPublicationDate": "2024-06-01"}, "pubYear": "2024", "pageInfo": "181-188", "abstractText": "Digital pathology poses unique computational challenges, as a standard gigapixel slide may comprise tens of thousands of image tiles<sup>1-3</sup>. Prior models have often resorted to subsampling a small portion of tiles for each slide, thus missing the important slide-level context<sup>4</sup>. Here we present Prov-GigaPath, a whole-slide pathology foundation model pretrained on 1.3 billion 256 × 256 pathology image tiles in 171,189 whole slides from Providence, a large US health network comprising 28 cancer centres. The slides originated from more than 30,000 patients covering 31 major tissue types. To pretrain Prov-GigaPath, we propose GigaPath, a novel vision transformer architecture for pretraining gigapixel pathology slides. To scale GigaPath for slide-level learning with tens of thousands of image tiles, GigaPath adapts the newly developed LongNet<sup>5</sup> method to digital pathology. To evaluate Prov-GigaPath, we construct a digital pathology benchmark comprising 9 cancer subtyping tasks and 17 pathomics tasks, using both Providence and TCGA data<sup>6</sup>. With large-scale pretraining and ultra-large-context modelling, Prov-GigaPath attains state-of-the-art performance on 25 out of 26 tasks, with significant improvement over the second-best method on 18 tasks. We further demonstrate the potential of Prov-GigaPath on vision-language pretraining for pathology<sup>7,8</sup> by incorporating the pathology reports. In sum, Prov-GigaPath is an open-weight foundation model that achieves state-of-the-art performance on various digital pathology tasks, demonstrating the importance of real-world data and whole-slide modelling.", "affiliation": "Microsoft Research, Redmond, WA, USA.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"