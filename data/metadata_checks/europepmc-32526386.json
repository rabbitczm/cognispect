filiationDetailsList": {"authorAffiliation": [{"affiliation": "German Center for Neurodegenerative Diseases (DZNE), Bonn, Germany."}]}}, {"fullName": "Conjeti S", "lastName": "Conjeti", "firstName": "Sailesh", "initials": "S", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "German Center for Neurodegenerative Diseases (DZNE), Bonn, Germany."}]}}, {"fullName": "Estrada S", "lastName": "Estrada", "firstName": "Santiago", "initials": "S", "authorId": {"type": "ORCID", "value": "0000-0003-0339-8870"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "German Center for Neurodegenerative Diseases (DZNE), Bonn, Germany."}]}}, {"fullName": "Diers K", "lastName": "Diers", "firstName": "Kersten", "initials": "K", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "German Center for Neurodegenerative Diseases (DZNE), Bonn, Germany."}]}}, {"fullName": "Fischl B", "lastName": "Fischl", "firstName": "Bruce", "initials": "B", "authorId": {"type": "ORCID", "value": "0000-0002-2413-1115"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "A.A. Martinos Center for Biomedical Imaging, Massachusetts General Hospital, Boston MA, USA; Department of Radiology, Harvard Medical School, Boston, MA, USA; Computer Science and Artificial Intelligence Laboratory, MIT, Cambridge, MA, USA."}]}}, {"fullName": "Reuter M", "lastName": "Reuter", "firstName": "Martin", "initials": "M", "authorId": {"type": "ORCID", "value": "0000-0002-2665-9693"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "German Center for Neurodegenerative Diseases (DZNE), Bonn, Germany; A.A. Martinos Center for Biomedical Imaging, Massachusetts General Hospital, Boston MA, USA; Department of Radiology, Harvard Medical School, Boston, MA, USA. Electronic address: martin.reuter@dzne.de."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-2413-1115"}, {"type": "ORCID", "value": "0000-0002-2665-9693"}, {"type": "ORCID", "value": "0000-0003-0339-8870"}, {"type": "ORCID", "value": "0009-0003-0370-8602"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics"]}, "journalInfo": {"volume": "219", "journalIssueId": 2996277, "dateOfPublication": "2020 Oct", "monthOfPublication": 10, "yearOfPublication": 2020, "journal": {"medlineAbbreviation": "Neuroimage", "title": "NeuroImage", "essn": "1095-9572", "issn": "1053-8119", "nlmid": "9215515", "isoabbreviation": "Neuroimage"}, "printPublicationDate": "2020-10-01"}, "pubYear": "2020", "pageInfo": "117012", "abstractText": "Traditional neuroimage analysis pipelines involve computationally intensive, time-consuming optimization steps, and thus, do not scale well to large cohort studies with thousands or tens of thousands of individuals. In this work we propose a fast and accurate deep learning based neuroimaging pipeline for the automated processing of structural human brain MRI scans, replicating FreeSurfer's anatomical segmentation including surface reconstruction and cortical parcellation. To this end, we introduce an advanced deep learning architecture capable of whole-brain segmentation into 95 classes. The network architecture incorporates local and global competition via competitive dense blocks and competitive skip pathways, as well as multi-slice information aggregation that specifically tailor network performance towards accurate segmentation of both cortical and subcortical structures. Further, we perform fast cortical surface reconstruction and thickness analysis by introducing a spectral spherical embedding and by directly mapping the cortical labels from the image to the surface. This approach provides a full FreeSurfer alternative for volumetric analysis (in under 1 ​min) and surface-based thickness analysis (within only around 1 ​h runtime). For sustainability of this approach we perform extensive validation: we assert high segmentation accuracy on several unseen datasets, measure generalizability and demonstrate increased test-retest reliability, and high sensitivity to group differences in dementia.", "affiliation": "German Center for Neurodegenerative Diseases (DZNE), Bonn, Germany.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Research Support, U.S. Gov't, Non-P.H.S.", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "National Institute on Aging", "grantId": "1R01AG064027", "orderIn": 0}, {"agency": "University of Southern California", "grantId": "1U54MH091657", "orderIn": 0}, {"agency": "National Institute of Neurological Disorders and Stroke", "grantId": "5U01NS086625", "orderIn": 0}, {"agency": "NIBIB NIH HHS", "acronym": "EB", "grantId": "P41 EB015896", "orderIn": 0}, {"agency": "NIA NIH HHS", "acronym": "AG", "grantId": "P50 AG005681", "orderIn": 0}, {"agency": "NIA NIH HHS", "acronym": "AG", "grantId": "R01 AG016495", "orderIn": 0}, {"agency": "NIBIB NIH HHS", "acronym": "EB", "grantId": "R01 EB023281", "orderIn": 0}, {"agency": "NINDS NIH HHS", "acronym": "NS", "grantId": "R01 NS070963", "orderIn": 0}, {"agency": "NIA NIH HHS", "acronym": "AG", "grantId": "R56 AG064027", "orderIn": 0}, {"agency": "NCRR NIH HHS", "acronym": "RR", "grantId": "S10 RR023401", "orderIn": 0}, {"agency": "NIMH NIH HHS", "acronym": "MH", "grantId": "U01 MH093765", "orderIn": 0}, {"agency": "NCRR NIH HHS", "acronym": "RR", "grantId": "U24 RR021382", "orderIn": 0}, {"agency": "Genentech", "orderIn": 0}, {"agency": "National Institute of Mental Health", "orderIn": 0}, {"agency": "NIA NIH HHS", "acronym": "AG", "grantId": "P01 AG026276", "orderIn": 0}, {"agency": "NIMH NIH HHS", "acronym": "MH", "grantId": "P50 MH071616", "orderIn": 0}, {"agency": "National Institute of Biomedical Imaging and Bioengineering", "grantId": "R01EB006758", "orderIn": 0}, {"agency": "National Institute of Neurological Disorders and Stroke