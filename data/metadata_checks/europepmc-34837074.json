liation": [{"affiliation": "Department of Diagnostics and Public Health, Section of Pathology, University and Hospital Trust of Verona, 37134, Verona, Italy. claudio.luchini@univr.it."}, {"affiliation": "ARC-Net Research Center, University and Hospital Trust of Verona, 37134, Verona, Italy. claudio.luchini@univr.it."}]}}, {"fullName": "Pea A", "lastName": "Pea", "firstName": "Antonio", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0002-0509-6756"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Surgery, the Pancreas Institute, University and Hospital Trust of Verona, 37134, Verona, Italy."}]}}, {"fullName": "Scarpa A", "lastName": "Scarpa", "firstName": "Aldo", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0003-1678-739X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Diagnostics and Public Health, Section of Pathology, University and Hospital Trust of Verona, 37134, Verona, Italy. aldo.scarpa@univr.it."}, {"affiliation": "ARC-Net Research Center, University and Hospital Trust of Verona, 37134, Verona, Italy. aldo.scarpa@univr.it."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-0509-6756"}, {"type": "ORCID", "value": "0000-0003-1678-739X"}, {"type": "ORCID", "value": "0000-0003-4901-4908"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics"]}, "journalInfo": {"issue": "1", "volume": "126", "journalIssueId": 3287850, "dateOfPublication": "2022 Jan", "monthOfPublication": 1, "yearOfPublication": 2022, "journal": {"medlineAbbreviation": "Br J Cancer", "title": "British journal of cancer", "essn": "1532-1827", "issn": "0007-0920", "isoabbreviation": "Br J Cancer", "nlmid": "0370635"}, "printPublicationDate": "2022-01-01"}, "pubYear": "2022", "pageInfo": "4-9", "abstractText": "Artificial intelligence (AI) is concretely reshaping the landscape and horizons of oncology, opening new important opportunities for improving the management of cancer patients. Analysing the AI-based devices that have already obtained the official approval by the Federal Drug Administration (FDA), here we show that cancer diagnostics is the oncology-related area in which AI is already entered with the largest impact into clinical practice. Furthermore, breast, lung and prostate cancers represent the specific cancer types that now are experiencing more advantages from AI-based devices. The future perspectives of AI in oncology are discussed: the creation of multidisciplinary platforms, the comprehension of the importance of all neoplasms, including rare tumours and the continuous support for guaranteeing its growth represent in this time the most important challenges for finalising the 'AI-revolution' in oncology.", "affiliation": "Department of Diagnostics and Public Health, Section of Pathology, University and Hospital Trust of Verona, 37134, Verona, Italy. claudio.luchini@univr.it.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "review-article", "Review", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Fondazione Cassa di Risparmio di Verona Vicenza Belluno e Ancona", "grantId": "203885/2017", "orderIn": 0}, {"agency": "Associazione Italiana per la Ricerca sul Cancro", "grantId": "12182", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "DI", "qualifierName": "diagnosis"}, {"majorTopic_YN": "Y", "abbreviation": "TH", "qualifierName": "therapy"}]}}, {"majorTopic_YN": "N", "descriptorName": "Medical Oncology", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Forecasting"}, {"majorTopic_YN": "Y", "descriptorName":