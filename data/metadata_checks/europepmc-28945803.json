 "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Psychology, Stanford University, Stanford, California, United States of America."}]}}, {"fullName": "Birman D", "lastName": "Birman", "firstName": "Daniel", "initials": "D", "authorId": {"type": "ORCID", "value": "0000-0003-3748-6289"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Psychology, Stanford University, Stanford, California, United States of America."}]}}, {"fullName": "Schaer M", "lastName": "Schaer", "firstName": "Marie", "initials": "M", "authorId": {"type": "ORCID", "value": "0000-0001-8479-6365"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Psychiatry, University of Geneva School of Medicine, Geneva, Switzerland."}]}}, {"fullName": "Koyejo OO", "lastName": "Koyejo", "firstName": "Oluwasanmi O", "initials": "OO", "authorId": {"type": "ORCID", "value": "0000-0002-4023-419X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Computer Science, University of Illinois at Urbana-Champaign, Urbana-Champaign, Illinois, United States of America."}]}}, {"fullName": "Poldrack RA", "lastName": "Poldrack", "firstName": "Russell A", "initials": "RA", "authorId": {"type": "ORCID", "value": "0000-0001-6755-0259"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Psychology, Stanford University, Stanford, California, United States of America."}]}}, {"fullName": "Gorgolewski KJ", "lastName": "Gorgolewski", "firstName": "Krzysztof J", "initials": "KJ", "authorId": {"type": "ORCID", "value": "0000-0003-3321-7583"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Psychology, Stanford University, Stanford, California, United States of America."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-6755-0259"}, {"type": "ORCID", "value": "0000-0001-8435-6191"}, {"type": "ORCID", "value": "0000-0001-8479-6365"}, {"type": "ORCID", "value": "0000-0002-4023-419X"}, {"type": "ORCID", "value": "0000-0003-3321-7583"}, {"type": "ORCID", "value": "0000-0003-3748-6289"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "9", "volume": "12", "journalIssueId": 2591647, "dateOfPublication": "2017 ", "monthOfPublication": 0, "yearOfPublication": 2017, "journal": {"medlineAbbreviation": "PLoS One", "title": "PloS one", "essn": "1932-6203", "issn": "1932-6203", "nlmid": "101285081", "isoabbreviation": "PLoS One"}, "printPublicationDate": "2017-01-01"}, "pubYear": "2017", "pageInfo": "e0184661", "abstractText": "Quality control of MRI is essential for excluding problematic acquisitions and avoiding bias in subsequent image processing and analysis. Visual inspection is subjective and impractical for large scale datasets. Although automated quality assessments have been demonstrated on single-site datasets, it is unclear that solutions can generalize to unseen data acquired at new sites. Here, we introduce the MRI Quality Control tool (MRIQC), a tool for extracting quality measures and fitting a binary (accept/exclude) classifier. Our tool can be run both locally and as a free online service via the OpenNeuro.org portal. The classifier is trained on a publicly available, multi-site dataset (17 sites, N = 1102). We perform model selection evaluating different normalization and feature exclusion approaches aimed at maximizing across-site generalization and estimate an accuracy of 76%±13% on new sites, using leave-one-site-out cross-validation. We confirm that result on a held-out dataset (2 sites, N = 265) also obtaining a 76% accuracy. Even though the performance of the trained classifier is statistically above chance, we show that it is susceptible to site effects and unable to account for artifacts specific to new sites. MRIQC performs with high accuracy in intra-site prediction, but performance on unseen sites leaves space for improvement which might require more labeled data and new approaches to the between-site variability. Overcoming these limitations is crucial for a more objective quality assessment of neuroimaging data, and to enable the analysis of extremely large and multi-site samples.", "affiliation": "Department of Psychology, Stanford University, Stanford, California, United States of America.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic-eCollection", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Swiss National Science Foundation", "grantId": "158831", "orderIn": 0}, {"agency": "Laura and John Arnold Foundation (US)", "orderIn": 0}, {"agency": "Swiss National Science Foundation", "grantId": "163859", "orderIn": 0}, {"agency": "Swiss National Science Foundation", "grantId": "158831,163859", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Brain", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}]}}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Image Interpretation, Computer-Assisted", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Observer Variation"}, {"majorTopic_YN": "N", "descriptorName": "Magnetic Resonance Imaging", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Image Enhancement", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Software"}, {"majorTopic_YN": "N", "descriptorName": "Neuroimaging", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "MT", "qualifierName": "methods"}]}}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1371/journal.pone.0184661"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC5612458"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC5612458?pdf=render"}]}, "commentCorrectionList": {"commentCorrection": [{"source": "PPR", "id": "PPR22426", "type": "Preprint in", "note": "CrossRef Pre-print loader", "orderIn": 10002}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 806, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "Y", "hasLabsLinks": "Y", "hasData": "Y", "license": "cc by", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "N", "dateOfCompletion": "2017-10-17", "dateOfCreation": "2017-09-26", "dateOfRevision": "2019-01-16", "electronicPublicationDate": "2017-09-25", "firstPublicationDate": "2017-09-25", "firstIndexDate": "2017-09-26", "fullTextReceivedDate": "2025-02-03", "hasEvaluations": "N"}]}}