uthorId": {"type": "ORCID", "value": "0009-0009-6317-3797"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "School of Chemical & Bioprocess Engineering, University College Dublin, D04 V1W8, Ireland."}]}}, {"fullName": "Nielsen LK", "lastName": "Nielsen", "firstName": "Lars K", "initials": "LK", "authorId": {"type": "ORCID", "value": "0000-0001-8191-3511"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Biotechnology Research Institute for the Green Transition (BRIGHT), Technical University of Denmark, Kgs. Lyngby, 2800, Denmark."}, {"affiliation": "Australian Institute for Bioengineering and Nanotechnology, University of Queensland, Brisbane, 4072, Australia."}]}}, {"fullName": "Jiménez Del Val I", "lastName": "Jiménez Del Val", "firstName": "Ioscani", "initials": "I", "authorId": {"type": "ORCID", "value": "0000-0001-9289-0191"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "School of Chemical & Bioprocess Engineering, University College Dublin, D04 V1W8, Ireland."}]}}, {"fullName": "Lavado-García J", "lastName": "Lavado-García", "firstName": "Jesús", "initials": "J", "authorId": {"type": "ORCID", "value": "0000-0001-9993-6332"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Biotechnology Research Institute for the Green Transition (BRIGHT), Technical University of Denmark, Kgs. Lyngby, 2800, Denmark."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-8191-3511"}, {"type": "ORCID", "value": "0000-0001-9289-0191"}, {"type": "ORCID", "value": "0000-0001-9993-6332"}, {"type": "ORCID", "value": "0009-0009-6317-3797"}]}, "journalInfo": {"volume": "19", "journalIssueId": 4277771, "dateOfPublication": "2027 May", "monthOfPublication": 5, "yearOfPublication": 2027, "journal": {"medlineAbbreviation": "Synth Syst Biotechnol", "title": "Synthetic and systems biotechnology", "essn": "2405-805X", "issn": "2405-805X", "nlmid": "101694371", "isoabbreviation": "Synth Syst Biotechnol"}, "printPublicationDate": "2027-05-01"}, "pubYear": "2027", "pageInfo": "69-80", "abstractText": "Predictable and tuneable gene expression is essential for advanced mammalian cell engineering yet remains challenged by genomic position effects and copy number variability. This study systematically compares random integration (RI) and targeted integration (TI) of two synthetic lineariser gene circuits, TetR/eGFP_Lin and PhlFd/mCherry_Lin, in CHO-S cells. Both circuits exhibited strong linearity and orthogonality across integration strategies, but integration method and repressor choice produced distinct performance trade-offs. RI increased achievable dynamic range for PhlFd but increased basal leakiness for TetR, whereas TI, via a dual-landing-pad system, constrained copy number, and reduced basal expression and PhlFd expression variability. These findings highlight integration context and circuit architecture as key design parameters informing rational design of synthetic regulators for biopharmaceutical applications.", "affiliation": "School of Chemical & Bioprocess Engineering, University College Dublin, D04 V1W8, Ireland.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic-eCollection", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "keywordList": {"keyword": ["targeted integration", "Synthetic Biology", "Computational Modelling", "Orthogonal Control", "Landing Pads", "Multiplex Genetic Circuits"]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1016/j.synbio.2026.10.004"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC13694990"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/article