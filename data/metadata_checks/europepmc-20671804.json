iation": [{"affiliation": "Department of Biomedical Informatics, The Ohio State University, Columbus, OH 43210, USA. metin.gurcan@osumc.edu"}]}}, {"fullName": "Boucheron LE", "lastName": "Boucheron", "firstName": "Laura E", "initials": "LE"}, {"fullName": "Can A", "lastName": "Can", "firstName": "Ali", "initials": "A"}, {"fullName": "Madabhushi A", "lastName": "Madabhushi", "firstName": "Anant", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0002-5741-0399"}}, {"fullName": "Rajpoot NM", "lastName": "Rajpoot", "firstName": "Nasir M", "initials": "NM", "authorId": {"type": "ORCID", "value": "0000-0002-4706-1308"}}, {"fullName": "Yener B", "lastName": "Yener", "firstName": "B", "initials": "B"}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-2421-8229"}, {"type": "ORCID", "value": "0000-0002-4706-1308"}, {"type": "ORCID", "value": "0000-0002-5741-0399"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"volume": "2", "journalIssueId": 1728193, "dateOfPublication": "2009 ", "monthOfPublication": 0, "yearOfPublication": 2009, "journal": {"medlineAbbreviation": "IEEE Rev Biomed Eng", "title": "IEEE reviews in biomedical engineering", "essn": "1941-1189", "issn": "1937-3333", "nlmid": "101493803", "isoabbreviation": "IEEE Rev Biomed Eng"}, "printPublicationDate": "2009-01-01"}, "pubYear": "2009", "pageInfo": "147-171", "abstractText": "Over the past decade, dramatic increases in computational power and improvement in image analysis algorithms have allowed the development of powerful computer-assisted analytical approaches to radiological data. With the recent advent of whole slide digital scanners, tissue histopathology slides can now be digitized and stored in digital image form. Consequently, digitized tissue histopathology has now become amenable to the application of computerized image analysis and machine learning techniques. Analogous to the role of computer-assisted diagnosis (CAD) algorithms in medical imaging to complement the opinion of a radiologist, CAD algorithms have begun to be developed for disease detection, diagnosis, and prognosis prediction to complement the opinion of the pathologist. In this paper, we review the recent state of the art CAD technology for digitized histopathology. This paper also briefly describes the development and application of novel image analysis technology for a few specific histopathology related problems being pursued in the United States and Europe.", "affiliation": "Department of Biomedical Informatics, The Ohio State University, Columbus, OH 43210, USA. metin.gurcan@osumc.edu", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, American Recovery and Reinvestment Act", "Research Support, Non-U.S. Gov't", "research-article", "Review", "Research Support, U.S. Gov't, Non-P.H.S.", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01CA136535-01", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R03 CA128081", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R03CA143991-01", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R03CA128081-01", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R21CA127186-01", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R03 CA143991", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "ARRA-NCL-3 21CA127186-02S1", "orderIn": 0}, {"agency": "NLM NIH HHS", "acronym": "LM", "grantId": "R01LM010119", "orderIn": 0}, {"agency": "NLM NIH HHS", "acronym": "LM", "grantId": "R01 LM010119", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01 CA134451", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01 CA136535", "orderIn": 0}, {"agency": "NCI NIH HHS", "ac