orAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Departments of Biomedical Sciences and Medicine, Cedars-Sinai Medical Center, Biomedical Imaging Research Institute, Los Angeles, California."}]}}, {"fullName": "Slomka PJ", "lastName": "Slomka", "firstName": "Piotr J", "initials": "PJ", "authorId": {"type": "ORCID", "value": "0000-0002-6110-938X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Departments of Biomedical Sciences and Medicine, Cedars-Sinai Medical Center, Biomedical Imaging Research Institute, Los Angeles, California."}]}}, {"fullName": "Leeson P", "lastName": "Leeson", "firstName": "Paul", "initials": "P", "authorId": {"type": "ORCID", "value": "0000-0001-9181-9297"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Oxford Cardiovascular Clinical Research Facility, Radcliffe Department of Medicine, University of Oxford, Oxford, United Kingdom."}]}}, {"fullName": "Comaniciu D", "lastName": "Comaniciu", "firstName": "Dorin", "initials": "D", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Siemens Corporate Technology, Munich, Germany."}]}}, {"fullName": "Shrestha S", "lastName": "Shrestha", "firstName": "Sirish", "initials": "S", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Section of Cardiology, West Virginia University, Morgantown, West Virginia."}]}}, {"fullName": "Sengupta PP", "lastName": "Sengupta", "firstName": "Partho P", "initials": "PP", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Section of Cardiology, West Virginia University, Morgantown, West Virginia."}]}}, {"fullName": "Marwick TH", "lastName": "Marwick", "firstName": "Thomas H", "initials": "TH", "authorId": {"type": "ORCID", "value": "0000-0001-9065-0899"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Baker Heart and Diabetes Research Institute, Melbourne, Australia. Electronic address: Tom.Marwick@bakeridi.edu.au."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-9065-0899"}, {"type": "ORCID", "value": "0000-0001-9181-9297"}, {"type": "ORCID", "value": "0000-0002-6110-938X"}, {"type": "ORCID", "value": "0000-0003-2236-6970"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "recommended_reviews", "supporting_data"]}, "journalInfo": {"issue": "11", "volume": "73", "journalIssueId": 2796174, "dateOfPublication": "2019 Mar", "monthOfPublication": 3, "yearOfPublication": 2019, "journal": {"medlineAbbreviation": "J Am Coll Cardiol", "title": "Journal of the American College of Cardiology", "essn": "1558-3597", "issn": "0735-1097", "isoabbreviation": "J Am Coll Cardiol", "nlmid": "8301365"}, "printPublicationDate": "2019-03-01"}, "pubYear": "2019", "pageInfo": "1317-1335", "abstractText": "Data science is likely to lead to major changes in cardiovascular imaging. Problems with timing, efficiency, and missed diagnoses occur at all stages of the imaging chain. The application of artificial intelligence (AI) is dependent on robust data; the application of appropriate computational approaches and tools; and validation of its clinical application to image segmentation, automated measurements, and eventually, automated diagnosis. AI may reduce cost and improve value at the stages of image acquisition, interpretation, and decision-making. Moreover, the precision now possible with cardiovascular imaging, combined with \"big data\" from the electronic health record and pathology, is likely to better characterize disease and personalize therapy. This review summarizes recent promising applications of AI in cardiology and cardiac imaging, which potentially add value to patient care.", "affiliation": "Departments of Biomedical Sciences and Medicine, Cedars-Sinai Medical Center, Biomedical Imaging Research Institute, Los Angeles, California.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["research-article", "