, "authorId": {"type": "ORCID", "value": "0000-0002-6050-2219"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Applied Bioinformatics Laboratories, New York University School of Medicine, New York, NY, USA."}, {"affiliation": "Skirball Institute, Department of Cell Biology, New York University School of Medicine, New York, NY, USA."}]}}, {"fullName": "Ocampo PS", "lastName": "Ocampo", "firstName": "Paolo Santiago", "initials": "PS", "authorId": {"type": "ORCID", "value": "0000-0003-4876-0861"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Pathology, New York University School of Medicine, New York, NY, USA."}]}}, {"fullName": "Sakellaropoulos T", "lastName": "Sakellaropoulos", "firstName": "Theodore", "initials": "T", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "School of Mechanical Engineering, National Technical University of Athens, Zografou, Greece."}]}}, {"fullName": "Narula N", "lastName": "Narula", "firstName": "Navneet", "initials": "N", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Pathology, New York University School of Medicine, New York, NY, USA."}]}}, {"fullName": "Snuderl M", "lastName": "Snuderl", "firstName": "Matija", "initials": "M", "authorId": {"type": "ORCID", "value": "0000-0003-0752-0917"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Pathology, New York University School of Medicine, New York, NY, USA."}]}}, {"fullName": "Fenyö D", "lastName": "Fenyö", "firstName": "David", "initials": "D", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute for Systems Genetics, New York University School of Medicine, New York, NY, USA."}, {"affiliation": "Department of Biochemistry and Molecular Pharmacology, New York University School of Medicine, New York, NY, USA."}]}}, {"fullName": "Moreira AL", "lastName": "Moreira", "firstName": "Andre L", "initials": "AL", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Pathology, New York University School of Medicine, New York, NY, USA."}, {"affiliation": "Center for Biospecimen Research and Development, New York University, New York, NY, USA."}]}}, {"fullName": "Razavian N", "lastName": "Razavian", "firstName": "Narges", "initials": "N", "authorId": {"type": "ORCID", "value": "0000-0002-9922-6370"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Population Health and the Center for Healthcare Innovation and Delivery Science, New York University School of Medicine, New York, NY, USA. narges.razavian@nyumc.org."}]}}, {"fullName": "Tsirigos A", "lastName": "Tsirigos", "firstName": "Aristotelis", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0002-7512-8477"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Applied Bioinformatics Laboratories, New York University School of Medicine, New York, NY, USA. aristotelis.tsirigos@nyumc.org."}, {"affiliation": "Department of Pathology, New York University School of Medicine, New York, NY, USA. aristotelis.tsirigos@nyumc.org."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-6050-2219"}, {"type": "ORCID", "value": "0000-0002-7512-8477"}, {"type": "ORCID", "value": "0000-0002-9922-6370"}, {"type": "ORCID", "value": "0000-0003-0752-0917"}, {"type": "ORCID", "value": "0000-0003-4876-0861"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data", "recommended_reviews"]}, "journalInfo": {"issue": "10", "volume": "24", "journalIssueId": 2736643, "dateOfPublication": "2018 Oct", "monthOfPublication": 10, "yearOfPublication": 2018, "journal": {"medlineAbbreviation": "Nat Med", "title": "Nature medicine", "essn": "1546-170X", "issn": "1078-8956", "nlmid": "9502015", "isoabbreviation": "Nat Med"}, "printPublicationDate": "2018-10-01"}, "pubYear": "2018", "pageInfo": "1559-1567", "abstractText": "Visual inspection of histopathology slides is one of the main methods used by pathologists to assess the stage, type and subtype of lung tumors. Adenocarcinoma (LUAD) and squamous cell carcinoma (LUSC) are the most prevalent subtypes of lung cancer, and their distinction requires visual inspection by an experienced pathologist. In this study, we trained a deep convolutional neural network (inception v3) on whole-slide images obtained from The Cancer Genome Atlas to accurately and automatically classify them into LUAD, LUSC or normal lung tissue. The performance of our method is comparable to that of pathologists, with an average area under the curve (AUC) of 0.97. Our model was validated on independent datasets of frozen tissues, formalin-fixed paraffin-embedded tissues and biopsies. Furthermore, we trained the network to predict the ten most commonly mutated genes in LUAD. We found that six of them-STK11, EGFR, FAT1, SETBP1, KRAS and TP53-can be predicted from pathology images, with AUCs from 0.733 to 0.856 as measured on a held-out population. These findings suggest that deep-learning models can assist pathologists in the detection of cancer subtype or gene mutations. Our approach can be applied to any cancer type, and the code is available at https://github.com/ncoudray/DeepPATH .", "affiliation": "Applied Bioinformatics Laboratories, New York University School of Medicine, New York, NY, USA.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "P30 CA016087", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Adenocarcinoma", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "CL", "qualifierName": "classification"}, {"m