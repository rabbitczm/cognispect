n": [{"affiliation": "Clinica di Radiologia EOC IIMSI, Lugano, Switzerland."}]}}, {"fullName": "Sconfienza LM", "lastName": "Sconfienza", "firstName": "Luca Maria", "initials": "LM", "authorId": {"type": "ORCID", "value": "0000-0003-0759-8431"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "IRCCS Istituto Ortopedico Galeazzi, Milano, Italy. io@lucasconfienza.it."}, {"affiliation": "Dipartimento di Scienze Biomediche per la Salute, Università degli Studi di Milano, Milano, Italy. io@lucasconfienza.it."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-7518-5773"}, {"type": "ORCID", "value": "0000-0001-7989-9861"}, {"type": "ORCID", "value": "0000-0002-0760-8946"}, {"type": "ORCID", "value": "0000-0002-2279-5559"}, {"type": "ORCID", "value": "0000-0002-3623-7822"}, {"type": "ORCID", "value": "0000-0002-7668-3042"}, {"type": "ORCID", "value": "0000-0003-0759-8431"}, {"type": "ORCID", "value": "0000-0003-1106-5830"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "9", "volume": "47", "journalIssueId": 3408931, "dateOfPublication": "2022 Sep", "monthOfPublication": 9, "yearOfPublication": 2022, "journal": {"medlineAbbreviation": "Abdom Radiol (NY)", "title": "Abdominal radiology (New York)", "essn": "2366-0058", "issn": "2366-004X", "isoabbreviation": "Abdom Radiol (NY)", "nlmid": "101674571"}, "printPublicationDate": "2022-09-01"}, "pubYear": "2022", "pageInfo": "3205-3216", "abstractText": "Sarcopenia is a progressive, generalized skeletal muscle disorder characterized by reduction of muscle mass and strength. It is associated with increased adverse outcomes including falls, fractures, physical disability, and mortality, particularly, in elderly patients. Nowadays, sarcopenia has become a specific imaging biomarker able to predict clinical outcomes of patients. Muscle fibre reduction has shown to be an unfavourable pre-operative predictive factor in patients with cancer, and is associated with worse clinical outcomes in terms of postoperative complications, morbidity, mortality, and lower tolerance of chemoradiation therapy. Several imaging modalities, including dual-energy X-ray absorptiometry, CT, MRI, and US can be used to estimate muscle mass and quality to reach the diagnosis of sarcopenia. This article reviews the clinical implications of sarcopenia, how this condition can be assessed through different imaging modalities, and future perspectives of imaging of sarcopenia.", "affiliation": "Clinica di Radiologia EOC IIMSI, Lugano, Switzerland.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "review-article", "Review", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Università degli Studi di Milano", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Muscle, Skeletal"}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Magnetic Resonance Imaging"}, {"majorTopic_YN": "N", "descriptorName": "Absorptiometry, Photon", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Body Composition", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "PH", "qualifierName": "physiology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Aged"}, {"majorTopic_YN": "Y", "descriptorName": "Sarcopenia", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}, {"majorTopic_YN": "N", "abbreviation": "CO", "qualifierName": "complications"}]}}]}, "keywordList": {"keyword": ["Muscle", "Body composition", "Imaging", "Sarcopenia"]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscrip