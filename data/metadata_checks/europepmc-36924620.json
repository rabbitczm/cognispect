sList": {"authorAffiliation": [{"affiliation": "Digital Health Cooperative Research Centre, Melbourne, Australia. Electronic address: stefan.harrer@dhcrc.com."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-7947-330X"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"volume": "90", "journalIssueId": 3544372, "dateOfPublication": "2023 Apr", "monthOfPublication": 4, "yearOfPublication": 2023, "journal": {"medlineAbbreviation": "EBioMedicine", "title": "EBioMedicine", "essn": "2352-3964", "issn": "2352-3964", "nlmid": "101647039", "isoabbreviation": "EBioMedicine"}, "printPublicationDate": "2023-04-01"}, "pubYear": "2023", "pageInfo": "104512", "abstractText": "Large Language Models (LLMs) are a key component of generative artificial intelligence (AI) applications for creating new content including text, imagery, audio, code, and videos in response to textual instructions. Without human oversight, guidance and responsible design and operation, such generative AI applications will remain a party trick with substantial potential for creating and spreading misinformation or harmful and inaccurate content at unprecedented scale. However, if positioned and developed responsibly as companions to humans augmenting but not replacing their role in decision making, knowledge retrieval and other cognitive processes, they could evolve into highly efficient, trustworthy, assistive tools for information management. This perspective describes how such tools could transform data management workflows in healthcare and medicine, explains how the underlying technology works, provides an assessment of risks and limitations, and proposes an ethical, technical, and cultural framework for responsible design, development, and deployment. It seeks to incentivise users, developers, providers, and regulators of generative AI that utilises LLMs to collectively prepare for the transformational role this technology could play in evidence-based sectors.", "affiliation": "Digital Health Cooperative Research Centre, Melbourne, Australia. Electronic address: stefan.harrer@dhcrc.com.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["review-article", "Review", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Language"}, {"majorTopic_YN": "N", "descriptorName": "Attention"}, {"majorTopic_YN": "Y", "descriptorName": "Medicine"}, {"majorTopic_YN": "Y", "descriptorName": "Artificial Intelligence"}, {"majorTopic_YN": "N", "descriptorName": "Delivery of Health Care"}]}, "keywordList": {"keyword": ["Information management", "Ai Ethics", "Augmented Human Intelligence", "Generative Artificial Intelligence", "Large Language Models", "Ai Trustworthiness", "Foundation Models"]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1016/j.ebiom.2023.104512"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC10025985"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC10025985?pdf=render"}]}, "commentCorrectionList": {"commentCorrection": [{"source": "MED", "id": "37327676", "reference": "EBioMedicine. 2023 Jul;93:104671. doi: 10.1016/j.ebiom.2023.104671", "type": "Comment in", "orderIn": 1}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 199, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "Y", "hasLabsLinks": "Y", "hasData": "Y", "license": "cc by-nc-nd", "authMan": "N", "epmc