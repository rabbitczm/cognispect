47X"}, {"type": "ORCID", "value": "0000-0001-7758-6896"}, {"type": "ORCID", "value": "0000-0001-8408-4499"}, {"type": "ORCID", "value": "0000-0002-0622-7391"}, {"type": "ORCID", "value": "0000-0002-1206-527X"}, {"type": "ORCID", "value": "0000-0002-1592-5896"}, {"type": "ORCID", "value": "0000-0002-3205-3794"}, {"type": "ORCID", "value": "0000-0002-3414-8244"}, {"type": "ORCID", "value": "0000-0002-4305-6376"}, {"type": "ORCID", "value": "0000-0002-8431-9136"}, {"type": "ORCID", "value": "0000-0002-9264-7551"}, {"type": "ORCID", "value": "0000-0002-9322-3515"}, {"type": "ORCID", "value": "0000-0003-0645-1964"}, {"type": "ORCID", "value": "0000-0003-2301-3309"}, {"type": "ORCID", "value": "0000-0003-4507-8648"}]}, "journalInfo": {"issue": "1", "volume": "14", "journalIssueId": 3514467, "dateOfPublication": "2023 Mar", "monthOfPublication": 3, "yearOfPublication": 2023, "journal": {"medlineAbbreviation": "Nat Commun", "title": "Nature communications", "essn": "2041-1723", "issn": "2041-1723", "nlmid": "101528555", "isoabbreviation": "Nat Commun"}, "printPublicationDate": "2023-03-01"}, "pubYear": "2023", "pageInfo": "1597", "abstractText": "Neuroscience has long been an essential driver of progress in artificial intelligence (AI). We propose that to accelerate progress in AI, we must invest in fundamental research in NeuroAI. A core component of this is the embodied Turing test, which challenges AI animal models to interact with the sensorimotor world at skill levels akin to their living counterparts. The embodied Turing test shifts the focus from those capabilities like game playing and language that are especially well-developed or uniquely human to those capabilities - inherited from over 500 million years of evolution - that are shared with all animals. Building models that can pass the embodied Turing test will provide a roadmap for the next generation of AI.", "affiliation": "Cold Spring Harbor Laboratory, Cold Spring Harbor, NY, 11724, USA. zador@cshl.edu.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "review-article", "Review", "Research Support, U.S. Gov't, Non-P.H.S.", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NINDS NIH HHS", "acronym": "NS", "grantId": "R01 NS053603", "orderIn": 0}, {"agency": "NEI NIH HHS", "acronym": "EY", "grantId": "R01 EY018847", "orderIn": 0}, {"agency": "NIMH NIH HHS", "acronym": "MH", "grantId": "R01 MH109556", "orderIn": 0}, {"agency": "NINDS NIH HHS", "acronym": "NS", "grantId": "RF1 NS127122", "orderIn": 0}, {"agency": "NEI NIH HHS", "acronym": "EY", "grantId": "R01 EY026927", "orderIn": 0}, {"agency": "NINDS NIH HHS", "acronym": "NS", "grantId": "R01 NS099323", "orderIn": 0}, {"agency": "NIMH NIH HHS", "acronym": "MH", "grantId": "R01 MH125571", "orderIn": 0}, {"agency": "NINDS NIH HHS", "acronym": "NS", "grantId": "U19 NS104649", "orderIn": 0}, {"agency": "NINDS NIH HHS", "acronym": "NS", "grantId": "U19 NS123716", "orderIn": 0}, {"agency": "NEI NIH HHS", "acronym": "EY", "grantId": "R01 EY022428", "orderIn": 0}, {"agency": "NIGMS NIH HHS", "acronym": "GM", "grantId": "R01 GM136972", "orderIn": 0}, {"agency": "NINDS NIH HHS", "acronym": "NS", "grantId": "R01 NS105349", "orderIn": 0}, {"agency": "NINDS NIH HHS", "acronym": "NS", "grantId": "R01 NS127122", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Animals"}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "Y", "descriptorName": "Neurosciences"}, {"majorTopic_YN": "Y", "descriptorName": "Artificial Intelligence"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1038/s41467-023-37180-x"}, {"availability": "Open access", "availabi