 "M", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Cell Biology, Harvard Medical School, Boston, MA 02115, USA."}]}}, {"fullName": "Sandri C", "lastName": "Sandri", "firstName": "Claudia", "initials": "C"}, {"fullName": "Gilbert A", "lastName": "Gilbert", "firstName": "Alex", "initials": "A"}, {"fullName": "Skurk C", "lastName": "Skurk", "firstName": "Carsten", "initials": "C", "authorId": {"type": "ORCID", "value": "0000-0003-4953-601X"}}, {"fullName": "Calabria E", "lastName": "Calabria", "firstName": "Elisa", "initials": "E", "authorId": {"type": "ORCID", "value": "0000-0001-6557-0379"}}, {"fullName": "Picard A", "lastName": "Picard", "firstName": "Anne", "initials": "A"}, {"fullName": "Walsh K", "lastName": "Walsh", "firstName": "Kenneth", "initials": "K", "authorId": {"type": "ORCID", "value": "0000-0001-7580-2276"}}, {"fullName": "Schiaffino S", "lastName": "Schiaffino", "firstName": "Stefano", "initials": "S", "authorId": {"type": "ORCID", "value": "0000-0002-5607-6421"}}, {"fullName": "Lecker SH", "lastName": "Lecker", "firstName": "Stewart H", "initials": "SH"}, {"fullName": "Goldberg AL", "lastName": "Goldberg", "firstName": "Alfred L", "initials": "AL"}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-6557-0379"}, {"type": "ORCID", "value": "0000-0001-7580-2276"}, {"type": "ORCID", "value": "0000-0002-5607-6421"}, {"type": "ORCID", "value": "0000-0003-4953-601X"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "recommended_reviews", "related_data"]}, "journalInfo": {"issue": "3", "volume": "117", "journalIssueId": 1143512, "dateOfPublication": "2004 Apr", "monthOfPublication": 4, "yearOfPublication": 2004, "journal": {"medlineAbbreviation": "Cell", "title": "Cell", "essn": "1097-4172", "issn": "0092-8674", "nlmid": "0413066", "isoabbreviation": "Cell"}, "printPublicationDate": "2004-04-01"}, "pubYear": "2004", "pageInfo": "399-412", "abstractText": "Skeletal muscle atrophy is a debilitating response to fasting, disuse, cancer, and other systemic diseases. In atrophying muscles, the ubiquitin ligase, atrogin-1 (MAFbx), is dramatically induced, and this response is necessary for rapid atrophy. Here, we show that in cultured myotubes undergoing atrophy, the activity of the PI3K/AKT pathway decreases, leading to activation of Foxo transcription factors and atrogin-1 induction. IGF-1 treatment or AKT overexpression inhibits Foxo and atrogin-1 expression. Moreover, constitutively active Foxo3 acts on the atrogin-1 promoter to cause atrogin-1 transcription and dramatic atrophy of myotubes and muscle fibers. When Foxo activation is blocked by a dominant-negative construct in myotubes or by RNAi in mouse muscles in vivo, atrogin-1 induction during starvation and atrophy of myotubes induced by glucocorticoids are prevented. Thus, forkhead factor(s) play a critical role in the development of muscle atrophy, and inhibition of Foxo factors is an attractive approach to combat muscle wasting.", "affiliation": "Department of Cell Biology, Harvard Medical School, Boston, MA 02115, USA.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["Research Support, U.S. Gov't, P.H.S.", "Research Support, Non-U.S. Gov't", "research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Muscular Dystrophy Association", "orderIn": 0}, {"agency": "National Space Biomedical Research Institute", "orderIn": 0}, {"agency": "National Institutes of Health", "grantId": "DK02707", "orderIn": 0}, {"agency": "NIAMS NIH HHS", "acronym": "AR", "grantId": "R01 AR040197", "orderIn": 0}, {"agency": "NIDDK NIH HHS", "acronym": "DK", "grantId": "DK02707", "orderIn": 0}, {"agency": "European Commission", "grantId": "QLRT-2000-00530", "orderIn": 0}, {"agency": "NIDDK NIH HHS", "acronym": "DK", "grantId": "R01 DK062307", "orderIn": 0}, {"agency": "National Institutes of Health", "grantId": "DK62307", "orderIn": 0}, {"agency": "Ministero dell’Istruzione, dell’Università e della Ricerca", "orderIn": 0}, {"agency": "Agenzia Spaziale Italiana", "orderIn": 0}, {"agency": "NIDDK NIH HHS", "acronym": "DK", "grantId": "DK62307", "orderIn": 0}, {"agency": "NIA NIH HHS", "acronym": "AG", "grantId": "R01 AG015052", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Muscle, Skeletal", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "ME", "qualifierName": "metabolism"}, {"majorTopic_YN": "Y", "abbreviation": "PA", "qualifierName": "pathology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Cells, Cultured"}, {"majorTopic_YN": "N", "descriptorName": "Muscle Cells", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "EN", "qualifierName": "enzymology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Animals"}, {"majorTopic_YN": "N", "descriptorName": "Mice"}, {"majorTopic_YN": "N", "descriptorName": "Adenoviridae", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "GE", "qualifierName": "genetics"}]}}, {"majorTopic_YN": "N", "descriptorName": "Muscular Atrophy", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "ET", "qualifierName": "etiology"}, {"majorTopic_YN": "Y", "abbreviation": "GE", "qualifierName": "genetics"}, {"majorTopic_YN": "N", "abbreviation": "ME", "qualifierName": "metabolism"}]}}, {"majorTopic_YN": "N", "descriptorName": "Ligases", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "GE", "qualifierName": "genetics"}, {"majorTopic_YN": "Y", "abbreviation": "ME", "qualifierName": "metabolism"}]}}, {"majorTopic_YN": "N", "descriptorName": "Ubiquitin-Protein Ligases", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "ME", "qualifierName": "metabolism"}]}}, {"majorTopic_YN": "N", "descriptorName": "SKP Cullin F-Box Protein Ligases"}, {"majorTopic_YN": "N", "descriptorName": "Insulin-L