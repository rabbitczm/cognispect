for Precision Cardiovascular Medicine; Council on Cardiovascular and Stroke Nursing; Council on Lifelong Congenital Heart Disease and Heart Health in the Young; Council on Cardiovascular Radiology and Intervention; Council on Hypertension; Council on the Kidney in Cardiovascular Disease; and Stroke Council.", "authorList": {"author": [{"fullName": "Armoundas AA", "lastName": "Armoundas", "firstName": "Antonis A", "initials": "AA"}, {"fullName": "Narayan SM", "lastName": "Narayan", "firstName": "Sanjiv M", "initials": "SM", "authorId": {"type": "ORCID", "value": "0000-0001-7552-5053"}}, {"fullName": "Arnett DK", "lastName": "Arnett", "firstName": "Donna K", "initials": "DK"}, {"fullName": "Spector-Bagdady K", "lastName": "Spector-Bagdady", "firstName": "Kayte", "initials": "K"}, {"fullName": "Bennett DA", "lastName": "Bennett", "firstName": "Derrick A", "initials": "DA"}, {"fullName": "Celi LA", "lastName": "Celi", "firstName": "Leo Anthony", "initials": "LA"}, {"fullName": "Friedman PA", "lastName": "Friedman", "firstName": "Paul A", "initials": "PA"}, {"fullName": "Gollob MH", "lastName": "Gollob", "firstName": "Michael H", "initials": "MH"}, {"fullName": "Hall JL", "lastName": "Hall", "firstName": "Jennifer L", "initials": "JL"}, {"fullName": "Kwitek AE", "lastName": "Kwitek", "firstName": "Anne E", "initials": "AE"}, {"fullName": "Lett E", "lastName": "Lett", "firstName": "Elle", "initials": "E"}, {"fullName": "Menon BK", "lastName": "Menon", "firstName": "Bijoy K", "initials": "BK"}, {"fullName": "Sheehan KA", "lastName": "Sheehan", "firstName": "Katherine A", "initials": "KA"}, {"fullName": "Al-Zaiti SS", "lastName": "Al-Zaiti", "firstName": "Salah S", "initials": "SS", "authorId": {"type": "ORCID", "value": "0000-0002-6862-0658"}}, {"collectiveName": "American Heart Association Institute for Precision Cardiovascular Medicine; Council on Cardiovascular and Stroke Nursing; Council on Lifelong Congenital Heart Disease and Heart Health in the Young; Council on Cardiovascular Radiology and Intervention; Council on Hypertension; Council on the Kidney in Cardiovascular Disease; and Stroke Council"}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-7552-5053"}, {"type": "ORCID", "value": "0000-0002-1562-3564"}, {"type": "ORCID", "value": "0000-0002-6862-0658"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "14", "volume": "149", "journalIssueId": 3747380, "dateOfPublication": "2024 Apr", "monthOfPublication": 4, "yearOfPublication": 2024, "journal": {"medlineAbbreviation": "Circulation", "title": "Circulation", "essn": "1524-4539", "issn": "0009-7322", "nlmid": "0147763", "isoabbreviation": "Circulation"}, "printPublicationDate": "2024-04-01"}, "pubYear": "2024", "pageInfo": "e1028-e1050", "abstractText": "A major focus of academia, industry, and global governmental agencies is to develop and apply artificial intelligence and other advanced analytical tools to transform health care delivery. The American Heart Association supports the creation of tools and services that would further the science and practice of precision medicine by enabling more precise approaches to cardiovascular and stroke research, prevention, and care of individuals and populations. Nevertheless, several challenges exist, and few artificial intelligence tools have been shown to improve cardiovascular and stroke care sufficiently to be widely adopted. This scientific statement outlines the current state of the art on the use of artificial intelligence algorithms and data science in the diagnosis, classification, and treatment of cardiovascular disease. It also sets out to advance this mission, focusing on how digital tools and, in particular, artificial intelligence may provide clinical and mechanistic insights, address bias in clinical studies, and facilitate education and implementation science to improve cardiovascular and stroke outcomes. Last, a key objective of this scientific statement is to further the field by identifying best practices, gaps, and challenges for interested stakeholders.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["research-article", "Review", "Journal Article"]}, "grantsList": {"grant": [{"agency": "NHLBI NIH HHS", "acronym": "HL", "grantId": "R01 HL149134", "orderIn": 0}, {"agency": "NHLBI NIH HHS", "acronym": "HL", "grantId": "R01 HL064541", "orderIn": 0}, {"agency": "NHLBI NIH HHS", "acronym": "HL", "grantId": "R01 HL083359", "orderIn": 0}, {"agency": "NHLBI NIH HHS", "acronym": "HL", "grantId": "R01 HL162260", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "Y", "descriptorName": "Cardiovascular Diseases", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "PC", "qualifierName": "prevention & control"}, {"majorTopic_YN": "N", "abbreviation": "TH", "qualifierName": "therapy"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Heart Diseases"}, {"majorTopic_YN": "N", "descriptorName": "Artificial Intelligence"}, {"majorTopic_YN": "N", "descriptorName": "American Heart Association"}, {"majorTopic_YN": "N", "descriptorName": "United States"}, {"majorTopic_YN": "Y", "descriptorName": "Stroke", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DI", "qualifierName": "diagnosis"}, {"majorTopic_YN": "N", "abbreviation": "PC", "qualifierName": "prevention & control"}]}}]}, "keywordList": {"keyword": ["Genetics", "Artificial intelligence", "Heart diseases", "Electrocardiography", "Ethics", "Electronic Health Records", "Monitoring, Physiologic", "Aha Scientific Statements"]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1161/CIR.0000000000001