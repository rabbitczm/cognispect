158X"}}, {"fullName": "Liu X", "lastName": "Liu", "firstName": "Xinglong", "initials": "X", "authorId": {"type": "ORCID", "value": "0000-0002-4213-2883"}}, {"fullName": "Li C", "lastName": "Li", "firstName": "Chaoping", "initials": "C"}, {"fullName": "Xu Z", "lastName": "Xu", "firstName": "Zhiyong", "initials": "Z"}, {"fullName": "Ruan J", "lastName": "Ruan", "firstName": "Jiugen", "initials": "J"}, {"fullName": "Zhu H", "lastName": "Zhu", "firstName": "Haifeng", "initials": "H"}, {"fullName": "Meng T", "lastName": "Meng", "firstName": "Tao", "initials": "T"}, {"fullName": "Li K", "lastName": "Li", "firstName": "Kang", "initials": "K"}, {"fullName": "Huang N", "lastName": "Huang", "firstName": "Ning", "initials": "N"}, {"fullName": "Zhang S", "lastName": "Zhang", "firstName": "Shaoting", "initials": "S", "authorId": {"type": "ORCID", "value": "0000-0002-8719-448X"}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-4213-2883"}, {"type": "ORCID", "value": "0000-0002-8632-158X"}, {"type": "ORCID", "value": "0000-0002-8719-448X"}]}, "journalInfo": {"issue": "8", "volume": "39", "journalIssueId": 2986730, "dateOfPublication": "2020 Aug", "monthOfPublication": 8, "yearOfPublication": 2020, "journal": {"medlineAbbreviation": "IEEE Trans Med Imaging", "title": "IEEE transactions on medical imaging", "essn": "1558-254X", "issn": "0278-0062", "nlmid": "8310780", "isoabbreviation": "IEEE Trans Med Imaging"}, "printPublicationDate": "2020-08-01"}, "pubYear": "2020", "pageInfo": "2653-2663", "abstractText": "Segmentation of pneumonia lesions from CT scans of COVID-19 patients is important for accurate diagnosis and follow-up. Deep learning has a potential to automate this task but requires a large set of high-quality annotations that are difficult to collect. Learning from noisy training labels that are easier to obtain has a potential to alleviate this problem. To this end, we propose a novel noise-robust framework to learn from noisy labels for the segmentation task. We first introduce a noise-robust Dice loss that is a generalization of Dice loss for segmentation and Mean Absolute Error (MAE) loss for robustness against noise, then propose a novel COVID-19 Pneumonia Lesion segmentation network (COPLE-Net) to better deal with the lesions with various scales and appearances. The noise-robust Dice loss and COPLE-Net are combined with an adaptive self-ensembling framework for training, where an Exponential Moving Average (EMA) of a student model is used as a teacher model that is adaptively updated by suppressing the contribution of the student to EMA when the student has a large training loss. The student model is also adaptive by learning from the teacher only when the teacher outperforms the student. Experimental results showed that: (1) our noise-robust Dice loss outperforms existing noise-robust loss functions, (2) the proposed COPLE-Net achieves higher performance than state-of-the-art image segmentation networks, and (3) our framework with adaptive self-ensembling significantly outperforms a standard training process and surpasses other noise-robust training approaches in the scenario of learning from noisy labels for COVID-19 pneumonia lesion segmentation.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "National Natural Science Foundation of China", "grantId": "61901084", "orderIn": 0}, {"agency": "National Natural Science Foundation of China", "grantId": "81771921", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Lung", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}]}}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Pneumonia, Viral", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}]}}, {"majorTopic_YN": "N", "descriptorName": "Coronavirus Infections", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}]}}, {"majorTopic_YN": "N", "descriptorName": "Tomography, X-Ray Computed", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Algorithms"}, {"majorTopic_YN": "N", "descriptorName": "Pandemics"}, {"majorTopic_YN": "N", "descriptorName": "Betacoronavirus"}, {"majorTopic_YN": "Y", "descriptorName": "Deep Learning"}, {"majorTopic_YN": "N", "descriptorName": "COVID-19"}, {"majorTopic_YN": "N", "descriptorName": "SARS-CoV-2"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1109/TMI.2020.3000314"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC8544954"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC8544954?pdf=render"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1109/tmi.2020.3000314"}]}, "isOpenAccess": "N", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 194, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "N", "hasData": "N", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "N", "dateOfCompletion": "2020-08-14", "dateOfCreation": "2020-07-31", "dateOfRevision": "2026-10-01", "firstPublicationDate": "2020-08-01", "firstIndexDate": "2020-07-31", "fullTextReceivedDate"