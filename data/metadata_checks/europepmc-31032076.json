edical Center, Nashville, TN, USA."}]}}, {"fullName": "Deppen SA", "lastName": "Deppen", "firstName": "Stephen A", "initials": "SA", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Vanderbilt University Medical Center, Nashville, TN, USA."}, {"affiliation": "Tennessee Valley Healthcare System, Nashville, TN, USA."}]}}, {"fullName": "Farjah F", "lastName": "Farjah", "firstName": "Farhood", "initials": "F", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "University of Washington, Seattle, WA, USA."}]}}, {"fullName": "Grogan EL", "lastName": "Grogan", "firstName": "Eric L", "initials": "EL", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Vanderbilt University Medical Center, Nashville, TN, USA."}, {"affiliation": "Tennessee Valley Healthcare System, Nashville, TN, USA."}]}}]}, "journalInfo": {"issue": "Suppl 4", "volume": "11", "journalIssueId": 2809678, "dateOfPublication": "2019 Mar", "monthOfPublication": 3, "yearOfPublication": 2019, "journal": {"medlineAbbreviation": "J Thorac Dis", "title": "Journal of thoracic disease", "essn": "2077-6624", "issn": "2072-1439", "isoabbreviation": "J Thorac Dis", "nlmid": "101533916"}, "printPublicationDate": "2019-03-01"}, "pubYear": "2019", "pageInfo": "S574-S584", "abstractText": "Prediction models help healthcare professionals and patients make clinical decisions. The goal of an accurate prediction model is to provide patient risk stratification to support tailored clinical decision-making with the hope of improving patient outcomes and quality of care. Clinical prediction models use variables selected because they are thought to be associated (either negatively or positively) with the outcome of interest. Building a model requires data that are computer-interpretable and reliably recorded within the time frame of interest for the prediction. Such models are generally defined as either diagnostic, likelihood of disease or disease group classification, or prognostic, likelihood of response or risk of recurrence. We describe a set of guidelines and heuristics for clinicians to use to develop a logistic regression-based prediction model for binary outcomes that is intended to augment clinical decision-making.", "affiliation": "Vanderbilt University Medical Center, Nashville, TN, USA.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["review-article", "Review", "Journal Article"]}, "grantsList": {"grant": [{"agency": "AHRQ HHS", "acronym": "HS", "grantId": "T32 HS026122", "orderIn": 0}]}, "keywordList": {"keyword": ["Review", "Logistic regression", "Predictive model"]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.21037/jtd.2019.01.25"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC6465431"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC6465431?pdf=render"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.21037/jtd.2019.01.25"}]}, "isOpenAccess": "N", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 295, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "N", "hasData": "N", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "N", "dateOfCreation": "2019-04-30", "dateOfRevision": "2021-10-22", "firstPublicationDate": "2019-03-01", "firstIndexDate": "2019-04-30", "fullTextReceivedDate": "2025-02-03", "hasEvaluations": "N"}]}}