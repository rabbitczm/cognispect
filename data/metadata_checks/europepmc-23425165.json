00-0002-4989-5058"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Community Health Sciences, Brock University, St. Catharines, ON, Canada. martin.tammemagi@brocku.ca"}]}}, {"fullName": "Katki HA", "lastName": "Katki", "firstName": "Hormuzd A", "initials": "HA", "authorId": {"type": "ORCID", "value": "0000-0003-2002-0095"}}, {"fullName": "Hocking WG", "lastName": "Hocking", "firstName": "William G", "initials": "WG", "authorId": {"type": "ORCID", "value": "0000-0002-0690-3759"}}, {"fullName": "Church TR", "lastName": "Church", "firstName": "Timothy R", "initials": "TR", "authorId": {"type": "ORCID", "value": "0000-0003-3292-5035"}}, {"fullName": "Caporaso N", "lastName": "Caporaso", "firstName": "Neil", "initials": "N"}, {"fullName": "Kvale PA", "lastName": "Kvale", "firstName": "Paul A", "initials": "PA"}, {"fullName": "Chaturvedi AK", "lastName": "Chaturvedi", "firstName": "Anil K", "initials": "AK"}, {"fullName": "Silvestri GA", "lastName": "Silvestri", "firstName": "Gerard A", "initials": "GA"}, {"fullName": "Riley TL", "lastName": "Riley", "firstName": "Tom L", "initials": "TL"}, {"fullName": "Commins J", "lastName": "Commins", "firstName": "John", "initials": "J"}, {"fullName": "Berg CD", "lastName": "Berg", "firstName": "Christine D", "initials": "CD"}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-0690-3759"}, {"type": "ORCID", "value": "0000-0002-4989-5058"}, {"type": "ORCID", "value": "0000-0003-2002-0095"}, {"type": "ORCID", "value": "0000-0003-3292-5035"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "8", "volume": "368", "journalIssueId": 2012682, "dateOfPublication": "2013 Feb", "monthOfPublication": 2, "yearOfPublication": 2013, "journal": {"medlineAbbreviation": "N Engl J Med", "title": "The New England journal of medicine", "essn": "1533-4406", "issn": "0028-4793", "nlmid": "0255562", "isoabbreviation": "N Engl J Med"}, "printPublicationDate": "2013-02-01"}, "pubYear": "2013", "pageInfo": "728-736", "abstractText": "<h4>Background</h4>The National Lung Screening Trial (NLST) used risk factors for lung cancer (e.g., ≥30 pack-years of smoking and <15 years since quitting) as selection criteria for lung-cancer screening. Use of an accurate model that incorporates additional risk factors to select persons for screening may identify more persons who have lung cancer or in whom lung cancer will develop.<h4>Methods</h4>We modified the 2011 lung-cancer risk-prediction model from our Prostate, Lung, Colorectal, and Ovarian (PLCO) Cancer Screening Trial to ensure applicability to NLST data; risk was the probability of a diagnosis of lung cancer during the 6-year study period. We developed and validated the model (PLCO(M2012)) with data from the 80,375 persons in the PLCO control and intervention groups who had ever smoked. Discrimination (area under the receiver-operating-characteristic curve [AUC]) and calibration were assessed. In the validation data set, 14,144 of 37,332 persons (37.9%) met NLST criteria. For comparison, 14,144 highest-risk persons were considered positive (eligible for screening) according to PLCO(M2012) criteria. We compared the accuracy of PLCO(M2012) criteria with NLST criteria to detect lung cancer. Cox models were used to evaluate whether the reduction in mortality among 53,202 persons undergoing low-dose computed tomographic screening in the NLST differed according to risk.<h4>Results</h4>The AUC was 0.803 in the development data set and 0.797 in the validation data set. As compared with NLST criteria, PLCO(M2012) criteria had improved sensitivity (83.0% vs. 71.1%, P<0.001) and positive predictive value (4.0% vs. 3.4%, P=0.01), without loss of specificity (62.9% and. 62.7%, respectively; P=0.54); 41.3% fewer lung cancers were missed. The NLST screening effect did not vary according to PLCO(M2012) risk (P=0.61 for interaction).<h4>Conclusions</h4>The use of the PLCO(M2012) model was more sensitive than the NLST criteria for lung-cancer detection.", "affiliation": "Department of Community Health Sciences, Brock University, St. Catharines, ON, Canada. martin.tammemagi@brocku.ca", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["Research Support, N.I.H., Intramural", "research-article", "Validation Study", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U01 CA079778", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CN", "grantId": "N01-CN-25518", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CN", "grantId": "N01-CN-25522", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CN", "grantId": "N01-CN-25476", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CN", "grantId": "N01-CN-25511", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CN", "grantId": "N01-CN-25513", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CN", "grantId": "N01-CN-25524", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U01 CA080098", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U01-CA-80098", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CN", "grantId": "N01-CN-25515", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CN", "grantId": "N01-CN-25516", "orderIn": 0}, {"agency": "Intramural NIH HHS", "acronym": "ImNIH", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CN", "grantId": "N01-CN-25512", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CN", "grantId": "N01-CN-25514", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CN", "grantId": "N02-CN-63300", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U01-CA-79778", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CN", "grantId": "N01-CN-75022", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", 