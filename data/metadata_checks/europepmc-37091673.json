ital of Binzhou Medical University, Yantai, Shandong, China."}]}}, {"fullName": "Sun J", "lastName": "Sun", "firstName": "Jiazheng", "initials": "J", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Vasculocardiology, Jinzhou Medical University, Jinzhou, Liaoning, China."}]}}, {"fullName": "Liu Y", "lastName": "Liu", "firstName": "Yipin", "initials": "Y", "authorId": {"type": "ORCID", "value": "0000-0002-2958-6354"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Gastroenterology, Yantai Affiliated Hospital of Binzhou Medical University, Yantai, Shandong, China."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-2958-6354"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"volume": "13", "journalIssueId": 3497169, "dateOfPublication": "2023 ", "monthOfPublication": 0, "yearOfPublication": 2023, "journal": {"medlineAbbreviation": "Front Cell Infect Microbiol", "title": "Frontiers in cellular and infection microbiology", "essn": "2235-2988", "issn": "2235-2988", "nlmid": "101585359", "isoabbreviation": "Front Cell Infect Microbiol"}, "printPublicationDate": "2023-01-01"}, "pubYear": "2023", "pageInfo": "1137947", "abstractText": "Bacterial biofilms are complex microbial communities encased in extracellular polymeric substances. Their formation is a multi-step process. Biofilms are a significant problem in treating bacterial infections and are one of the main reasons for the persistence of infections. They can exhibit increased resistance to classical antibiotics and cause disease through device-related and non-device (tissue) -associated infections, posing a severe threat to global health issues. Therefore, early detection and search for new and alternative treatments are essential for treating and suppressing biofilm-associated infections. In this paper, we systematically reviewed the formation of bacterial biofilms, associated infections, detection methods, and potential treatment strategies, aiming to provide researchers with the latest progress in the detection and treatment of bacterial biofilms.", "affiliation": "Department of Gastroenterology, Yantai Affiliated Hospital of Binzhou Medical University, Yantai, Shandong, China.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic-eCollection", "pubTypeList": {"pubType": ["Systematic Review", "review-article", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Bacteria"}, {"majorTopic_YN": "Y", "descriptorName": "Biofilms"}, {"majorTopic_YN": "Y", "descriptorName": "Bacterial Infections", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DT", "qualifierName": "drug therapy"}]}}, {"majorTopic_YN": "N", "descriptorName": "Anti-Bacterial Agents", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "PD", "qualifierName": "pharmacology"}, {"majorTopic_YN": "N", "abbreviation": "TU", "qualifierName": "therapeutic use"}]}}, {"majorTopic_YN": "N", "descriptorName": "Extracellular Polymeric Substance Matrix"}]}, "keywordList": {"keyword": ["Infection", "Treatment", "Antibiotic Resistance", "Bacterial biofilms", "Biofilm Detection"]}, "chemicalList": {"chemical": [{"name": "Anti-Bacterial Agents", "registryNumber": "0"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": "OA", "documentStyle": "doi", "site": "Unpaywall", "url": "https://doi.org/10.3389/fcimb.2023.1137947"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.3389/fcimb.2023.1137947"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/