orId": {"type": "ORCID", "value": "0000-0002-2946-7785"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Hygiene, Microbiology and Virology, Institute of Hygiene and Medical Microbiology, Medical University Innsbruck, Innsbruck, Austria."}]}}, {"fullName": "Lagrou K", "lastName": "Lagrou", "firstName": "Katrien", "initials": "K", "authorId": {"type": "ORCID", "value": "0000-0001-8668-1350"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Microbiology, Immunology and Transplantation, Laboratory of Clinical Microbiology, KU Leuven, Leuven, Belgium."}, {"affiliation": "Department of Laboratory Medicine and National Reference Center for Mycosis, University Hospitals Leuven, Leuven, Belgium."}]}}, {"fullName": "Garre V", "lastName": "Garre", "firstName": "Victoriano", "initials": "V", "authorId": {"type": "ORCID", "value": "0000-0001-7605-1726"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Departamento de Genética y Microbiología, Facultad de Biología, Universidad de Murcia, Murcia, Spain."}]}}, {"fullName": "Binder U", "lastName": "Binder", "firstName": "Ulrike", "initials": "U", "authorId": {"type": "ORCID", "value": "0000-0002-2160-2903"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Hygiene, Microbiology and Virology, Institute of Hygiene and Medical Microbiology, Medical University Innsbruck, Innsbruck, Austria."}]}}, {"fullName": "Velde GV", "lastName": "Velde", "firstName": "Greetje Vande", "initials": "GV", "authorId": {"type": "ORCID", "value": "0000-0002-5633-3993"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Imaging and Pathology, Faculty of Medicine, KU Leuven, Leuven, Belgium."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-7605-1726"}, {"type": "ORCID", "value": "0000-0001-8668-1350"}, {"type": "ORCID", "value": "0000-0001-9229-8841"}, {"type": "ORCID", "value": "0000-0002-2000-1030"}, {"type": "ORCID", "value": "0000-0002-2160-2903"}, {"type": "ORCID", "value": "0000-0002-2946-7785"}, {"type": "ORCID", "value": "0000-0002-3316-7769"}, {"type": "ORCID", "value": "0000-0002-3560-6155"}, {"type": "ORCID", "value": "0000-0002-4999-8532"}, {"type": "ORCID", "value": "0000-0002-5633-3993"}, {"type": "ORCID", "value": "0000-0002-8944-6898"}, {"type": "ORCID", "value": "0000-0002-9562-2923"}, {"type": "ORCID", "value": "0000-0003-1938-254X"}, {"type": "ORCID", "value": "0000-0003-3762-5971"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "1", "volume": "17", "journalIssueId": 4069776, "dateOfPublication": "2026 Dec", "monthOfPublication": 12, "yearOfPublication": 2026, "journal": {"medlineAbbreviation": "Virulence", "title": "Virulence", "essn": "2150-5608", "issn": "2150-5594", "isoabbreviation": "Virulence", "nlmid": "101531386"}, "printPublicationDate": "2026-12-01"}, "pubYear": "2026", "pageInfo": "2688582", "abstractText": "Mucormycosis, a disease encompassing life-threatening fungal infections by members of the Mucorales group, is characterized by significant heterogeneity, poor clinical outcomes, and globally rising incidences. Although showing clear outbreak potential, the disease remains poorly understood. Mucorales infections are characterized by rapid progression and extensive tissue destruction, often requiring disfiguring surgical interventions. Moreover, intrinsic resistance and high drug tolerance limit antifungal effectiveness, contributing to the disease's high mortality. To overcome the challenges associated with these infections, a deeper understanding of mucormycosis is urgently needed. Valuable translational insights traditionally derive from <i>in vivo</i> host models. However, current systems are limited by single-endpoint invasive analysis, offering only a narrow view of infection progression and treatment effects. To address these critical shortcomings and enhance experimental models, bioluminescent <i>Mucor lusitanicus</i> reporter strains were generated to establish models that allow for real-time, longitudinal monitoring of infection in individual animals. Codon optimization, targeted integration of the firefly luciferase gene, and control of expression using highly active promoters resulted in the successful establishment of two mucormycosis models: <i>Galleria mellonella</i> larvae as an intermediate infection model and a translational mouse model. In the murine model, the integration of micro-CT imaging further enhanced the characterization of host-pathogen interactions by enabling noninvasive assessment of tissue responses over time. Overall, our approach enables enhanced temporal resolution for quantitative assessment of fungal burden and host responses. Using <i>M. lusitanicus</i> as a model organism, this methodology establishes a foundation and technical expertise for application toward clinically relevant Mucorales infection and antifungal research.", "affiliation": "Department of Imaging and Pathology, Faculty of Medicine, KU Leuven, Leuven, Belgium.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Research Foundation Flanders", "grantId": "1186123N", "orderIn": 0}, {"agency": "Research Foundation Flanders", "grantId": "1199825N", "orderIn": 0}, {"agency": "Interne Fondsen KU Leuven/Internal Funds KU Leuven", "grantId": "C24E/23/036", "orderIn": 0}, {"agency": "Research Foundation Flanders", "grantId": "1186121N", "orderIn": 0}, {"agency": "UK Department of Health and Social Care’s (DHSC) Global AMR Innovation Fund", "grantId": "FR1-32", "orderIn": 0}, {"agency": "MICIU/AEI", "grantId": "PID2021-124674NB-I00", "orderIn": 0}, {"agency": "MICIU/AEI", "grantId": "PID2024-160088NB-I00", "orderIn": 0}, {"agency": "Fundacion Seneca", "grantId": "20617/IV/18", "orderIn": 0}, {"agency": "Research Foundation Flanders", "grantId": "1266926N", "orderIn": 0}, {"agency": "Research Foundation Flanders", "grantId": "1SF2224N", "orderIn": 0}, {"agency": "ERDF/EU", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Animals"}, {"majorTopic_YN": "N", "descriptorName": "Mice"}, {"majorTopic_YN": "Y", "descriptorName": "Moths", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "MI", "qualifierName": "microbiology"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Mucorales", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "PY", "qualifierName": "pathogenicity"}]}}, {"majorTopic_YN": "N", "descriptorName": "Mucor", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "GE", "qualifierName": "genetics"}, {"majorTopic_YN": "N", "abbreviation": "PY", "qualifierName": "pathogenicity"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Mucormycosis", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}, {"majorTopic_YN": "N", "abbreviation": "MI", "qualifierName": "microbiology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Disease Models, Animal"}, {"majorTopic_YN": "N", "descriptorName": "Luciferases, Firefly", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "GE", "qualifierName": "genetics"}]}}, {"majorTopic_YN": "N", "descriptorName": "Luminescent Measurements"}, {"majorTopic_YN": "N", "descriptorName": "Larva", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "MI", "qualifierName": "microbiology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Genes, Reporter"}, {"majorTopic_YN": "N", "descriptorName": "Female"}, {"majorTopic_YN": "Y", "descriptorName": "Host-Pathogen Interactions"}]}, "keywordList": {"keyword": ["Galleria mellonella", "Mucormycosis", "Mouse Model", "Bioluminescence Imagi