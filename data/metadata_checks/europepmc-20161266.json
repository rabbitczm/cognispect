horId": {"type": "ORCID", "value": "0000-0001-6023-1132"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiation Oncology, Washington University School of Medicine St. Louis, MO, USA."}]}}, {"fullName": "Grigsby P", "lastName": "Grigsby", "firstName": "P", "initials": "P"}, {"fullName": "Apte A", "lastName": "Apte", "firstName": "A", "initials": "A"}, {"fullName": "Kidd E", "lastName": "Kidd", "firstName": "E", "initials": "E"}, {"fullName": "Donnelly E", "lastName": "Donnelly", "firstName": "E", "initials": "E"}, {"fullName": "Khullar D", "lastName": "Khullar", "firstName": "D", "initials": "D"}, {"fullName": "Chaudhari S", "lastName": "Chaudhari", "firstName": "S", "initials": "S"}, {"fullName": "Yang D", "lastName": "Yang", "firstName": "D", "initials": "D"}, {"fullName": "Schmitt M", "lastName": "Schmitt", "firstName": "M", "initials": "M"}, {"fullName": "Laforest R", "lastName": "Laforest", "firstName": "Richard", "initials": "R"}, {"fullName": "Thorstad W", "lastName": "Thorstad", "firstName": "W", "initials": "W"}, {"fullName": "Deasy JO", "lastName": "Deasy", "firstName": "J O", "initials": "JO", "authorId": {"type": "ORCID", "value": "0000-0002-9437-266X"}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-6023-1132"}, {"type": "ORCID", "value": "0000-0002-9437-266X"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics"]}, "journalInfo": {"issue": "6", "volume": "42", "journalIssueId": 1626988, "dateOfPublication": "2009 Jun", "monthOfPublication": 6, "yearOfPublication": 2009, "journal": {"medlineAbbreviation": "Pattern Recognit", "title": "Pattern recognition", "issn": "0031-3203", "nlmid": "0250655", "isoabbreviation": "Pattern Recognit"}, "printPublicationDate": "2009-06-01"}, "pubYear": "2009", "pageInfo": "1162-1171", "abstractText": "Accumulating evidence suggests that characteristics of pre-treatment FDG-PET could be used as prognostic factors to predict outcomes in different cancer sites. Current risk analyses are limited to visual assessment or direct uptake value measurements. We are investigating intensity-volume histogram metrics and shape and texture features extracted from PET images to predict patient's response to treatment. These approaches were demonstrated using datasets from cervix and head and neck cancers, where AUC of 0.76 and 1.0 were achieved, respectively. The preliminary results suggest that the proposed approaches could potentially provide better tools and discriminant power for utilizing functional imaging in clinical prognosis.", "affiliation": "Department of Radiation Oncology, Washington University School of Medicine St. Louis, MO, USA.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01 CA085181", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "K25 CA128809", "orderIn": 0}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1016/j.patcog.2008.08.011"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC2701316"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC2701316?pdf=render"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1016/j.patcog.2008.08.011"}]}, "isOpenAccess": "N", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 348, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "Y", "hasData": "N", "authMan": "Y", "epmcAuthMan": "N", "nihAuthMan": "Y", "manuscriptId": "NIHMS9849