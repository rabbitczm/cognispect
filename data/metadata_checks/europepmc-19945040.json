02-6600-435X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, University of Wisconsin School of Medicine and Public Health, Madison, Wisconsin 53792-3252, USA. eburnside@uwhealth.org"}]}}, {"fullName": "Sickles EA", "lastName": "Sickles", "firstName": "Edward A", "initials": "EA"}, {"fullName": "Bassett LW", "lastName": "Bassett", "firstName": "Lawrence W", "initials": "LW"}, {"fullName": "Rubin DL", "lastName": "Rubin", "firstName": "Daniel L", "initials": "DL"}, {"fullName": "Lee CH", "lastName": "Lee", "firstName": "Carol H", "initials": "CH", "authorId": {"type": "ORCID", "value": "0000-0002-0143-5351"}}, {"fullName": "Ikeda DM", "lastName": "Ikeda", "firstName": "Debra M", "initials": "DM"}, {"fullName": "Mendelson EB", "lastName": "Mendelson", "firstName": "Ellen B", "initials": "EB"}, {"fullName": "Wilcox PA", "lastName": "Wilcox", "firstName": "Pamela A", "initials": "PA"}, {"fullName": "Butler PF", "lastName": "Butler", "firstName": "Priscilla F", "initials": "PF"}, {"fullName": "D'Orsi CJ", "lastName": "D'Orsi", "firstName": "Carl J", "initials": "CJ"}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-0143-5351"}, {"type": "ORCID", "value": "0000-0002-6600-435X"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics"]}, "journalInfo": {"issue": "12", "volume": "6", "journalIssueId": 1679653, "dateOfPublication": "2009 Dec", "monthOfPublication": 12, "yearOfPublication": 2009, "journal": {"medlineAbbreviation": "J Am Coll Radiol", "title": "Journal of the American College of Radiology : JACR", "essn": "1558-349X", "issn": "1546-1440", "nlmid": "101190326", "isoabbreviation": "J Am Coll Radiol"}, "printPublicationDate": "2009-12-01"}, "pubYear": "2009", "pageInfo": "851-860", "abstractText": "The Breast Imaging Reporting and Data System (BI-RADS) initiative, instituted by the ACR, was begun in the late 1980s to address a lack of standardization and uniformity in mammography practice reporting. An important component of the BI-RADS initiative is the lexicon, a dictionary of descriptors of specific imaging features. The BI-RADS lexicon has always been data driven, using descriptors that previously had been shown in the literature to be predictive of benign and malignant disease. Once established, the BI-RADS lexicon provided new opportunities for quality assurance, communication, research, and improved patient care. The history of this lexicon illustrates a series of challenges and instructive successes that provide a valuable guide for other groups that aspire to develop similar lexicons in the future.", "affiliation": "Department of Radiology, University of Wisconsin School of Medicine and Public Health, Madison, Wisconsin 53792-3252, USA. eburnside@uwhealth.org", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["Historical Article", "research-article", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "1 K07 CA114181", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "K07 CA114181", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Breast Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}, {"majorTopic_YN": "N", "abbreviation": "CL", "qualifierName": "classification"}, {"majorTopic_YN": "Y", "abbreviation": "HI", "qualifierName": "history"}]}}, {"majorTopic_YN": "N", "descriptorName": "Radiography", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "HI", "qualifierName": "history"}]}}, {"majorTopic_YN": "N", "descriptorName": "Mammography", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "HI", "qualifierName": "history"}]}}, {"majorTopic_YN": "N", "de