Affiliation": [{"affiliation": "Department of Development and Regeneration, KU Leuven, Leuven, Belgium."}, {"affiliation": "EPI-Center, KU Leuven, Leuven, Belgium."}, {"affiliation": "Department of Biomedical Data Sciences, Leiden University Medical Center, Leiden, Netherlands."}]}}, {"fullName": "Steyerberg EW", "lastName": "Steyerberg", "firstName": "Ewout W", "initials": "EW", "authorId": {"type": "ORCID", "value": "0000-0002-7787-0122"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Development and Regeneration, KU Leuven, Leuven, Belgium."}]}}, {"fullName": "Wynants L", "lastName": "Wynants", "firstName": "Laure", "initials": "L", "authorId": {"type": "ORCID", "value": "0000-0002-3037-122X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Development and Regeneration, KU Leuven, Leuven, Belgium."}, {"affiliation": "EPI-Center, KU Leuven, Leuven, Belgium."}, {"affiliation": "Department of Epidemiology, CAPHRI Care and Public Health Research Institute, Maastricht University, Maastricht, Netherlands."}]}}, {"fullName": "van Smeden M", "lastName": "van Smeden", "firstName": "Maarten", "initials": "M", "authorId": {"type": "ORCID", "value": "0000-0002-5529-1541"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Julius Center for Health Sciences and Primary Care, University Medical Center Utrecht, Utrecht University, Universiteitsweg 100, 3584 CG, Utrecht, Netherlands. M.vanSmeden@umcutrecht.nl."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-3037-122X"}, {"type": "ORCID", "value": "0000-0002-5529-1541"}, {"type": "ORCID", "value": "0000-0002-7787-0122"}, {"type": "ORCID", "value": "0000-0003-1613-7450"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics"]}, "journalInfo": {"issue": "1", "volume": "21", "journalIssueId": 3497999, "dateOfPublication": "2023 Feb", "monthOfPublication": 2, "yearOfPublication": 2023, "journal": {"medlineAbbreviation": "BMC Med", "title": "BMC medicine", "essn": "1741-7015", "issn": "1741-7015", "nlmid": "101190723", "isoabbreviation": "BMC Med"}, "printPublicationDate": "2023-02-01"}, "pubYear": "2023", "pageInfo": "70", "abstractText": "<h4>Background</h4>Clinical prediction models should be validated before implementation in clinical practice. But is favorable performance at internal validation or one external validation sufficient to claim that a prediction model works well in the intended clinical context?<h4>Main body</h4>We argue to the contrary because (1) patient populations vary, (2) measurement procedures vary, and (3) populations and measurements change over time. Hence, we have to expect heterogeneity in model performance between locations and settings, and across time. It follows that prediction models are never truly validated. This does not imply that validation is not important. Rather, the current focus on developing new models should shift to a focus on more extensive, well-conducted, and well-reported validation studies of promising models.<h4>Conclusion</h4>Principled validation strategies are needed to understand and quantify heterogeneity, monitor performance over time, and update prediction models when appropriate. Such strategies will help to ensure that prediction models stay up-to-date and safe to support clinical decision-making.", "affiliation": "Department of Development and Regeneration, KU Leuven, Leuven, Belgium.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["brief-report", "Research Support, Non-U.S. Gov't", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Fonds Wetenschappelijk Onderzoek", "grantId": "G097322N", "orderIn": 0}]}, "keywordList": {"keyword": ["Heterogeneity", "Discrimination", "calibration", "Internal Validation", "Model Performance", "Risk Prediction Models", "External Validation", "Predictive Analytics"]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Unpaywall", "url": "https://bmcmedicine.biomedcentral.com/counter/pdf/10.1186/s12916-023-02779-w"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1186/s12916-023-02779-w"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC9951847"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC9951847?pdf=render"}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 221, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "Y", "hasData": "N", "license": "cc by", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "N", "dateOfCompletion": "2023-02-28", "dateOfCreation": "2023-02-24", "dateOfRevision": "2024-09-13", "electronicPublicationDate": "2023-02-24", "firstPublicationDate": "2023-02-24", "firstIndexDate": "2023-02-26", "fullTextReceivedDate": "2025-02-04", "hasEvaluations": "N"}]}}