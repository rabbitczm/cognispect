00-0002-0330-9949"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Histopathology, Division of Cancer and Stem Cells, School of Medicine, The University of Nottingham and Nottingham University Hospitals NHS Trust, Nottingham City Hospital, Nottingham, NG5 1PB, UK."}]}}, {"fullName": "Gamble P", "lastName": "Gamble", "firstName": "Paul", "initials": "P", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Google Health, Google, Palo Alto, CA, USA."}]}}, {"fullName": "Jaroensri R", "lastName": "Jaroensri", "firstName": "Ronnachai", "initials": "R", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Google Health, Google, Palo Alto, CA, USA."}]}}, {"fullName": "Abdelsamea MM", "lastName": "Abdelsamea", "firstName": "Mohammed M", "initials": "MM", "authorId": {"type": "ORCID", "value": "0009-0000-5677-6818"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "School of Computing and Digital Technology, Birmingham City University, Birmingham, UK."}]}}, {"fullName": "Abdelsamea MM", "lastName": "Abdelsamea", "firstName": "Mohammed M", "initials": "MM", "authorId": {"type": "ORCID", "value": "0000-0002-2728-1127"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "School of Computing and Digital Technology, Birmingham City University, Birmingham, UK."}]}}, {"fullName": "Mermel CH", "lastName": "Mermel", "firstName": "Craig H", "initials": "CH", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Google Health, Google, Palo Alto, CA, USA."}]}}, {"fullName": "Chen PC", "lastName": "Chen", "firstName": "Po-Hsuan Cameron", "initials": "PC", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Google Health, Google, Palo Alto, CA, USA."}]}}, {"fullName": "Rakha EA", "lastName": "Rakha", "firstName": "Emad A", "initials": "EA", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Histopathology, Division of Cancer and Stem Cells, School of Medicine, The University of Nottingham and Nottingham University Hospitals NHS Trust, Nottingham City Hospital, Nottingham, NG5 1PB, UK. Electronic address: Emad.Rakha@nottingham.ac.uk."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-0330-9949"}, {"type": "ORCID", "value": "0000-0002-2728-1127"}, {"type": "ORCID", "value": "0000-0002-9655-2621"}, {"type": "ORCID", "value": "0009-0000-5677-6818"}]}, "journalInfo": {"volume": "49", "journalIssueId": 2911591, "dateOfPublication": "2020 Feb", "monthOfPublication": 2, "yearOfPublication": 2020, "journal": {"medlineAbbreviation": "Breast", "title": "Breast (Edinburgh, Scotland)", "essn": "1532-3080", "issn": "0960-9776", "nlmid": "9213011", "isoabbreviation": "Breast"}, "printPublicationDate": "2020-02-01"}, "pubYear": "2020", "pageInfo": "267-273", "abstractText": "Breast cancer is the most common cancer and second leading cause of cancer-related death worldwide. The mainstay of breast cancer workup is histopathological diagnosis - which guides therapy and prognosis. However, emerging knowledge about the complex nature of cancer and the availability of tailored therapies have exposed opportunities for improvements in diagnostic precision. In parallel, advances in artificial intelligence (AI) along with the growing digitization of pathology slides for the primary diagnosis are a promising approach to meet the demand for more accurate detection, classification and prediction of behaviour of breast tumours. In this article, we cover the current and prospective uses of AI in digital pathology for breast cancer, review the basics of digital pathology and AI, and outline outstanding challenges in the field.", "affiliation": "Department of Histopathology, Division of Cancer and Stem Cells, School of Medicine, The University of Nottingham and Nottingham University Hospitals NHS Trust, Nottingham City Hospital, Nottingham, NG5 1PB, UK.", "publicati