liation": "Department of Electrical and Computer Engineering, Sungkyunkwan University, Suwon, Korea."}, {"affiliation": "Center for Neuroscience Imaging Research, Institute for Basic Science (IBS), Suwon, Korea."}]}}, {"fullName": "Park H", "lastName": "Park", "firstName": "Hyunjin", "initials": "H", "authorId": {"type": "ORCID", "value": "0000-0001-5681-8918"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Center for Neuroscience Imaging Research, Institute for Basic Science (IBS), Suwon, Korea."}, {"affiliation": "School of Electronic and Electrical Engineering, Sungkyunkwan University, Suwon, Korea."}]}}, {"fullName": "Ko ES", "lastName": "Ko", "firstName": "Eun Sook", "initials": "ES", "authorId": {"type": "ORCID", "value": "0000-0002-0399-7956"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Samsung Medical Center, Sungkyunkwan University School of Medicine, Seoul, Korea. mathilda0330@gmail.com."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5681-8918"}, {"type": "ORCID", "value": "0000-0002-0399-7956"}, {"type": "ORCID", "value": "0000-0002-8618-7261"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "7", "volume": "21", "journalIssueId": 2967143, "dateOfPublication": "2020 Jul", "monthOfPublication": 7, "yearOfPublication": 2020, "journal": {"medlineAbbreviation": "Korean J Radiol", "title": "Korean journal of radiology", "essn": "2005-8330", "issn": "1229-6929", "nlmid": "100956096", "isoabbreviation": "Korean J Radiol"}, "printPublicationDate": "2020-07-01"}, "pubYear": "2020", "pageInfo": "779-792", "abstractText": "Recent advances in computer technology have generated a new area of research known as radiomics. Radiomics is defined as the high throughput extraction and analysis of quantitative features from imaging data. Radiomic features provide information on the gray-scale patterns, inter-pixel relationships, as well as shape and spectral properties of radiological images. Moreover, these features can be used to develop computational models that may serve as a tool for personalized diagnosis and treatment guidance. Although radiomics is becoming popular and widely used in oncology, many problems such as overfitting and reproducibility issues remain unresolved. In this review, we will outline the steps of radiomics used for oncology, specifically addressing applications for breast cancer patients and focusing on technical issues.", "affiliation": "Department of Electrical and Computer Engineering, Sungkyunkwan University, Suwon, Korea.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["review-article", "Review", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Breast", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}]}}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Breast Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}, {"majorTopic_YN": "Y", "abbreviation": "DI", "qualifierName": "diagnosis"}]}}, {"majorTopic_YN": "N", "descriptorName": "Tomography, X-Ray Computed"}, {"majorTopic_YN": "N", "descriptorName": "Magnetic Resonance Imaging"}, {"majorTopic_YN": "N", "descriptorName": "Ultrasonography"}, {"majorTopic_YN": "N", "descriptorName": "Reproducibility of Results"}, {"majorTopic_YN": "N", "descriptorName": "Image Processing, Computer-Assisted"}, {"majorTopic_YN": "N", "descriptorName": "Female"}, {"majorTopic_YN": "N", "descriptorName": "Machine Learning"}]}, "keywordList": {"keyword": ["Breast cancer", "Texture", "Informatics", "Quantitative Imaging", "Radiomics"]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullT