ffiliation": [{"affiliation": "1Department of Epidemiology and Biostatistics, Memorial Sloan Kettering Cancer Center, 485 Lexington Avenue, 2nd Floor, New York, NY 10017 USA."}]}}, {"fullName": "van Calster B", "lastName": "van Calster", "firstName": "Ben", "initials": "B", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "2Department of Development and Regeneration, KU Leuven, Oude Markt 13, 3000 Leuven, Belgium."}, {"affiliation": "3Department of Biomedical Data Sciences, Leiden University Medical Center, Albinusdreef 2, 2333 ZA Leiden, Netherlands."}]}}, {"fullName": "Steyerberg EW", "lastName": "Steyerberg", "firstName": "Ewout W", "initials": "EW", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "3Department of Biomedical Data Sciences, Leiden University Medical Center, Albinusdreef 2, 2333 ZA Leiden, Netherlands."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0003-1525-6503"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics"]}, "journalInfo": {"volume": "3", "journalIssueId": 2817664, "dateOfPublication": "2019 ", "monthOfPublication": 0, "yearOfPublication": 2019, "journal": {"medlineAbbreviation": "Diagn Progn Res", "title": "Diagnostic and prognostic research", "essn": "2397-7523", "issn": "2397-7523", "nlmid": "101718985", "isoabbreviation": "Diagn Progn Res"}, "printPublicationDate": "2019-01-01"}, "pubYear": "2019", "pageInfo": "18", "abstractText": "<h4>Background</h4>Decision curve analysis is a method to evaluate prediction models and diagnostic tests that was introduced in a 2006 publication. Decision curves are now commonly reported in the literature, but there remains widespread misunderstanding of and confusion about what they mean.<h4>Summary of commentary</h4>In this paper, we present a didactic, step-by-step introduction to interpreting a decision curve analysis and answer some common questions about the method. We argue that many of the difficulties with interpreting decision curves can be solved by relabeling the <i>y</i>-axis as \"benefit\" and the <i>x</i>-axis as \"preference.\" A model or test can be recommended for clinical use if it has the highest level of benefit across a range of clinically reasonable preferences.<h4>Conclusion</h4>Decision curves are readily interpretable if readers and authors follow a few simple guidelines.", "affiliation": "1Department of Epidemiology and Biostatistics, Memorial Sloan Kettering Cancer Center, 485 Lexington Avenue, 2nd Floor, New York, NY 10017 USA.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic-eCollection", "pubTypeList": {"pubType": ["letter", "Journal Article"]}, "grantsList": {"grant": [{"agency": "National Institutes of Health", "grantId": "P30-CA008748", "orderIn": 0}, {"agency": "National Cancer Institute", "grantId": "P50-CA92629", "orderIn": 0}, {"agency": "National Institutes of Health", "grantId": "U01 NS086294", "orderIn": 0}]}, "keywordList": {"keyword": ["net benefit", "Decision Curve Analysis", "Educational Paper"]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Unpaywall", "url": "https://diagnprognres.biomedcentral.com/track/pdf/10.1186/s41512-019-0064-7"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1186/s41512-019-0064-7"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC6777022"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC6777022?pdf=render"}]}, "commentCorrectionList": {"commentCorrection": [{"source": "MED", "id": "35348862", "reference": "Eur Radiol. 2022 Sep;32(9):5787-5789. doi: 10.1007/s00330-022-08685-8", "type": "Comment in", "orderIn": 1}]}, "isOpenAccess": "Y