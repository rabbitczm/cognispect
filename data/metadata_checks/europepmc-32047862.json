9-1914"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "1Department of Medicine, Division of Gastroenterology, University of Alberta, Edmonton, Canada."}]}}, {"fullName": "Pincock D", "lastName": "Pincock", "firstName": "David", "initials": "D", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "2Chief Medical Information Office, Alberta Health Services, Edmonton, Canada."}]}}, {"fullName": "Baumgart DC", "lastName": "Baumgart", "firstName": "Daniel C", "initials": "DC", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "1Department of Medicine, Division of Gastroenterology, University of Alberta, Edmonton, Canada."}]}}, {"fullName": "Sadowski DC", "lastName": "Sadowski", "firstName": "Daniel C", "initials": "DC", "authorId": {"type": "ORCID", "value": "0000-0001-6614-8866"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "1Department of Medicine, Division of Gastroenterology, University of Alberta, Edmonton, Canada."}]}}, {"fullName": "Fedorak RN", "lastName": "Fedorak", "firstName": "Richard N", "initials": "RN", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "1Department of Medicine, Division of Gastroenterology, University of Alberta, Edmonton, Canada."}]}}, {"fullName": "Kroeker KI", "lastName": "Kroeker", "firstName": "Karen I", "initials": "KI", "authorId": {"type": "ORCID", "value": "0000-0002-3886-4213"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "1Department of Medicine, Division of Gastroenterology, University of Alberta, Edmonton, Canada."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-6614-8866"}, {"type": "ORCID", "value": "0000-0002-3009-1914"}, {"type": "ORCID", "value": "0000-0002-3886-4213"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"volume": "3", "journalIssueId": 2901940, "dateOfPublication": "2020 ", "monthOfPublication": 0, "yearOfPublication": 2020, "journal": {"medlineAbbreviation": "NPJ Digit Med", "title": "NPJ digital medicine", "essn": "2398-6352", "issn": "2398-6352", "nlmid": "101731738", "isoabbreviation": "NPJ Digit Med"}, "printPublicationDate": "2020-01-01"}, "pubYear": "2020", "pageInfo": "17", "abstractText": "Computerized clinical decision support systems, or CDSS, represent a paradigm shift in healthcare today. CDSS are used to augment clinicians in their complex decision-making processes. Since their first use in the 1980s, CDSS have seen a rapid evolution. They are now commonly administered through electronic medical records and other computerized clinical workflows, which has been facilitated by increasing global adoption of electronic medical records with advanced capabilities. Despite these advances, there remain unknowns regarding the effect CDSS have on the providers who use them, patient outcomes, and costs. There have been numerous published examples in the past decade(s) of CDSS success stories, but notable setbacks have also shown us that CDSS are not without risks. In this paper, we provide a state-of-the-art overview on the use of clinical decision support systems in medicine, including the different types, current use cases with proven efficacy, common pitfalls, and potential harms. We conclude with evidence-based recommendations for minimizing risk in CDSS design, implementation, evaluation, and maintenance.", "affiliation": "1Department of Medicine, Division of Gastroenterology, University of Alberta, Edmonton, Canada.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic-eCollection", "pubTypeList": {"pubType": ["review-article", "Review", "Journal Article"]}, "keywordList": {"keyword": ["Diagnosis", "Medical imaging", "Health Services", "Drug Regulation"]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1038/s41746-020-0221-y"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC7005290"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC7005290?pdf=render"}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 1616, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "Y", "hasData": "Y", "license": "cc by", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["doi"]}, "dateOfCreation": "2020-02-13", "dateOfRevision": "2024-10-10", "electronicPublicationDate": "2020-02-06", "firstPublicationDate": "2020-02-06", "firstIndexDate": "2020-02-13", "fullTextReceivedDate": "2025-02-05", "hasEvaluations": "N"}]}}