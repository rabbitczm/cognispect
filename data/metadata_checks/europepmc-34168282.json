rAffiliation": [{"affiliation": "Regional computing center (RRZK), University of Cologne, Cologne, Germany."}]}}, {"fullName": "Nieroda L", "lastName": "Nieroda", "firstName": "Lech", "initials": "L", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Regional computing center (RRZK), University of Cologne, Cologne, Germany."}]}}, {"fullName": "Büttner R", "lastName": "Büttner", "firstName": "Reinhard", "initials": "R", "authorId": {"type": "ORCID", "value": "0000-0001-8806-4786"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Pathology, University Hospital Cologne, Cologne, Germany."}]}}, {"fullName": "Quaas A", "lastName": "Quaas", "firstName": "Alexander", "initials": "A", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Pathology, University Hospital Cologne, Cologne, Germany."}]}}, {"fullName": "Tolkach Y", "lastName": "Tolkach", "firstName": "Yuri", "initials": "Y", "authorId": {"type": "ORCID", "value": "0000-0001-5239-2841"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Pathology, University Hospital Cologne, Cologne, Germany. yuri.tolkach@gmail.com."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5239-2841"}, {"type": "ORCID", "value": "0000-0001-8806-4786"}, {"type": "ORCID", "value": "0000-0002-3813-0746"}, {"type": "ORCID", "value": "0000-0002-4203-5696"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "12", "volume": "34", "journalIssueId": 3269191, "dateOfPublication": "2021 Dec", "monthOfPublication": 12, "yearOfPublication": 2021, "journal": {"medlineAbbreviation": "Mod Pathol", "title": "Modern pathology : an official journal of the United States and Canadian Academy of Pathology, Inc", "essn": "1530-0285", "issn": "0893-3952", "nlmid": "8806605", "isoabbreviation": "Mod Pathol"}, "printPublicationDate": "2021-12-01"}, "pubYear": "2021", "pageInfo": "2098-2108", "abstractText": "Digital pathology provides a possibility for computational analysis of histological slides and automatization of routine pathological tasks. Histological slides are very heterogeneous concerning staining, sections' thickness, and artifacts arising during tissue processing, cutting, staining, and digitization. In this study, we digitally reproduce major types of artifacts. Using six datasets from four different institutions digitized by different scanner systems, we systematically explore artifacts' influence on the accuracy of the pre-trained, validated, deep learning-based model for prostate cancer detection in histological slides. We provide evidence that any histological artifact dependent on severity can lead to a substantial loss in model performance. Strategies for the prevention of diagnostic model accuracy losses in the context of artifacts are warranted. Stress-testing of diagnostic models using synthetically generated artifacts might be an essential step during clinical validation of deep learning-based algorithms.", "affiliation": "Institute of Pathology, University Hospital Cologne, Cologne, Germany.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Research Support, U.S. Gov't, Non-P.H.S.", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01 CA220581", "orderIn": 0}, {"agency": "NIBIB NIH HHS", "acronym": "EB", "grantId": "R43 EB028736", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U54 CA254566", "orderIn": 0}, {"agency": "NCRR NIH HHS", "acronym": "RR", "grantId": "C06 RR012463", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01 CA208236", "orderIn": 0}, {"agency": "BLRD VA", "acronym": "BX", "grantId": "I01 BX004121", "orderIn": 0}, {"agency": "NCI 