": {"authorAffiliation": [{"affiliation": "From the Department of Radiology, Juntendo University School of Medicine, Tokyo."}]}}, {"fullName": "Fujita S", "lastName": "Fujita", "firstName": "Shohei", "initials": "S"}, {"fullName": "Ohno Y", "lastName": "Ohno", "firstName": "Yoshiharu", "initials": "Y", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Fujita Health University School of Medicine, Toyoake, Aichi, Japan."}]}}, {"fullName": "Aoki S", "lastName": "Aoki", "firstName": "Shigeki", "initials": "S", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "From the Department of Radiology, Juntendo University School of Medicine, Tokyo."}]}}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "9", "volume": "55", "journalIssueId": 2993254, "dateOfPublication": "2020 Sep", "monthOfPublication": 9, "yearOfPublication": 2020, "journal": {"medlineAbbreviation": "Invest Radiol", "title": "Investigative radiology", "essn": "1536-0210", "issn": "0020-9996", "nlmid": "0045377", "isoabbreviation": "Invest Radiol"}, "printPublicationDate": "2020-09-01"}, "pubYear": "2020", "pageInfo": "601-616", "abstractText": "Radiological images have been assessed qualitatively in most clinical settings by the expert eyes of radiologists and other clinicians. On the other hand, quantification of radiological images has the potential to detect early disease that may be difficult to detect with human eyes, complement or replace biopsy, and provide clear differentiation of disease stage. Further, objective assessment by quantification is a prerequisite of personalized/precision medicine. This review article aims to summarize and discuss how the variability of quantitative values derived from radiological images are induced by a number of factors and how these variabilities are mitigated and standardization of the quantitative values are achieved. We discuss the variabilities of specific biomarkers derived from magnetic resonance imaging and computed tomography, and focus on diffusion-weighted imaging, relaxometry, lung density evaluation, and computer-aided computed tomography volumetry. We also review the sources of variability and current efforts of standardization of the rapidly evolving techniques, which include radiomics and artificial intelligence.", "affiliation": "From the Department of Radiology, Juntendo University School of Medicine, Tokyo.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "review-article", "Review", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Diagnostic Imaging", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "ST", "qualifierName": "standards"}]}}, {"majorTopic_YN": "N", "descriptorName": "Reference Standards"}, {"majorTopic_YN": "Y", "descriptorName": "Artificial Intelligence"}, {"majorTopic_YN": "N", "descriptorName": "Image Processing, Computer-Assisted", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "MT", "qualifierName": "methods"}, {"majorTopic_YN": "Y", "abbreviation": "ST", "qualifierName": "standards"}]}}, {"majorTopic_YN": "N", "descriptorName": "Precision Medicine"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1097/RLI.0000000000000666"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC7413678"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC7413678?pdf=render"}]}, "commentCorrectionList": {"commentCorrection": [{"source": "MED", "id": "32776768", "reference": "Invest Radiol. 2020 Sep;55(9):617-618. doi: 10.1097/RLI.0000000000000667", "type": "Comment in", "orderIn": 1}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 126, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "N", "hasData": "Y", "license": "cc by-nc-nd", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["doi"]}, "dateOfCompletion": "2021-05-19", "dateOfCreation": "2020-03-27", "dateOfRevision": "2024-03-29", "firstPublicationDate": "2020-09-01", "firstIndexDate": "2020-03-26", "fullTextReceivedDate": "2025-02-03", "hasEvaluations": "N"}]}}