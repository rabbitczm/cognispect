cellular electrophysiology of the European Society of Cardiology", "essn": "1532-2092", "issn": "1099-5129", "nlmid": "100883649", "isoabbreviation": "Europace"}, "printPublicationDate": "2024-03-01"}, "pubYear": "2024", "pageInfo": "euae043", "abstractText": "In the last three decades, ablation of atrial fibrillation (AF) has become an evidence-based safe and efficacious treatment for managing the most common cardiac arrhythmia. In 2007, the first joint expert consensus document was issued, guiding healthcare professionals involved in catheter or surgical AF ablation. Mounting research evidence and technological advances have resulted in a rapidly changing landscape in the field of catheter and surgical AF ablation, thus stressing the need for regularly updated versions of this partnership which were issued in 2012 and 2017. Seven years after the last consensus, an updated document was considered necessary to define a contemporary framework for selection and management of patients considered for or undergoing catheter or surgical AF ablation. This consensus is a joint effort from collaborating cardiac electrophysiology societies, namely the European Heart Rhythm Association, the Heart Rhythm Society, the Asia Pacific Heart Rhythm Society, and the Latin American Heart Rhythm Society .", "affiliation": "Department of Cardiology, Mitera Hospital, 6, Erythrou Stavrou Str., Marousi, Athens, PC 151 23, Greece.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["research-article", "Consensus Statement", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "Y", "descriptorName": "Atrial Fibrillation", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DI", "qualifierName": "diagnosis"}, {"majorTopic_YN": "N", "abbreviation": "SU", "qualifierName": "surgery"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Catheter Ablation", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "AE", "qualifierName": "adverse effects"}, {"majorTopic_YN": "N", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Treatment Outcome"}, {"majorTopic_YN": "N", "descriptorName": "Latin America"}, {"majorTopic_YN": "N", "descriptorName": "Asia"}, {"majorTopic_YN": "N", "descriptorName": "Catheters"}]}, "keywordList": {"keyword": ["Atrial fibrillation", "Catheter ablation", "Surgical ablation"]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Unpaywall", "url": "https://digitalcommons.wustl.edu/oa_4/3654"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1093/europace/euae043"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC11000153"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC11000153?pdf=render"}]}, "commentCorrectionList": {"commentCorrection": [{"source": "MED", "id": "38597857", "reference": "Heart Rhythm. 2024 Sep;21(9):e31-e149. doi: 10.1016/j.hrthm.2024.03.017.", "type": "Republished in", "orderIn": 1}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 442, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "Y", "hasLabsLinks": "Y", "hasData": "Y", "license": "cc by-nc-nd", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["nct", "doi"]}, "dateOfCompletion": "2024-04-09", "dateOfCreation": "2024-04-08", "dateOfRevision": "2026-08-17", "firstP