horAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Medicine, Stanford University, Stanford, CA, USA. tsavage@stanford.edu."}, {"affiliation": "Division of Hospital Medicine, Stanford University, Stanford, CA, USA. tsavage@stanford.edu."}]}}, {"fullName": "Nayak A", "lastName": "Nayak", "firstName": "Ashwin", "initials": "A", "authorId": {"type": "ORCID", "value": "0009-0003-2024-3683"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Medicine, Stanford University, Stanford, CA, USA."}, {"affiliation": "Division of Hospital Medicine, Stanford University, Stanford, CA, USA."}]}}, {"fullName": "Gallo R", "lastName": "Gallo", "firstName": "Robert", "initials": "R", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Palo Alto Veterans Affairs Medical Center, Palo Alto, CA, USA."}, {"affiliation": "Department of Health Policy, Stanford University, Stanford, CA, USA."}]}}, {"fullName": "Rangan E", "lastName": "Rangan", "firstName": "Ekanath", "initials": "E", "authorId": {"type": "ORCID", "value": "0000-0001-5168-3508"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Medicine, Stanford University, Stanford, CA, USA."}]}}, {"fullName": "Chen JH", "lastName": "Chen", "firstName": "Jonathan H", "initials": "JH", "authorId": {"type": "ORCID", "value": "0000-0002-4387-8740"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Medicine, Stanford University, Stanford, CA, USA."}, {"affiliation": "Division of Hospital Medicine, Stanford University, Stanford, CA, USA."}, {"affiliation": "Stanford Center for Biomedical Informatics Research, Stanford University, Stanford, CA, USA."}, {"affiliation": "Clinical Excellence Research Center, Stanford University, Stanford, CA, USA."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5168-3508"}, {"type": "ORCID", "value": "0000-0002-4387-8740"}, {"type": "ORCID", "value": "0000-0003-4828-5802"}, {"type": "ORCID", "value": "0009-0003-2024-3683"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "1", "volume": "7", "journalIssueId": 3690128, "dateOfPublication": "2024 Jan", "monthOfPublication": 1, "yearOfPublication": 2024, "journal": {"medlineAbbreviation": "NPJ Digit Med", "title": "NPJ digital medicine", "essn": "2398-6352", "issn": "2398-6352", "nlmid": "101731738", "isoabbreviation": "NPJ Digit Med"}, "printPublicationDate": "2024-01-01"}, "pubYear": "2024", "pageInfo": "20", "abstractText": "One of the major barriers to using large language models (LLMs) in medicine is the perception they use uninterpretable methods to make clinical decisions that are inherently different from the cognitive processes of clinicians. In this manuscript we develop diagnostic reasoning prompts to study whether LLMs can imitate clinical reasoning while accurately forming a diagnosis. We find that GPT-4 can be prompted to mimic the common clinical reasoning processes of clinicians without sacrificing diagnostic accuracy. This is significant because an LLM that can imitate clinical reasoning to provide an interpretable rationale offers physicians a means to evaluate whether an LLMs response is likely correct and can be trusted for patient care. Prompting methods that use diagnostic reasoning have the potential to mitigate the \"black box\" limitations of LLMs, bringing them one step closer to safe and effective use in medicine.", "affiliation": "Department of Medicine, Stanford University, Stanford, CA, USA. tsavage@stanford.edu.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "NCATS NIH HHS", "acronym": "TR", "grantId": "UL1 TR003142", "orderIn": 0}, {"agency": "NIAID NIH HHS", "acronym": "AI", "grantId": "R01 AI178121", "orderIn": 0}, {"agency": "NIDA NIH HHS", "acronym": "DA", "grantId": "UG1 DA015815", "orderIn": 0}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Unpaywall", "url": "https://www.nature.com/articles/s41746-024-01010-1.pdf"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1038/s41746-024-01010-1"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC10808088"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC10808088?pdf=render"}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 184, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "Y", "hasLabsLinks": "Y", "hasData": "Y", "license": "cc by", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "N", "dateOfCreation": "2024-01-24", "dateOfRevision": "2026-09-22", "electronicPublicationDate": "2024-01-24", "firstPublicationDate": "2024-01-24", "firstIndexDate": "2024-01-25", "fullTextReceivedDate": "2024-01-27", "hasEvaluations": "N"}]}}