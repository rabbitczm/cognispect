: [{"affiliation": "Department of Experimental Therapeutics, The University of Texas MD Anderson Cancer Center, Houston, TX, USA. gcalin@mdanderson.org."}, {"affiliation": "Center for RNA Interference and Non-Coding RNAs, The University of Texas MD Anderson Cancer Center, Houston, TX, USA. gcalin@mdanderson.org."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-7476-3447"}, {"type": "ORCID", "value": "0000-0001-8694-8545"}, {"type": "ORCID", "value": "0000-0002-7427-0578"}, {"type": "ORCID", "value": "0000-0003-2026-5543"}, {"type": "ORCID", "value": "0000-0003-4779-8470"}, {"type": "ORCID", "value": "0009-0000-0675-6202"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "38", "volume": "42", "journalIssueId": 3634497, "dateOfPublication": "2023 Sep", "monthOfPublication": 9, "yearOfPublication": 2023, "journal": {"medlineAbbreviation": "Oncogene", "title": "Oncogene", "essn": "1476-5594", "issn": "0950-9232", "nlmid": "8711562", "isoabbreviation": "Oncogene"}, "printPublicationDate": "2023-09-01"}, "pubYear": "2023", "pageInfo": "2783-2800", "abstractText": "To date, thousands of highly abundant and conserved single-stranded RNA molecules shaped into ring structures (circRNAs) have been identified. CircRNAs are multifunctional molecules that have been shown to regulate gene expression transcriptionally and post-transcriptionally and exhibit distinct tissue- and development-specific expression patterns associated with a variety of normal and disease conditions, including cancer pathogenesis. Over the past years, due to their intrinsic stability and resistance to ribonucleases, particular attention has been drawn to their use as reliable diagnostic and prognostic biomarkers in cancer diagnosis, treatment, and prevention. However, there are some critical caveats to their utility in the clinic. Their circular shape limits their annotation and a complete functional elucidation is lacking. This makes their detection and biomedical application still challenging. Herein, we review the current knowledge of circRNA biogenesis and function, and of their involvement in tumorigenesis and potential utility in cancer-targeted therapy.", "affiliation": "Department of Life Sciences, University of Bath, Claverton Down, Bath, BA2 7AY, UK. gp529@bath.ac.uk.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "review-article", "Review", "Research Support, U.S. Gov't, Non-P.H.S.", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "P50 CA127001", "orderIn": 0}, {"agency": "N/A", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "Y", "descriptorName": "Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "GE", "qualifierName": "genetics"}]}}, {"majorTopic_YN": "N", "descriptorName": "Cell Transformation, Neoplastic"}, {"majorTopic_YN": "N", "descriptorName": "RNA", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "GE", "qualifierName": "genetics"}]}}, {"majorTopic_YN": "N", "descriptorName": "Carcinogenesis"}, {"majorTopic_YN": "Y", "descriptorName": "RNA, Circular", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "GE", "qualifierName": "genetics"}]}}]}, "chemicalList": {"chemical": [{"name": "RNA, circular", "registryNumber": "0"}, {"name": "RNA", "registryNumber": "63231-63-0"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1038/s41388-023-02780-w"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "h