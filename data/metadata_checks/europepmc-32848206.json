ist": {"authorAffiliation": [{"affiliation": "Department of Pathology, Duke University, Durham, NC, USA. laura.barisoni@duke.edu."}, {"affiliation": "Department of Medicine, Division of Nephrology, Duke University, Durham, NC, USA. laura.barisoni@duke.edu."}]}}, {"fullName": "Lafata KJ", "lastName": "Lafata", "firstName": "Kyle J", "initials": "KJ", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Duke University, Durham, NC, USA."}, {"affiliation": "Department of Radiation Oncology, Duke University, Durham, NC, USA."}]}}, {"fullName": "Hewitt SM", "lastName": "Hewitt", "firstName": "Stephen M", "initials": "SM", "authorId": {"type": "ORCID", "value": "0000-0001-8283-1788"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Laboratory of Pathology, Center for Cancer Research, National Cancer Institute, NIH, Bethesda, MD, USA."}]}}, {"fullName": "Madabhushi A", "lastName": "Madabhushi", "firstName": "Anant", "initials": "A", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Biomedical Engineering, Case Western Reserve University, Cleveland, OH, USA."}, {"affiliation": "Louis Stokes Veterans Administration Medical Center, Cleveland, OH, USA."}]}}, {"fullName": "Balis UGJ", "lastName": "Balis", "firstName": "Ulysses G J", "initials": "UGJ", "authorId": {"type": "ORCID", "value": "0000-0002-4168-1477"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Pathology, University of Michigan, Ann Arbor, MI, USA."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-8283-1788"}, {"type": "ORCID", "value": "0000-0002-4168-1477"}, {"type": "ORCID", "value": "0000-0003-0848-9683"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "11", "volume": "16", "journalIssueId": 3038730, "dateOfPublication": "2020 Nov", "monthOfPublication": 11, "yearOfPublication": 2020, "journal": {"medlineAbbreviation": "Nat Rev Nephrol", "title": "Nature reviews. Nephrology", "essn": "1759-507X", "issn": "1759-5061", "nlmid": "101500081", "isoabbreviation": "Nat Rev Nephrol"}, "printPublicationDate": "2020-11-01"}, "pubYear": "2020", "pageInfo": "669-685", "abstractText": "The emergence of digital pathology - an image-based environment for the acquisition, management and interpretation of pathology information supported by computational techniques for data extraction and analysis - is changing the pathology ecosystem. In particular, by virtue of our new-found ability to generate and curate digital libraries, the field of machine vision can now be effectively applied to histopathological subject matter by individuals who do not have deep expertise in machine vision techniques. Although these novel approaches have already advanced the detection, classification, and prognostication of diseases in the fields of radiology and oncology, renal pathology is just entering the digital era, with the establishment of consortia and digital pathology repositories for the collection, analysis and integration of pathology data with other domains. The development of machine-learning approaches for the extraction of information from image data, allows for tissue interrogation in a way that was not previously possible. The application of these novel tools are placing pathology centre stage in the process of defining new, integrated, biologically and clinically homogeneous disease categories, to identify patients at risk of progression, and shifting current paradigms for the treatment and prevention of kidney diseases.", "affiliation": "Department of Pathology, Duke University, Durham, NC, USA. laura.barisoni@duke.edu.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, U.S. Gov't, P.H.S.", "Research Support, Non-U.S. Gov't", "review-article", "Review", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NCRR NIH HHS", "acronym": "RR", "grantId": "C06 RR12463-01", "orderIn": 0}, {"agency": "NIDDK NIH HHS", "acronym": "DK", "grantId": "U2C DK114886", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "CA220581-01A1", "orderIn": 0}, {"agency": "NIDDK NIH HHS", "acronym": "DK", "grantId": "1RC2DK01", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01 CA216579-01A1", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R01CA208236-01A1", "orderIn": 0}, {"agency": "NIDDK NIH HHS", "acronym": "DK", "grantId": "U24 DK114886", "orderIn": 0}, {"agency": "NIDDK NIH HHS", "acronym": "DK", "grantId": "UH3 DK114908", "orderIn": 0}, {"agency": "NIBIB NIH HHS", "acronym": "EB", "grantId": "1R43EB028736-01", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": " 1U01 CA239055-01", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Kidney Diseases", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "DG", "qualifierName": "diagnostic imaging"}, {"majorTopic_YN": "Y", "abbreviation": "PA", "qualifierName": "pathology"}]}}, {"majorTopic_YN": "N", "descriptorName": "Image Interpretation, Computer-Assisted"}, {"majorTopic_YN": "N", "descriptorName": "Nephrology", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "TD", "qualifierName": "trends"}]}}, {"majorTopic_YN": "N", "descriptorName": "Image Processing, Computer-Assisted", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "TD", "qualifierName": "trends"}]}}, {"majorTopic_YN": "N", "descriptorName": "Machine Learning"}, {"majorTopic_YN": "Y", "descriptorName": "Precision Medicine"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availab