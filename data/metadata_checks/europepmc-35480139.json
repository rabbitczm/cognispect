s": "A", "authorId": {"type": "ORCID", "value": "0000-0001-9519-3391"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of computer science, College of Computers and Information Technology, Taif University, P.O. BOX 11099, Taif 21944, Saudi Arabia."}]}}, {"fullName": "Koundal S", "lastName": "Koundal", "firstName": "Shubham", "initials": "S", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Medical Laboratory Technology, University Institute of Applied Health Sciences, Chandigarh University (Gharuan), Mohali 140313, India."}]}}, {"fullName": "Belay A", "lastName": "Belay", "firstName": "Assaye", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0001-7315-9141"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Statistics, Mizan-Tepi University, Ethiopia."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-7315-9141"}, {"type": "ORCID", "value": "0000-0001-9519-3391"}, {"type": "ORCID", "value": "0000-0002-1577-4530"}, {"type": "ORCID", "value": "0000-0002-3083-6170"}, {"type": "ORCID", "value": "0000-0002-7906-2153"}, {"type": "ORCID", "value": "0000-0002-9160-9377"}, {"type": "ORCID", "value": "0000-0003-1688-8772"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"volume": "2022", "journalIssueId": 3292194, "dateOfPublication": "2022 ", "monthOfPublication": 0, "yearOfPublication": 2022, "journal": {"medlineAbbreviation": "Biomed Res Int", "title": "BioMed research international", "essn": "2314-6141", "issn": "2314-6133", "nlmid": "101600173", "isoabbreviation": "Biomed Res Int"}, "printPublicationDate": "2022-01-01"}, "pubYear": "2022", "pageInfo": "9605439", "abstractText": "Breast cancer is a global cause for concern owing to its high incidence around the world. The alarming increase in breast cancer cases emphasizes the management of disease at multiple levels. The management should start from the beginning that includes stringent cancer screening or cancer registry to effective diagnostic and treatment strategies. Breast cancer is highly heterogeneous at morphology as well as molecular levels and needs different therapeutic regimens based on the molecular subtype. Breast cancer patients with respective subtype have different clinical outcome prognoses. Breast cancer heterogeneity emphasizes the advanced molecular testing that will help on-time diagnosis and improved survival. Emerging fields such as liquid biopsy and artificial intelligence would help to under the complexity of breast cancer disease and decide the therapeutic regimen that helps in breast cancer management. In this review, we have discussed various risk factors and advanced technology available for breast cancer diagnosis to combat the worst breast cancer status and areas that need to be focused for the better management of breast cancer.", "affiliation": "Department of Histopathology, Postgraduate Institute of Medical Education and Research, Chandigarh 160012, India.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic-eCollection", "pubTypeList": {"pubType": ["Retracted Publication", "research-article", "Review", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Taif University", "grantId": "2020/114", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "Y", "descriptorName": "Breast Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DI", "qualifierName": "diagnosis"}, {"majorTopic_YN": "N", "abbreviation": "EP", "qualifierName": "epidemiology"}, {"majorTopic_YN": "N", "abbreviation": "PC", "qualifierName": "prevention & control"}]}}, {"majorTopic_YN": "N", "descriptorName": "Incidence"}, {"majorTopic_YN": "N", "descriptorName": "Risk Factors"}, {"majorTopic_YN": "N", "descriptorName": "Artificial Intelligence"}, {"majorTopic_YN": "N", "descriptorName": "Female"}, {"majorTopic_YN": "N", "descriptorName": "Early Detection of Cancer"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Unpaywall", "url": "https://downloads.hindawi.com/journals/bmri/2022/9605439.pdf"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Unpaywall", "url": "https://downloads.hindawi.com/journals/bmri/2022/9605439.pdf"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Unpaywall", "url": "https://downloads.hindawi.com/journals/bmri/2022/9605439.pdf"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1155/2022/9605439"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC9038417"}]}, "commentCorrectionList": {"commentCorrection": [{"source": "MED", "id": "38188754", "reference": "Biomed Res Int. 2023 Dec 29;2023:9872034. doi: 10.1155/2023/9872034", "type": "Retraction in", "orderIn": 1}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 318, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "N", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "N", "hasData": "Y", "license": "cc by", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["doi"]}, "dateOfCompletion": "2022-04-29", "dateOfCreation": "2022-04-28", "dateOfRevision": "2024-09-27", "electronicPublicationDate": "2022-04-18", "firstPublicationDate": "2022-04-18", "firstIndexDate": "2022-04-29", "fullTextReceivedDate": "2025-02-05", "hasEvaluations": "N"}]}}