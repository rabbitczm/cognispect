"authorId": {"type": "ORCID", "value": "0000-0002-0224-2340"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "University of Leeds, Leeds, UK. c.m.mcgenity@leeds.ac.uk."}, {"affiliation": "Leeds Teaching Hospitals NHS Trust, Leeds, UK. c.m.mcgenity@leeds.ac.uk."}]}}, {"fullName": "Clarke EL", "lastName": "Clarke", "firstName": "Emily L", "initials": "EL", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "University of Leeds, Leeds, UK."}, {"affiliation": "Leeds Teaching Hospitals NHS Trust, Leeds, UK."}]}}, {"fullName": "Jennings C", "lastName": "Jennings", "firstName": "Charlotte", "initials": "C", "authorId": {"type": "ORCID", "value": "0000-0003-1584-4057"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "University of Leeds, Leeds, UK."}, {"affiliation": "Leeds Teaching Hospitals NHS Trust, Leeds, UK."}]}}, {"fullName": "Matthews G", "lastName": "Matthews", "firstName": "Gillian", "initials": "G", "authorId": {"type": "ORCID", "value": "0000-0001-6754-0333"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Leeds Teaching Hospitals NHS Trust, Leeds, UK."}]}}, {"fullName": "Cartlidge C", "lastName": "Cartlidge", "firstName": "Caroline", "initials": "C", "authorId": {"type": "ORCID", "value": "0000-0002-8366-4528"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "University of Leeds, Leeds, UK."}]}}, {"fullName": "Freduah-Agyemang H", "lastName": "Freduah-Agyemang", "firstName": "Henschel", "initials": "H", "authorId": {"type": "ORCID", "value": "0009-0007-4910-5013"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "University of Leeds, Leeds, UK."}]}}, {"fullName": "Stocken DD", "lastName": "Stocken", "firstName": "Deborah D", "initials": "DD", "authorId": {"type": "ORCID", "value": "0000-0001-8031-1738"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "University of Leeds, Leeds, UK."}]}}, {"fullName": "Treanor D", "lastName": "Treanor", "firstName": "Darren", "initials": "D", "authorId": {"type": "ORCID", "value": "0000-0002-4579-484X"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "University of Leeds, Leeds, UK."}, {"affiliation": "Leeds Teaching Hospitals NHS Trust, Leeds, UK."}, {"affiliation": "Department of Clinical Pathology and Department of Clinical and Experimental Medicine, Linköping University, Linköping, Sweden."}, {"affiliation": "Centre for Medical Image Science and Visualization (CMIV), Linköping University, Linköping, Sweden."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-6754-0333"}, {"type": "ORCID", "value": "0000-0001-8031-1738"}, {"type": "ORCID", "value": "0000-0002-0224-2340"}, {"type": "ORCID", "value": "0000-0002-4579-484X"}, {"type": "ORCID", "value": "0000-0002-8366-4528"}, {"type": "ORCID", "value": "0000-0003-1584-4057"}, {"type": "ORCID", "value": "0009-0007-4910-5013"}]}, "dataLinksTagsList": {"dataLinkstag": ["full_text", "supporting_data"]}, "journalInfo": {"issue": "1", "volume": "7", "journalIssueId": 3763696, "dateOfPublication": "2024 May", "monthOfPublication": 5, "yearOfPublication": 2024, "journal": {"medlineAbbreviation": "NPJ Digit Med", "title": "NPJ digital medicine", "essn": "2398-6352", "issn": "2398-6352", "nlmid": "101731738", "isoabbreviation": "NPJ Digit Med"}, "printPublicationDate": "2024-05-01"}, "pubYear": "2024", "pageInfo": "114", "abstractText": "Ensuring diagnostic performance of artificial intelligence (AI) before introduction into clinical practice is essential. Growing numbers of studies using AI for digital pathology have been reported over recent years. The aim of this work is to examine the diagnostic accuracy of AI in digital pathology images for any disease. This systematic review and meta-analysis included diagnostic accuracy studies using any type of AI applied to whole slide images (WSIs) for any disease. The reference standard was diagnosis by histopathological assessment and/or immunohistochemistry. Searches were conducted in PubMed, EMBASE and CENTRAL in June 2022. Risk of bias and concerns of applicability were assessed using the QUADAS-2 tool. Data extraction was conducted by two investigators and meta-analysis was performed using a bivariate random effects model, with additional subgroup analyses also performed. Of 2976 identified studies, 100 were included in the review and 48 in the meta-analysis. Studies were from a range of countries, including over 152,000 whole slide images (WSIs), representing many diseases. These studies reported a mean sensitivity of 96.3% (CI 94.1-97.7) and mean specificity of 93.3% (CI 90.5-95.4). There was heterogeneity in study design and 99% of studies identified for inclusion had at least one area at high or unclear risk of bias or applicability concerns. Details on selection of cases, division of model development and validation data and raw performance data were frequently ambiguous or missing. AI is reported as having high diagnostic accuracy in the reported areas but requires more rigorous evaluation of its performance.", "affiliation": "University of Leeds, Leeds, UK. c.m.mcgenity@leeds.ac.uk.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["review-article", "Review", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Medical Research Council", "grantId": "MR/S001530/1", "orderIn": 0}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1038/s41746-024-01106-8"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC11069583"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC11069583?pdf=render"}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 146, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "Y", "hasLabsLinks": "Y", "hasData": "Y", "license": "cc by", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["doi"]}, "dateOfCreation": "2024-05-04", "dateOfRevision": "2024-05-07", "electronicPublicationDate": "2024-05-04", "firstPublicationDate": "2024-05-04", "firstIndexDate": "2024-05-05", "fullTextReceivedDate": "2025-02-04", "hasEvaluations": "N"}]}}