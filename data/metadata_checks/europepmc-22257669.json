iliation": "Department of Biostatistics, JHU Bloomberg School of Public Health, Baltimore, MD, USA. jleek@jhsph.edu"}]}}, {"fullName": "Johnson WE", "lastName": "Johnson", "firstName": "W Evan", "initials": "WE", "authorId": {"type": "ORCID", "value": "0000-0002-6247-6595"}}, {"fullName": "Parker HS", "lastName": "Parker", "firstName": "Hilary S", "initials": "HS"}, {"fullName": "Jaffe AE", "lastName": "Jaffe", "firstName": "Andrew E", "initials": "AE", "authorId": {"type": "ORCID", "value": "0000-0001-6886-1454"}}, {"fullName": "Storey JD", "lastName": "Storey", "firstName": "John D", "initials": "JD", "authorId": {"type": "ORCID", "value": "0000-0001-5992-402X"}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5992-402X"}, {"type": "ORCID", "value": "0000-0001-6886-1454"}, {"type": "ORCID", "value": "0000-0002-6247-6595"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data", "wikipedia"]}, "journalInfo": {"issue": "6", "volume": "28", "journalIssueId": 1915990, "dateOfPublication": "2012 Mar", "monthOfPublication": 3, "yearOfPublication": 2012, "journal": {"medlineAbbreviation": "Bioinformatics", "title": "Bioinformatics (Oxford, England)", "essn": "1367-4811", "issn": "1367-4803", "nlmid": "9808944", "isoabbreviation": "Bioinformatics"}, "printPublicationDate": "2012-03-01"}, "pubYear": "2012", "pageInfo": "882-883", "abstractText": "Heterogeneity and latent variables are now widely recognized as major sources of bias and variability in high-throughput experiments. The most well-known source of latent variation in genomic experiments are batch effects-when samples are processed on different days, in different groups or by different people. However, there are also a large number of other variables that may have a major impact on high-throughput measurements. Here we describe the sva package for identifying, estimating and removing unwanted sources of variation in high-throughput experiments. The sva package supports surrogate variable estimation with the sva function, direct adjustment for known batch effects with the ComBat function and adjustment for batch and latent variables in prediction problems with the fsva function.", "affiliation": "Department of Biostatistics, JHU Bloomberg School of Public Health, Baltimore, MD, USA. jleek@jhsph.edu", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NCRR NIH HHS", "acronym": "RR", "grantId": "R01 RR021967", "orderIn": 0}, {"agency": "NCRR NIH HHS", "acronym": "RR", "grantId": "RR021967", "orderIn": 0}, {"agency": "NIGMS NIH HHS", "acronym": "GM", "grantId": "R01 GM103552", "orderIn": 0}, {"agency": "NHGRI NIH HHS", "acronym": "HG", "grantId": "R01 HG002913", "orderIn": 0}, {"agency": "NHGRI NIH HHS", "acronym": "HG", "grantId": "R01HG002913", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Regression Analysis"}, {"majorTopic_YN": "N", "descriptorName": "Gene Expression Profiling"}, {"majorTopic_YN": "N", "descriptorName": "Genomics"}, {"majorTopic_YN": "Y", "descriptorName": "Software"}, {"majorTopic_YN": "N", "descriptorName": "Urinary Bladder Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "GE", "qualifierName": "genetics"}]}}, {"majorTopic_YN": "N", "descriptorName": "High-Throughput Nucleotide Sequencing"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Free", "availabilityCode": "F", "documentStyle": "pdf", "site": "Unpaywall", "url": "https://academic.oup.com/bioinformatics/article-pdf/28/6/882/48880603/bioinformatics_28_6_882.pdf"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https