: "City University of Hong Kong."}]}}, {"fullName": "Zhang Y", "lastName": "Zhang", "firstName": "Yixiao", "initials": "Y", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Johns Hopkins University."}]}}, {"fullName": "Chen JN", "lastName": "Chen", "firstName": "Jie-Neng", "initials": "JN", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Johns Hopkins University."}]}}, {"fullName": "Xiao J", "lastName": "Xiao", "firstName": "Junfei", "initials": "J", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Johns Hopkins University."}]}}, {"fullName": "Lu Y", "lastName": "Lu", "firstName": "Yongyi", "initials": "Y", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Johns Hopkins University."}]}}, {"fullName": "Landman BA", "lastName": "Landman", "firstName": "Bennett A", "initials": "BA", "authorId": {"type": "ORCID", "value": "0000-0001-5733-2127"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Vanderbilt University."}]}}, {"fullName": "Yuan Y", "lastName": "Yuan", "firstName": "Yixuan", "initials": "Y", "authorId": {"type": "ORCID", "value": "0000-0002-0853-6948"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Chinese University of Hong Kong."}, {"affiliation": "CUHK Shenzhen Research Institute."}]}}, {"fullName": "Yuille A", "lastName": "Yuille", "firstName": "Alan", "initials": "A", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Johns Hopkins University."}]}}, {"fullName": "Tang Y", "lastName": "Tang", "firstName": "Yucheng", "initials": "Y", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Vanderbilt University."}, {"affiliation": "NVIDIA."}]}}, {"fullName": "Zhou Z", "lastName": "Zhou", "firstName": "Zongwei", "initials": "Z", "authorId": {"type": "ORCID", "value": "0000-0002-3154-9851"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Johns Hopkins University."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-5733-2127"}, {"type": "ORCID", "value": "0000-0002-0853-6948"}, {"type": "ORCID", "value": "0000-0002-3154-9851"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"volume": "2023", "journalIssueId": 3757944, "dateOfPublication": "2023 Oct", "monthOfPublication": 10, "yearOfPublication": 2023, "journal": {"medlineAbbreviation": "Proc IEEE Int Conf Comput Vis", "title": "Proceedings. IEEE International Conference on Computer Vision", "essn": "2380-7504", "issn": "1550-5499", "isoabbreviation": "Proc IEEE Int Conf Comput Vis", "nlmid": "101492443"}, "printPublicationDate": "2023-10-01"}, "pubYear": "2023", "pageInfo": "21095-21107", "abstractText": "An increasing number of public datasets have shown a marked impact on automated organ segmentation and tumor detection. However, due to the small size and partially labeled problem of each dataset, as well as a limited investigation of diverse types of tumors, the resulting models are often limited to segmenting specific organs/tumors and ignore the semantics of anatomical structures, nor can they be extended to novel domains. To address these issues, we propose the CLIP-Driven Universal Model, which incorporates text embedding learned from Contrastive Language-Image Pre-training (CLIP) to segmentation models. This CLIP-based label encoding captures anatomical relationships, enabling the model to learn a structured feature embedding and segment 25 organs and 6 types of tumors. The proposed model is developed from an assembly of 14 datasets, using a total of 3,410 CT scans for training and then evaluated on 6,162 external CT scans from 3 additional datasets. We rank first on the Medical Segmentation Decathlon (MSD) public leaderboard and achieve state-of-the-art results on Beyond The Cranial Vault (BTCV). Additionally, the Universal Model is computationally more efficient (6× faster) compared with dataset-specific models, generalized better to CT scans from varying sites, and shows stronger transfer learning performance on novel tasks.", "affiliation": "City University of Hong Kong.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "NIBIB NIH HHS", "acronym": "EB", "grantId": "R01 EB037669", "orderIn": 0}, {"agency": "National Natural Science Foundation of China", "orderIn": 0}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1109/iccv51070.2023.01934"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC13332747"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC13332747?pdf=render"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1109/iccv51070.2023.01934"}]}, "isOpenAccess": "N", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 94, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "Y", "hasLabsLinks": "N", "hasData": "Y", "authMan": "Y", "epmcAuthMan": "N", "nihAuthMan": "Y", "manuscriptId": "NIHMS2117213", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["doi"]}, "dateOfCreation": "2026-07-06", "dateOfRevision": "2026-09-22", "electronicPublicationDate": "2024-01-15", "firstPublicationDate": "2023-10-01", "firstIndexDate": "2026-07-06", "fullTextReceivedDate": "2026-09-03", "hasEvaluations": "N"}]}}