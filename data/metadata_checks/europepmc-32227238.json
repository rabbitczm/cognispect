ffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Applied Health Research, University of Birmingham, Birmingham B15 2TT, UK."}]}}, {"fullName": "Kotecha D", "lastName": "Kotecha", "firstName": "Dipak", "initials": "D", "authorId": {"type": "ORCID", "value": "0000-0002-2570-9812"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Cardiovascular Sciences, University of Birmingham, Birmingham B15 2TT, UK."}, {"affiliation": "University Hospitals Birmingham NHS Foundation Trust, Birmingham B15 2GW, UK."}]}}, {"fullName": "Deeks JJ", "lastName": "Deeks", "firstName": "Jonathan J", "initials": "JJ", "authorId": {"type": "ORCID", "value": "0000-0002-8850-1971"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Applied Health Research, University of Birmingham, Birmingham B15 2TT, UK."}]}}, {"fullName": "Kirchhof P", "lastName": "Kirchhof", "firstName": "Paulus", "initials": "P", "authorId": {"type": "ORCID", "value": "0000-0002-1881-0197"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Cardiovascular Sciences, University of Birmingham, Birmingham B15 2TT, UK."}, {"affiliation": "University Hospitals Birmingham NHS Foundation Trust, Birmingham B15 2GW, UK."}, {"affiliation": "Sandwell and West Birmingham Hospitals NHS Trust, Birmingham B18 7QH, UK."}]}}, {"fullName": "Takwoingi Y", "lastName": "Takwoingi", "firstName": "Yemisi", "initials": "Y", "authorId": {"type": "ORCID", "value": "0000-0002-5828-9746"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Applied Health Research, University of Birmingham, Birmingham B15 2TT, UK."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0002-1351-1112"}, {"type": "ORCID", "value": "0000-0002-1881-0197"}, {"type": "ORCID", "value": "0000-0002-2570-9812"}, {"type": "ORCID", "value": "0000-0002-2591-6918"}, {"type": "ORCID", "value": "0000-0002-5828-9746"}, {"type": "ORCID", "value": "0000-0002-6747-8813"}, {"type": "ORCID", "value": "0000-0002-6930-5617"}, {"type": "ORCID", "value": "0000-0002-8850-1971"}, {"type": "ORCID", "value": "0000-0002-9241-1733"}, {"type": "ORCID", "value": "0000-0003-3025-9323"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "5", "volume": "22", "journalIssueId": 2952360, "dateOfPublication": "2020 May", "monthOfPublication": 5, "yearOfPublication": 2020, "journal": {"medlineAbbreviation": "Europace", "title": "Europace : European pacing, arrhythmias, and cardiac electrophysiology : journal of the working groups on cardiac pacing, arrhythmias, and cardiac cellular electrophysiology of the European Society of Cardiology", "essn": "1532-2092", "issn": "1099-5129", "nlmid": "100883649", "isoabbreviation": "Europace"}, "printPublicationDate": "2020-05-01"}, "pubYear": "2020", "pageInfo": "748-760", "abstractText": "<h4>Aims</h4>We assessed the performance of modelsf (risk scores) for predicting recurrence of atrial fibrillation (AF) in patients who have undergone catheter ablation.<h4>Methods and results</h4>Systematic searches of bibliographic databases were conducted (November 2018). Studies were eligible for inclusion if they reported the development, validation, or impact assessment of a model for predicting AF recurrence after ablation. Model performance (discrimination and calibration) measures were extracted. The Prediction Study Risk of Bias Assessment Tool (PROBAST) was used to assess risk of bias. Meta-analysis was not feasible due to clinical and methodological differences between studies, but c-statistics were presented in forest plots. Thirty-three studies developing or validating 13 models were included; eight studies compared two or more models. Common model variables were left atrial parameters, type of AF, and age. Model discriminatory ability was highly variable and no model had consistently poor or good performance. Most studies did not assess model calibration. The main risk of bias concern was the lack of internal validation which may have resulted in overly optimistic and/or biased model performance estimates. No model impact studies were identified.<h4>Conclusion</h4>Our systematic review suggests that clinical risk prediction of AF after ablation has potential, but there remains a need for robust evaluation of risk factors and development of risk scores.", "affiliation": "Institute of Applied Health Research, University of Birmingham, Birmingham B15 2TT, UK.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Systematic Review", "Journal Article"]}, "grantsList": {"grant": [{"agency": "British Heart Foundation", "acronym": "BHF_", "grantId": "FS/13/43/30324 ", "orderIn": 0}, {"agency": "Leducq Foundation", "orderIn": 0}, {"agency": "National Institute for Health Research (NIHR)", "orderIn": 0}, {"agency": "European Union", "grantId": "633196", "orderIn": 0}, {"agency": "British Heart Foundation", "acronym": "BHF_", "grantId": "PG/17/30/32961 ", "orderIn": 0}, {"agency": "German Centre for Cardiovascular Research", "orderIn": 0}, {"agency": "British Heart Foundation", "acronym": "BHF_", "grantId": "PG/17/30/32961", "orderIn": 0}, {"agency": "British Heart Foundation", "acronym": "BHF_", "grantId": "AA/18/2/34218", "orderIn": 0}, {"agency": "British Heart Foundation", "acronym": "BHF_", "grantId": "FS/13/43/30324", "orderIn": 0}, {"agency": "National Institute for Health Research (NIHR)", "grantId": "PDF-2017-10-059", "orderIn": 0}, {"agency": "German Ministry of Education and Research", "orderIn": 0}, {"agency": "National Institute for Health Research (NIHR)", "acronym": "DH_", "grantId": "CDF-2015-08-074", "orderIn": 0}, {"agency": "European Union BigData@Heart", "grantId": "EU IMI 116074", "orderIn": 0}, {"agency": "DZHK", "orderIn": 0}, {"agency": "British 