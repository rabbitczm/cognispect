ential to assist with medical education, and potentially, clinical decision-making.", "affiliation": "AnsibleHealth, Inc Mountain View, California, United States of America.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic-eCollection", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Unpaywall", "url": "https://journals.plos.org/digitalhealth/article/file?id=10.1371/journal.pdig.0000198&type=printable"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1371/journal.pdig.0000198"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC9931230"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC9931230?pdf=render"}]}, "commentCorrectionList": {"commentCorrection": [{"source": "PPR", "id": "PPR586708", "type": "Preprint in", "note": "CrossRef Pre-print loader", "orderIn": 10002}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 2390, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "Y", "hasLabsLinks": "Y", "hasData": "Y", "license": "cc by", "authMan": "N", "epmcAuthMan": "N", "nihAuthMan": "N", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["doi"]}, "dateOfCreation": "2023-02-22", "dateOfRevision": "2024-09-12", "electronicPublicationDate": "2023-02-09", "firstPublicationDate": "2023-02-09", "firstIndexDate": "2023-02-23", "fullTextReceivedDate": "2025-02-04", "hasEvaluations": "N"}]}}