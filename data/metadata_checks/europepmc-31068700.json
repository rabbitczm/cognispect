Boston, MA, USA."}, {"affiliation": "Howard Hughes Medical Institute, Chevy Chase, MD, USA."}]}}, {"fullName": "Garraway LA", "lastName": "Garraway", "firstName": "Levi A", "initials": "LA", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Broad Institute of Harvard and MIT, Cambridge, MA, USA."}, {"affiliation": "Department of Medical Oncology, Dana-Farber Cancer Institute, Boston, MA, USA."}]}}, {"fullName": "Sellers WR", "lastName": "Sellers", "firstName": "William R", "initials": "WR", "authorId": {"type": "ORCID", "value": "0000-0002-3539-9803"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Novartis Institutes for Biomedical Research, Cambridge, MA, USA. wsellers@broadinstitute.org."}, {"affiliation": "Broad Institute of Harvard and MIT, Cambridge, MA, USA. wsellers@broadinstitute.org."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-7380-0226"}, {"type": "ORCID", "value": "0000-0002-0144-9614"}, {"type": "ORCID", "value": "0000-0002-1649-0652"}, {"type": "ORCID", "value": "0000-0002-2778-4293"}, {"type": "ORCID", "value": "0000-0002-2857-4685"}, {"type": "ORCID", "value": "0000-0002-3539-9803"}, {"type": "ORCID", "value": "0000-0002-5628-3965"}, {"type": "ORCID", "value": "0000-0002-5732-3471"}, {"type": "ORCID", "value": "0000-0002-6131-9483"}, {"type": "ORCID", "value": "0000-0002-9695-6570"}, {"type": "ORCID", "value": "0000-0003-0887-6771"}, {"type": "ORCID", "value": "0000-0003-1897-2265"}, {"type": "ORCID", "value": "0009-0006-4822-5147"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data", "protocols", "recommended_reviews", "related_data"]}, "journalInfo": {"issue": "7757", "volume": "569", "journalIssueId": 2816973, "dateOfPublication": "2019 May", "monthOfPublication": 5, "yearOfPublication": 2019, "journal": {"medlineAbbreviation": "Nature", "title": "Nature", "essn": "1476-4687", "issn": "0028-0836", "isoabbreviation": "Nature", "nlmid": "0410462"}, "printPublicationDate": "2019-05-01"}, "pubYear": "2019", "pageInfo": "503-508", "abstractText": "Large panels of comprehensively characterized human cancer models, including the Cancer Cell Line Encyclopedia (CCLE), have provided a rigorous framework with which to study genetic variants, candidate targets, and small-molecule and biological therapeutics and to identify new marker-driven cancer dependencies. To improve our understanding of the molecular features that contribute to cancer phenotypes, including drug responses, here we have expanded the characterizations of cancer cell lines to include genetic, RNA splicing, DNA methylation, histone H3 modification, microRNA expression and reverse-phase protein array data for 1,072 cell lines from individuals of various lineages and ethnicities. Integration of these data with functional characterizations such as drug-sensitivity, short hairpin RNA knockdown and CRISPR-Cas9 knockout data reveals potential targets for cancer drugs and associated biomarkers. Together, this dataset and an accompanying public data portal provide a resource for the acceleration of cancer research using model cancer cell lines.", "affiliation": "Broad Institute of Harvard and MIT, Cambridge, MA, USA.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "P30 CA016672", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "P50 CA098258", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R37 CA225191", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U24 CA180922", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "U01 CA217842", "orderIn": 0}, {"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "R50 CA221675", "orderI