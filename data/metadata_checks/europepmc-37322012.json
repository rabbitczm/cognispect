rAffiliation": [{"affiliation": "Lymphoma Unit, IRCCS San Raffaele Scientific Institute, Milan, Italy. ferreri.andres@hsr.it."}]}}, {"fullName": "Calimeri T", "lastName": "Calimeri", "firstName": "Teresa", "initials": "T", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Lymphoma Unit, IRCCS San Raffaele Scientific Institute, Milan, Italy."}]}}, {"fullName": "Cwynarski K", "lastName": "Cwynarski", "firstName": "Kate", "initials": "K", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Haematology, University College Hospital, London, UK."}]}}, {"fullName": "Dietrich J", "lastName": "Dietrich", "firstName": "Jorg", "initials": "J", "authorId": {"type": "ORCID", "value": "0000-0001-8291-0136"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Cancer and Neurotoxicity Clinic and Brain Repair Research Program, Massachusetts General Hospital Cancer Center, Boston, MA, USA."}]}}, {"fullName": "Grommes C", "lastName": "Grommes", "firstName": "Christian", "initials": "C", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Neurology, Memorial Sloan Kettering Cancer Center, New York, NY, USA."}]}}, {"fullName": "Hoang-Xuan K", "lastName": "Hoang-Xuan", "firstName": "Khê", "initials": "K", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "APHP, Groupe Hospitalier Salpêtrière, Sorbonne Université, IHU, ICM, Service de Neurologie 2, Paris, France."}]}}, {"fullName": "Hu LS", "lastName": "Hu", "firstName": "Leland S", "initials": "LS", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, Neuroradiology Division, Mayo Clinic, Phoenix, AZ, USA."}]}}, {"fullName": "Illerhaus G", "lastName": "Illerhaus", "firstName": "Gerald", "initials": "G", "authorId": {"type": "ORCID", "value": "0000-0002-0009-8138"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Clinic of Hematology, Oncology and Palliative Care, Klinikum Stuttgart, Stuttgart, Germany."}]}}, {"fullName": "Nayak L", "lastName": "Nayak", "firstName": "Lakshmi", "initials": "L", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Brigham and Women's Hospital, Harvard Medical School, Boston, MA, USA."}]}}, {"fullName": "Ponzoni M", "lastName": "Ponzoni", "firstName": "Maurilio", "initials": "M", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Pathology Unit, IRCCS San Raffaele Scientific Institute, Milan, Italy."}, {"affiliation": "Ateneo Vita-Salute San Raffaele, Milan, Italy."}]}}, {"fullName": "Batchelor TT", "lastName": "Batchelor", "firstName": "Tracy T", "initials": "TT", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Brigham and Women's Hospital, Harvard Medical School, Boston, MA, USA."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-8291-0136"}, {"type": "ORCID", "value": "0000-0002-0009-8138"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "1", "volume": "9", "journalIssueId": 3586296, "dateOfPublication": "2023 Jun", "monthOfPublication": 6, "yearOfPublication": 2023, "journal": {"medlineAbbreviation": "Nat Rev Dis Primers", "title": "Nature reviews. Disease primers", "essn": "2056-676X", "issn": "2056-676X", "nlmid": "101672103", "isoabbreviation": "Nat Rev Dis Primers"}, "printPublicationDate": "2023-06-01"}, "pubYear": "2023", "pageInfo": "29", "abstractText": "Primary central nervous system lymphoma (PCNSL) is a diffuse large B cell lymphoma in which the brain, spinal cord, leptomeninges and/or eyes are exclusive sites of disease. Pathophysiology is incompletely understood, although a central role seems to comprise immunoglobulins binding to self-proteins expressed in the central nervous system (CNS) and alterations of genes involved in B cell receptor, Toll-like receptor and NF-κB signalling. Other factors such as T cells, macrophages or microglia, endothelial cells, chemokines, and interleukins, probably also have important roles. Clinical presentation varies depending on the involved regions of the CNS. Standard of care includes methotrexate-based polychemotherapy followed by age-tailored thiotepa-based conditioned autologous stem cell transplantation and, in patients unsuitable for such treatment, consolidation with whole-brain radiotherapy or single-drug maintenance. Personalized treatment, primary radiotherapy and only supportive care should be considered in unfit, frail patients. Despite available treatments, 15-25% of patients do not respond to chemotherapy and 25-50% relapse after initial response. Relapse rates are higher in older patients, although the prognosis of patients experiencing relapse is poor independent of age. Further research is needed to identify diagnostic biomarkers, treatments with higher efficacy and less neurotoxicity, strategies to improve the penetration of drugs into the CNS, and roles of other therapies such as immunotherapies and adoptive cell therapies.", "affiliation": "Lymphoma Unit, IRCCS San Raffaele Scientific Institute, Milan, Italy. ferreri.andres@hsr.it.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["research-article", "Review", "Journal Article"]}, "grantsList": {"grant": [{"agency": "NCI NIH HHS", "acronym": "CA", "grantId": "P30 CA008748", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Brain"}, {"majorTopic_YN": "N", "descriptorName": "Endothelial Cells"}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "Y", "descriptorName": "Lymphoma", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DI", "qualifierName": "diagnosis"}, {"majorTopic_YN": "N", "abbreviation": "TH", "qualifierName": "therapy"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Central Nervous System Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DT", "qualifierName": "drug therapy"}, {"majorTopic_YN": "N", "abbreviation": "TH", "qualifierName": "therapy"}]}}, {"majorTopic_YN": "N", "descriptorName": "Neoplasm Recurrence, Local"}, {"majorTopic_YN": "N", "descriptorName": "Combined Modality Therapy"}, {"majorTopic_YN": "Y", "descriptorName": "Hematopoietic Stem Cell Transplantation"}, {"majorTopic_YN": "N", "descriptorName": "Transplantation, Autologous"}, {"majorTopic_YN": "N", "descriptorName": "Aged"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Free", "availabilityCode": "F", "documentStyle": "html", "site": "PubMedCentral", "url": "https://www.ncbi.nlm.nih.gov/pmc/articles/PMC10637780"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1038/s41572-023-00439-0"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC10637780"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC10637780?pdf=render"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1038/s41572-023-00439-0"}]}, "isOpenAccess": "N", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 213, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "Y", "hasLabsLinks": "N", "hasData": "Y", "authMan": "Y", "epmcAuthMan": "N", "nihAuthMan": "Y", "manuscriptId": "NIHMS1942631", "hasTMAccessionNumbers": "Y", "tmAccessionTypeList": {"accessionType": ["nct", "doi"]}, "dateOfCompletion": "2023-06-19", "dateOfCreation": "2023-06-15", "dateOfRevision": "2025-12-03", "electronicPublicationDate": "2023-06-15", "firstPublicationDate": "2023-06-15", 