thorAffiliation": [{"affiliation": "Department of Nephrology, 1st Faculty of Medicine and General University Hospital, Charles University, Prague, Czech Republic."}]}}, {"fullName": "Stillfried SV", "lastName": "Stillfried", "firstName": "Saskia V", "initials": "SV", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Pathology, RWTH Aachen University Clinic, Aachen, Germany."}]}}, {"fullName": "Klinkhammer BM", "lastName": "Klinkhammer", "firstName": "Barbara M", "initials": "BM", "authorId": {"type": "ORCID", "value": "0000-0002-1566-7129"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Pathology, RWTH Aachen University Clinic, Aachen, Germany."}]}}, {"fullName": "Barratt J", "lastName": "Barratt", "firstName": "Jonathan", "initials": "J", "authorId": {"type": "ORCID", "value": "0000-0002-9063-7229"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "John Walls Renal Unit, University Hospital of Leicester National Health Service Trust, Leicester, United Kingdom."}, {"affiliation": "Department of Cardiovascular Sciences, University of Leicester, Leicester, United Kingdom."}]}}, {"fullName": "Floege J", "lastName": "Floege", "firstName": "Jürgen", "initials": "J", "authorId": {"type": "ORCID", "value": "0000-0001-7102-6150"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Nephrology and Immunology, RWTH Aachen University Clinic, Aachen, Germany."}]}}, {"fullName": "Roberts ISD", "lastName": "Roberts", "firstName": "Ian S D", "initials": "ISD", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Cellular Pathology, Oxford University Hospitals National Health Services Foundation Trust, Oxford, United Kingdom."}]}}, {"fullName": "Coppo R", "lastName": "Coppo", "firstName": "Rosanna", "initials": "R", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Fondazione Ricerca Molinette, Torino, Italy."}, {"affiliation": "Regina Margherita Children's University Hospital, Torino, Italy."}]}}, {"fullName": "Costa IG", "lastName": "Costa", "firstName": "Ivan G", "initials": "IG", "authorId": {"type": "ORCID", "value": "0000-0003-2890-8697"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute for Computational Genomics, RWTH Aachen University Clinic, Aachen, Germany."}]}}, {"fullName": "Bülow RD", "lastName": "Bülow", "firstName": "Roman D", "initials": "RD", "authorId": {"type": "ORCID", "value": "0000-0002-8527-7353"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Pathology, RWTH Aachen University Clinic, Aachen, Germany."}]}}, {"fullName": "Boor P", "lastName": "Boor", "firstName": "Peter", "initials": "P", "authorId": {"type": "ORCID", "value": "0000-0001-9921-4284"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Institute of Pathology, RWTH Aachen University Clinic, Aachen, Germany. pboor@ukaachen.de."}, {"affiliation": "Department of Nephrology and Immunology, RWTH Aachen University Clinic, Aachen, Germany. pboor@ukaachen.de."}]}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-6982-0689"}, {"type": "ORCID", "value": "0000-0001-7102-6150"}, {"type": "ORCID", "value": "0000-0001-8595-0694"}, {"type": "ORCID", "value": "0000-0001-9921-4284"}, {"type": "ORCID", "value": "0000-0002-1566-7129"}, {"type": "ORCID", "value": "0000-0002-5260-8494"}, {"type": "ORCID", "value": "0000-0002-8327-4642"}, {"type": "ORCID", "value": "0000-0002-8527-7353"}, {"type": "ORCID", "value": "0000-0002-9063-7229"}, {"type": "ORCID", "value": "0000-0003-2890-8697"}, {"type": "ORCID", "value": "0000-0003-3938-0461"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "1", "volume": "14", "journalIssueId": 3482889, "dateOfPublication": "2023 Jan", "monthOfPublication": 1, "yearOfPublication": 2023, "journal": {"medlineAbbreviation": "Nat Commun", "title": "Nature communications", "essn": "2041-1723", "issn": "2041-1723", "nlmid": "101528555", "isoabbreviation": "Nat Commun"}, "printPublicationDate": "2023-01-01"}, "pubYear": "2023", "pageInfo": "470", "abstractText": "Pathology diagnostics relies on the assessment of morphology by trained experts, which remains subjective and qualitative. Here we developed a framework for large-scale histomorphometry (FLASH) performing deep learning-based semantic segmentation and subsequent large-scale extraction of interpretable, quantitative, morphometric features in non-tumour kidney histology. We use two internal and three external, multi-centre cohorts to analyse over 1000 kidney biopsies and nephrectomies. By associating morphometric features with clinical parameters, we confirm previous concepts and reveal unexpected relations. We show that the extracted features are independent predictors of long-term clinical outcomes in IgA-nephropathy. We introduce single-structure morphometric analysis by applying techniques from single-cell transcriptomics, identifying distinct glomerular populations and morphometric phenotypes along a trajectory of disease progression. Our study provides a concept for Next-generation Morphometry (NGM), enabling comprehensive quantitative pathology data mining, i.e., pathomics.", "affiliation": "Institute of Pathology, RWTH Aachen University Clinic, Aachen, Germany.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "Bundesministerium für Bildung und Forschung", "grantId": "STOP-FSGS-01GM1901A", "orderIn": 0}, {"agency": "European Research Council", "grantId": "101001791", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "Y", "descriptorName": "Kidney", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbre