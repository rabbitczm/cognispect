n": [{"affiliation": "Department of Biomedical Informatics and Data Science, Yale School of Medicine, Yale University, New Haven, CT, USA."}]}}, {"fullName": "Zhang J", "lastName": "Zhang", "firstName": "Jeffrey", "initials": "J", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Biomedical Informatics and Data Science, Yale School of Medicine, Yale University, New Haven, CT, USA."}]}}, {"fullName": "Keloth V", "lastName": "Keloth", "firstName": "Vipina", "initials": "V", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Biomedical Informatics and Data Science, Yale School of Medicine, Yale University, New Haven, CT, USA."}]}}, {"fullName": "Zhou X", "lastName": "Zhou", "firstName": "Xinyu", "initials": "X", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Biomedical Informatics and Data Science, Yale School of Medicine, Yale University, New Haven, CT, USA."}]}}, {"fullName": "Qian L", "lastName": "Qian", "firstName": "Lingfei", "initials": "L", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Biomedical Informatics and Data Science, Yale School of Medicine, Yale University, New Haven, CT, USA."}]}}, {"fullName": "He H", "lastName": "He", "firstName": "Huan", "initials": "H", "authorId": {"type": "ORCID", "value": "0000-0003-1312-4195"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Biomedical Informatics and Data Science, Yale School of Medicine, Yale University, New Haven, CT, USA."}]}}, {"fullName": "Shung D", "lastName": "Shung", "firstName": "Dennis", "initials": "D", "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Biomedical Informatics and Data Science, Yale School of Medicine, Yale University, New Haven, CT, USA."}, {"affiliation": "Department of Medicine (Digestive Diseases), Yale School of Medicine, Yale University, New Haven, CT, USA."