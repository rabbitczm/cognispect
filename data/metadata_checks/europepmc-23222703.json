n": "Department of Stem Cell and Regenerative Biology, Harvard University, Cambridge, Massachusetts, USA."}]}}, {"fullName": "Hendrickson DG", "lastName": "Hendrickson", "firstName": "David G", "initials": "DG"}, {"fullName": "Sauvageau M", "lastName": "Sauvageau", "firstName": "Martin", "initials": "M", "authorId": {"type": "ORCID", "value": "0000-0001-9487-5016"}}, {"fullName": "Sauvageau M", "lastName": "Sauvageau", "firstName": "Martin", "initials": "M", "authorId": {"type": "ORCID", "value": "0009-0000-2385-914X"}}, {"fullName": "Goff L", "lastName": "Goff", "firstName": "Loyal", "initials": "L", "authorId": {"type": "ORCID", "value": "0000-0003-2875-451X"}}, {"fullName": "Rinn JL", "lastName": "Rinn", "firstName": "John L", "initials": "JL", "authorId": {"type": "ORCID", "value": "0000-0002-7231-7539"}}, {"fullName": "Pachter L", "lastName": "Pachter", "firstName": "Lior", "initials": "L", "authorId": {"type": "ORCID", "value": "0000-0002-9164-6231"}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-9487-5016"}, {"type": "ORCID", "value": "0000-0002-7231-7539"}, {"type": "ORCID", "value": "0000-0002-9164-6231"}, {"type": "ORCID", "value": "0000-0003-2875-451X"}, {"type": "ORCID", "value": "0009-0000-2385-914X"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data", "recommended_reviews", "related_data", "wikipedia"]}, "journalInfo": {"issue": "1", "volume": "31", "journalIssueId": 1999792, "dateOfPublication": "2013 Jan", "monthOfPublication": 1, "yearOfPublication": 2013, "journal": {"medlineAbbreviation": "Nat Biotechnol", "title": "Nature biotechnology", "essn": "1546-1696", "issn": "1087-0156", "nlmid": "9604648", "isoabbreviation": "Nat Biotechnol"}, "printPublicationDate": "2013-01-01"}, "pubYear": "2013", "pageInfo": "46-53", "abstractText": "Differential analysis of gene and transcript expression using high-throughput RNA sequencing (RNA-seq) is complicated by several sources of measurement variability and poses numerous statistical challenges. We present Cuffdiff 2, an algorithm that estimates expression at transcript-level resolution and controls for variability evident across replicate libraries. Cuffdiff 2 robustly identifies differentially expressed transcripts and genes and reveals differential splicing and promoter-preference changes. We demonstrate the accuracy of our approach through differential analysis of lung fibroblasts in response to loss of the developmental transcription factor HOXA1, which we show is required for lung fibroblast and HeLa cell cycle progression. Loss of HOXA1 results in significant expression level changes in thousands of individual transcripts, along with isoform switching events in key regulators of the cell cycle. Cuffdiff 2 performs robust differential analysis in RNA-seq experiments at transcript resolution, revealing a layer of regulation not readily observable with other high-throughput technologies.", "affiliation": "Department of Stem Cell and Regenerative Biology, Harvard University, Cambridge, Massachusetts, USA.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["Research Support, Non-U.S. Gov't", "research-article", "Journal Article", "Research Support, N.I.H., Extramural"]}, "grantsList": {"grant": [{"agency": "NIH HHS", "acronym": "OD", "grantId": "DP2 OD006670", "orderIn": 0}, {"agency": "NIDDK NIH HHS", "acronym": "DK", "grantId": "R01 DK094699", "orderIn": 0}, {"agency": "NIGMS NIH HHS", "acronym": "GM", "grantId": "P01GM099117", "orderIn": 0}, {"agency": "NHGRI NIH HHS", "acronym": "HG", "grantId": "P50 HG006193", "orderIn": 0}, {"agency": "NIGMS NIH HHS", "acronym": "GM", "grantId": "P01 GM099117", "orderIn": 0}, {"agency": "NIEHS NIH HHS", "acronym": "ES", "grantId": "R01 ES020260", "orderIn": 0}, {"agency": "NHGRI NIH HHS", "acronym": "HG", "grantId": "P50HG006193", "orderIn": 0}, {"agency": "NIH HHS", "acronym": "OD", "grantId": "DP2OD006670", "orderIn": 0}, {"agency"