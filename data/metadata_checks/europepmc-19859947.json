 "0000-0001-8228-0437"}, "authorAffiliationDetailsList": {"authorAffiliation": [{"affiliation": "Department of Radiology, University of Pennsylvania, Philadelphia, Pennsylvania 19104, USA. eva.zacharaki@uphs.upenn.edu"}]}}, {"fullName": "Wang S", "lastName": "Wang", "firstName": "Sumei", "initials": "S"}, {"fullName": "Chawla S", "lastName": "Chawla", "firstName": "Sanjeev", "initials": "S"}, {"fullName": "Soo Yoo D", "lastName": "Soo Yoo", "firstName": "Dong", "initials": "D"}, {"fullName": "Wolf R", "lastName": "Wolf", "firstName": "Ronald", "initials": "R"}, {"fullName": "Melhem ER", "lastName": "Melhem", "firstName": "Elias R", "initials": "ER"}, {"fullName": "Davatzikos C", "lastName": "Davatzikos", "firstName": "Christos", "initials": "C", "authorId": {"type": "ORCID", "value": "0000-0002-1025-8561"}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-6978-7284"}, {"type": "ORCID", "value": "0000-0001-8228-0437"}, {"type": "ORCID", "value": "0000-0002-1025-8561"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics"]}, "journalInfo": {"issue": "6", "volume": "62", "journalIssueId": 1679690, "dateOfPublication": "2009 Dec", "monthOfPublication": 12, "yearOfPublication": 2009, "journal": {"medlineAbbreviation": "Magn Reson Med", "title": "Magnetic resonance in medicine", "essn": "1522-2594", "issn": "0740-3194", "nlmid": "8505245", "isoabbreviation": "Magn Reson Med"}, "printPublicationDate": "2009-12-01"}, "pubYear": "2009", "pageInfo": "1609-1618", "abstractText": "The objective of this study is to investigate the use of pattern classification methods for distinguishing different types of brain tumors, such as primary gliomas from metastases, and also for grading of gliomas. The availability of an automated computer analysis tool that is more objective than human readers can potentially lead to more reliable and reproducible brain tumor diagnostic procedures. A computer-assisted classification method combining conventional MRI and perfusion MRI is developed and used for differential diagnosis. The proposed scheme consists of several steps including region-of-interest definition, feature extraction, feature selection, and classification. The extracted features include tumor shape and intensity characteristics, as well as rotation invariant texture features. Feature subset selection is performed using support vector machines with recursive feature elimination. The method was applied on a population of 102 brain tumors histologically diagnosed as metastasis (24), meningiomas (4), gliomas World Health Organization grade II (22), gliomas World Health Organization grade III (18), and glioblastomas (34). The binary support vector machine classification accuracy, sensitivity, and specificity, assessed by leave-one-out cross-validation, were, respectively, 85%, 87%, and 79% for discrimination of metastases from gliomas and 88%, 85%, and 96% for discrimination of high-grade (grades III and IV) from low-grade (grade II) neoplasms. Multiclass classification was also performed via a one-vs-all voting scheme.", "affiliation": "Department of Radiology, University of Pennsylvania, Philadelphia, Pennsylvania 19104, USA. eva.zacharaki@uphs.upenn.edu", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print", "pubTypeList": {"pubType": ["research-article", "Journal Article"]}, "grantsList": {"grant": [{"agency": "NINDS NIH HHS", "acronym": "NS", "grantId": "R01 NS042645", "orderIn": 0}]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "N", "descriptorName": "Brain Neoplasms", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "CL", "qualifierName": "classification"}, {"majorTopic_YN": "Y", "abbreviation": "DI", "qualifierName": "diagnosis"}]}}, {"majorTopic_YN": "N", "descriptorName": "Image Interpretation, Computer-Assisted", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Imaging, Three-Dimensional", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Magnetic Resonance Imaging", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Image Enhancement", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Sensitivity and Specificity"}, {"majorTopic_YN": "N", "descriptorName": "Reproducibility of Results"}, {"majorTopic_YN": "N", "descriptorName": "Algorithms"}, {"majorTopic_YN": "Y", "descriptorName": "Artificial Intelligence"}, {"majorTopic_YN": "N", "descriptorName": "Pattern Recognition, Automated", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "Y", "abbreviation": "MT", "qualifierName": "methods"}]}}, {"majorTopic_YN": "N", "descriptorName": "Adult"}, {"majorTopic_YN": "N", "descriptorName": "Aged"}, {"majorTopic_YN": "N", "descriptorName": "Aged, 80 and over"}, {"majorTopic_YN": "N", "descriptorName": "Middle Aged"}, {"majorTopic_YN": "N", "descriptorName": "Female"}, {"majorTopic_YN": "N", "descriptorName": "Male"}, {"majorTopic_YN": "N", "descriptorName": "Young Adult"}]}, "subsetList": {"subset": [{"code": "IM", "name": "Index Medicus"}]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Free", "availabilityCode": "F", "documentStyle": "pdf", "site": "Unpaywall", "url": "https://onlinelibrary.wiley.com/doi/pdfdirect/10.1002/mrm.22147"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1002/mrm.22147"}, {"availability": "Free", "availabilityCode": "F", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC2863141"}, {