 [{"affiliation": "Reproductive Medical Center, Department of Obstetrics and Gynecology, the Second Norman Bethune Hospital of Jilin University, Changchun, Jilin Province, China."}]}}, {"fullName": "Zhou Z", "lastName": "Zhou", "firstName": "Zhenhuan", "initials": "Z"}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-6169-3726"}]}, "dataLinksTagsList": {"dataLinkstag": ["supporting_data"]}, "journalInfo": {"issue": "1", "volume": "17", "journalIssueId": 4262016, "dateOfPublication": "2027 Jan", "monthOfPublication": 1, "yearOfPublication": 2027, "journal": {"medlineAbbreviation": "Med Gas Res", "title": "Medical gas research", "essn": "2045-9912", "issn": "2045-9912", "nlmid": "101564536", "isoabbreviation": "Med Gas Res"}, "printPublicationDate": "2027-01-01"}, "pubYear": "2027", "pageInfo": "197-210", "abstractText": "Gas signaling molecules, including nitric oxide, carbon monoxide, and hydrogen sulfide, have recently gained attention in erectile dysfunction treatment research because of their roles in regulating blood vessel function, reducing oxidative stress, and protecting nerves and other cells. This article reviews how nitric oxide, carbon monoxide, and hydrogen sulfide are involved in the development of erectile dysfunction and their potential as treatments. The review focuses on how these gases improve blood vessel function, relax smooth muscles, repair nerve function, and reduce tissue scarring. Current research shows that methods of gas delivery, especially those using nanocarriers or prodrugs, greatly increase how well these gases are absorbed and where they act in the body. Early animal studies and initial clinical trials support the effectiveness of these gasotransmitters in treating various causes of erectile dysfunction, including diabetes, aging, and nerve damage. Although challenges remain in controlling the speed of delivery, determining the appropriate dosage, and tailoring treatment to individual patients, there is reason for optimism. The development of responsive delivery systems, combinations of multiple gases, and additional therapies for difficult cases suggests that gas signaling molecules could transform erectile dysfunction treatment.", "affiliation": "Reproductive Medical Center, Department of Obstetrics and Gynecology, the Second Norman Bethune Hospital of Jilin University, Changchun, Jilin Province, China.", "publicationStatus": "ppublish", "language": "eng", "pubModel": "Print-Electronic", "pubTypeList": {"pubType": ["review-article", "Review", "Journal Article"]}, "meshHeadingList": {"meshHeading": [{"majorTopic_YN": "N", "descriptorName": "Animals"}, {"majorTopic_YN": "N", "descriptorName": "Humans"}, {"majorTopic_YN": "Y", "descriptorName": "Hydrogen Sulfide", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "ME", "qualifierName": "metabolism"}, {"majorTopic_YN": "N", "abbreviation": "TU", "qualifierName": "therapeutic use"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Carbon Monoxide", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "ME", "qualifierName": "metabolism"}, {"majorTopic_YN": "N", "abbreviation": "TU", "qualifierName": "therapeutic use"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Nitric Oxide", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "ME", "qualifierName": "metabolism"}, {"majorTopic_YN": "N", "abbreviation": "TU", "qualifierName": "therapeutic use"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Gases", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "ME", "qualifierName": "metabolism"}]}}, {"majorTopic_YN": "Y", "descriptorName": "Signal Transduction"}, {"majorTopic_YN": "N", "descriptorName": "Male"}, {"majorTopic_YN": "Y", "descriptorName": "Erectile Dysfunction", "meshQualifierList": {"meshQualifier": [{"majorTopic_YN": "N", "abbreviation": "DT", "qualifierName": "drug therapy"}, {"majorTopic_YN": "N", "abbreviation": "