ist": {"investigator": [{"fullName": "Neri E", "lastName": "Neri", "firstName": "Emanuele", "initials": "E", "authorId": {"type": "ORCID", "value": "0000-0001-7950-4559"}}, {"fullName": "de Souza N", "lastName": "de Souza", "firstName": "Nandita", "initials": "N"}, {"fullName": "Brady A", "lastName": "Brady", "firstName": "Adrian", "initials": "A", "authorId": {"type": "ORCID", "value": "0000-0003-3473-0282"}}, {"fullName": "Bayarri AA", "lastName": "Bayarri", "firstName": "Angel Alberich", "initials": "AA"}, {"fullName": "Becker CD", "lastName": "Becker", "firstName": "Christoph D", "initials": "CD"}, {"fullName": "Coppola F", "lastName": "Coppola", "firstName": "Francesca", "initials": "F", "authorId": {"type": "ORCID", "value": "0000-0001-8957-4606"}}, {"fullName": "Visser J", "lastName": "Visser", "firstName": "Jacob", "initials": "J", "authorId": {"type": "ORCID", "value": "0000-0001-9935-2097"}}]}, "authorIdList": {"authorId": [{"type": "ORCID", "value": "0000-0001-7950-4559"}, {"type": "ORCID", "value": "0000-0001-8957-4606"}, {"type": "ORCID", "value": "0000-0001-9935-2097"}, {"type": "ORCID", "value": "0000-0002-5932-2392"}, {"type": "ORCID", "value": "0000-0003-3473-0282"}]}, "dataLinksTagsList": {"dataLinkstag": ["altmetrics", "supporting_data"]}, "journalInfo": {"issue": "1", "volume": "10", "journalIssueId": 2801707, "dateOfPublication": "2019 Apr", "monthOfPublication": 4, "yearOfPublication": 2019, "journal": {"medlineAbbreviation": "Insights Imaging", "title": "Insights into imaging", "essn": "1869-4101", "issn": "1869-4101", "isoabbreviation": "Insights Imaging", "nlmid": "101532453"}, "printPublicationDate": "2019-04-01"}, "pubYear": "2019", "pageInfo": "44", "abstractText": "This paper aims to provide a review of the basis for application of AI in radiology, to discuss the immediate ethical and professional impact in radiology, and to consider possible future evolution.Even if AI does add significant value to image interpretation, there are implications outside the traditional radiology activities of lesion detection and characterisation. In radiomics, AI can foster the analysis of the features and help in the correlation with other omics data. Imaging biobanks would become a necessary infrastructure to organise and share the image data from which AI models can be trained. AI can be used as an optimising tool to assist the technologist and radiologist in choosing a personalised patient's protocol, tracking the patient's dose parameters, providing an estimate of the radiation risks. AI can also aid the reporting workflow and help the linking between words, images, and quantitative data. Finally, AI coupled with CDS can improve the decision process and thereby optimise clinical and radiological workflow.", "publicationStatus": "epublish", "language": "eng", "pubModel": "Electronic", "pubTypeList": {"pubType": ["brief-report", "Journal Article"]}, "keywordList": {"keyword": ["Artificial intelligence", "Ethical Issues", "Computer Applications", "Imaging Informatics", "Radiomics"]}, "fullTextUrlList": {"fullTextUrl": [{"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Unpaywall", "url": "https://insightsimaging.springeropen.com/track/pdf/10.1186/s13244-019-0738-2"}, {"availability": "Subscription required", "availabilityCode": "S", "documentStyle": "doi", "site": "DOI", "url": "https://doi.org/10.1186/s13244-019-0738-2"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "html", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC6449411"}, {"availability": "Open access", "availabilityCode": "OA", "documentStyle": "pdf", "site": "Europe_PMC", "url": "https://europepmc.org/articles/PMC6449411?pdf=render"}]}, "isOpenAccess": "Y", "inEPMC": "Y", "inPMC": "Y", "citedByCount": 195, "hasReferences": "Y", "hasTextMinedTerms": "Y", "hasDbCrossReferences": "N", "hasPDF": "Y", "hasBook": "N", "hasSuppl": "N", "hasLabsLinks": "Y", "hasData": "Y", "