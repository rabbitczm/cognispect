  "entries": {
    "FMA7088": {
      "en": "heart",
      "zh": "心脏",
      "source": "heart",
      "text": "左右心共同形成泵，将血液分别送入肺循环与体循环。",
      "supportTerm": "pumps blood",
      "scope": "structure"
    },
    "FMA7096": {
      "en": "right atrium",
      "zh": "右心房",
      "source": "heart",
      "text": "接收体循环静脉回流的血液，并将血液送入右心室。",
      "supportTerm": "right atrium",
      "scope": "structure"
    },
    "FMA7097": {
      "en": "left atrium",
      "zh": "左心房",
      "source": "heart",
      "text": "接收来自肺静脉的血液，并将血液送入左心室。",
      "supportTerm": "left atrium",
      "scope": "structure"
    },
    "FMA7098": {
      "en": "right ventricle",
      "zh": "右心室",
      "source": "heart",
      "text": "将血液射入肺动脉干，进入肺循环。",
      "supportTerm": "right ventricle",
      "scope": "structure"
    },
    "FMA7101": {
      "en": "left ventricle",
      "zh": "左心室",
      "source": "heart",
      "text": "将血液射入主动脉，进入体循环。",
      "supportTerm": "left ventricle",
      "scope": "structure"
    },
    "FMA3734": {
      "en": "aorta",
      "zh": "主动脉",
      "source": "heart",
      "text": "承接左心室射出的血液，连接体循环的主要动脉分支。",
      "supportTerm": "aorta",
      "scope": "structure"
    },
    "FMA4720": {
      "en": "superior vena cava",
      "zh": "上腔静脉",
      "source": "heart",
      "text": "将上半身的静脉回流汇入右心房。",
      "supportTerm": "superior vena cava",
      "scope": "structure"
    },
    "FMA10951": {
      "en": "inferior vena cava",
      "zh": "下腔静脉",
      "source": "heart",
      "text": "将身体下部的静脉回流汇入右心房。",
      "supportTerm": "inferior vena cava",
      "scope": "structure"
    },
    "FMA7394": {
      "en": "trachea",
      "zh": "气管",
      "source": "respiratory",
      "text": "传导空气并分为左右主支气管；软骨有助于保持气道开放。",
      "supportTerm": "trachea",
      "scope": "structure"
    },
    "FMA7309": {
      "en": "right lung",
      "zh": "右肺",
      "source": "lungs",
      "text": "右肺通常分为三叶；肺内的肺泡与肺毛细血管构成气体交换界面。",
      "supportTerm": "right lung",
      "scope": "structure"
    },
    "FMA7310": {
      "en": "left lung",
      "zh": "左肺",
      "source": "lungs",
      "text": "左肺通常分为两叶；肺内的肺泡与肺毛细血管构成气体交换界面。",
      "supportTerm": "left lung",
      "scope": "structure"
    },
    "FMA50801": {
      "en": "brain",
      "zh": "脑",
      "source": "nervous",
      "text": "脑由大脑、间脑、脑干和小脑等主要区域构成，参与感觉、运动及内环境调节；不能将任一功能定位到整个脑。",
      "supportTerm": "cerebrum",
      "scope": "structure"
    },
    "FMA67944": {
      "en": "cerebellum",
      "zh": "小脑",
      "source": "nervous",
      "text": "参与运动协调，对正在进行的动作和相关感觉反馈进行调节。",
      "supportTerm": "cerebellum",
      "scope": "structure"
    },
    "FMA79876": {
      "en": "brainstem",
      "zh": "脑干",
      "source": "nervous",
      "text": "连接脑与脊髓，包含参与心血管、呼吸等基本活动调节的区域及多组脑神经核。",
      "supportTerm": "brain stem",
      "scope": "structure"
    },
    "FMA7647": {
      "en": "spinal cord",
      "zh": "脊髓",
      "source": "nervous",
      "text": "在脑与外周之间传递信息，并整合部分感觉和运动反射通路。",
      "supportTerm": "spinal cord",
      "scope": "structure"
    },
    "FMA7197": {
      "en": "liver",
      "zh": "肝脏",
      "source": "liver",
      "text": "肝脏产生胆汁并将其输送到十二指肠，参与消化过程；该条仅概述其消化功能。",
      "supportTerm": "bile",
      "scope": "structure"
    },
    "FMA7202": {
      "en": "gallbladder",
      "zh": "胆囊",
      "source": "liver",
      "text": "储存、浓缩和释放肝脏产生的胆汁。",
      "supportTerm": "gallbladder",
      "scope": "structure"
    },
    "FMA7198": {
      "en": "pancreas",
      "zh": "胰腺",
      "source": "liver",
      "text": "外分泌部分产生含消化酶和碳酸氢根的胰液并输送到十二指肠；此条不概括其全部内分泌功能。",
      "supportTerm": "bicarbonate",
      "scope": "structure"
    },
    "FMA7204": {
      "en": "right kidney",
      "zh": "右肾",
      "source": "urinary",
      "text": "肾脏形成的尿液经肾盏、肾盂进入输尿管。该网格为外形，不含完整肾单位微观结构。",
      "supportTerm": "renal pelvis",
      "scope": "structure"
    },
    "FMA7205": {
      "en": "left kidney",
      "zh": "左肾",
      "source": "urinary",
      "text": "肾脏形成的尿液经肾盏、肾盂进入输尿管。该网格为外形，不含完整肾单位微观结构。",
      "supportTerm": "renal pelvis",
      "scope": "structure"
    },
    "FMA7163": {
      "en": "skin",
      "zh": "皮肤",
      "source": "skin",
      "text": "参与保护、感觉、体温调节等功能。该表面模型不表示皮肤各组织层的真实厚度。",
      "supportTerm": "thermoregulation",
      "scope": "structure"
    }
  },
  "groups": {
    "skeleton": {
      "source": "bones",
      "text": "系统共性：骨骼支撑身体、保护部分内脏，并与肌肉、关节协同完成运动。此说明不等于每一块骨的独有作用。",
      "scope": "system-background"
    },
    "muscles": {
      "source": "muscles",
      "text": "骨骼肌共性：收缩产生张力，参与运动与姿势维持。尚未逐一核对本页每束肌肉的起止点、支配神经和具体动作。",
      "scope": "system-background"
    },
    "nervous": {
      "source": "nervous",
      "text": "系统背景：脑和脊髓构成中枢神经系统，参与信息整合、运动和反射调节。外围神经及细小分区的专属功能需要另行核对。",
      "scope": "system-background"
    },
    "arteries": {
      "source": "vessels",
      "text": "类别共性：动脉输送离开心脏的血液；动脉不等同于含氧血管，例如肺动脉。具体血管的供血范围须逐结构核对。",
      "scope": "system-background"
    },
    "veins": {
      "source": "vessels",
      "text": "类别共性：静脉将血液带回心脏。蓝色仅是教学分类配色，不代表血液实际颜色或含氧量。具体引流区域须另行核对。",
      "scope": "system-background"
    },
    "heart": {
      "source": "heart",
      "text": "器官背景：心脏通过左右两侧泵送血液，分别连接肺循环和体循环。各心腔、瓣膜与附属结构承担不同作用。",
      "scope": "system-background"
    },
    "respiratory": {
      "source": "respiratory",
      "text": "系统背景：气道传导空气，肺泡与肺毛细血管之间进行气体交换。传导气道不能被当作气体交换表面。",
      "scope": "system-background"
    },
    "digestive": {
      "source": "digestive",
      "text": "系统背景：消化系统完成食物的推进、机械和化学消化、吸收与排泄；各器官分工不同。",
      "scope": "system-background"
    },
    "urinary": {
      "source": "urinary",
      "text": "器官背景：肾脏形成尿液，肾盏和肾盂汇集尿液并连接输尿管。此几何模型不计算滤过率或患者肾功能。",
      "scope": "system-background"
    },
    "endocrine": {
      "source": "endocrine",
      "text": "系统共性：内分泌组织分泌激素，参与对远处靶组织的调节；不同腺体分泌的激素和靶组织不同。",
      "scope": "system-background"
    },
    "skin": {
      "source": "skin",
      "text": "系统背景：皮肤参与保护、感觉与体温调节。外表网格没有呈现显微层次或真实皮肤纹理。",
      "scope": "system-background"
    },
    "reproductive": {
      "source": "reproductive",
      "text": "系统背景：睾丸生殖系统参与精子的产生、输送及相关激素分泌；这些作用不能泛化到其中任意一个结构。",
      "scope": "system-background"
    }
  },
